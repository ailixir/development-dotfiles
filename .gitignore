# ─────────────────────────────────────────────────────
# Monorepo: frontend/ (React MFE) + backend/ (Spring Boot)
# ─────────────────────────────────────────────────────

# ── Shared OS / editor ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Frontend (Node / Vite / Webpack / MSW / Cypress) ──
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.nyc_output/
frontend/.cache/
frontend/.parcel-cache/
frontend/.federation/
frontend/cypress/videos/
frontend/cypress/screenshots/
frontend/.env
frontend/.env.backup
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/*.tgz

# ── Studio runner (Node / TypeScript / Playwright) ──
studio-runner/node_modules/
studio-runner/dist/
studio-runner/coverage/
studio-runner/test-results/
studio-runner/playwright-report/
studio-runner/.scratch/
studio-runner/videos/
studio-runner/runtime-versions.json
studio-runner/*.log

# ── Backend (Gradle / JVM / Spring Boot) ──
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/local/
backend/*.log
backend/logs/
backend/src/main/resources/application-local-override.yml

# ── Legacy / tolerate leftovers ──
node_modules/
dist/
build/
coverage/
.cache/

# Environment & Secrets (AIOX)
.env
.env.local
.env.*.local
*.key
*.pem

# Dependencies (AIOX)
node_modules

# Build & Logs (AIOX)
*.log
logs/

# IDE & OS (AIOX)
.idea/
*.swp

# AIOX Local
.aiox-core/local/
.claude/settings.local.json
.aiox/install-log.txt
.aiox/

# QA evidence binaries (coverage archives, run videos) stay on disk, out of git history
docs/qa/evidence/**/*.tar.gz
docs/qa/evidence/**/*.webm

# Recorded public-site HARs (contain a public page API key string); never commit
studio-runner/evaluation/grounding/e18/**/runs/
studio-runner/evaluation/grounding/runs/e18-har/
