  "findings": [
    {
      "id": "DATA-006-01",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D1,D5",
      "resolution": "Exact ordinary-null/guided-nonnull origin branches, scoped reciprocal deferred revision/receipt FKs, validated claim binding, V21 behavior, capability-detected V19 installation orders and preserved ordinary index expressions."
    },
    {
      "id": "DATA-006-02",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D4,D6; C5",
      "resolution": "Exact status/claim/lease CAS and terminal immutability; three charged validator claims per session across keys/restarts; no stale send/result authority."
    },
    {
      "id": "DATA-006-03",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D6; C10",
      "resolution": "Separate uncached fresh Core READ_PUBLISHED_RECEIPT with current canRead and same original principal; no worker/session/head/source requirement, durable body/key identity, historical receipt distinguished from readiness."
    },
    {
      "id": "DATA-006-04",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D7; C7",
      "resolution": "Explicit immutable observed_revision_binding and one-time observed_admission_receipt in actual partitioned executions, existing admission CAS and scoped tuple/hash/profile guards; no runtimeVersions evidence shortcut."
    },
    {
      "id": "RUNTIME-001",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D2,D3; C3,C4",
      "resolution": "Capture original sanitized observation/preparation facts while current before effects; atomic admission association; independent raw-row basis with original target resolution; basisHash bound end-to-end; no inferred subtype/policy digest."
    },
    {
      "id": "RUNTIME-002",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "C1-C5,C7-C9",
      "resolution": "Closed artifact2/policy3/IR/profile/basis/verdict/job/admission/protocol2 frames and composed UTF-8/Unicode/integer/depth/cardinality limits, exact family refusal and parent ready/result echo checks; legacy64KiB limits preserved."
    },
    {
      "id": "RUNTIME-003",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "C2,C6-C8",
      "resolution": "Exact neutral authorize/issue/current and worker consume/prepare/apply/dispose ABI, sensitive ephemeral handles, trusted mounted policy/registry, actual child entry injection, one recorded context, blank/entry rules and ambiguous consumption refusal."
    },
    {
      "id": "RUNTIME-004",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "C8; main7",
      "resolution": "Native pointer/key separated from actual fixed isolated fill/select DOM primitive; retained checks and residual browser races/uncertainty stop preserved."
    },
    {
      "id": "RUNTIME-005",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "C2-C4,C9",
      "resolution": "Preserve sourceHash and ordered-ledger admissionProvenanceHash; separate publicationEvidenceHash; exact CompileInputs config and independent opaque cfg mapping; fixed canonical bytes/digests and Java/Node/JSONB oracle requirements."
    },
    {
      "id": "PUB-001",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D2,D3; C4,C11",
      "resolution": "Original multipage/restart facts captured transactionally before effects and independently validated; missing old history refuses without recollection or replay."
    },
    {
      "id": "PUB-002",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D6; C10",
      "resolution": "Historical committed receipt retrieval uses separate fresh Core access after expiry/head/source change without publication/validation/effects, and does not assert current readiness."
    },
    {
      "id": "PUB-003",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "D7; C6,C7",
      "resolution": "Concrete006 fresh Core explicit-replay authorization, execution/preallocated-attempt grant bounded30seconds, exact queue/dispatch/admission checks and existing cancellation/policy/account revocation; no provisional fallback; observed schedules fail closed, legacy unchanged."
    },
    {
      "id": "PUB-004",
      "status": "DESIGN_ADDRESSED_PENDING_REVIEW",
      "sections": "C10; D1,D5,D6",
      "resolution": "New public result3/session-view3 for base-enabled sessions, actual receipt-backed producer, revision UUID/digest separation, historic/current readiness and learned/replay evidence distinction, oldresult2 compatibility and008 automatic finalize/poll/reconnect."
    }
  ],
  "mandatoryConditions": {
    "DATA-mandatory": "D1,D5,D6,D8: epoch/ORM/overflow, pre-effect base, final CAS/clock/grant, fresh conflict transaction, lock order, no synthetic execution/schedule mutation.",
    "RUNTIME-mandatory": "C3-C9,C11: exact graph/hash/profile chain, no historic child authority, fresh values, data-free diagnostics before spawn, isolation/deadline/scratch preservation; LearningProvenance excluded from required execution compatibility.",
