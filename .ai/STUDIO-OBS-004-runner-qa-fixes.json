    "SEC-001": {
      "disposition": "FIXED in runner; QA verification pending",
      "implementation": "Session-private worker inventory seeded into isolated collectors, persistent across document replacement/removal, strict raw+normalized provenance for input/sensitive/business sources,4096 entries/1MiBUTF8; no eviction, persistent failure, public facade strips inventory, teardown/late-result refusal",
      "proof": [
        "Real password/ordinary input/authorized source/sensitive-region later echoes masked",
        "Actual runtime callbacks exclude uncaptured password/ordinary input bytes in all3 source-to-consumer fixtures",
        "Count/UTF8 overflow, invalidUnicode failure, late result afterdispose andlatewithhold reject",
        "UnexpectedCDP error messages normalized; private inventory clear/zero state verified only in tests"
      ]
    },
    "REL-001": {
      "disposition": "FIXED in runner; QA verification pending",
      "implementation": "Native check/uncheck single attempt followed by retained original document/node/type/enabled/sensitivity/state postcondition; no re-resolution/retry; radio uncheck refused duringprepare; post-effect failure UNKNOWN",
      "proof": [
        "PreventDefault/reverted/replaced/retyped checkbox attempts yieldUNKNOWN afterone receipt",
        "Checked radio uncheck prepare/invoke refusebeforeeffect",
        "Radio check and existing checkbox check/uncheck/no-op receipts pass"
      ]
    },
    "SEC-002": {
      "disposition": "Runner FIXED; backend integration owned by lead; QA verification pending",
      "implementation": "Recursive fatalUTF8 JSON parser rejects raw nested/escaped duplicates, trailingtokens, noncanonical/unsafe integers, unpairedUnicode andBOM; used inboundrunner/controllerresponses/JWT; closedJWT required6claims plusoptionalnonnegativenbf",
      "proof": [
        "Real authenticatedTLS /assign malformed rawbytes refused409SCHEMA with0claim/browsercalls",
        "Shared20raw vectors match",
        "JWT signedduplicate/unknown/fraction/future/negative cases reject"
      ]
    },
    "REL-002": {
      "disposition": "Runner FIXED with coordinator-approved sharedv2 profile; QA verification pending",
      "implementation": "Explicit UTC upperT/Z Gregorian second00..59 optional1..9fraction validation; exactfinalpattern bundled; no timestampnormalization; schema startupaudits keywords/formats/fullID refs/pointers andcycles; unknown definitions failclosed; nolearnedplanruntime support",
      "proof": [
        "Shared26date vectors pass actualassignment schemas",
        "Bundle drift test matcheslead schemas",
        "Unsupported keywords/formats/unresolved ref/pointer/non-schema target/cycles refuse atload"
      ]
