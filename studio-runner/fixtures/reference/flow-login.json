{
  "name": "flow-login",
  "description": "A multi-step login flow using both reference kinds and several methods.",
  "source": [
    "Go to \"https://example.com/login\"",
    "Type \"<var USERNAME>\" in the \"Username\" field",
    "Type \"<secret LOGIN_PW>\" in the \"Password\" field",
    "Click the \"Sign in\" button",
    "Check that we landed on the dashboard"
  ],
  "references": {
    "variables": [
      "USERNAME"
    ],
    "secrets": [
      "LOGIN_PW"
    ]
  },
  "values": {
    "variables": {
      "USERNAME": "alice"
    },
    "secrets": {
      "LOGIN_PW": "s3cr3t-canary"
    }
  },
  "artifact": {
    "version": 1,
    "steps": [
      {
        "stepIndex": 0,
        "originalText": "Go to \"https://example.com/login\"",
        "code": "await page.goto('https://example.com/login');"
      },
      {
        "stepIndex": 1,
        "originalText": "Type \"<var USERNAME>\" in the \"Username\" field",
        "code": "await page.getByLabel('Username').fill(vars.get('USERNAME'));"
      },
      {
        "stepIndex": 2,
        "originalText": "Type \"<secret LOGIN_PW>\" in the \"Password\" field",
        "code": "await page.getByLabel('Password').fill(vars.secret('LOGIN_PW'));"
      },
      {
        "stepIndex": 3,
        "originalText": "Click the \"Sign in\" button",
        "code": "await page.getByRole('button', { name: 'Sign in' }).click();"
      },
      {
        "stepIndex": 4,
        "originalText": "Check that we landed on the dashboard",
        "code": "await expect(page).toHaveURL('https://example.com/dashboard');"
      }
    ]
  },
