{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/design/studio-obs-015/correction01.schema.json",
  "title": "015 correction01 internal pure-validation snapshot facts; one authoring generation unchanged",
  "definitions": {
    "ContextText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "LiteralInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "VariableReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variableRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "SecretReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "secretRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "TargetHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "targetHint"
        },
        "strategy": {
          "enum": [
            "role",
            "label",
            "testId",
            "text"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "strategy",
        "value",
        "scope",
        "exact"
      ]
    },
    "DefaultVariableValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variableRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "DefaultLiteralValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "ContextualDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "default"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/definitions/DefaultLiteralValue"
            },
            {
              "$ref": "#/definitions/DefaultVariableValue"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "value"
      ]
    },
    "AuthoringEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "const": "supplied"
        },
        "csiId": {
          "type": "string",
          "maxLength": 20
        },
        "environment": {
          "type": "string",
          "maxLength": 50
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "source",
        "csiId",
        "environment",
        "route",
        "state",
        "stepId",
        "capturedAt",
        "completeness",
        "hash"
      ]
    },
    "GlobalContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/ContextText"
              },
              {
                "$ref": "#/definitions/TargetHint"
              },
              {
                "$ref": "#/definitions/ContextualDefault"
              }
            ]
          },
          "minItems": 0
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoringEvidenceReference"
          },
          "minItems": 0
        }
      },
      "required": [
        "entries",
        "evidenceReferences"
      ]
    },
    "StepContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/ContextText"
              },
              {
                "$ref": "#/definitions/LiteralInput"
              },
              {
                "$ref": "#/definitions/VariableReference"
              },
              {
                "$ref": "#/definitions/SecretReference"
              },
              {
                "$ref": "#/definitions/TargetHint"
              },
              {
                "$ref": "#/definitions/ContextualDefault"
              }
            ]
          },
          "minItems": 0
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoringEvidenceReference"
          },
          "minItems": 0
        }
      },
      "required": [
        "entries",
        "evidenceReferences"
      ]
    },
    "NormalizedAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringSchemaVersion": {
          "const": 2
        },
        "globalContext": {
          "$ref": "#/definitions/GlobalContext"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "context": {
                "$ref": "#/definitions/StepContext"
              }
            },
            "required": [
              "id",
              "text",
              "context"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "authoringSchemaVersion",
        "globalContext",
        "steps"
      ]
    },
    "AuthoringSnapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringIdentityVersion": {
          "const": 1
        },
        "authoring": {
          "$ref": "#/definitions/NormalizedAuthoring"
        },
        "authoredDeclarations": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/Declaration"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "authoringIdentityVersion",
        "authoring",
        "authoredDeclarations"
      ]
    },
    "PinnedBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "revisionId",
        "revisionDigest"
      ]
    },
    "BaseSnapshotProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json"
        },
        "authoringIdentity": {
          "$ref": "#/definitions/AuthoringSnapshotIdentity"
        },
        "configuration": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/Configuration"
        },
        "artifact": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-artifact.schema.json"
        }
      },
      "required": [
        "revision",
        "authoringIdentity",
        "configuration",
        "artifact"
      ]
    },
    "SnapshotEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "current": {
          "$ref": "#/definitions/AuthoringSnapshotIdentity"
        },
        "pinnedBase": {
          "oneOf": [
            {
              "$ref": "#/definitions/PinnedBase"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseProof": {
          "oneOf": [
            {
              "$ref": "#/definitions/BaseSnapshotProof"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "current",
        "pinnedBase",
        "baseProof"
      ]
    },
    "CorrectedValidationBasis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "configurationRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authoringHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authoredInputsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/Configuration"
        },
        "learningProvenance": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/LearningProvenance"
        },
        "sourceSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "source": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "stepId",
              "ordinal",
              "source"
            ]
          }
        },
        "scope": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/session.schema.json#/properties/scope"
        },
        "runAuthorization": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/session.schema.json#/properties/runAuthorization"
        },
        "replayRequirements": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/ReplayRequirements"
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contextId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "contextRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "ownerFence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "materializationRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "inputsHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allocationHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "metadataAcknowledged": {
              "const": true
            },
            "initialEvidence": {
              "$ref": "https://checks.citi.example/contracts/observed/v3/execution-evidence.schema.json"
            }
          },
          "required": [
            "contextId",
            "contextRevision",
            "ownerFence",
            "materializationRevision",
            "inputsHash",
            "allocationHash",
            "metadataAcknowledged",
            "initialEvidence"
          ]
        },
        "translationRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "translationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "translationPlan": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/AcceptedTranslationPlan"
        },
        "sourceSelections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/source-selection.schema.json#/definitions/sourceQuestionMeaning"
          }
        },
        "obligationAssociations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 800,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "obligationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "coordinate": {
                "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
              },
              "admissionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "proposalHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "obligationId",
              "coordinate",
              "admissionId",
              "proposalHash"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/InputIndex"
          }
        },
        "configurationReferences": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/ConfigReference"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observationHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "observation": {
                "$ref": "https://checks.citi.example/contracts/observed/v3/observation.schema.json"
              }
            },
            "required": [
              "observationHash",
              "observation"
            ]
          }
        },
        "preparations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/PreparationFact"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/EffectiveActionFact"
          }
        },
        "allocations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/allocation.schema.json"
          }
        },
        "producers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/producer.schema.json"
          }
        },
        "consumerEdges": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/consumer-edge.schema.json"
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/binding.schema.json"
          }
        },
        "transfers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json#/definitions/Transfer"
          }
        },
        "materializationEvidence": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/MaterializationEvidence"
        },
        "incrementalEvidence": {
          "oneOf": [
            {
              "$ref": "https://checks.citi.example/contracts/observed/v3/replay-validation.schema.json#/definitions/IncrementalEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotEvidence": {
          "$ref": "#/definitions/SnapshotEvidence"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "testId",
        "csiId",
        "sourceRevision",
        "configurationRevision",
        "sourceHash",
        "configurationHash",
        "authoringHash",
        "sourceManifestHash",
        "authoredInputsHash",
        "configuration",
        "learningProvenance",
        "sourceSteps",
        "scope",
        "runAuthorization",
        "replayRequirements",
        "bootstrap",
        "translationRevision",
        "translationHash",
        "translationPlan",
        "sourceSelections",
        "obligationAssociations",
        "inputs",
        "configurationReferences",
        "observations",
        "preparations",
        "actions",
        "allocations",
        "producers",
        "consumerEdges",
        "bindings",
        "transfers",
        "materializationEvidence",
        "incrementalEvidence",
        "snapshotEvidence"
      ]
    }
  }
}
