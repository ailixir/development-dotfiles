+  /**
+   * Replaces the paused-run state file atomically. The runner-side {@code checkInitial} hook re-reads
+   * it every 20 ms and {@code JSON.parse}s it; {@code Files.writeString} truncates before it writes,
+   * so a read inside that window sees an empty file, throws, and the held run ends INTERNAL_ERROR
+   * before Ready (attempt02: the pool-refusal blocker). A rename leaves a reader only the old or
+   * the new complete document, as the revocation-state and private-value files already do.
+   */
+  private static void writeInitialContextState(String json) throws IOException {
+    Path target = TEMP.resolve("initial-context-state.json");
+    Path staged = TEMP.resolve("initial-context-state.json." + System.nanoTime() + ".tmp");
+    try {
+      Files.writeString(staged, json);
+      Files.move(
+          staged,
+          target,
+          java.nio.file.StandardCopyOption.ATOMIC_MOVE,
+          java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+    } finally {
+      Files.deleteIfExists(staged);
+    }
+  }
