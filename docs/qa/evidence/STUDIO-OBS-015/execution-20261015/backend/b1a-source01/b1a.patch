+  private final class B1aParent implements AutoCloseable {
+    final String id;
+    final JsonNode edited;
+    final B1aCallbackCut cut;
+    final Map<String, B1aControl> controls;
+
+    B1aParent(String id, JsonNode edited, B1aCallbackCut cut, Map<String, B1aControl> controls) {
+      this.id = id;
+      this.edited = edited;
+      this.cut = cut;
+      this.controls = controls;
+    }
+
+    long fence() {
+      return sessions.transaction(
+          () -> sessions.lock(id).document().path("owner").path("fence").asLong());
+    }
+
+    void cancel() throws Exception {
+      String state =
+          sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
+      if (!List.of(
+              "SUCCEEDED",
+              "FAILED",
+              "UNKNOWN_OUTCOME",
+              "CANCELLED",
+              "EXPIRED",
+              "PUBLICATION_CONFLICT")
+          .contains(state)) {
+        publicCall(
+            "/api/v1/studio/guided-sessions/" + id + "/cancel",
+            C.object().put("schemaVersion", 3).put("reason", "userRequested"),
+            202,
+            UUID.randomUUID().toString());
+      }
+    }
+
+    @Override
+    public void close() throws Exception {
+      var failures = new ArrayList<Throwable>();
+      coreRole = "owner";
+      forgetCachedCoreIdentity();
+      try {
+        cancel();
+      } catch (Exception | AssertionError failure) {
+        failures.add(failure);
+      } finally {
+        cut.close();
+      }
+      try {
+        p3AwaitTeardown(id);
+      } catch (Exception | AssertionError failure) {
+        failures.add(failure);
+      }
+      try {
+        assertThat(cut.failure)
+            .as("scoped post-commit cut must complete without instrumentation failure")
+            .isNull();
+        Files.writeString(TEMP.resolve("obs015-native-mode.json"), "{}");
+      } catch (Exception | AssertionError failure) {
+        failures.add(failure);
+      } finally {
+        b1aCallbackCut = null;
+        incrementalTenScenario = false;
+        incrementalDomVariant = null;
+        primaryCsi = "CSI-123";
+        forgetCachedCoreIdentity();
+      }
+      throwTeardownFailures(failures);
+    }
+  }
