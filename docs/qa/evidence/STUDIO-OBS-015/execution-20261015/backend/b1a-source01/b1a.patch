+  /** Valid direct-attempt controls: the exact tuple of a real committed base reservation. */
+  private Map<String, B1aControl> b1aControls(String original) {
+    var controls = new java.util.LinkedHashMap<String, B1aControl>();
+    for (String kind : List.of("SOURCE_PLAN", "NEXT_ACTION")) {
+      JsonNode identity =
+          C.parse(
+              jdbc.queryForObject(
+                  "SELECT identity::text FROM studio_guided_model_attempts"
+                      + " WHERE session_id=? AND kind=? ORDER BY created_at LIMIT 1",
+                  String.class,
+                  original,
+                  kind));
+      var control =
+          new B1aControl(
+              identity.path("projectionHash").asText(),
+              identity.path("inputCeiling").asInt(),
+              identity.path("outputCeiling").asInt());
+      assertThat(control.projectionHash()).matches("[a-f0-9]{64}");
+      assertThat(control.inputCeiling()).isPositive();
+      assertDeclaredFixtureCeiling(control.outputCeiling());
+      controls.put(kind, control);
+    }
+    return Map.copyOf(controls);
