+  // B1A-CB-01: test-only post-commit checkpoints of actual prefix callbacks. Inactive by default.
+  private enum B1aPhase {
+    ADMIT,
+    CONSUME,
+    NAVIGATION_SUCCESS,
+    OBSERVATION,
+    READ_SUCCESS
+  }
+
+  private static volatile B1aCallbackCut b1aCallbackCut;
+  private static final ThreadLocal<Boolean> B1A_OBSERVER_READ = new ThreadLocal<>();
+  private static final String B1A_SESSION_SERVICE =
+      "com.citi.put.checks.studio.guided.session.GuidedSessionService";
+  private static final String B1A_TRANSLATION = "com.citi.put.checks.studio.guided.translation.";
+  private static final java.util.Set<String> B1A_SERVICE_FRAMES =
+      java.util.Set.of("observeV2", "admitChecked", "consume", "outcomeV2");
+
+  /**
+   * Recognizes the actual service frame after its original outermost transaction committed, copies
+   * bounded ID/hash/state facts from an independent autocommit read, then holds the real caller
+   * outside every transaction. It never changes a result, exception, decision, clock or source.
+   */
+  private static final class B1aCallbackCut {
+    final UUID test;
+    final java.util.Set<B1aPhase> holds;
+    final Thread owner = Thread.currentThread();
+    final java.util.Map<B1aPhase, java.util.concurrent.CountDownLatch> entered =
+        new java.util.EnumMap<>(B1aPhase.class);
+    final java.util.Map<B1aPhase, java.util.concurrent.CountDownLatch> release =
+        new java.util.EnumMap<>(B1aPhase.class);
+    final java.util.Map<B1aPhase, ObjectNode> facts =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    final java.util.Map<B1aPhase, Long> enteredAtNanos =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    final List<B1aPhase> order = new CopyOnWriteArrayList<>();
+    volatile String sessionId;
+    volatile boolean closed;
+    volatile Throwable failure;
+
+    B1aCallbackCut(UUID test, java.util.Set<B1aPhase> holds) {
+      this.test = test;
+      this.holds = java.util.Set.copyOf(holds);
+      for (B1aPhase phase : B1aPhase.values()) {
+        entered.put(phase, new java.util.concurrent.CountDownLatch(1));
+        release.put(phase, new java.util.concurrent.CountDownLatch(1));
+      }
+    }
+
+    void afterCommit(JdbcTemplate jdbc, Object result) {
+      if (closed || Thread.currentThread() == owner || B1A_OBSERVER_READ.get() != null) {
+        return;
+      }
+      B1aPhase held = null;
+      B1A_OBSERVER_READ.set(Boolean.TRUE);
+      try {
+        String frame =
+            StackWalker.getInstance()
+                .walk(
+                    frames ->
+                        frames
+                            .filter(
+                                candidate -> candidate.getClassName().equals(B1A_SESSION_SERVICE))
+                            .map(StackWalker.StackFrame::getMethodName)
+                            .filter(B1A_SERVICE_FRAMES::contains)
+                            .findFirst())
+                .orElse(null);
+        if (frame == null) {
+          return;
+        }
+        JsonNode returned = null;
+        if (result
+            instanceof
+            com.citi.put.checks.studio.guided.session.GuidedSessionService.WonConsumption won) {
+          returned = won.ledger();
+        } else if (!frame.equals("consume") && result instanceof JsonNode node) {
+          returned = node;
+        }
+        if (returned == null) {
+          return;
+        }
+        String id = returned.path("sessionId").asText("");
+        if (id.isEmpty() || !bind(jdbc, id)) {
+          return;
+        }
+        ObjectNode stored = b1aStoredFacts(jdbc, id);
+        B1aPhase phase = phase(frame, returned, stored);
+        if (phase == null || !holds.contains(phase)) {
+          return;
+        }
+        // Copies only IDs, states and counters; the consumed capability itself is never retained.
+        ObjectNode checkpoint =
+            C.object().put("frame", frame).put("resultType", result.getClass().getSimpleName());
+        ObjectNode copied = checkpoint.putObject("result");
+        copied.set("sessionId", b1aFact(returned.path("sessionId")));
+        copied.set("state", b1aFact(returned.path("state")));
+        copied.set("admissionId", b1aFact(returned.path("admission").path("admissionId")));
+        copied.set("dispatchCount", b1aFact(returned.path("dispatchCount")));
+        copied.set("coordinate", b1aFact(returned.path("coordinate")));
+        checkpoint.set("stored", stored);
+        synchronized (this) {
+          if (closed || facts.containsKey(phase)) {
+            return;
+          }
+          facts.put(phase, checkpoint);
+          enteredAtNanos.put(phase, System.nanoTime());
+          order.add(phase);
+        }
+        held = phase;
+        entered.get(phase).countDown();
+      } catch (RuntimeException | AssertionError instrumentation) {
+        if (failure == null) {
+          failure = instrumentation;
+        }
+      } finally {
+        B1A_OBSERVER_READ.remove();
+      }
+      if (held == null) {
+        return;
+      }
+      try {
+        if (!release.get(held).await(13, java.util.concurrent.TimeUnit.SECONDS)
+            && failure == null) {
+          failure = new IllegalStateException("B1a " + held + " hold was not released in time");
+        }
+      } catch (InterruptedException interrupted) {
+        Thread.currentThread().interrupt();
+        if (failure == null) {
+          failure = interrupted;
+        }
+      }
+    }
+
+    private synchronized boolean bind(JdbcTemplate jdbc, String id) {
+      if (sessionId != null) {
+        return sessionId.equals(id);
+      }
+      Map<String, Object> row =
+          jdbc.queryForMap(
+              "SELECT test_id::text AS test,studio_015_prefix_pending(session_id) AS pending"
+                  + " FROM studio_guided_sessions WHERE session_id=?",
+              id);
+      if (!test.toString().equals(row.get("test")) || !Boolean.TRUE.equals(row.get("pending"))) {
+        return false;
+      }
+      sessionId = id;
+      return true;
+    }
+
+    private static B1aPhase phase(String frame, JsonNode returned, JsonNode stored) {
+      JsonNode actions = stored.path("step0Actions");
+      JsonNode navigation = actions.path(0);
+      JsonNode read = actions.path(1);
+      boolean navigationOnly =
+          actions.size() == 1
+              && navigation.path("ordinal").asInt(-1) == 0
+              && navigation.path("kind").asText().equals("navigate");
+      boolean navigationReturned =
+          returned.path("coordinate").path("stepId").asText().equals(INCREMENTAL_STEPS.get(0))
+              && returned.path("coordinate").path("ordinal").asInt(-1) == 0;
+      return switch (frame) {
+        case "admitChecked" ->
+            navigationOnly
+                    && navigationReturned
+                    && navigation.path("state").asText().equals("ADMITTED")
+                ? B1aPhase.ADMIT
+                : null;
+        case "consume" ->
+            navigationOnly
+                    && navigationReturned
+                    && navigation.path("state").asText().equals("DISPATCHING")
+                ? B1aPhase.CONSUME
+                : null;
+        case "outcomeV2" ->
+            actions.size() == 2
+                    && b1aSucceeded(navigation)
+                    && read.path("ordinal").asInt(-1) == 1
+                    && read.path("kind").asText().equals("read")
+                    && b1aSucceeded(read)
+                ? B1aPhase.READ_SUCCESS
+                : navigationOnly && b1aSucceeded(navigation) ? B1aPhase.NAVIGATION_SUCCESS : null;
+        case "observeV2" ->
+            navigationOnly && b1aSucceeded(navigation) ? B1aPhase.OBSERVATION : null;
+        default -> null;
+      };
+    }
+
+    void close() {
+      closed = true;
+      release.values().forEach(java.util.concurrent.CountDownLatch::countDown);
+    }
   }
+
+  private static boolean b1aSucceeded(JsonNode action) {
+    return action.path("state").asText().equals("SUCCEEDED")
+        && action.path("dispatchCount").asInt(-1) == 1;
+  }
+
+  private static JsonNode b1aFact(JsonNode value) {
+    return value.isMissingNode()
+        ? com.fasterxml.jackson.databind.node.NullNode.instance
+        : value.deepCopy();
+  }
