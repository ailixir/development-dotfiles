+    assertThat(stored.path("step0Obligations").get(0).path("admissionId").asText())
+        .as("no read obligation association exists for step0")
+        .isEqualTo(navigation);
+    for (JsonNode preparation : stored.path("preparations")) {
+      assertThat(preparation.path("admissionId").asText())
+          .as("no read preparation row exists")
+          .isEqualTo(navigation);
+    }
