+  /**
+   * Direct reserveModel, direct typed reserveAttempt (SOURCE_PLAN and NEXT_ACTION) and the actual
+   * SOURCE_PLAN route at one held cut. Both pending predicates are recorded (C2); state, counters,
+   * attempts, CSI day rows and provider witnesses stay unchanged (C3).
+   */
+  private B1aProbe b1aFenceProbes(B1aParent parent, B1aPhase phase) throws Exception {
+    var service =
+        ownedApplicationContext.getBean(
+            com.citi.put.checks.studio.guided.session.GuidedSessionService.class);
+    var controller =
+        com.citi.put.checks.studio.guided.session.GuidedInternalIdentityFixture.controller();
+    String id = parent.id;
+    long fence = parent.fence();
+    Map<String, Object> predicates = b1aPredicates(id);
+    String pending = incrementalPendingSnapshot(id);
+    String accounting = b1aAccounting(id);
+    ObjectNode stored = b1aStoredFacts(jdbc, id);
+    B1aControl next = parent.controls.get("NEXT_ACTION");
+    assertThatThrownBy(
+            () ->
+                service.reserveModel(
+                    controller,
+                    id,
+                    fence,
+                    "b1a-reserve-" + phase + "-" + UUID.randomUUID(),
+                    next.inputCeiling(),
+                    next.outputCeiling()))
+        .isInstanceOf(GuidedSessionException.class)
+        .hasMessage("REVISION_CONFLICT");
+    for (String kind : List.of("SOURCE_PLAN", "NEXT_ACTION")) {
+      B1aControl control = parent.controls.get(kind);
+      String request = "b1a-" + kind + "-" + UUID.randomUUID();
+      assertThatThrownBy(
+              () ->
+                  sessions.transaction(
+                      () -> {
+                        var locked = sessions.lock(id);
+                        long revision = plans.state(id).path("planRevision").asLong();
+                        Instant expires =
+                            Instant.parse(locked.document().path("expiresAt").asText());
+                        Instant until = Instant.now().plusSeconds(10);
+                        return plans.reserveAttempt(
+                            locked.document(),
+                            request,
+                            1,
+                            kind,
+                            control.projectionHash(),
+                            revision,
+                            control.inputCeiling(),
+                            control.outputCeiling(),
+                            UUID.randomUUID().toString(),
+                            until.isAfter(expires) ? expires : until);
+                      }))
+          .isInstanceOf(GuidedSessionException.class)
+          .hasMessage("REVISION_CONFLICT");
+      assertThat(
+              jdbc.queryForObject(
+                  "SELECT count(*) FROM studio_guided_model_attempts WHERE request_id=?",
+                  Integer.class,
+                  request))
+          .isZero();
+    }
+    int diagnostics = FINALIZE_DIAGNOSTICS.get();
+    JsonNode refused =
+        incrementalControllerProbe(
+            id, fence, b1aPlanningCommand(parent), 409, "dependency-admissions");
+    assertThat(refused.path("code").asText()).isEqualTo("REVISION_CONFLICT");
+    b1aRouteDiagnostic(
+        diagnostics,
+        "REVISION_CONFLICT",
+        List.of(B1A_TRANSLATION + "GuidedTranslationService#lambda$learnSuffix$"));
+    assertThat(b1aPredicates(id)).isEqualTo(predicates);
+    assertThat(incrementalPendingSnapshot(id)).isEqualTo(pending);
+    assertThat(b1aAccounting(id)).isEqualTo(accounting);
+    assertThat(b1aStoredFacts(jdbc, id)).isEqualTo(stored);
+    return new B1aProbe(
+        phase,
+        "direct+dependency-admissions",
+        Boolean.TRUE.equals(predicates.get("prefix")),
+        Boolean.TRUE.equals(predicates.get("delivery")));
+  }
