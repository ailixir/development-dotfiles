+  private ObjectNode b1aAwait(B1aParent parent, B1aPhase phase) throws Exception {
+    assertThat(parent.cut.entered.get(phase).await(30, java.util.concurrent.TimeUnit.SECONDS))
+        .as("actual %s commit cut is required; an earlier guard or refusal stays OPEN", phase)
+        .isTrue();
+    assertThat(parent.cut.failure).isNull();
+    assertThat(parent.cut.sessionId).isEqualTo(parent.id);
+    assertThat(parent.cut.order)
+        .containsExactlyElementsOf(
+            java.util.Arrays.stream(B1aPhase.values())
+                .filter(
+                    candidate ->
+                        parent.cut.holds.contains(candidate)
+                            && candidate.ordinal() <= phase.ordinal())
+                .toList());
+    ObjectNode checkpoint = parent.cut.facts.get(phase);
+    JsonNode stored = checkpoint.path("stored");
+    assertThat(b1aStoredFacts(jdbc, parent.id))
+        .as("the committed %s state cannot move while its caller is held", phase)
+        .isEqualTo(stored);
+    assertThat(stored.path("state").asText()).isEqualTo("REPLAYING_PREFIX");
+    assertThat(stored.path("continuation").asText()).isEqualTo("REPLAYING_PREFIX");
+    assertThat(stored.path("prefixPending").asBoolean()).isTrue();
+    assertThat(stored.path("bootstrapPhase").asText()).isEqualTo("READY");
+    assertThat(stored.path("stepIndex").asInt(-1)).isZero();
+    assertThat(stored.path("switches").asInt(-1)).isZero();
+    assertThat(stored.path("modelAttempts").asInt(-1)).isZero();
+    assertThat(stored.path("stepCompleteCommands").asInt(-1)).isZero();
+    return checkpoint;
+  }
