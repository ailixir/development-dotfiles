+  private void b1aRelease(B1aParent parent, B1aPhase phase) {
+    assertThat(System.nanoTime() - parent.cut.enteredAtNanos.get(phase))
+        .as("hold stays inside the original callback and coordinator transport deadlines")
+        .isLessThan(Duration.ofSeconds(12).toNanos());
+    parent.cut.release.get(phase).countDown();
+  }
