+  @ParameterizedTest(name = "stored source returned manifest {0}")
+  @ValueSource(strings = {"manifest-checksum", "manifest-private-plain", "manifest-missing-plain", "manifest-authored-context"})
+  void storedSourceManifestRequiresOriginalImmutableSourcePreimage(String mutation) throws Exception {
+    try (var owner = new GuidedPublicationMigrationTest.Database();
+        var db = new GuidedPublicationMigrationTest.Database(owner.jdbc, owner.tx, "b3a-manifest", fixtures().path("basis").deepCopy())) {
+      var base = db.capture(); db.finalizing();
+      var command = prepareStored(db, base);
+      JsonNode originalRead = assertStoredPrivateProjection(db, base);
+      String original = privateAuthoritySnapshot(db);
+      var boundary = new PrivateReadBoundary(db.jdbc, db.fixtureSession());
+      var reader = new GuidedPublicationEvidenceRepository(boundary, C);
+      var reads = new AtomicInteger();
+      var writer = new GuidedPublicationRepository(db.jdbc, C, () -> { reads.incrementAndGet(); return reader; });
+      assertCommitRollback(db, writer, command, original);
+      assertThat(reads).hasValue(1);
+      boundary.arm(mutation);
+      if (mutation.equals("manifest-authored-context")) {
+        // A coherent substituted read passes snapshotEvidence and complete history reconstruction.
+        // The original pinned base then rejects its changed public manifest at the builder boundary.
+        JsonNode offered = db.tx.execute(t -> reader.read(db.fixtureSession())).document();
+        assertThat(boundary.substitutions).isEqualTo(1);
+        assertThat(boundary.currentReads).isEqualTo(1);
+        assertThat(offered.path("sourceManifest").equals(originalRead.path("sourceManifest"))).isFalse();
+        assertThat(offered.path("snapshotEvidence").path("current").path("authoring")
+            .equals(offered.path("sourceManifest").path("authoringSnapshot"))).isTrue();
+        assertThat(GuidedContracts.hash(offered.path("sourceManifest")).equals(base.document().path("sourceManifestHash").asText())).isFalse();
+        assertThat(privateAuthoritySnapshot(db)).isEqualTo(original);
+        boundary.arm(mutation);
+      }
+      String code = mutation.equals("manifest-missing-plain") ? "MISSING_SOURCE" : "EVIDENCE_MISMATCH";
+      assertThatThrownBy(() -> db.tx.execute(t -> writer.commit(command, Instant.now())))
+          .isInstanceOf(GuidedSessionException.class).hasMessage(code);
+      assertThat(reads).as("the current writer reached the actual private evidence reader").hasValue(2);
+      assertThat(boundary.substitutions).as("one exact returned manifest preimage was substituted").isEqualTo(1);
+      assertThat(boundary.inputReads).as("only the coherent context attack passes the private snapshot reader")
+          .isEqualTo(mutation.equals("manifest-authored-context") ? 1 : 0);
+      assertThat(boundary.currentReads).isEqualTo(mutation.equals("manifest-authored-context") ? 1 : 0);
+      assertThat(privateAuthoritySnapshot(db)).as("refused manifest substitution preserves every original row and trigger").isEqualTo(original);
+      boundary.arm(null);
+      JsonNode restored = db.tx.execute(t -> reader.read(db.fixtureSession())).document();
+      assertThat(restored.equals(originalRead)).as("restoring the reader recovers the original immutable source preimage").isTrue();
+      assertCommitRollback(db, writer, command, original);
+      assertThat(reads).hasValue(3);
+      assertThat(boundary.substitutions).isZero();
+    }
+  }
