+  @ParameterizedTest(name = "stored private returned history {0}")
+  @ValueSource(strings = {"private-value", "private-provenance", "input-order", "missing-input",
+      "introduced-version", "header-hash", "header-count", "header-provenance", "current-private-value"})
+  void storedPrivateHistoryCannotBeSubstitutedAtPublicationBoundary(String mutation) throws Exception {
+    try (var owner = new GuidedPublicationMigrationTest.Database();
+        var db = new GuidedPublicationMigrationTest.Database(owner.jdbc, owner.tx, "b3a-history", fixtures().path("basis").deepCopy())) {
+      var base = db.capture(); db.finalizing();
+      var command = prepareStored(db, base);
+      JsonNode originalRead = assertStoredPrivateProjection(db, base);
+      String original = privateAuthoritySnapshot(db);
+      var boundary = new PrivateReadBoundary(db.jdbc, db.fixtureSession());
+      var reader = new GuidedPublicationEvidenceRepository(boundary, C);
+      var reads = new AtomicInteger();
+      var writer = new GuidedPublicationRepository(db.jdbc, C, () -> { reads.incrementAndGet(); return reader; });
+      assertCommitRollback(db, writer, command, original);
+      assertThat(reads).hasValue(1);
+      boundary.arm(mutation);
+      assertThatThrownBy(() -> db.tx.execute(t -> writer.commit(command, Instant.now())))
+          .isInstanceOf(GuidedSessionException.class).hasMessage("EVIDENCE_MISMATCH");
+      assertThat(reads).as("the current writer reached the actual private evidence reader").hasValue(2);
+      assertThat(boundary.substitutions).as("one exact returned SQL preimage was substituted").isEqualTo(1);
+      assertThat(boundary.inputReads).isEqualTo(1);
+      assertThat(boundary.versionReads).isEqualTo(mutation.equals("input-order") ? 0 : 1);
+      assertThat(boundary.currentReads).isEqualTo(mutation.equals("current-private-value") ? 1 : 0);
+      assertThat(privateAuthoritySnapshot(db)).as("refused substituted read preserves every original row and trigger").isEqualTo(original);
+      boundary.arm(null);
+      JsonNode restored = db.tx.execute(t -> reader.read(db.fixtureSession())).document();
+      assertThat(restored.equals(originalRead)).as("restoring the reader recovers the exact stored evidence").isTrue();
+      assertCommitRollback(db, writer, command, original);
+      assertThat(reads).hasValue(3);
+      assertThat(boundary.substitutions).isZero();
+    }
+  }
