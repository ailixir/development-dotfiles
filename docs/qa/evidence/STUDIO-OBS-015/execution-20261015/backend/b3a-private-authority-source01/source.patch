+  private static void assertCommitRollback(
+      GuidedPublicationMigrationTest.Database db, GuidedPublicationRepository writer,
+      PublicationContracts.Commit command, String original) {
+    db.tx.executeWithoutResult(t -> {
+      assertThat(writer.commit(command, Instant.now())).isNotNull();
+      assertThat(db.jdbc.queryForObject("SELECT count(*) FROM ui_test_revisions WHERE guided_session_id=?",
+          Integer.class, command.sessionId())).isEqualTo(1);
+      assertThat(db.jdbc.queryForObject("SELECT confirmed_revision_id FROM ui_tests WHERE id=?",
+          UUID.class, db.testId)).isEqualTo(command.revisionId());
+      t.setRollbackOnly();
+    });
+    assertThat(privateAuthoritySnapshot(db)).as("positive publication rollback preserves every original row and trigger").isEqualTo(original);
+  }
