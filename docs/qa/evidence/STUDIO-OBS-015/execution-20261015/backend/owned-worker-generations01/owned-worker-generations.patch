+        boolean terminal = List.of("SUCCEEDED", "PUBLICATION_CONFLICT", "FAILED", "UNKNOWN_OUTCOME", "CANCELLED", "EXPIRED").contains(String.valueOf(row.get("state")));
+        boolean recording = !progress.has("executionEvidence") || jdbc.queryForObject(
+            "SELECT count(*) FROM studio_guided_session_recordings WHERE session_id=? AND state IN ('AVAILABLE','FAILED','UNAVAILABLE')", Integer.class, id) == 1;
+        closed &= terminal && (!assigned || progress.path("teardownStatus").asText().equals("CONFIRMED")) && recording;
+      }
+      for (var row : jdbc.queryForList("SELECT e.id,e.status,e.video_status,l.state AS ledger_state,l.attempt_id,l.admission_id FROM ui_test_executions e LEFT JOIN studio_dispatch_ledger l ON l.execution_id=e.id AND l.execution_accepted_at=e.started_at")) {
