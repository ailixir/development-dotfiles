+  private static void verifyOwnedRoot(OwnedFixtureProcess root) {
+    assertThat(root.process.pid() == root.handle.pid() && root.handle.isAlive()).as("owned root live identity").isTrue();
+    assertThat(root.started != null && root.handle.info().startInstant().map(root.started::equals).orElse(false))
+        .as("owned root exact start identity").isTrue();
+    assertThat(root.commandHash != null && root.commandHash.equals(ownedCommandHash(root.handle)))
+        .as("owned root exact command identity").isTrue();
+    if (root.wrapper != null) {
+      assertThat(root.handle.info().arguments().map(args -> java.util.Arrays.stream(args).anyMatch(arg -> {
+        try { return Path.of(arg).toAbsolutePath().normalize().equals(root.wrapper.toAbsolutePath().normalize()); }
+        catch (Exception notAPath) { return false; }
+      })).orElse(false)).as("owned exact wrapper argument").isTrue();
+    }
+  }
+
+  private static void recordOwnedDescendants(OwnedFixtureProcess root) throws Exception {
+    if (!root.process.isAlive() || root.started == null || root.commandHash == null) return;
+    verifyOwnedRoot(root);
+    for (ProcessHandle child : root.handle.descendants().toList()) {
+      if (!child.isAlive() || root.descendants.stream().anyMatch(old -> old.handle().pid() == child.pid()
+          && old.started() != null && child.info().startInstant().map(old.started()::equals).orElse(false))) continue;
+      var started = child.info().startInstant(); var command = child.info().commandLine();
+      if (!child.isAlive()) continue;
+      if ((started.isEmpty() || command.isEmpty()) && root.descendants.stream()
+          .anyMatch(old -> old.handle().pid() == child.pid())) continue;
+      if (started.isPresent() && command.isPresent()) root.descendants.removeIf(old -> old.handle().pid() == child.pid()
+          && (old.started() == null || old.commandHash() == null));
+      var ancestry = new ArrayList<Long>(); ProcessHandle cursor = child; boolean linked = false;
+      while (cursor.parent().isPresent() && ancestry.size() < 128) {
+        cursor = cursor.parent().orElseThrow(); ancestry.add(cursor.pid());
+        if (cursor.pid() == root.handle.pid()) { linked = true; break; }
+      }
+      if (!linked && !child.isAlive()) continue;
+      OwnedFixtureDescendant captured = new OwnedFixtureDescendant(child, started.orElse(null), command.isEmpty() ? null : ownedCommandHash(child),
+          child.parent().map(ProcessHandle::pid).orElse(-1L), List.copyOf(ancestry));
+      root.descendants.add(captured);
+      ownedProcessEvent("DESCENDANT_RECORDED", root, captured);
+    }
+  }
