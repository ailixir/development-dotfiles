+  private static Process registerOwnedProcess(Process process, String role, long generation, Path wrapper) throws Exception {
+    // Keep the actual root before readiness/identity/metadata can throw; never discard this record.
+    OwnedFixtureProcess root = new OwnedFixtureProcess(process, role, generation, wrapper);
+    OWNED_FIXTURE_PROCESSES.add(root);
+    long until = System.nanoTime() + Duration.ofMillis(500).toNanos();
+    while (root.handle.isAlive() && System.nanoTime() < until) {
+      var info = root.handle.info();
+      if (info.startInstant().isPresent() && info.commandLine().isPresent()) {
+        root.started = info.startInstant().orElseThrow(); root.commandHash = ownedCommandHash(root.handle); break;
+      }
+      Thread.sleep(5);
+    }
+    root.wrapperHash = wrapper == null ? "NOT_A_WRAPPER" : ownedFileHash(wrapper);
+    if (role.equals("guided")) root.configHash = ownedFileHash(ownedFixtureTemp.resolve("worker.json"));
+    ownedProcessEvent("SPAWN", root);
+    if (root.handle.isAlive() && (root.started == null || root.commandHash == null))
+      throw new IllegalStateException("Live owned process identity unavailable; no signal authorized");
+    synchronized (OWNED_FIXTURE_PROCESSES) {
+      if (!ownedObserverStarted) {
+        ownedObserverStarted = true;
+        OWNED_PROCESS_OBSERVER.scheduleWithFixedDelay(() -> {
+          for (OwnedFixtureProcess candidate : OWNED_FIXTURE_PROCESSES) {
+            try { recordOwnedDescendants(candidate); }
+            catch (Exception | AssertionError failure) {
+              if (candidate.process.isAlive() && !candidate.stopping) OWNED_FIXTURE_FAILURES.add(failure);
+            }
+          }
+        }, 0, 100, java.util.concurrent.TimeUnit.MILLISECONDS);
+      }
+    }
+    return process;
+  }
