+  private static void verifyRecordedOwnedHandle(ProcessHandle handle) {
+    for (OwnedFixtureProcess root : OWNED_FIXTURE_PROCESSES) {
+      if (root.handle.pid() == handle.pid()) { verifyOwnedRoot(root); return; }
+      for (OwnedFixtureDescendant child : root.descendants) {
+        if (child.handle().pid() == handle.pid() && child.started() != null
+            && handle.info().startInstant().map(child.started()::equals).orElse(false)) {
