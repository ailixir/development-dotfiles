+  private List<JsonNode> prefixSyncEvents(PrefixSyncParent parent) throws Exception {
+    Path file = TEMP.resolve("obs015-prefix-sync-" + parent.cut.key + ".jsonl");
+    assertThat(Files.isRegularFile(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)).isTrue();
+    assertThat(Files.size(file)).isLessThanOrEqualTo(65536);
+    assertThat(Files.getPosixFilePermissions(file)).isEqualTo(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"));
+    var events = Files.readAllLines(file, StandardCharsets.UTF_8).stream().filter(line -> !line.isBlank()).map(C::parse).toList();
+    assertThat(events.size()).isBetween(1, 200);
+    for (JsonNode row : events) {
+      var keys = new java.util.HashSet<String>(); row.fieldNames().forEachRemaining(keys::add);
+      assertThat(keys).isEqualTo(java.util.Set.of("phase", "mode", "sessionHash", "contextRevision", "materializationRevision",
+          "authoredInputsHash", "prefixProgramHash", "sameBrowser", "sameObservationSession"));
+      assertThat(row.path("sessionHash").asText()).isEqualTo(GuidedContracts.hash(JSON.getNodeFactory().textNode(parent.id)));
+      assertThat(row.path("mode").asText()).isEqualTo(parent.cut.mode);
+      assertThat(List.of("BEFORE_REFUSAL", "UPDATED_BEFORE_ACK", "ACK_RELEASED", "TARGET_PREPARE_ENTER", "TARGET_DISPATCH_ENTER"))
+          .contains(row.path("phase").asText());
