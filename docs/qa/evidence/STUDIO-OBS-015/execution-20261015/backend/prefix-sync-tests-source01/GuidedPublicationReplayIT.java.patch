+  /** PFXSYNC-01: a real producer-bearing update is held outside SQL until its original ACK. */
+  @Test
+  void prefixProducerContextAcknowledgementPrecedesPreparationAndPreservesIssuedRequest() throws Exception {
+    try (var parent = prefixSyncParent("HOLD")) {
+      PrefixSyncFacts before = prefixSyncFacts(parent);
+      Instant lease = Instant.parse(before.session().path("owner").path("leaseExpiresAt").asText());
+      long end = System.nanoTime() + Duration.ofSeconds(12).toNanos();
+      JsonNode renewed;
+      do {
+        prefixSyncNoTarget(parent, before);
+        renewed = sessions.transaction(() -> sessions.lock(parent.id).document().path("owner").deepCopy());
+        if (Instant.parse(renewed.path("leaseExpiresAt").asText()).isAfter(lease)) break;
+        Thread.sleep(20);
+      } while (System.nanoTime() < end);
+      assertThat(Instant.parse(renewed.path("leaseExpiresAt").asText()))
+          .as("a real same-owner renewal must occur before the unchanged context transport deadline").isAfter(lease);
+      assertThat(renewed.path("workerId")).isEqualTo(before.session().path("owner").path("workerId"));
+      assertThat(renewed.path("fence")).isEqualTo(before.session().path("owner").path("fence"));
+      prefixSyncNoTarget(parent, before);
+      JsonNode still = sessions.transaction(() -> sessions.lock(parent.id).progress().deepCopy());
+      for (String field : List.of("evidenceHash", "generation", "documentId", "executionEvidence"))
+        assertThat(still.path(field)).isEqualTo(before.progress().path(field));
+      JsonNode renewedSession = sessions.transaction(() -> sessions.lock(parent.id).document().deepCopy());
+      assertThat(renewedSession.path("scope")).isEqualTo(before.session().path("scope"));
+      assertThat(renewedSession.path("counters")).isEqualTo(before.session().path("counters"));
+      assertThat(System.nanoTime() - parent.cut.enteredAtNanos).isLessThan(Duration.ofSeconds(15).toNanos());
+      parent.cut.release.countDown();
+      prefixSyncFinishAndReplay(parent, before);
+    }
+  }
