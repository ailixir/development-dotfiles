+  private void prefixSyncAwaitDiagnostic(PrefixSyncParent parent, int after, String code, boolean gate) throws Exception {
+    long end = System.nanoTime() + Duration.ofSeconds(20).toNanos();
+    do {
+      int current = FINALIZE_DIAGNOSTICS.get();
+      var matches = new ArrayList<JsonNode>();
+      for (int n = after + 1; n <= current; n++) {
+        Path file = TEMP.resolve("finalize-exception-" + n + ".json");
+        if (!Files.isRegularFile(file)) continue; // Counter increment precedes completed write.
+        JsonNode row;
+        try { row = C.parse(Files.readString(file)); } catch (RuntimeException incomplete) { continue; }
+        if (code != null && !row.path("exceptionCode").asText().equals(code)) continue;
+        boolean stage = false;
+        for (JsonNode frame : row.path("stackFrames")) {
+          if (frame.path("class").asText().equals("com.citi.put.checks.studio.guided.translation.GuidedTranslationService")
+              && frame.path("method").asText().equals("advancePrefix")
+              && frame.path("line").asInt() == (gate ? 405 : 397)) stage = true;
+        }
+        if (gate && "STALE_GENERATION".equals(code)) {
+          int predicateStart = parent.cut.mode.equals("CONCURRENT") ? 417 : 428;
+          int predicateEnd = parent.cut.mode.equals("CONCURRENT") ? 418 : 433;
+          boolean predicate = false;
+          for (JsonNode frame : row.path("stackFrames")) {
+            if (frame.path("class").asText().equals("com.citi.put.checks.studio.guided.translation.GuidedTranslationService")
+                && frame.path("method").asText().startsWith("lambda$advancePrefix$")
+                && frame.path("line").asInt() >= predicateStart
+                && frame.path("line").asInt() <= predicateEnd) predicate = true;
+          }
+          stage &= predicate;
+        }
+        if (stage) matches.add(row);
+      }
+      if (!matches.isEmpty()) {
+        if (gate) assertThat(matches).as("one isolated fresh case must identify its exact post-ACK gate, not an ambiguous interval").hasSize(1);
+        // Uncertain responses may be revisited by the real coordinator; no single-call claim applies.
+        assertThat(PREFIX_SYNC_CUTS.keySet()).containsExactly(parent.cut.key);
+        assertThat(testOwnedSessions.keySet().stream().filter(id -> !id.equals(parent.id))
+            .allMatch(id -> sessions.transaction(() -> List.of("SUCCEEDED", "FAILED", "CANCELLED", "EXPIRED", "PUBLICATION_CONFLICT")
+                .contains(sessions.lock(id).document().path("state").asText())))).isTrue();
+        return;
+      }
+      Thread.sleep(10);
+    } while (System.nanoTime() < end);
+    throw new AssertionError("PFXSYNC intended Java context/gate stage not observed; no earlier refusal or timeout is credited");
+  }
