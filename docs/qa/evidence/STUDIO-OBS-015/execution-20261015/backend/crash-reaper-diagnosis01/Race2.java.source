import java.time.Duration;
public class Race2 {
  public static void main(String[] a) throws Exception {
    int n = Integer.parseInt(a[0]); int bad = 0, ok = 0, never = 0, firstPresent = 0;
    for (int i = 0; i < n; i++) {
      Process p = new ProcessBuilder(a[1], a.length > 2 ? a[2] : "-0", "--", Long.toString(ProcessHandle.current().pid())).redirectErrorStream(true).start();
      var h = p.toHandle();
      long until = System.nanoTime() + Duration.ofMillis(500).toNanos();
      boolean got = false;
      while (h.isAlive() && System.nanoTime() < until) {
        var info = h.info();
        if (info.startInstant().isPresent() && info.commandLine().isPresent()) {
          firstPresent++;
          try { h.info().commandLine().orElseThrow(); ok++; } catch (java.util.NoSuchElementException e) { bad++; }
          got = true; break;
        }
        Thread.sleep(5);
      }
      if (!got) never++;
      p.getInputStream().readAllBytes(); p.waitFor();
    }
    System.out.println("n=" + n + " firstPresent=" + firstPresent + " ok=" + ok + " NoSuchElement(2nd snapshot)=" + bad + " neverObserved=" + never);
  }
}
