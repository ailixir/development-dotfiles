+  private static void privateImmutableJson(Path path, JsonNode value) throws Exception {
+    Files.createDirectories(path.getParent());
+    byte[] bytes = GuidedContracts.canonical(value).getBytes(StandardCharsets.UTF_8);
+    try (var channel = Files.newByteChannel(path,
+        java.util.Set.of(java.nio.file.StandardOpenOption.CREATE_NEW, java.nio.file.StandardOpenOption.WRITE),
+        java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
+            java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")))) {
+      var buffer = java.nio.ByteBuffer.wrap(bytes);
+      while (buffer.hasRemaining()) channel.write(buffer);
+    }
+  }
