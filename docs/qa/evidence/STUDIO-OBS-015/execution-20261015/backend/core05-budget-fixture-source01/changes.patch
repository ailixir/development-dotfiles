+    var calls = out.putArray("calls");
+    MODEL_RESPONSE_FACTS.stream().filter(row -> row.path("invocationOrdinal").asInt() == invocation.ordinal)
+        .forEach(row -> { synchronized (row) { calls.add(row.deepCopy()); } });
+    var maxima = out.putObject("actualAppliedResponseMaxUtf8Bytes");
+    for (String kind : List.of("SOURCE_PLAN", "NEXT_ACTION", "VERIFY_STEP")) {
+      long maximum = 0, count = 0;
+      for (JsonNode row : calls) if (row.path("kind").asText().equals(kind)
+          && row.path("attemptApplied").asBoolean() && row.path("textEncoded").asBoolean()) {
+        count++; maximum = Math.max(maximum, row.path("textUtf8Bytes").asLong());
+      }
+      maxima.putObject(kind).put("count", count).put("maximum", maximum);
+    }
+    privateImmutableJson(COHORT_DIRECTORY.resolve("responses-" + invocation.key + "-" + phase + ".json"), out);
+  }
