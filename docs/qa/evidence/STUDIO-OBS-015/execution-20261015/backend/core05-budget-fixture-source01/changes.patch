+      String status = jdbc.queryForObject("SELECT status FROM studio_guided_model_attempts"
+          + " WHERE session_id=? AND request_id=? AND attempt_number=?", String.class,
+          join.sessionId(), entry.getKey().requestId(), entry.getKey().attempt());
+      synchronized (entry.getValue()) {
+        entry.getValue().put("attemptDispositionRead", true).put("attemptApplied", "APPLIED".equals(status));
+      }
+    }
+  }
