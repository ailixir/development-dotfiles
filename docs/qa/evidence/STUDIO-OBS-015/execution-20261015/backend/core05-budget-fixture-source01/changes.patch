+  private static void joinProviderFacts(ObjectNode facts, JsonNode request, JsonNode wire) {
+    try {
+      ModelCallKey key = new ModelCallKey(request.path("context").path("sessionId").asText(),
+          request.path("requestId").asText(), request.path("attempt").asInt());
+      ModelCallJoin join = MODEL_CALL_JOINS.get(key);
+      if (join == null) throw new IllegalStateException("Missing committed provider attempt join");
+      assertThat(request.path("kind").asText()).isEqualTo(join.kind());
+      if (MODEL_RESPONSE_JOINS.putIfAbsent(key, facts) != null)
+        throw new IllegalStateException("Duplicate provider response attempt diagnostic join");
+      synchronized (facts) { facts.put("joined", true).put("lane", FIXTURE_PROFILE.lane)
+          .put("invocationOrdinal", join.invocation().ordinal).put("variantOrdinal", join.invocation().variantOrdinal)
+          .put("sessionOrdinal", join.sessionOrdinal()).put("attemptOrdinal", join.attemptOrdinal())
+          .put("kind", join.kind()).put("persistedInputCeiling", join.inputCeiling())
+          .put("requestedOutputCeiling", join.outputCeiling())
+          .put("actualWireOutputCeiling", wire.path("generationConfig").path("maxOutputTokens").asInt())
+          .put("responseTextByteBound", join.responseBound()); }
+    } catch (Exception | AssertionError diagnosticFailure) {
+      MODEL_BUDGET_WITNESS_FAILURES.incrementAndGet();
+      synchronized (facts) { facts.put("instrumentationError", true); }
+    }
+  }
