+  /** B3B-3 (73/75/72): one immutable first acceptance; later pair/obligation/edge loss refuses. */
+  @Test
+  void incrementalFirstSuffixAcceptanceIsOnceAndLaterPairsCannotDisappear() throws Exception {
+    b3IsolatedCsi();
+    var hold = new B3FirstSuffixHold();
+    var seen = new java.util.concurrent.atomic.AtomicReference<B3Parent>();
+    b3FirstSuffixHold = hold;
+    java.util.concurrent.Future<ObjectNode> race = null;
+    try (var watcher = java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()) {
+      race = watcher.submit(() -> b3ContendFirstSuffix(hold));
+      final java.util.concurrent.Future<ObjectNode> contention = race;
+      try {
+        b3Hooks =
+            new B3Hooks() {
+              @Override
+              public void beforeFinalize(B3Parent p) throws Exception {
+                seen.set(p);
+                ObjectNode contended = contention.get(5, java.util.concurrent.TimeUnit.SECONDS);
+                assertThat(contended.path("sessionId").asText()).isEqualTo(p.id());
+                assertThat(hold.releasedInTime)
+                    .as("the held actual call was released inside its bound")
+                    .isTrue();
+                for (JsonNode contender : contended.path("contenders")) {
+                  assertThat(contender.path("status").asInt()).isEqualTo(409);
+                  assertThat(contender.path("code").asText())
+                      .as("in-flight first suffix refuses a second reservation")
+                      .isEqualTo("IDEMPOTENCY_CONFLICT");
+                }
+                assertThat(contended.path("contenders")).hasSize(2);
+                assertThat(contended.path("acceptancesDuringHold").asInt()).isZero();
+                assertThat(contended.path("attemptsDelta").asInt()).isZero();
+                assertThat(contended.path("wireDelta").asInt()).isZero();
+                b3AssertOneImmutableFirstAcceptance(p); // 73 concurrent/duplicate + removals
+                b3AssertLaterLossRefuses(p); // 73 later pair deletion / obligation mutation
+                b3EdgeMatrix(p); // 75 / 72 edge side
+              }
+            };
+        incrementalJoined("admitted-drift2");
+        assertThat(seen.get()).isNotNull();
+      } finally {
+        b3Hooks = null;
+        b3FirstSuffixHold = null;
+        hold.release.countDown();
+        if (!race.isDone()) {
+          race.cancel(true); // never leave the 120 s watcher waiting after an earlier failure
+        }
+      }
+    } finally {
+      b3RestoreCsi();
+      b3RetainOutcomes();
+    }
+  }
