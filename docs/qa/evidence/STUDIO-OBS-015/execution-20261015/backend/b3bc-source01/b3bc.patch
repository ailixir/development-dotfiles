+  private ObjectNode b3ActualBaseProof(String revisionId) {
+    // Same construction as GuidedPublicationEvidenceRepository.snapshotEvidence, from actual rows.
+    var row =
+        jdbc.queryForMap(
+            "SELECT revision_digest,authoring::text AS authoring,\"references\"::text AS refs,"
+                + "step_snapshot_hashes::text AS snapshots,step_reuse_provenance::text AS reuse"
+                + " FROM ui_test_revisions WHERE id=?::uuid",
+            revisionId);
+    ObjectNode verified =
+        ownedApplicationContext
+            .getBean(ObservedRevisionVerifier.class)
+            .verify(UUID.fromString(revisionId));
+    ObjectNode proof = C.object();
+    ObjectNode identity = proof.putObject("authoringIdentity").put("authoringIdentityVersion", 1);
+    identity.set("authoring", C.parse((String) row.get("authoring")));
+    identity.set(
+        "authoredDeclarations", C.parse((String) row.get("refs")).path("authoredDeclarations"));
+    proof.set("configuration", verified.path("configuration"));
+    proof.set("artifact", verified.path("artifact"));
+    ObjectNode revision =
+        proof
+            .putObject("revision")
+            .put("schemaVersion", 3)
+            .put("id", revisionId)
+            .put("revisionDigest", (String) row.get("revision_digest"));
+    revision.set("identity", verified.path("identity"));
+    revision.set("stepSnapshotHashes", C.parse((String) row.get("snapshots")));
+    revision.set("reusedFrom", C.parse((String) row.get("reuse")));
+    return proof;
+  }
