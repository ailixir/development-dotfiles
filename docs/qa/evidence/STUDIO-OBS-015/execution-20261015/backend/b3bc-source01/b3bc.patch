+  /**
+   * Returned-read substitution over the actual private rows (52). The SQL strings are copied
+   * verbatim from {@code GuidedMaterializationEvidence.read}. Stored rows stay untouched. This is a
+   * JDBC-boundary substitution, so under authority-tier ruling T3 it earns no private-authority
+   * credit; it is retained as disclosed full-version reconstruction evidence only.
+   */
+  private static final class B3PrivateReadBoundary extends JdbcTemplate {
+    static final String INPUTS =
+        "SELECT input_ordinal,input_id,introduced_revision,document::text FROM"
+            + " studio_guided_materialization_inputs WHERE session_id=? ORDER BY input_ordinal";
+    static final String VERSIONS =
+        "SELECT * FROM studio_guided_materialization_versions WHERE session_id=? ORDER BY"
+            + " context_revision";
+    final String sessionId;
+    volatile String mutation;
+    final AtomicInteger substitutions = new AtomicInteger();
+
+    B3PrivateReadBoundary(JdbcTemplate actual, String sessionId) {
+      super(java.util.Objects.requireNonNull(actual.getDataSource()));
+      this.sessionId = sessionId;
+    }
+
+    @Override
+    public List<Map<String, Object>> queryForList(String sql, Object... args) {
+      List<Map<String, Object>> actual = super.queryForList(sql, args);
+      String selected = mutation;
+      if (selected == null
+          || (!sql.equals(INPUTS) && !sql.equals(VERSIONS))
+          || args.length != 1
+          || !sessionId.equals(args[0])) {
+        return actual;
+      }
+      var offered = new ArrayList<Map<String, Object>>();
+      actual.forEach(row -> offered.add(new java.util.HashMap<>(row)));
+      boolean changed = false;
+      if (sql.equals(INPUTS)
+          && (selected.equals("v1-private-value") || selected.equals("v2-private-value"))) {
+        int introduced = selected.startsWith("v1") ? 1 : 2;
+        for (var row : offered) {
+          ObjectNode input = PublicationContracts.copy(C.parse((String) row.get("document")));
+          if (((Number) row.get("introduced_revision")).intValue() == introduced
+              && input.path("value").isTextual()) {
+            input.put("value", "B3-DIFFERENT-PRIVATE-VALUE");
+            row.put("document", input.toString());
+            changed = true;
+            break;
+          }
+        }
+      } else if (sql.equals(VERSIONS) && selected.equals("v1-cutoff-includes-v2-input")) {
+        offered
+            .getFirst()
+            .put("input_count", ((Number) offered.getFirst().get("input_count")).intValue() + 1);
+        changed = true;
+      }
+      if (!changed) {
+        return actual;
+      }
+      assertThat(offered.equals(actual)).isFalse();
+      substitutions.incrementAndGet();
+      return offered;
+    }
+  }
+
+  private void b3AssertMultiVersionReturnedHistoryRefuses(B3Parent parent) {
+    var boundary = new B3PrivateReadBoundary(jdbc, parent.id());
+    var reader = new GuidedPublicationEvidenceRepository(boundary, C);
+    var verifier = ownedApplicationContext.getBean(ObservedRevisionVerifier.class);
+    reader.installRevisionVerifier(verifier::verify); // GuidedPublicationConfiguration composition
+    var probe = new B3WriterProbe(parent.id(), parent.test(), reader);
+    probe.positive("multi-version-unarmed");
+    for (String label :
+        List.of("v1-private-value", "v2-private-value", "v1-cutoff-includes-v2-input")) {
+      boundary.mutation = label;
+      int before = boundary.substitutions.get();
+      B3Outcome outcome;
+      try {
+        outcome = probe.genuineAgainstReader("returned-read-no-t3-credit-" + label);
+      } finally {
+        boundary.mutation = null;
+      }
+      assertThat(boundary.substitutions.get() - before)
+          .as("%s substituted an actual returned private row", label)
+          .isPositive();
+      assertThat(outcome.stage()).isEqualTo("WRITER_REFUSED");
+      assertThat(outcome.code())
+          .as("%s full-version reconstruction refusal", label)
+          .isEqualTo("EVIDENCE_MISMATCH");
+      assertThat(outcome.readsDelta()).isEqualTo(1);
+    }
+    probe.positive("multi-version-restored");
+  }
