+  /** N01 at the actual stored writer: unretained/suffix/changed producer and hidden use refuse. */
+  private void b3ZeroConsumerAndOrphanNegatives(B3Parent p, String read) throws Exception {
+    var probe = new B3WriterProbe(p.id(), p.test());
+    probe.positive("n01-positive");
+    String fill = b3SoleSucceeded(p.id(), INCREMENTAL_STEPS.get(1), 1, "fill");
+    String later = b3SoleSucceeded(p.id(), INCREMENTAL_STEPS.get(3), 0, "assert");
+    probe.refuse(
+        "unretained-producer",
+        b -> {
+          ObjectNode incremental = (ObjectNode) b.path("incrementalEvidence");
+          for (String path : List.of("switch", "firstSuffixAcceptance")) {
+            var ids = (ArrayNode) incremental.path(path).path("retainedPrefixAdmissionIds");
+            for (int at = ids.size() - 1; at >= 0; at--) {
+              if (ids.get(at).asText().equals(read)) {
+                ids.remove(at);
+              }
+            }
+          }
+          ((ObjectNode) incremental.path("switch"))
+              .put(
+                  "retainedPrefixAdmissionsHash",
+                  GuidedContracts.hash(
+                      incremental.path("switch").path("retainedPrefixAdmissionIds")));
+        });
+    probe.refuse(
+        "suffix-created-producer",
+        b -> ((ObjectNode) b.path("producers").get(0)).put("producerAdmissionId", fill));
+    probe.refuse(
+        "changed-recipe",
+        b ->
+            ((ObjectNode) b.path("producers").get(0).path("recipe"))
+                .put("policyRuleId", "b3-other-rule"));
+    probe.refuse(
+        "changed-origin",
+        b -> ((ObjectNode) b.path("producers").get(0)).put("origin", "https://other.example.test"));
+    probe.refuse(
+        "changed-coordinate",
+        b -> ((ObjectNode) b.path("producers").get(0).path("coordinate")).put("ordinal", 1));
+    probe.refuse("missing-producer", b -> ((ArrayNode) b.path("producers")).removeAll());
+    probe.refuse(
+        "unknown-base",
+        b ->
+            ((ObjectNode) b.path("incrementalEvidence").path("plan"))
+                .put("baseRevisionId", UUID.randomUUID().toString()));
+    probe.refuse(
+        "hidden-successful-use",
+        b -> {
+          ObjectNode hidden = b3Edge0(b).deepCopy();
+          hidden.put("consumerAdmissionId", later).put("argumentSlot", "assert.expected");
+          hidden.set(
+              "coordinate", C.object().put("stepId", INCREMENTAL_STEPS.get(3)).put("ordinal", 0));
+          ((ArrayNode) b.path("consumerEdges")).add(hidden);
+        });
+    probe.refuse(
+        "model-empty-consumers",
+        b ->
+            ((ArrayNode) b.path("translationPlan").path("needs").get(0).path("consumers"))
+                .removeAll());
+    probe.positive("n01-positive-after");
+  }
