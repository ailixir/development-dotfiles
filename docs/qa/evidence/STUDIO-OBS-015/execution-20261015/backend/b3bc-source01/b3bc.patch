+  /** Rolled-back reserve/claim/actual-runner-validate/finish/commit at the actual stored writer. */
+  private final class B3WriterProbe {
+    final String id;
+    final UUID test;
+    final org.springframework.transaction.support.TransactionTemplate tx;
+    final org.springframework.transaction.support.TransactionTemplate outside;
+    final GuidedPublicationEvidenceRepository reader;
+    final GuidedPublicationRepository writer;
+    final ObservedValidationClient validator;
+    final AtomicInteger reads = new AtomicInteger();
+    final PublicationContracts.Base base;
+    final ObjectNode genuine;
+    final ObjectNode identityTemplate;
+    final ObjectNode profile;
+    final ObjectNode build;
+    final PublicationContracts.Candidate genuineCandidate;
+
+    B3WriterProbe(String id, UUID test) {
+      this(id, test, ownedApplicationContext.getBean(GuidedPublicationEvidenceRepository.class));
+    }
+
+    B3WriterProbe(String id, UUID test, GuidedPublicationEvidenceRepository reader) {
+      this.id = id;
+      this.test = test;
+      this.reader = reader;
+      var manager =
+          ownedApplicationContext.getBean(
+              org.springframework.transaction.PlatformTransactionManager.class);
+      tx = new org.springframework.transaction.support.TransactionTemplate(manager);
+      // ObservedValidationClient.validate refuses any active transaction (RUNTIME_INCOMPATIBLE),
+      // exactly as GuidedPlanPublisher calls it between transactions; the staged call suspends.
+      outside = new org.springframework.transaction.support.TransactionTemplate(manager);
+      outside.setPropagationBehavior(
+          org.springframework.transaction.TransactionDefinition.PROPAGATION_NOT_SUPPORTED);
+      validator = ownedApplicationContext.getBean(ObservedValidationClient.class);
+      // Package-private production constructor; the counting supplier is the stored-reader stage.
+      writer =
+          new GuidedPublicationRepository(
+              jdbc,
+              C,
+              () -> {
+                reads.incrementAndGet();
+                return this.reader;
+              });
+      var bases = ownedApplicationContext.getBean(GuidedPublicationBaseRepository.class);
+      var actual = ownedApplicationContext.getBean(GuidedPublicationEvidenceRepository.class);
+      ObjectNode selected = ownedApplicationContext.getBean(ObservedReplayPins.class).selected();
+      profile = (ObjectNode) selected.path("profile").deepCopy();
+      build = (ObjectNode) selected.path("build").deepCopy();
+      // Exactly GuidedPlanPublisher.prepare's basis/identity construction, read-only, rolled back.
+      Object[] captured =
+          tx.execute(
+              status -> {
+                status.setRollbackOnly();
+                var current = sessions.lock(id);
+                assertThat(current.document().path("state").asText()).isEqualTo("FINALIZING");
+                var pinned = bases.find(id).orElseThrow();
+                var source = bases.lockCurrent(test);
+                bases.requireCurrent(pinned, source);
+                var raw = actual.read(id);
+                var builder = new GuidedPlanBuilder(C);
+                ObjectNode basis =
+                    builder.basis(
+                        pinned,
+                        source,
+                        raw,
+                        current.document(),
+                        builder.learningProvenance(raw.document().path("sourceManifest")));
+                ObjectNode identity = C.object();
+                identity.set("base", pinned.document());
+                identity.set("ownerWorkerId", current.document().path("owner").path("workerId"));
+                identity.set("ownerFence", current.document().path("owner").path("fence"));
+                identity.set("translationHash", basis.path("translationHash"));
+                return new Object[] {pinned, basis, identity};
+              });
+      base = (PublicationContracts.Base) captured[0];
+      genuine = (ObjectNode) captured[1];
+      identityTemplate = (ObjectNode) captured[2];
+      genuineCandidate =
+          new ObservedArtifactLowerer(C).lower(genuine.deepCopy(), profile.deepCopy());
+    }
+
+    B3Outcome staged(
+        String label,
+        ObjectNode offered,
+        PublicationContracts.Candidate candidate,
+        String lowering) {
+      String key = "b3-" + label + "-" + UUID.randomUUID();
+      String digest = GuidedContracts.hash(C.object().put("b3", key));
+      int before = reads.get();
+      String[] stage = {"UNREACHED", null};
+      try {
+        tx.executeWithoutResult(
+            status -> {
+              status.setRollbackOnly();
+              JsonNode current = sessions.lock(id).document();
+              Instant deadline = Instant.now().plusSeconds(12);
+              for (Instant ceiling :
+                  List.of(
+                      Instant.parse(current.path("expiresAt").asText()),
+                      Instant.parse(current.path("owner").path("leaseExpiresAt").asText()))) {
+                if (deadline.isAfter(ceiling)) {
+                  deadline = ceiling;
+                }
+              }
+              ObjectNode identity = identityTemplate.deepCopy();
+              identity
+                  .put("basisHash", GuidedContracts.hash(offered))
+                  .put("validationBuildHash", GuidedContracts.hash(build))
+                  .put(
+                      "validationDeadline",
+                      PublicationContracts.time(PublicationContracts.millisecond(deadline)));
+              for (String field :
+                  List.of(
+                      "learnedPlanHash",
+                      "artifactHash",
+                      "referencePolicyHash",
+                      "operationEquivalenceHash",
+                      "publicationEvidenceHash",
+                      "profileHash")) {
+                identity.set(field, candidate.hashes().path(field));
+              }
+              var snapshot = new PublicationContracts.Snapshot(identity, offered);
+              var attempt =
+                  writer.reserve(
+                      new PublicationContracts.Claim(id, key, digest, snapshot), Instant.now());
+              attempt =
+                  writer.claim(
+                      id, attempt.attemptId(), attempt.claimId(), snapshot.hash(), Instant.now());
+              ObjectNode outgoing =
+                  C.object()
+                      .put("schemaVersion", 3)
+                      .put("attemptId", attempt.attemptId().toString())
+                      .put("claimId", attempt.claimId().toString())
+                      .put("snapshotHash", snapshot.hash())
+                      .put("basisHash", identity.path("basisHash").asText());
+              outgoing.set("requiredProfile", candidate.artifact().path("profile"));
+              outgoing.set("requiredBuild", build);
+              outgoing.set("artifact", candidate.artifact());
+              outgoing.set("validationBasis", snapshot.basis());
+              var budget =
+                  new PublicationBudget(attempt.validationDeadline(), java.time.Clock.systemUTC());
+              JsonNode verdict;
+              try {
+                verdict = outside.execute(ignored -> validator.validate(outgoing, budget));
+              } catch (GuidedSessionException failure) {
+                stage[0] = "VALIDATOR_FAILURE";
+                stage[1] = failure.getMessage();
+                return;
+              }
+              if (!verdict.path("ok").asBoolean()) {
+                stage[0] = "VALIDATOR_REJECTED";
+                stage[1] = verdict.path("errorCode").asText();
+                return;
+              }
+              writer.finish(
+                  id,
+                  attempt.attemptId(),
+                  attempt.claimId(),
+                  snapshot.hash(),
+                  PublicationContracts.AttemptStatus.VALIDATED,
+                  verdict,
+                  null,
+                  Instant.now());
+              // Controlled input (disclosed): the grant, built from the stored base and re-checked
+              // by the writer against that same stored base.
+              var grant =
+                  new PublicationContracts.Grant(
+                      id,
+                      base.document().path("originalPrincipalId").asText(),
+                      base.document().path("csiId").asText(),
+                      snapshot.hash(),
+                      attempt.validationDeadline());
+              var receipt =
+                  writer.commit(
+                      new PublicationContracts.Commit(
+                          id,
+                          UUID.randomUUID(),
+                          attempt.attemptId(),
+                          attempt.claimId(),
+                          key,
+                          digest,
+                          snapshot,
+                          candidate,
+                          grant),
+                      Instant.now());
+              assertThat(
+                      jdbc.queryForObject(
+                          "SELECT confirmed_revision_id::text FROM ui_tests WHERE id=?",
+                          String.class,
+                          test))
+                  .isEqualTo(receipt.document().path("revisionId").asText());
+              stage[0] = "COMMITTED_ROLLED_BACK";
+            });
+      } catch (GuidedSessionException refused) {
+        stage[0] = "WRITER_REFUSED";
+        stage[1] = refused.getMessage();
+      } catch (org.springframework.dao.DataAccessException refused) {
+        // A database guard is a genuine stage too; only its type is retained (never a value).
+        stage[0] = "DATABASE_REFUSED";
+        stage[1] = refused.getClass().getSimpleName();
+      }
+      var outcome = new B3Outcome(label, stage[0], stage[1], reads.get() - before, lowering);
+      B3_OUTCOMES.add(
+          C.object()
+              .put("sessionHash", GuidedContracts.hash(JSON.getNodeFactory().textNode(id)))
+              .put("label", label)
+              .put("stage", outcome.stage())
+              .put("code", outcome.code())
+              .put("readsDelta", outcome.readsDelta())
+              .put("backendLowering", lowering));
+      return outcome;
+    }
