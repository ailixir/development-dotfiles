+    JsonNode binding = artifact.path("learnedPlan").path("bindings").get(0);
+    assertThat(artifact.path("learnedPlan").path("bindings")).hasSize(1);
+    assertThat(binding.path("producer").path("stepId").asText()).isEqualTo(step1);
+    assertThat(binding.path("provenance").path("producerAdmissionId").asText()).isEqualTo(read);
+    assertThat(artifact.path("learnedPlan").path("incremental").path("retainedPrefixAdmissionIds"))
+        .contains(JSON.getNodeFactory().textNode(read));
+    assertThat(observedBinding(first).path("revisionId").asText())
+        .isEqualTo(merged.path("revisionId").asText());
+    String firstValue = VALUES.getLast();
+    int model = MODEL_WIRE.size(), reads = INCREMENTAL_ORDINARY_READS.get();
+    int legacy = LEGACY_MODEL_CALLS.get();
+    UUID second =
+        UUID.fromString(
+            publicCall(
+                    "/api/v1/studio/tests/" + p.test() + "/execute",
+                    C.object(),
