+    assertThat(MODEL_WIRE).hasSize(model);
+    assertThat(LEGACY_MODEL_CALLS.get()).isEqualTo(legacy);
+    assertThat(observedBinding(second).path("revisionId").asText())
+        .isEqualTo(merged.path("revisionId").asText());
+  }
