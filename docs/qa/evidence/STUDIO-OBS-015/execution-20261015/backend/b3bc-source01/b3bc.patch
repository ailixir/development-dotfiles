+  /** Holds the actual first SOURCE_PLAN with a learning window on the in-JVM provider thread. */
+  private static final class B3FirstSuffixHold {
+    final java.util.concurrent.CountDownLatch entered = new java.util.concurrent.CountDownLatch(1);
+    final java.util.concurrent.CountDownLatch release = new java.util.concurrent.CountDownLatch(1);
+    final java.util.concurrent.atomic.AtomicBoolean armed =
+        new java.util.concurrent.atomic.AtomicBoolean(true);
+    volatile String sessionId;
+    volatile boolean releasedInTime;
+
+    /** Bound 10 s, below the 60 s default GuidedTranslationProperties.callSeconds (R-HOLD). */
+    void hold(String session) {
+      if (!armed.compareAndSet(true, false)) {
+        return;
+      }
+      sessionId = session;
+      entered.countDown();
+      try {
+        releasedInTime = release.await(10, java.util.concurrent.TimeUnit.SECONDS);
+      } catch (InterruptedException interrupted) {
+        Thread.currentThread().interrupt();
+      }
+    }
+  }
+
+  private ObjectNode b3ContendFirstSuffix(B3FirstSuffixHold hold) throws Exception {
+    ObjectNode out = C.object();
+    try {
+      assertThat(hold.entered.await(120, java.util.concurrent.TimeUnit.SECONDS))
+          .as("actual first-suffix model call reached")
+          .isTrue();
+      String id = hold.sessionId;
+      JsonNode session = sessions.transaction(() -> sessions.lock(id).document().deepCopy());
+      long fence = session.path("owner").path("fence").asLong();
+      long revision = sessions.transaction(() -> plans.state(id).path("planRevision").asLong());
+      assertThat(
+              jdbc.queryForObject(
+                  "SELECT count(*) FROM studio_guided_suffix_acceptances WHERE session_id=?",
+                  Integer.class,
+                  id))
+          .isZero();
+      assertThat(
+              jdbc.queryForObject(
+                  "SELECT count(*) FROM studio_guided_model_attempts WHERE session_id=?"
+                      + " AND status IN ('RESERVED','CALLING')",
+                  Integer.class,
+                  id))
+          .as("exactly the real coordinator's first-suffix attempt is in flight")
+          .isEqualTo(1);
+      int attempts =
+          jdbc.queryForObject(
+              "SELECT count(*) FROM studio_guided_model_attempts WHERE session_id=?",
+              Integer.class,
+              id);
+      int wire = MODEL_WIRE.size();
+      ObjectNode command = C.object().put("schemaVersion", 3).put("sessionId", id);
+      // checkCommand compares the session scope nodes by equality: copy them, never re-type them.
+      command.set(
+          "expectedSourceRevision", session.path("scope").path("sourceRevision").deepCopy());
+      command.set(
+          "expectedConfigurationRevision",
+          session.path("scope").path("configurationRevision").deepCopy());
+      command.put("expectedPlanRevision", revision);
+      String controller = token("backend-controller", "controller-1", "studio-guided-controller");
+      var gate = new java.util.concurrent.CountDownLatch(1);
+      try (var pool = java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()) {
+        var futures = new ArrayList<java.util.concurrent.Future<HttpResponse<String>>>();
+        for (int contender = 0; contender < 2; contender++) {
+          futures.add(
+              pool.submit(
+                  () -> {
+                    gate.await();
+                    var request =
+                        HttpRequest.newBuilder(
+                                URI.create(
+                                    "https://localhost:"
+                                        + port
+                                        + "/internal/v2/studio/guided-sessions/"
+                                        + id
+                                        + "/dependency-admissions"))
+                            .timeout(Duration.ofSeconds(8))
+                            .header("Authorization", "Bearer " + controller)
+                            .header("X-Owner-Fence", Long.toString(fence))
+                            .header("Idempotency-Key", UUID.randomUUID().toString())
+                            .header("Content-Type", "application/json")
+                            .POST(HttpRequest.BodyPublishers.ofString(command.toString()))
+                            .build();
+                    return HttpClient.newBuilder()
+                        .sslContext(TLS)
+                        .build()
+                        .send(request, HttpResponse.BodyHandlers.ofString());
+                  }));
+        }
+        gate.countDown();
+        var codes = out.putArray("contenders");
+        for (var future : futures) {
+          var response = future.get(9, java.util.concurrent.TimeUnit.SECONDS);
+          codes
+              .addObject()
+              .put("status", response.statusCode())
+              .put("code", C.parse(response.body()).path("code").asText());
+        }
+      }
+      out.put(
+          "acceptancesDuringHold",
+          jdbc.queryForObject(
+              "SELECT count(*) FROM studio_guided_suffix_acceptances WHERE session_id=?",
+              Integer.class,
+              id));
+      out.put(
+          "attemptsDelta",
+          jdbc.queryForObject(
+                  "SELECT count(*) FROM studio_guided_model_attempts WHERE session_id=?",
+                  Integer.class,
+                  id)
+              - attempts);
+      out.put("wireDelta", MODEL_WIRE.size() - wire);
+      out.put("sessionId", id);
+    } finally {
+      hold.release.countDown();
+    }
+    return out;
+  }
