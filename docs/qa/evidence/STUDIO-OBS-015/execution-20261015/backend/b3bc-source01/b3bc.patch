+  /** Accepted owning-worker evidence callbacks: retains only kind=action timing items. */
+  private static final class B3EvidenceCapture {
+    static final String PREFIX = "/internal/v2/studio/guided-sessions/";
+    static final String ROUTE =
+        com.citi.put.checks.studio.guided.evidence.GuidedSessionEvidenceService.ROUTE_PATH;
+    final java.util.concurrent.ConcurrentMap<String, List<JsonNode>> actions =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    volatile Throwable failure;
+
+    boolean selected(jakarta.servlet.http.HttpServletRequest http) {
+      String uri = http.getRequestURI();
+      return http.getMethod().equals("POST") && uri.startsWith(PREFIX) && uri.endsWith(ROUTE);
+    }
+
+    void record(String uri, byte[] body, int status) {
+      try {
+        if (status < 200 || status >= 300 || body.length == 0) {
+          return;
+        }
+        String id = uri.substring(PREFIX.length(), uri.length() - ROUTE.length());
+        JsonNode parsed = C.parseWire(body);
+        if (!parsed.path("timings").isArray()) {
+          throw new AssertionError("accepted evidence callback without timings array");
+        }
+        ArrayNode items = C.object().putArray("items");
+        for (JsonNode item : parsed.path("timings")) {
+          if (item.path("kind").asText().equals("action")) {
+            items.add(item.deepCopy());
+          }
+        }
+        actions.computeIfAbsent(id, ignored -> new CopyOnWriteArrayList<>()).add(items);
+      } catch (RuntimeException | AssertionError invalid) {
+        failure = invalid;
+      }
+    }
+  }
