+                .as("real v2 suffix append")
+                .isEqualTo(2);
+            P3Publication merged = b2Publish(mixed, edited);
+            // ---- A68-1, A68-3, A68-4, AP08-2: pure basis declarations and evidence ----
+            JsonNode raw =
+                sessions.transaction(
+                    () ->
+                        ownedApplicationContext
+                            .getBean(GuidedPublicationEvidenceRepository.class)
+                            .read(mixed)
+                            .document());
+            JsonNode current = raw.path("snapshotEvidence").path("current");
+            boolean userHash = false;
+            boolean passId = false;
+            for (JsonNode declaration : current.path("authoredDeclarations")) {
+              assertThat(declaration.has("value")).as("declaration is value-free").isFalse();
+              String reference = declaration.path("referenceId").asText();
+              if (reference.equals("USER") && declaration.path("kind").asText().equals("plain")) {
+                userHash = declaration.path("valueHash").asText().matches("^[a-f0-9]{64}$");
+              }
+              if (reference.equals("PASS")
