+  /** REUSED owned ordinary-child argv/env scan, plus the same bounded scan of the guided worker. */
+  private static void b2bScanLiveProcesses(List<String> values) throws Exception {
+    p3ScanOwnedChildArguments(p3OrdinaryChildren(ordinaryWorker), values);
+    ProcessHandle guided = guidedWorker.toHandle();
+    Instant started = guided.info().startInstant().orElseThrow();
+    p6SameProcess(guided, started);
+    C5CanaryStream scan = new C5CanaryStream(values);
+    byte[] arguments = null;
+    byte[] environment = null;
+    Process probe = null;
+    try {
+      String[] actual = guided.info().arguments().orElseThrow();
+      assertThat(actual.length).isBetween(1, 32);
+      arguments = String.join("\0", actual).getBytes(StandardCharsets.UTF_8);
+      probe =
+          new ProcessBuilder("/bin/ps", "eww", "-p", Long.toString(guided.pid()), "-o", "command=")
+              .redirectErrorStream(true)
+              .start();
+      registerOwnedTool(probe, "private-process-scan");
+      assertThat(probe.waitFor(5, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
+      assertThat(probe.exitValue()).isZero();
+      environment = probe.getInputStream().readNBytes(65537);
+      assertThat(environment.length).isBetween(1, 65536);
+      p6SameProcess(guided, started);
+      scan.write(arguments, 0, arguments.length);
+      scan.write(environment, 0, environment.length);
+      scan.closeInput();
+      scan.assertClean(true);
+    } finally {
+      if (arguments != null) {
+        java.util.Arrays.fill(arguments, (byte) 0);
+      }
+      if (environment != null) {
+        java.util.Arrays.fill(environment, (byte) 0);
+      }
+      scan.wipe();
+      if (probe != null) {
+        p6CloseCommand(probe);
+      }
+    }
+  }
