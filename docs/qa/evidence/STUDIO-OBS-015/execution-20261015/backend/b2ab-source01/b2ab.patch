+  /** A77-4: authenticated owner/browser loss while the v2 ACK is pending bumps nothing. */
+  private void b2bOwnerLoss(
+      String session,
+      B2bPlanHold hold,
+      com.citi.put.checks.studio.guided.session.GuidedSessionService service,
+      org.springframework.security.core.Authentication controller)
+      throws Exception {
+    hold.release.countDown(); // this sibling never holds its suffix plan
+    long held = System.nanoTime() + Duration.ofSeconds(90).toNanos();
+    while (!INCREMENTAL_ACK_ENTERED.contains(session) && System.nanoTime() < held) {
+      Thread.sleep(20);
+    }
+    assertThat(INCREMENTAL_ACK_ENTERED.contains(session)).as("v2 ACK pending").isTrue();
+    long fence =
+        sessions.transaction(
+            () -> sessions.lock(session).document().path("owner").path("fence").asLong());
+    String pending = incrementalImmutableSnapshot(session);
+    String allocations = b2bRows("studio_guided_allocations", "binding_id", session);
+    String producers = b2bRows("studio_guided_producers", "binding_id", session);
+    int revision = b2bMaterializationRevision(session);
+    String work = b2bWorkSnapshot(session);
+    ObjectNode context = service.runnerContext(controller, session, fence);
+    ownedApplicationContext
+        .getBean(com.citi.put.checks.studio.guided.bridge.GuidedDispatchService.class)
+        .stop(context, "LEASE_LOST");
+    INCREMENTAL_ACK_RELEASE.get(session).countDown();
+    String state = b2AwaitSettled(session, 30);
+    assertThat(state).isIn("FAILED", "UNKNOWN_OUTCOME");
+    p3AwaitTeardown(session);
+    assertThat(incrementalImmutableSnapshot(session)).isEqualTo(pending);
+    assertThat(b2bCount("studio_guided_materialization_deliveries", session)).isEqualTo(1);
+    assertThat(b2bRows("studio_guided_allocations", "binding_id", session)).isEqualTo(allocations);
+    assertThat(b2bRows("studio_guided_producers", "binding_id", session)).isEqualTo(producers);
+    assertThat(b2bMaterializationRevision(session)).isEqualTo(revision);
+    // Design note 1: counters may legitimately change on stop, so only work tables are compared.
+    assertThat(b2bWorkSnapshot(session))
+        .as("no action/preparation/model attempt/switch after loss")
+        .isEqualTo(work);
+  }
+
+  private String b2bWorkSnapshot(String id) {
+    ObjectNode snapshot = C.object();
+    for (String table :
+        List.of(
+            "studio_guided_actions",
+            "studio_guided_model_attempts",
+            "studio_guided_relearn_switches",
+            "studio_guided_preparations")) {
+      snapshot.set(
+          table,
+          C.parse(
+              jdbc.queryForObject(
+                  "SELECT COALESCE(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text),'[]'::jsonb)"
+                      + "::text FROM "
+                      + table
+                      + " t WHERE session_id=?",
+                  String.class,
+                  id)));
+    }
+    return GuidedContracts.canonical(snapshot);
+  }
