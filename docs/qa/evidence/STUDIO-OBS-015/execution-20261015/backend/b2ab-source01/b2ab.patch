+  private void b2ResetKnobs() {
+    b2PasswordPage = B2PasswordPage.SINGLE;
+    b2Combined = false;
+    b2aTitleSuffix = false;
+    B2_REFERENCE_RECEIPTS.clear();
+    B2_MODEL_CONTEXTS.clear();
+    b2bSignInHold = null;
+    b2bSignInEntered = null;
+  }
