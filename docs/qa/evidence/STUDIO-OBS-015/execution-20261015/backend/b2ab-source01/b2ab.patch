+  private String b2PassReferenceId(String session) {
+    for (JsonNode reference :
+        C.parse(
+                jdbc.queryForObject(
+                    "SELECT manifest::text FROM studio_guided_source_manifests WHERE session_id=?",
+                    String.class,
+                    session))
+            .path("configurationReferences")) {
+      if (reference.path("kind").asText().equals("secretRef")
+          && reference.path("referenceName").asText().equals("PASS")) {
+        return reference.path("referenceId").asText();
+      }
+    }
+    throw new AssertionError("frozen PASS secretRef missing");
+  }
