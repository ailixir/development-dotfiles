+                .put("expectedSourceRevision", edited.path("sourceRevision").asText())
+                .put(
+                    "expectedConfigurationRevision", edited.path("configurationRevision").asText()),
+            200);
+    UUID revision = UUID.fromString(published.path("revisionId").asText());
+    String artifact =
+        jdbc.queryForObject(
+            "SELECT artifact::text FROM ui_test_revisions WHERE id=?", String.class, revision);
+    String hash =
+        jdbc.queryForObject(
