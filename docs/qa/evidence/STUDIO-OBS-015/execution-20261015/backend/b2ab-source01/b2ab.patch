+  private static void b2SignIn(Map<String, String> values) {
+    if (b2Combined) {
+      B2_REFERENCE_RECEIPTS.add(values.getOrDefault("reference", ""));
+    }
+    java.util.concurrent.CountDownLatch hold = b2bSignInHold;
+    if (hold == null) {
+      return;
+    }
+    java.util.concurrent.CountDownLatch entered = b2bSignInEntered;
+    if (entered != null) {
+      entered.countDown();
+    }
+    try {
+      if (!hold.await(20, java.util.concurrent.TimeUnit.SECONDS)) {
+        b2bSignInHold = null;
+      }
+    } catch (InterruptedException interrupted) {
+      Thread.currentThread().interrupt();
+    }
