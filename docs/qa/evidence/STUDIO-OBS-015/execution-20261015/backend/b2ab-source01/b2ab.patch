+  private void b2bAppendAuthority(
+      UUID test,
+      String session,
+      JsonNode edited,
+      B2bPlanHold hold,
+      com.citi.put.checks.studio.guided.session.GuidedSessionService service,
+      org.springframework.security.core.Authentication controller)
+      throws Exception {
+    var materialization =
+        new com.citi.put.checks.studio.guided.bridge.GuidedMaterializationService(jdbc, C);
+    var preparationStore =
+        new com.citi.put.checks.studio.guided.bridge.GuidedPreparationStore(jdbc, C);
+    var runner =
+        ownedApplicationContext.getBean(
+            com.citi.put.checks.studio.guided.bridge.GuidedRunnerClient.class);
+    // ---- Phase A: a real unexpired, unconsumed preparation blocks the append (A46-1) ----
+    assertThat(hold.entered.await(60, java.util.concurrent.TimeUnit.SECONDS))
+        .as("suffix SOURCE_PLAN in flight")
+        .isTrue();
+    assertThat(
+            jdbc.queryForObject(
+                "SELECT reason FROM studio_guided_relearn_switches WHERE session_id=?",
+                String.class,
+                session))
+        .isEqualTo("BOUNDARY");
+    assertThat(b2bCount("studio_guided_materialization_versions", session)).isEqualTo(1);
+    long fence =
+        sessions.transaction(
+            () -> sessions.lock(session).document().path("owner").path("fence").asLong());
+    JsonNode progress = sessions.transaction(() -> sessions.lock(session).progress().deepCopy());
+    JsonNode document = sessions.transaction(() -> sessions.lock(session).document().deepCopy());
+    ObjectNode context = service.runnerContext(controller, session, fence);
+    JsonNode target = null;
+    for (JsonNode node : progress.path("observation").path("nodes")) {
+      if (node.path("name").asText().equals("Destination")) {
+        target = node;
+      }
+    }
+    assertThat(target != null).as("Destination observed on the live page").isTrue();
+    ObjectNode proposal =
+        C.object()
+            .put("schemaVersion", 3)
+            .put("sessionId", session)
+            .put("scopeHash", document.path("scopeHash").asText())
+            .put("generation", progress.path("generation").asInt())
+            .put("evidenceHash", progress.path("evidenceHash").asText())
+            .put("contextRevision", context.path("contextRevision").asInt())
+            .put("authoredInputsHash", context.path("authoredInputsHash").asText());
+    proposal.putObject("coordinate").put("stepId", INCREMENTAL_STEPS.get(3)).put("ordinal", 0);
+    proposal.set("executionEvidence", progress.path("executionEvidence"));
+    proposal
+        .putObject("target")
+        .put("nodeId", target.path("nodeId").asText())
+        .put("documentId", progress.path("documentId").asText())
+        .put("generation", progress.path("generation").asInt())
+        .putObject("locator")
+        .put("kind", "role")
+        .put("role", target.path("role").asText())
+        .put("name", "Destination")
+        .put("exact", true);
