+  /** A28-12 typed walk (VERIFY-4): no literal/spanning lowering of the secret token. */
+  private void b2aAssertNoSpanningLowering(UUID test, String mixed, P3Publication merged) {
+    String text =
+        jdbc.queryForObject("SELECT steps->>1 FROM ui_tests WHERE id=?", String.class, test);
+    String token = "<secret PASS>";
+    int start = text.indexOf(token);
+    int end = start + token.length();
+    assertThat(start).as("authored secret token present in step TWO").isNotNegative();
+    int secretInputs = 0;
+    for (String row :
+        jdbc.queryForList(
+            "SELECT document::text FROM studio_guided_materialization_inputs WHERE session_id=?",
+            String.class,
+            mixed)) {
+      JsonNode input = C.parse(row);
+      JsonNode provenance = input.path("provenance");
+      if (input.path("kind").asText().equals("secretRef")) {
+        secretInputs++;
+        assertThat(input.has("value")).as("secretRef input is value-free").isFalse();
+        continue;
+      }
+      assertThat(input.has("secretId"))
+          .as("no nonsecret/destination input carries secretId")
+          .isFalse();
+      if (provenance.path("referenceKind").asText().equals("sourceSpan")
+          && provenance.path("stepId").asText().equals(TWO)) {
+        assertThat(
+                provenance.path("endUtf16").asInt() <= start
+                    || provenance.path("startUtf16").asInt() >= end)
+            .as("no literal input span overlaps the secret token")
+            .isTrue();
+      }
+    }
+    assertThat(secretInputs).as("one secretRef input").isEqualTo(1);
+    JsonNode artifact = C.parse(merged.artifact());
+    for (JsonNode recipe : artifact.path("inputRecipes")) {
+      if (recipe.path("kind").asText().equals("secretRef")) {
+        assertThat(recipe.path("provenance").path("kind").asText()).isEqualTo("configuration");
+      } else if (recipe.path("stepId").asText().equals(TWO)
+          && recipe.path("provenance").path("kind").asText().equals("sourceSpan")) {
+        assertThat(
+                recipe.path("provenance").path("end").asInt() <= start
+                    || recipe.path("provenance").path("start").asInt() >= end)
+            .as("no published literal recipe overlaps the secret token")
+            .isTrue();
+      }
+    }
+    var guards = new java.util.HashMap<String, JsonNode>();
+    for (JsonNode guard : artifact.path("guards")) {
+      guards.put(guard.path("guardId").asText(), guard);
+    }
+    int passwordOperations = 0;
+    for (JsonNode step : artifact.path("steps")) {
+      for (JsonNode operation : step.path("operations")) {
+        JsonNode guard = guards.get(operation.path("guardId").asText());
+        assertThat(guard != null).as("every published operation has its guard").isTrue();
+        boolean password = guard.path("target").path("kind").asText().equals("passwordControl");
+        boolean secretValue =
+            operation.path("operation").path("value").path("kind").asText().equals("secretRef");
+        assertThat(password)
+            .as("secretRef only on a passwordControl target")
+            .isEqualTo(secretValue);
+        if (password) {
+          passwordOperations++;
+          assertThat(operation.path("operation").path("kind").asText()).isEqualTo("fill");
+          assertThat(operation.path("coordinate").path("stepId").asText()).isEqualTo(TWO);
+        }
+      }
+    }
+    assertThat(passwordOperations).as("exactly one password fill is published").isEqualTo(1);
+  }
