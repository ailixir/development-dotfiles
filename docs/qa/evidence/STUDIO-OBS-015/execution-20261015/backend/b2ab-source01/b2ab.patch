+  private String b2AwaitSettled(String id, int seconds) throws Exception {
+    long end = System.nanoTime() + Duration.ofSeconds(seconds).toNanos();
+    String state;
+    do {
+      state = sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
+      if (List.of("FAILED", "UNKNOWN_OUTCOME", "CANCELLED", "EXPIRED", "SUCCEEDED", "FINALIZING")
+          .contains(state)) {
+        break;
+      }
+      Thread.sleep(25);
+    } while (System.nanoTime() < end);
+    return state;
+  }
