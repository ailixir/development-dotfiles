+  /** PASS audit rows of one session matching a test-owned predicate with bound parameters. */
+  private long b2AuditCount(String session, String predicate, Object... arguments) {
+    Object[] bound = new Object[arguments.length + 1];
+    bound[0] = session;
+    System.arraycopy(arguments, 0, bound, 1, arguments.length);
+    return jdbc.queryForObject(
+        "SELECT count(*) FROM studio_secret_use_audit WHERE session_id=? AND secret_id='PASS' AND "
+            + predicate,
+        Long.class,
+        bound);
+  }
