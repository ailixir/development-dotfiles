+            assertThat(userHash).as("plain declaration carries a 64-hex valueHash").isTrue();
+            assertThat(passId).as("secret declaration carries its secretId").isTrue();
+            byte[] authoringBytes =
+                current.path("authoring").toString().getBytes(StandardCharsets.UTF_8);
+            assertThat(containsBytes(authoringBytes, ctxText.getBytes(StandardCharsets.UTF_8)))
+                .as("positive control: context text reaches internal validation")
+                .isTrue();
+            assertThat(containsBytes(authoringBytes, ctxLiteral.getBytes(StandardCharsets.UTF_8)))
+                .as("positive control: context literal reaches internal validation")
+                .isTrue();
+            // Both private authoring subtrees are internal validation inputs: the current
+            // snapshot and the pinned base revision's own authoring (baseProof, mixed session).
+            ObjectNode outsideAuthoring = raw.deepCopy();
