+  private List<JsonNode> b2PrefixSyncEvents(PrefixSyncCut cut, String session) throws Exception {
+    Path file = TEMP.resolve("obs015-prefix-sync-" + cut.key + ".jsonl");
+    if (!Files.exists(file)) {
+      return List.of();
+    }
+    assertThat(Files.isSymbolicLink(file)).isFalse();
+    assertThat(Files.getPosixFilePermissions(file))
+        .isEqualTo(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"));
+    var events =
+        Files.readAllLines(file, StandardCharsets.UTF_8).stream()
+            .filter(line -> !line.isBlank())
+            .map(C::parse)
+            .toList();
+    for (JsonNode row : events) {
+      assertThat(row.size()).as("closed nine-key event row").isEqualTo(9);
+      assertThat(row.path("mode").asText()).isEqualTo(cut.mode);
+      assertThat(row.path("sessionHash").asText())
+          .isEqualTo(GuidedContracts.hash(JSON.getNodeFactory().textNode(session)));
+    }
+    return events;
