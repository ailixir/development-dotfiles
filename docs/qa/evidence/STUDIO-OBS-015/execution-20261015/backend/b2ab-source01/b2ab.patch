+  /** One real mixed session on the confirmed base under one fault; code/count oracles only. */
+  private void b2aFault(
+      UUID test,
+      VaultScope scope,
+      P3Publication base,
+      String environment,
+      String value,
+      B2aSetup setup,
+      B2aExpected expected)
+      throws Exception {
+    p3ExpectedPassword = value;
+    p3Seed(scope, value);
+    setup.run();
+    P3_RECEIPTS.clear();
+    P3_NATIVE_SESSIONS.clear();
+    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
+    int models = MODEL_WIRE.size();
+    try {
+      String id =
+          p3Call(
+                  p3Cookie,
+                  "/api/v1/studio/guided-sessions",
+                  p3StartCommand(test, environment)
+                      .put("baseRevisionId", base.revision().toString())
+                      .put("firstLearnStepId", THREE),
+                  202)
+              .path("session")
+              .path("sessionId")
+              .asText();
+      String state = b2AwaitSettled(id, 60);
+      if (expected.state() != null) {
+        assertThat(state).as("fault terminal state").isEqualTo(expected.state());
+      } else {
+        // VERIFY-2: the exact ZERO/TWO terminal is pinned on the first run; effects are exact.
+        assertThat(state).as("fault terminal state").isIn("FAILED", "UNKNOWN_OUTCOME");
+      }
+      p3AwaitTeardown(id);
+      if (expected.code() != null) {
+        assertThat(
+                sessions.transaction(() -> sessions.lock(id).progress().path("errorCode").asText()))
+            .isEqualTo(expected.code());
+      }
+      assertThat(
+              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
+                  - reads)
+          .as("in-JVM fake Vault value reads under the fault")
+          .isEqualTo(expected.reads());
+      assertThat(MODEL_WIRE.size())
+          .as("no prefix or relearn model call under a fault")
+          .isEqualTo(models);
+      assertThat(P3_RECEIPTS).as("no sign-in POST under any fault").isEmpty();
+      assertThat(b2AuditCount(id, "row_kind='RELEASE'"))
+          .isEqualTo(expected.release() == null ? 0 : 1);
+      if (expected.release() != null) {
+        assertThat(b2AuditCount(id, "row_kind='RELEASE' AND outcome=?", expected.release()))
+            .isEqualTo(1);
+      }
+      assertThat(b2AuditCount(id, "row_kind='USAGE'")).isEqualTo(1);
+      assertThat(
+              b2AuditCount(
+                  id,
+                  "row_kind='USAGE' AND usage_outcome=? AND admission_id IS "
+                      + (expected.linked() ? "NOT NULL" : "NULL"),
+                  expected.usage()))
+          .isEqualTo(1);
+      if (!expected.usage().equals("REFUSED")) {
+        assertThat(b2AuditCount(id, "row_kind='USAGE' AND usage_outcome='REFUSED'")).isZero();
+      }
+      if (!expected.usage().equals("NOT_USED")) {
+        assertThat(b2AuditCount(id, "row_kind='USAGE' AND usage_outcome='NOT_USED'")).isZero();
+      }
+      var fill =
+          jdbc.queryForList(
+              "SELECT document::text FROM studio_guided_actions"
+                  + " WHERE session_id=? AND step_id=? AND ordinal=1",
+              String.class,
+              id,
+              TWO);
+      if (expected.reads() == 0) {
+        assertThat(fill).as("no TWO/1 admission without a password target").isEmpty();
+        assertThat(
+                jdbc.queryForObject(
+                    "SELECT count(*) FROM studio_guided_prefix_requests"
+                        + " WHERE session_id=? AND step_id=? AND ordinal=1 AND status='PREPARED'",
+                    Integer.class,
+                    id,
+                    TWO))
+            .isZero();
+      } else {
+        assertThat(fill).hasSize(1);
+        assertThat(C.parse(fill.getFirst()).path("dispatchCount").asInt()).isEqualTo(1);
+        assertThat(
+                jdbc.queryForObject(
+                    "SELECT count(*) FROM studio_guided_actions WHERE session_id=? AND step_id=?",
+                    Integer.class,
+                    id,
+                    TWO))
+            .as("no replacement admission after a fault")
+            .isEqualTo(2);
+      }
+      assertThat(
+              COUNTED_VAULT.reads.stream()
+                  .filter(read -> read.value != null)
+                  .allMatch(read -> allErased(read.value)))
+          .isTrue();
+    } finally {
+      // Restore the exact page origin binding for the next fault (fake Vault leaf only).
+      VAULT.bindOrigins(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS", ORIGIN);
+    }
+  }
