+    B2bPlanHold hold = B2B_PLAN_HOLDS.get(context.path("sessionId").asText());
+    if (hold == null || hold.hits.getAndIncrement() > 0) {
+      return; // only the first suffix SOURCE_PLAN of the selected session
+    }
+    hold.entered.countDown();
+    try {
+      if (!hold.release.await(8, java.util.concurrent.TimeUnit.SECONDS)) {
+        hold.failure = new IllegalStateException("B2b plan hold deadline");
