+  // ---- B2 shared helpers (test-owned; value-free failure texts) ----
+
+  /** Immutable snapshot of a concurrently appended fixture list from an index. */
+  private static <T> List<T> b2Tail(List<T> list, int from) {
+    List<T> copy = List.copyOf(list);
+    return copy.subList(from, copy.size());
+  }
