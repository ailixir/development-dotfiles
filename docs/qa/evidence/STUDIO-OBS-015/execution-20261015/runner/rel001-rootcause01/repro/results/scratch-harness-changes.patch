@@ -0,0 +1,16 @@
+#!/bin/bash
+# REL-001 repro (scratch only): put every descendant of <pid> (the harness/probe node process, which itself is NOT
+# touched) into macOS background policy as soon as it appears. Signals nothing. Exits when <pid> is gone.
+#   bgpoller.sh <pid> <log>
+REL001_HERE="$(cd "$(dirname "$0")" && pwd)"; source "$REL001_HERE/lib.sh"
+root="$1"; log="${2:-/dev/null}"; seen=" "; n=0
+while kill -0 "$root" 2>/dev/null; do
+  for d in $(descendants "$root"); do
+    case "$seen" in *" $d "*) continue;; esac
+    is_denied "$d" && continue
+    seen="$seen$d "
+    taskpolicy -b -p "$d" 2>/dev/null && n=$((n+1))
+  done
+  sleep 0.02
+done
+echo "bgpoller: applied background policy to $n processes" >> "$log"
