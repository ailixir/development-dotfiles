 }
+
+# scratch-only: page-cache eviction + read I/O contention. Writes a GB-sized file inside the run's owned dir,
+# then streams it in a loop. Chrome's own cached pages get evicted; the file is removed with the owned dir.
+start_evict() {  # start_evict <owned-dir> <gb>
+  local f="$1/evict.bin" gb="${2:-10}"
+  bash -c 'dd if=/dev/zero of="$1" bs=1m count="$2" 2>/dev/null; while :; do cat "$1" > /dev/null; done' _ "$f" $((gb*1024)) & track $!
+}
