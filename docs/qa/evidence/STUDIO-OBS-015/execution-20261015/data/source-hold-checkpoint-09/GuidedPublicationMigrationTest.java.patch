+    private void rebindClassifiedReferences(JsonNode node,JsonNode originalDeclarations,JsonNode manifest) {
+      if(node.isArray()){node.forEach(child->rebindClassifiedReferences(child,originalDeclarations,manifest));return;}
+      if(!node.isObject())return;
+      ObjectNode object=(ObjectNode)node;
+      if(object.path("referenceKind").asText().equals("configuration"))
+        object.put("referenceId",classifiedReference(object,originalDeclarations,manifest).path("referenceId").asText());
+      object.elements().forEachRemaining(child->rebindClassifiedReferences(child,originalDeclarations,manifest));
     }
 
