+    private JsonNode classifiedReference(JsonNode reference,JsonNode originalDeclarations,JsonNode manifest) {
+      String previous=reference.path("referenceId").asText(),name=reference.path("referenceName").asText();
+      if(name.isEmpty())for(JsonNode declared:originalDeclarations)if(declared.path("referenceId").asText().equals(previous))name=declared.path("referenceName").asText();
+      if(name.isEmpty())for(var variable:sharedVariables)if(variable.name().equals(previous))name=variable.name();
+      if(name.isEmpty())for(JsonNode actual:manifest.path("configurationReferences"))if(actual.path("referenceId").asText().equals(previous))name=actual.path("referenceName").asText();
+      JsonNode found=null;
+      for(JsonNode actual:manifest.path("configurationReferences")) {
+        if(actual.path("referenceName").asText().equals(name) && actual.path("stepId").equals(reference.path("stepId"))
+            && actual.path("kind").equals(reference.path("kind")) && actual.path("intendedSlot").equals(reference.path("intendedSlot"))) {
+          if(found!=null)throw new IllegalArgumentException("Ambiguous classified fixture reference");found=actual;
+        }
+      }
+      if(found==null)throw new IllegalArgumentException("Fixture reference lacks its exact classified declaration: "+previous);
+      return found;
+    }
