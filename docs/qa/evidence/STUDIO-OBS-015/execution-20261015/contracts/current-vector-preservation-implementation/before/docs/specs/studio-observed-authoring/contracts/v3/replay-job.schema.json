{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/replay-job.schema.json",
  "title": "Observed replay replay-job",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "observed"
    },
    "binding": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/replay-job.schema.json#/definitions/ExecutionBinding"
    },
    "artifact": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/replay-artifact.schema.json"
    },
    "configuration": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/Configuration"
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "inputId",
          "value"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "totalRuntimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepTimeoutMs",
        "totalRuntimeMs"
      ]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "maxProperties": 64
    },
    "secretOrigins": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 512,
            "pattern": "^https?://[^/?#]+$"
          }
        }
      },
      "maxProperties": 64
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "binding",
    "artifact",
    "configuration",
    "inputs",
    "runtime",
    "recording",
    "secrets",
    "secretOrigins"
  ],
