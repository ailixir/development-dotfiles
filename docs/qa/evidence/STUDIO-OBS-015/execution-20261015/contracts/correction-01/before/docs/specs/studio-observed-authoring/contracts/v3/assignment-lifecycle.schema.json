{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/assignment-lifecycle.schema.json",
  "title": "Observed v3 pre-context assignment lifecycle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "assignment"
    },
    "assignment": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/assignment.schema.json"
    },
    "reason": {
      "enum": [
        "CANCELLED",
        "EXPIRED",
        "UNKNOWN_OUTCOME",
        "LEASE_LOST",
        "CONTEXT_LOST",
        "REVOKED"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "assignment",
    "reason"
  ]
}
