{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json",
  "title": "Observed replay replay-operation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "coordinate": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
    },
    "guardId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/operation"
    }
  },
  "required": [
    "coordinate",
    "guardId",
    "operation"
  ],
  "definitions": {
    "InputRecipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "destination",
            "nonsecretText",
            "secretRef"
          ]
        },
        "intendedSlot": {
          "type": "string",
          "enum": [
            "navigate.destination",
            "fill.value",
            "selectOption.value",
            "assert.expected"
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "sourceSpan"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "start",
                "end",
                "sourceHash"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "configuration"
                },
                "referenceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "referenceName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "referenceId",
                "referenceName"
              ]
            }
          ]
        }
      },
      "required": [
        "inputId",
        "stepId",
        "kind",
        "intendedSlot",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "secretRef"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "intendedSlot": {
                "const": "fill.value"
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "configuration"
                  },
                  "referenceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "referenceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "kind",
                  "referenceId",
                  "referenceName"
                ]
              }
            }
          }
        }
      ]
    },
    "Guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "origin": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 256,
              "pattern": "^https?://[^/?#]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "initialBlank"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "page"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "element"
                },
                "locator": {
                  "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/target/oneOf/0/properties/locator"
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "elementType": {
                  "type": "string",
                  "enum": [
                    "button",
                    "input",
                    "textarea",
                    "select",
                    "text",
                    "link",
                    "other"
                  ]
                },
                "controlType": {
                  "type": "string",
                  "enum": [
                    "none",
                    "text",
                    "search",
                    "email",
                    "tel",
                    "url",
                    "textarea",
                    "password",
                    "hidden",
                    "other"
                  ]
                },
                "classification": {
                  "type": "string",
                  "enum": [
                    "structuralOnly",
                    "permittedBusinessData",
                    "nonsecretApproved",
                    "withheld"
                  ]
                },
                "visible": {
                  "type": "boolean"
                },
                "actionable": {
                  "type": "boolean"
                },
                "readRuleId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "locator",
                "role",
                "elementType",
                "controlType",
                "classification",
                "visible",
                "actionable",
                "readRuleId"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "passwordControl"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "required": [
        "guardId",
        "origin",
        "target"
      ]
    },
    "Transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producer": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
        },
        "consumer": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
        },
        "slot": {
          "type": "string",
          "enum": [
            "fill.value",
            "selectOption.value",
            "assert.expected"
          ]
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 256,
          "pattern": "^https?://[^/?#]+$"
        }
      },
      "required": [
        "bindingId",
        "producer",
        "consumer",
        "slot",
        "origin"
      ]
    },
    "RuntimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producer": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
        },
        "recipe": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/producer.schema.json#/properties/recipe"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 256,
          "pattern": "^https?://[^/?#]+$"
        }
      },
      "required": [
        "bindingId",
        "producer",
        "recipe",
        "origin"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stepId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json"
          }
        }
      },
      "required": [
        "stepIndex",
        "stepId",
        "operations"
      ]
    }
  }
}
