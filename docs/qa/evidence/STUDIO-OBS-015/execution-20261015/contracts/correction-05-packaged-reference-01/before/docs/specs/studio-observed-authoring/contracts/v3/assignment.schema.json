{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/assignment.schema.json",
  "title": "Observed v3 immutable pre-context assignment",
  "description": "Controller intent only. No browser, owner grant or lease exists until the actual worker validates its own claim response.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "versions": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
    },
    "expectedFence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "assignmentId",
    "sessionId",
    "workerId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "versions",
    "expectedFence",
    "expiresAt"
  ]
}
