{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/action.schema.json",
  "title": "Studio observed v3 action",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "locator": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "role"
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "exact": {
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "role",
                    "name",
                    "exact"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "label",
                        "testId",
                        "text",
                        "placeholder"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "exact": {
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "value",
                    "exact"
                  ]
                }
              ]
            }
          },
          "required": [
            "nodeId",
            "documentId",
            "generation",
            "locator"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "page"
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "documentId",
            "generation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "passwordControl"
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "documentId",
            "generation"
          ]
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "click",
                "check",
                "uncheck",
                "hover"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fill"
            },
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "authoredLiteral"
                    },
                    "sourceInputId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "sourceInputId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "binding"
                    },
                    "bindingId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "bindingId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "secretRef"
                    },
                    "sourceInputId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "sourceInputId"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "press"
            },
            "key": {
              "enum": [
                "Enter",
                "Tab",
                "Escape",
                "ArrowDown",
                "ArrowUp"
              ]
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "selectOption"
            },
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "authoredLiteral"
                    },
                    "sourceInputId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "sourceInputId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "binding"
                    },
                    "bindingId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "bindingId"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "destinationInputId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "destinationInputId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "read"
            },
            "bindingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "recipe": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "visibleText"
                    },
                    "classification": {
                      "const": "permittedBusinessData"
                    },
                    "policyRuleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "classification",
                    "policyRuleId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "controlValue"
                    },
                    "classification": {
                      "const": "nonsecretApproved"
                    },
                    "controlType": {
                      "enum": [
                        "text",
                        "search",
                        "email",
                        "tel",
                        "url",
                        "textarea"
                      ]
                    },
                    "policyRuleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "classification",
                    "controlType",
                    "policyRuleId"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "bindingId",
            "recipe"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "assert"
            },
            "predicate": {
              "enum": [
                "visible",
                "containsText",
                "hasValue",
                "url",
                "title"
              ]
            },
            "expected": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "authoredLiteral"
                        },
                        "sourceInputId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "kind",
                        "sourceInputId"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "binding"
                        },
                        "bindingId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "kind",
                        "bindingId"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "predicate",
            "expected"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "predicate": {
                    "const": "visible"
                  }
                }
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "expected": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "predicate": {
                    "enum": [
                      "url",
                      "title"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "authoredLiteral"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "executionEvidence": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/execution-evidence.schema.json"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "coordinate",
    "scopeHash",
    "generation",
    "target",
    "operation",
    "executionEvidence",
    "evidenceHash",
    "authoredInputsHash",
    "contextRevision"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "fill"
              },
              "value": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "secretRef"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "kind",
              "value"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "passwordControl"
              },
              "documentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "kind",
              "documentId",
              "generation"
            ]
          }
        },
        "required": [
          "target"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "target": {
            "not": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "passwordControl"
                },
                "documentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "kind",
                "documentId",
                "generation"
              ]
            }
          }
        }
      }
    }
  ]
}
