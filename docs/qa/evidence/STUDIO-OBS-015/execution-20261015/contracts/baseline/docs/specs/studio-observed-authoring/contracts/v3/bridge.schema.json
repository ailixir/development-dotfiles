        "versions": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
        },
        "recordingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$"
        },
        "state": {
          "enum": [
            "STORED",
            "FAILED",
            "UNAVAILABLE"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "timings": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/action-timing.schema.json"
          }
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "workerId",
        "ownerFence",
        "scopeHash",
        "contextId",
        "contextRevision",
        "sourceRevision",
        "configurationRevision",
        "versions",
        "recordingId",
        "state",
        "partial",
        "timings"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "state": {
                "const": "STORED"
              }
            },
            "required": [
              "state"
            ]
          },
          "else": {
            "type": "object",
            "properties": {
              "partial": {
                "const": false
              },
              "timings": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_DENIED",
            "IDEMPOTENCY_CONFLICT",
            "SCHEMA",
            "IDENTITY_MISMATCH",
            "CAPACITY",
            "CONTEXT_LOST",
            "ALREADY_CONSUMED",
            "BUSY",
            "TARGET_CHANGED",
            "PREPARATION_DENIED",
            "ADMISSION_DENIED",
            "BINDING_UNAVAILABLE",
            "BINDING_DENIED",
            "BINDING_ORDER",
            "ACTION_ORDER",
            "CONTEXT_REVISION",
            "INPUT_IDENTITY",
            "BUDGET_EXCEEDED",
            "POLICY_DENIED"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "PASSWORD_TARGET_ABSENT",
            "PASSWORD_TARGET_AMBIGUOUS",
            "PASSWORD_FORM_ACTION_NOT_ALLOWED",
            "PASSWORD_CONTROL_READ_REFUSED"
          ]
        }
      },
      "required": [
        "code"
      ],
      "if": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "code": {
            "const": "POLICY_DENIED"
          }
        }
      }
    }
  }
}
