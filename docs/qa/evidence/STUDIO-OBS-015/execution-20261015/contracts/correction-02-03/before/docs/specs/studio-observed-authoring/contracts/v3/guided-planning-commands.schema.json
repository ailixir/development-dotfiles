{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/guided-planning-commands.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedSourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedConfigurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedPlanRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "expectedSourceRevision",
    "expectedConfigurationRevision",
    "expectedPlanRevision"
  ]
}
