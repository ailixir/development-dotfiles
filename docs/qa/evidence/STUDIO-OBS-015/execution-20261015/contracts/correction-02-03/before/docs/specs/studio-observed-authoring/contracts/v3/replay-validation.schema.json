        "schemaVersion",
        "attemptId",
        "claimId",
        "snapshotHash",
        "basisHash",
        "profile",
        "build",
        "ok",
        "artifactHash",
        "learnedPlanHash",
        "referencePolicyHash",
        "operationEquivalenceHash",
        "admissionProvenanceHash",
        "publicationEvidenceHash",
        "errorCode"
      ]
    },
    "AcceptedTranslationPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "occurrence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
