        "sourceManifestHash",
        "authoredInputsHash",
        "configuration",
        "learningProvenance",
        "sourceSteps",
        "scope",
        "runAuthorization",
        "replayRequirements",
        "bootstrap",
        "translationRevision",
        "translationHash",
        "translationPlan",
        "sourceSelections",
        "obligationAssociations",
        "inputs",
        "configurationReferences",
        "observations",
        "preparations",
        "actions",
        "allocations",
        "producers",
        "consumerEdges",
        "bindings",
        "transfers",
        "materializationEvidence",
        "incrementalEvidence",
        "snapshotEvidence"
