        "learnedPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referencePolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operationEquivalenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "admissionProvenanceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicationEvidenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "errorCode": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "INVALID_CONTRACT",
                "EVIDENCE_MISMATCH",
                "OPERATION_MISMATCH",
                "REFERENCE_MISMATCH",
                "PROFILE_MISMATCH",
                "LIMIT_EXCEEDED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
