              "operationKind": {
                "enum": [
                  "navigate",
                  "click",
                  "fill",
                  "press",
                  "selectOption",
                  "check",
                  "uncheck",
                  "hover",
                  "read",
                  "assert"
                ]
              },
              "targetIntent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "referenceIndex": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "needId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "predicate": {
                "oneOf": [
                  {
                    "enum": [
                      "visible",
                      "containsText",
                      "hasValue",
                      "url",
                      "title"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "obligationId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "stepId",
              "occurrence",
              "operationKind",
              "targetIntent",
              "referenceIndex",
              "needId",
              "predicate",
              "obligationId"
            ]
          },
          "minItems": 1,
          "maxItems": 800
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "needId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "producerStepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "stepId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "argumentSlot": {
                      "enum": [
                        "fill.value",
                        "selectOption.value",
                        "assert.expected"
                      ]
                    }
                  },
                  "required": [
                    "stepId",
                    "argumentSlot"
                  ]
                },
                "minItems": 1,
                "maxItems": 200
              },
              "bindingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
