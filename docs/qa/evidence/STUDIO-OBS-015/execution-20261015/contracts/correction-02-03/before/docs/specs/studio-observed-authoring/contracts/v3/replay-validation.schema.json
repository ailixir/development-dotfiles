          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "destination",
            "nonsecretText",
            "secretRef"
          ]
        },
        "intendedSlot": {
          "type": "string",
          "enum": [
            "navigate.destination",
            "fill.value",
            "selectOption.value",
            "assert.expected"
          ]
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "referenceId",
        "referenceName",
        "stepId",
        "kind",
        "intendedSlot",
        "inputId"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "secretRef"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "intendedSlot": {
                "const": "fill.value"
              }
            }
          }
        }
      ]
