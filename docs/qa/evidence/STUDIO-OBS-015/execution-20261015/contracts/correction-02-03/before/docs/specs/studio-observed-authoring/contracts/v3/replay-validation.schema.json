    "InputIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "destination",
            "nonsecretText",
            "secretRef"
          ]
        },
        "intendedSlot": {
          "type": "string",
          "enum": [
            "navigate.destination",
            "fill.value",
            "selectOption.value",
            "assert.expected"
          ]
        },
        "provenance": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
        }
      },
      "required": [
        "inputId",
        "stepId",
        "kind",
        "intendedSlot",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "secretRef"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "intendedSlot": {
                "const": "fill.value"
              }
            }
          }
        }
      ]
    },
    "ConfigReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceId": {
          "type": "string",
