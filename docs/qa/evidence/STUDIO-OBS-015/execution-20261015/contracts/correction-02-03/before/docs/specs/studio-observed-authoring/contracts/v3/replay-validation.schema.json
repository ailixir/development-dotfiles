          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/BuildIdentity"
        },
        "ok": {
          "type": "boolean"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
