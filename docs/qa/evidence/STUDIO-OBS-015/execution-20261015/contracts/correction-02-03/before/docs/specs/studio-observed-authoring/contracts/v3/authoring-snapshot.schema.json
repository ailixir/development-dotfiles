{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/authoring-snapshot.schema.json",
  "title": "Private normalized authoring snapshot evidence; existing v2 source, observed v3 proof",
  "definitions": {
    "ContextText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "LiteralInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "VariableReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variableRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "SecretReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "secretRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "TargetHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "targetHint"
        },
        "strategy": {
          "enum": [
            "role",
            "label",
            "testId",
            "text"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "strategy",
        "value",
        "scope",
        "exact"
      ]
    },
    "DefaultVariableValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variableRef"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "referenceId"
      ]
    },
    "DefaultLiteralValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "ContextualDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "default"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/definitions/DefaultLiteralValue"
            },
            {
              "$ref": "#/definitions/DefaultVariableValue"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "value"
      ]
    },
    "AuthoringEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "const": "supplied"
        },
        "csiId": {
          "type": "string",
          "maxLength": 20
        },
        "environment": {
          "type": "string",
          "maxLength": 50
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "source",
        "csiId",
        "environment",
        "route",
        "state",
        "stepId",
        "capturedAt",
        "completeness",
        "hash"
      ]
    },
    "GlobalContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/ContextText"
              },
              {
                "$ref": "#/definitions/TargetHint"
              },
              {
                "$ref": "#/definitions/ContextualDefault"
              }
            ]
          },
          "minItems": 0
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoringEvidenceReference"
          },
          "minItems": 0
        }
      },
      "required": [
        "entries",
        "evidenceReferences"
      ]
    },
    "StepContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/ContextText"
              },
              {
                "$ref": "#/definitions/LiteralInput"
              },
              {
                "$ref": "#/definitions/VariableReference"
              },
              {
                "$ref": "#/definitions/SecretReference"
              },
              {
                "$ref": "#/definitions/TargetHint"
              },
              {
                "$ref": "#/definitions/ContextualDefault"
              }
            ]
          },
          "minItems": 0
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoringEvidenceReference"
          },
          "minItems": 0
        }
      },
      "required": [
        "entries",
        "evidenceReferences"
      ]
    },
    "NormalizedAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringSchemaVersion": {
          "const": 2
        },
        "globalContext": {
          "$ref": "#/definitions/GlobalContext"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "context": {
                "$ref": "#/definitions/StepContext"
              }
            },
            "required": [
              "id",
              "text",
              "context"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "authoringSchemaVersion",
        "globalContext",
        "steps"
      ]
    },
    "AuthoringSnapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringIdentityVersion": {
          "const": 1
        },
        "authoring": {
          "$ref": "#/definitions/NormalizedAuthoring"
        },
        "authoredDeclarations": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/Declaration"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "authoringIdentityVersion",
        "authoring",
        "authoredDeclarations"
      ]
    },
    "PinnedBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "revisionId",
        "revisionDigest"
      ]
    },
    "BaseSnapshotProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json"
        },
        "authoringIdentity": {
          "$ref": "#/definitions/AuthoringSnapshotIdentity"
        },
        "configuration": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json#/definitions/Configuration"
        },
        "artifact": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/replay-artifact.schema.json"
        }
      },
      "required": [
        "revision",
        "authoringIdentity",
        "configuration",
        "artifact"
      ]
    },
    "SnapshotEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "current": {
          "$ref": "#/definitions/AuthoringSnapshotIdentity"
        },
        "pinnedBase": {
          "oneOf": [
            {
              "$ref": "#/definitions/PinnedBase"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseProof": {
          "oneOf": [
            {
              "$ref": "#/definitions/BaseSnapshotProof"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "current",
        "pinnedBase",
        "baseProof"
      ]
    }
  },
  "$ref": "#/definitions/SnapshotEvidence"
}
