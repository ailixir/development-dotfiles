{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/design/studio-obs-015/correction03-private-marker.schema.json",
  "classification": "DESIGN PRIVATE JSON PROGRESS ONLY; no public or runner wire extension",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clarificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "PENDING",
        "CONFIRMED"
      ]
    },
    "prefixRequestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "clarificationId",
    "status",
    "prefixRequestDigest"
  ]
}
