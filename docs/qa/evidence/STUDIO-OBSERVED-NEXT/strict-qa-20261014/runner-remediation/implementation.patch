+/** The standalone worker's graceful signal lifecycle. SIGKILL cannot call this handler. */
+export function installGuidedShutdown(close: () => Promise<void>, release: () => void): void {
+  let stopping: Promise<void> | undefined;
+  const stop = (): void => {
+    stopping ??= close().then(() => { process.exitCode = 0; }).catch(() => { process.exitCode = 1; }).finally(release);
+  };
+  process.once('SIGTERM', stop); process.once('SIGINT', stop);
+}
