+    private void triggerPgOnce(Thread target) {
+      synchronized (gate) {
+        Long start = entered.get(target);
+        if (stopping || start == null || !executing.contains(target)
+            || System.nanoTime() - start < Duration.ofMillis(500).toNanos()
+            || !pgOnce.compareAndSet(false, true)) {
+          return;
+        }
+        pgStatus = PgStatus.RUNNING;
+        pgObserver = Thread.ofPlatform().daemon().name("private-c5-pg-once").unstarted(this::snapshotPg);
+        try { pgObserver.start(); } catch (Throwable failed) { pgStatus = PgStatus.FAILED; }
+      }
+    }
