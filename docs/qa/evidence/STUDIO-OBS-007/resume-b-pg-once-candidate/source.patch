+    private static int pgStage(String original) {
+      if (original == null || original.length() > 4096) return 6;
+      String sql = original.toLowerCase(java.util.Locale.ROOT).replaceAll("\\s+", " ").trim();
+      if (sql.startsWith("select state,revoked_at from studio_guided_sessions") && sql.contains("for update")) return 0;
+      if (sql.startsWith("select document::text,progress::text from studio_guided_sessions") && sql.contains("for update")) return 1;
+      if (sql.contains(" from ui_tests ") && (sql.contains("for update") || sql.contains("for no key update"))) return 2;
+      if (sql.startsWith("select m.manifest::text from studio_guided_translation_state")) return 3;
+      if (sql.startsWith("with updated as (update studio_guided_sessions")) return 4;
+      if (sql.startsWith("update studio_guided_sessions")) return 5;
+      return 6;
+    }
+
+    private static int pgWait(String type) {
+      if (type == null) return 0;
+      int index = List.of("Lock", "LWLock", "IO", "Client", "IPC", "Timeout", "Activity", "BufferPin").indexOf(type);
+      return index < 0 ? 9 : index + 1;
+    }
+
+    private static int pgEvent(String event) {
+      if (event == null) return 0;
+      int index = List.of("transactionid", "tuple", "relation", "ClientRead", "ClientWrite", "DataFileRead").indexOf(event);
+      return index < 0 ? 7 : index + 1;
+    }
