+        }
+        pgCandidates = candidates.size();
+        pgBlockers = blockers.size();
+        if (pgStatus != PgStatus.TRUNCATED && pgStatus != PgStatus.NON_QUIESCENT) {
+          pgStatus = pgCandidates > 1 ? PgStatus.AMBIGUOUS : pgCandidates == 1 ? PgStatus.OBSERVED : PgStatus.UNOBSERVED;
+        }
+      } catch (Throwable failed) {
+        if (pgStatus != PgStatus.NON_QUIESCENT) pgStatus = PgStatus.FAILED;
+        // Never retain/log raw SQL/IDs/credentials/exception.
+      } finally {
+        privatePids.clear(); candidates.clear(); blockers.clear(); settings.clear();
+      }
+    }
