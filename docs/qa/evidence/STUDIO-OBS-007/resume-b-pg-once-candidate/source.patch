+    private void snapshotPg() {
+      var privatePids = new java.util.HashSet<Integer>();
+      var candidates = new java.util.HashSet<Integer>();
+      var blockers = new java.util.HashSet<Integer>();
+      var settings = new java.util.Properties();
+      settings.setProperty("user", DB.getUsername());
+      settings.setProperty("password", DB.getPassword());
+      settings.setProperty("connectTimeout", "1");
+      settings.setProperty("socketTimeout", "1");
+      settings.setProperty("ApplicationName", "c5-private-pg-observer");
+      try (var connection = java.sql.DriverManager.getConnection(DB.getJdbcUrl(), settings)) {
+        connection.setReadOnly(true);
+        connection.setAutoCommit(false);
+        try {
+          try (var statement = connection.createStatement()) {
+            statement.setQueryTimeout(1);
+            statement.execute("SET LOCAL statement_timeout='250ms'");
+            statement.setMaxRows(64);
+            String catalog = "SELECT a.pid,a.query,a.wait_event_type,a.wait_event,b.pid AS blocker_pid,b.query AS blocker_query,"
+                + " EXISTS(SELECT 1 FROM pg_locks l WHERE l.pid=a.pid AND l.relation='studio_guided_sessions'::regclass) AS owner_relation,"
+                + " EXISTS(SELECT 1 FROM pg_locks l WHERE l.pid=a.pid AND l.relation='ui_tests'::regclass) AS source_relation"
+                + " FROM pg_stat_activity a LEFT JOIN LATERAL unnest(pg_blocking_pids(a.pid)) blocked(pid) ON true"
+                + " LEFT JOIN pg_stat_activity b ON b.pid=blocked.pid"
+                + " WHERE a.datname=current_database() AND a.backend_type='client backend'"
+                + " AND a.pid<>pg_backend_pid() AND a.state<>'idle'";
+            try (var rows = statement.executeQuery(catalog)) {
+              while (rows.next()) {
+                if (++pgRows >= 64) { pgStatus = PgStatus.TRUNCATED; break; }
+                String original = rows.getString("query"), blockerQuery = rows.getString("blocker_query");
+                if (original != null && original.length() > 4096 || blockerQuery != null && blockerQuery.length() > 4096) {
+                  pgStatus = PgStatus.TRUNCATED;
+                  break;
+                }
+                int pid = rows.getInt("pid"), stage = pgStage(original), wait = pgWait(rows.getString("wait_event_type"));
+                if (privatePids.add(pid)) {
+                  pgStagesAndWaits[stage][wait]++;
+                  pgWaitEvents[pgEvent(rows.getString("wait_event"))]++;
+                  if (stage < 6) candidates.add(pid);
+                  boolean owner = rows.getBoolean("owner_relation"), source = rows.getBoolean("source_relation");
+                  if (owner) pgRelations[0]++;
+                  if (source) pgRelations[1]++;
+                  if (!owner && !source) pgRelations[2]++;
+                }
+                int blocker = rows.getInt("blocker_pid");
+                if (!rows.wasNull() && blockers.add(blocker)) pgBlockerStages[pgStage(blockerQuery)]++;
+              }
+            }
+          }
+        } finally {
