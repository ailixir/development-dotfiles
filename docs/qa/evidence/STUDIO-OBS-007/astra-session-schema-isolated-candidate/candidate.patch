+  private Object compiledSchema(JsonSchema original) throws Exception {
+    var compile = GuidedContracts.class.getDeclaredMethod("compileSchema", String.class, JsonSchema.class);
+    compile.setAccessible(true);
+    return compile.invoke(contracts, "v3/session", original);
+  }
