+  @Test
+  void sessionValidationMatchesOriginalNativeSchemaWithoutApplyingDefaults() throws Exception {
+    ObjectNode session = fixtureSession("v3/");
+    JsonSchema original = originalSchema("v3/session");
+    org.assertj.core.api.Assertions.assertThat(originalAccepts(original, session)).isTrue();
+    Object strategy = compiledSchema(original);
+    var properties = strategy.getClass().getDeclaredMethod("properties");
+    properties.setAccessible(true);
+    org.assertj.core.api.Assertions.assertThat(((java.util.Map<?, ?>) properties.invoke(strategy)).size())
+        .isEqualTo(14);
+    List<JsonNode> cases = new ArrayList<>();
+    cases.add(session);
+    collectMutations(session, "", session, cases);
+    cases.add(contracts.parse("null"));
+    cases.add(contracts.parse("[]"));
+    cases.add(contracts.parse("1"));
+    ObjectNode malformedDate = session.deepCopy();
+    malformedDate.withObject("/owner").put("leaseExpiresAt", "not-a-date");
+    cases.add(malformedDate);
+    ObjectNode malformedUnicode = session.deepCopy();
+    malformedUnicode.put("sessionId", Character.toString((char) 0xd800));
+    cases.add(malformedUnicode);
+    ObjectNode unsafeNumber = session.deepCopy();
+    unsafeNumber.withObject("/counters").put("actions", 9007199254740992L);
+    cases.add(unsafeNumber);
+    var softly = new SoftAssertions();
+    int index = 0;
+    for (JsonNode value : cases) {
+      String before = value.toString();
+      boolean expected = originalAccepts(original, value);
+      boolean accepted;
+      try {
+        String canonical = contracts.validateAndCanonical("v3/session", value);
+        softly.assertThat(canonical.equals(GuidedContracts.canonical(value))).isTrue();
+        accepted = true;
+      } catch (GuidedSessionException refusal) {
+        softly.assertThat(refusal.getMessage()).isEqualTo("INVALID_CONTRACT");
+        softly.assertThat(refusal.status()).isEqualTo(422);
+        accepted = false;
+      }
+      softly.assertThat(accepted).as("mutation %s", index++).isEqualTo(expected);
+      softly.assertThat(before.equals(value.toString())).as("input unchanged").isTrue();
+    }
+    softly.assertAll();
+  }
