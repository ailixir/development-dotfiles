{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/runner-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownerFence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "versions": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "approvedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 10
    },
    "sourceStepIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "authoredInputs": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/authored-inputs.schema.json"
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "materializationRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "allocations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/allocation.schema.json"
      }
    },
    "producers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/producer.schema.json"
      }
    },
    "consumerEdges": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/consumer-edge.schema.json"
      }
    },
    "limits": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/limits.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "workerId",
    "ownerFence",
    "scopeHash",
    "contextId",
    "contextRevision",
    "sourceRevision",
    "configurationRevision",
    "versions",
    "expiresAt",
    "leaseExpiresAt",
    "approvedOrigins",
    "sourceStepIds",
    "authoredInputs",
    "authoredInputsHash",
    "materializationRevision",
    "allocations",
    "producers",
    "consumerEdges",
    "limits"
  ]
}
