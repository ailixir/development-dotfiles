   /** Private capture of actual existing sinks; usable around the required C4 sub-runs too. */
+  private static final class C5ClaimSampler implements AutoCloseable {
+    private enum Segment { OWNER_LOCK, JDBC_PATH, CURRENT_AUTH, SOURCE_CHECK, SCHEMA,
+      JSON_RENDER, LOG_ENCODER, COMMIT, OTHER }
+    private enum Status { OFF, UNOBSERVED, OBSERVED, FAILED, NON_QUIESCENT }
+    private static final int MAX_THREADS = 8;
+    private final Object gate = new Object();
+    private final java.util.Set<Thread> executing = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+    private final long[][] counts = new long[Segment.values().length][Thread.State.values().length];
+    private volatile boolean stopping;
+    private volatile Status status = Status.OFF;
+    private long empty, unattributed, cycles;
+    private final Thread sampler;
+    private final long end;
+
+    C5ClaimSampler(boolean selected) {
+      if (!selected) { sampler = null; end = 0; return; }
+      status = Status.UNOBSERVED;
+      end = System.nanoTime() + java.time.Duration.ofSeconds(30).toNanos();
+      sampler = Thread.ofPlatform().daemon().name("private-c5-claim-sampler").unstarted(this::sample);
+      try { sampler.start(); } catch (Throwable unavailable) { status = Status.FAILED; }
+    }
+    void enterCurrent() {
+      if (sampler == null || stopping || System.nanoTime() >= end) return;
+      try {
+        synchronized (gate) {
+          if (stopping) return;
+          if (executing.size() >= MAX_THREADS) { status = Status.FAILED; return; }
+          executing.add(Thread.currentThread()); // Only original selected filter's executing thread.
+        }
+      } catch (Throwable unsupported) { status = Status.FAILED; }
+    }
+    void leaveCurrent() {
+      try { synchronized (gate) { executing.remove(Thread.currentThread()); } }
+      catch (Throwable unsupported) { status = Status.FAILED; }
+    }
+
+    private void sample() {
+      try {
+        while (!stopping && System.nanoTime() < end) {
+          Thread[] snapshot;
+          synchronized (gate) { snapshot = executing.toArray(Thread[]::new); }
+          try {
+            for (Thread target : snapshot) {
+              if (stopping || System.nanoTime() >= end) break;
+              StackTraceElement[] stack = target.getStackTrace();
+              try {
+                Thread.State state = target.getState(); // Observed state; not atomic with stack.
+                if (stack.length == 0 || stack.length > 512) { empty++; continue; }
+                Segment segment = classify(stack);
+                if (segment == Segment.OTHER) unattributed++;
+                counts[segment.ordinal()][state.ordinal()]++;
+                if (segment != Segment.OTHER && status != Status.FAILED
+                    && status != Status.NON_QUIESCENT) status = Status.OBSERVED;
+              } finally { java.util.Arrays.fill(stack, null); }
+            }
+          } finally { java.util.Arrays.fill(snapshot, null); }
+          cycles++;
+          Thread.sleep(20); // Diagnostic cadence only; no authority poll/action changed.
+        }
+      } catch (InterruptedException stopped) {
+        Thread.currentThread().interrupt();
+      } catch (Throwable unsupported) {
+        status = Status.FAILED; // No exception/message/raw stack retained or emitted.
+      } finally { synchronized (gate) { executing.clear(); } }
+    }
+
+    private static Segment classify(StackTraceElement[] stack) {
+      boolean claim = java.util.Arrays.stream(stack).anyMatch(frame -> frame.getClassName().equals(
+          "com.citi.put.checks.studio.guided.session.GuidedSessionService")
+          && (frame.getMethodName().equals("claim") || frame.getMethodName().startsWith("lambda$claim$")));
+      if (!claim) return Segment.OTHER;
+      // Fixed source categories only; no arbitrary class/method/file/line/name/ID export.
+      for (StackTraceElement frame : stack) {
+        String type = frame.getClassName(), method = frame.getMethodName();
+        if (type.startsWith("ch.qos.logback.") || type.startsWith("net.logstash.logback.")) return Segment.LOG_ENCODER;
+        if (type.startsWith("com.networknt.") || type.endsWith("GuidedContracts")) return Segment.SCHEMA;
+        if (type.startsWith("com.fasterxml.jackson.")) return Segment.JSON_RENDER;
+        if (type.startsWith("org.postgresql.") || type.startsWith("org.springframework.jdbc.")) return Segment.JDBC_PATH;
+        if (type.endsWith("GuidedSessionRepository") && method.equals("lock")) return Segment.OWNER_LOCK;
