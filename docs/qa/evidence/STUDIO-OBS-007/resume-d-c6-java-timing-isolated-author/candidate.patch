+  private static final class P8PendingTiming {
+    private static final String[] POINTS = {"WaitBegin", "WaitExit", "NativeEntryIngress",
+        "FocusAccepted", "Probe1WriteComplete", "PendingIngress", "PendingAccepted", "NativeSettleIngress"};
+    final long origin = System.nanoTime();
+    final long[] times = new long[8];
+    final boolean[] observed = new boolean[8];
+    boolean selected, waitResultObserved, waitResult, nativeEntryAccepted, nativeSettleAccepted;
+    int nativeOrdinal, refusalOrdinal;
+    boolean refusalScopeKnown, diagnosticFailed;
+    long refusalNanos;
+    boolean provisionalFocusLossObserved;
+    ObjectNode early;
+
+    synchronized void mark(int point) {
+      if (!observed[point]) { observed[point] = true; times[point] = System.nanoTime() - origin; }
+    }
+
+    synchronized void nativeNotice(boolean entry, int ordinal, boolean accepted) {
+      if (entry && !observed[2]) { nativeOrdinal = ordinal; mark(2); }
+      if (ordinal != nativeOrdinal || !observed[2]) { return; }
+      if (entry) { nativeEntryAccepted |= accepted; }
+      else { mark(7); nativeSettleAccepted |= accepted; }
+    }
+
+    synchronized void refuse(int site, boolean scopeKnown) {
+      if (refusalOrdinal == 0) { refusalOrdinal = site; refusalNanos = System.nanoTime() - origin;
+        refusalScopeKnown = scopeKnown; }
+    }
+
+    synchronized void waitExit(boolean returned, boolean result) {
+      mark(1); waitResultObserved = returned; waitResult = returned && result;
+      early = snapshot(); // Memory only before the original assertion/exception exits.
+    }
+
+    synchronized ObjectNode snapshot() {
+      ObjectNode out = C.object().put("diagSelectedStateObserved", selected)
+          .put("diagSameJavaMonotonicClock", true).put("diagIngressNotNativeApiClock", true)
+          .put("diagWaitResultObserved", waitResultObserved).put("diagWaitResult", waitResult)
+          .put("diagNativeOrdinalObserved", observed[2]).put("diagNativeOrdinal", nativeOrdinal)
+          .put("diagNativeEntryAccepted", nativeEntryAccepted).put("diagNativeSettleAccepted", nativeSettleAccepted)
+          .put("diagFirstRefusalObserved", refusalOrdinal != 0).put("diagFirstRefusalOrdinal", refusalOrdinal)
+          .put("diagFirstRefusalElapsedNanos", refusalNanos).put("diagFirstRefusalScopeKnown", refusalScopeKnown)
+          .put("diagProvisionalFocusLossObserved", provisionalFocusLossObserved)
+          .put("diagObservationFailed", diagnosticFailed);
+      for (int i = 0; i < POINTS.length; i++) {
+        out.put("diag" + POINTS[i] + "Observed", observed[i]);
+        out.put("diag" + POINTS[i] + "ElapsedNanos", times[i]);
+      }
+      return out;
+    }
+  }
