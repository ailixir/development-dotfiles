+  private static final class ConsoleRoute {
+    final ch.qos.logback.core.ConsoleAppender<?> appender;
+    final java.io.OutputStream stream;
+    final ch.qos.logback.core.encoder.Encoder<?> encoder;
+    final String target;
+    final boolean started, flush;
+    final List<?> filters;
+    final QuarantineBytes quarantine = new QuarantineBytes();
+
+    ConsoleRoute(ch.qos.logback.core.ConsoleAppender<?> original) {
+      appender = original;
+      stream = original.getOutputStream();
+      encoder = original.getEncoder();
+      target = original.getTarget();
+      started = original.isStarted();
+      flush = original.isImmediateFlush();
+      filters = List.copyOf(original.getCopyOfAttachedFiltersList());
+    }
