+    void validate(boolean installed) {
+      if (appender.getClass() != ch.qos.logback.core.ConsoleAppender.class
+          || appender.isWithJansi() || !started || !appender.isStarted()
+          || !flush || appender.isImmediateFlush() != flush
+          || encoder == null || encoder.getClass() != net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder.class
+          || !encoder.isStarted() || appender.getEncoder() != encoder
+          || !target.equals(appender.getTarget()) || !filters.isEmpty()
+          || !filters.equals(appender.getCopyOfAttachedFiltersList())
+          || appender.getOutputStream() != (installed ? quarantine : stream)
+          || encoder.headerBytes().length != 0 || encoder.footerBytes().length != 0) {
+        FaultCapture.fail();
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, FaultCapture.FAILURES.get());
+      }
+      var consoleTarget = "System.out".equals(target) ? ch.qos.logback.core.joran.spi.ConsoleTarget.SystemOut
+          : "System.err".equals(target) ? ch.qos.logback.core.joran.spi.ConsoleTarget.SystemErr : null;
+      if (consoleTarget == null || consoleTarget.getStream() != stream) {
+        FaultCapture.fail();
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, FaultCapture.FAILURES.get());
