+        FaultCapture.fail();
+        throw closedFault(FaultCode.PREREQUISITE, ordinal, 0, FaultCapture.FAILURES.get());
+      }
+      if (!FaultCapture.reserve(actual.length * 2)) {
+        FaultCapture.fail();
+        throw closedFault(FaultCode.INCOMPLETE, ordinal, 0, FaultCapture.FAILURES.get());
+      }
+      releases.add(actual.clone());
+      callers.add(caller);
+    }
