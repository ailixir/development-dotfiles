+    private void artifact(Class<?> loaded, String expected) throws Exception {
+      var location = loaded.getProtectionDomain().getCodeSource().getLocation().toURI();
+      byte[] bytes = Files.readAllBytes(Path.of(location));
+      byte[] digest = java.security.MessageDigest.getInstance("SHA-256").digest(bytes);
+      try {
+        if (!java.util.HexFormat.of().formatHex(digest).equals(expected)) {
+          throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+        }
+      } finally { Arrays.fill(bytes, (byte) 0); Arrays.fill(digest, (byte) 0); }
+    }
+
+    private List<ch.qos.logback.core.Appender<ch.qos.logback.classic.spi.ILoggingEvent>> attached(
+        ch.qos.logback.classic.Logger logger) {
+      var originals = new java.util.ArrayList<ch.qos.logback.core.Appender<ch.qos.logback.classic.spi.ILoggingEvent>>();
+      var iterator = logger.iteratorForAppenders();
+      while (iterator.hasNext()) {
+        var next = iterator.next();
+        if (next != raw) { originals.add(next); }
+      }
+      return originals;
+    }
+
+    private void register(ch.qos.logback.classic.Logger logger, boolean newlyExisting) {
+      if ((!logger.isAdditive() && !logger.getName().equals(org.slf4j.Logger.ROOT_LOGGER_NAME))
+          || (newlyExisting && logger.getLevel() != null)) {
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+      }
+      var attached = attached(logger);
+      if (newlyExisting && !attached.isEmpty()) {
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+      }
+      for (var appender : attached) {
+        if (!(appender instanceof ch.qos.logback.core.ConsoleAppender<?> console)) {
+          throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+        }
+        var route = consoles.computeIfAbsent(appender, unused -> new ConsoleRoute(console));
+        route.validate(initialized);
+        attachmentMultiplicity++;
