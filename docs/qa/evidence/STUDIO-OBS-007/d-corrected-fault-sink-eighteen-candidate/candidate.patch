+  private static final class LogQuarantine {
+    final ch.qos.logback.classic.LoggerContext context;
+    final Map<ch.qos.logback.core.Appender<?>, ConsoleRoute> consoles = new java.util.IdentityHashMap<>();
+    final Map<ch.qos.logback.classic.Logger, LoggerRoute> routes = new java.util.IdentityHashMap<>();
+    final RawEvents raw = new RawEvents();
