+  /** The original encoder writes here once; close is intentionally a no-op for public stream swap. */
+  private static final class QuarantineBytes extends java.io.OutputStream {
+    private byte[] bytes;
+    QuarantineBytes() {
+      int allocation = 4 * 1024 * 1024;
+      if (!FaultCapture.reserve(allocation)) {
+        FaultCapture.fail();
+        bytes = new byte[0];
+      } else { bytes = new byte[allocation]; }
+    }
+    private int size;
+    @Override public synchronized void write(int value) { write(new byte[] {(byte) value}, 0, 1); }
+    @Override public synchronized void write(byte[] value, int offset, int length) {
+      if (length > bytes.length - size) { FaultCapture.fail(); return; }
+      System.arraycopy(value, offset, bytes, size, length);
+      size += length;
+    }
+    @Override public void close() { /* Remains owned through restoration scan and explicit wipe. */ }
+    synchronized byte[] copy() { return Arrays.copyOf(bytes, size); }
+    synchronized int size() { return size; }
+    synchronized void wipe() { Arrays.fill(bytes, (byte) 0); size = 0; }
+  }
