+  /** Finite equality variants; no claim for arbitrary transforms, compression or opaque fields. */
+  private static final class FaultScanner {
+    static List<byte[]> variants(char[] actual) {
+      String value = new String(actual);
+      var variants = new java.util.ArrayList<byte[]>();
+      variants.add(value.getBytes(StandardCharsets.UTF_8));
+      variants.add(value.getBytes(StandardCharsets.UTF_16LE));
+      variants.add(value.getBytes(StandardCharsets.UTF_16BE));
+      byte[] utf8 = value.getBytes(StandardCharsets.UTF_8);
+      variants.add(Base64.getEncoder().encode(utf8));
+      variants.add(java.util.HexFormat.of().formatHex(utf8).getBytes(StandardCharsets.US_ASCII));
+      variants.add(java.util.HexFormat.of().withUpperCase().formatHex(utf8).getBytes(StandardCharsets.US_ASCII));
+      StringBuilder unicode = new StringBuilder(), json = new StringBuilder(), percent = new StringBuilder();
+      for (char unit : actual) {
+        unicode.append(String.format(java.util.Locale.ROOT, "\\u%04x", (int) unit));
+        switch (unit) {
+          case '"' -> json.append("\\\"");
+          case '\\' -> json.append("\\\\");
+          case '\b' -> json.append("\\b");
+          case '\f' -> json.append("\\f");
+          case '\n' -> json.append("\\n");
+          case '\r' -> json.append("\\r");
+          case '\t' -> json.append("\\t");
+          default -> {
+            if (unit < 32) { json.append(String.format(java.util.Locale.ROOT, "\\u%04x", (int) unit)); }
+            else { json.append(unit); }
+          }
+        }
+      }
+      for (byte octet : utf8) { percent.append(String.format(java.util.Locale.ROOT, "%%%02X", octet & 255)); }
+      variants.add(unicode.toString().getBytes(StandardCharsets.US_ASCII));
+      variants.add(unicode.toString().toUpperCase(java.util.Locale.ROOT).replace("\\U", "\\u").getBytes(StandardCharsets.US_ASCII));
+      variants.add(json.toString().getBytes(StandardCharsets.UTF_8));
+      variants.add(percent.toString().getBytes(StandardCharsets.US_ASCII));
+      variants.add(percent.toString().toLowerCase(java.util.Locale.ROOT).getBytes(StandardCharsets.US_ASCII));
+      String form = java.net.URLEncoder.encode(value, StandardCharsets.UTF_8);
+      variants.add(form.getBytes(StandardCharsets.US_ASCII));
+      variants.add(form.replace("+", "%20").getBytes(StandardCharsets.US_ASCII));
+      Arrays.fill(utf8, (byte) 0);
+      return variants;
+    }
+
+    static boolean containsAny(byte[] actual, List<byte[]> needles) {
+      for (byte[] needle : needles) {
+        if (needle.length == 0 || needle.length > actual.length) { continue; }
+        for (int start = 0; start <= actual.length - needle.length; start++) {
+          boolean equal = true;
+          for (int index = 0; index < needle.length; index++) {
+            if (actual[start + index] != needle[index]) { equal = false; break; }
+          }
+          if (equal) { return true; }
+        }
+      }
+      return false;
+    }
+  }
