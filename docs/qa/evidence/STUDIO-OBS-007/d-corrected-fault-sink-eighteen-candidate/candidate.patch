+    LogQuarantine() {
+      Object factory = org.slf4j.LoggerFactory.getILoggerFactory();
+      if (!(factory instanceof ch.qos.logback.classic.LoggerContext actual)) {
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+      }
+      context = actual;
+      contextListeners = List.copyOf(context.getCopyOfListenerList());
+    }
+
+    void install() throws Exception {
+      artifact(ch.qos.logback.core.ConsoleAppender.class,
+          "e0f242aa3c4411ce8c7ec304a5afeaa75224680890f5f813153ef807cbb9542e");
+      artifact(ch.qos.logback.classic.LoggerContext.class,
+          "e223cce321ccb435d23e1dadfc6ceeccd862e2dabb1a2a5675318426f7fa1978");
+      artifact(org.slf4j.LoggerFactory.class,
+          "a12578dde1ba00bd9b816d388a0b879928d00bab3c83c240f7013bf4196c579a");
+      artifact(net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder.class,
+          "81fcbde1b5a7d673d6c0d0d4f1e0f79b676f948e6b92b912e9e0b75097458bd3");
+      if (!context.getTurboFilterList().isEmpty()
+          || !context.getStatusManager().getCopyOfStatusListenerList().isEmpty()) {
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+      }
+      context.getLogger(org.slf4j.Logger.ROOT_LOGGER_NAME);
+      context.getLogger("com.citi.put.checks");
+      if (context.getLoggerList().size() > 512) {
+        throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1);
+      }
+      for (var logger : context.getLoggerList()) { register(logger, false); }
+      if (consoles.isEmpty()) { throw closedFault(FaultCode.PREREQUISITE, 0, 0, 1); }
+      for (ConsoleRoute route : consoles.values()) {
+        route.validate(false);
+        route.appender.setOutputStream(route.quarantine); // One public swap, original encoder stays active.
+        route.validate(true);
+      }
+      raw.setContext(context);
+      raw.setName("FAULT_CAPTURE_RAW");
+      raw.start();
+      for (LoggerRoute route : routes.values()) { route.logger.addAppender(raw); }
+      context.getLogger(org.slf4j.Logger.ROOT_LOGGER_NAME).setLevel(ch.qos.logback.classic.Level.TRACE);
+      context.getLogger("com.citi.put.checks").setLevel(ch.qos.logback.classic.Level.TRACE);
+      statusCount = 0;
+      inspectStatus();
+      initialized = true;
+    }
