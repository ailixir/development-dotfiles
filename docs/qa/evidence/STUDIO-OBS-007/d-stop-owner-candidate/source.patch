+  private static void terminateOwnedContextBeforePostgres() {
+    for (SourceStopOwner owner : STOP_OWNERS) {
+      owner.drainUninterruptibly();
+    }
+    ConfigurableApplicationContext context = ownedContext;
+    assertThat(context).as("this class's actual Spring context was captured").isNotNull();
+    var executors = new java.util.LinkedHashSet<ExecutorService>();
+    var schedulers = context.getBeansOfType(org.springframework.scheduling.TaskScheduler.class, false, false);
+    assertThat(schedulers).as("actual class-owned scheduler is available for termination proof").isNotEmpty();
+    assertThat(schedulers.values()).allMatch(
+        scheduler -> scheduler instanceof org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler);
+    for (var scheduler : context.getBeansOfType(
+        org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler.class, false, false).values()) {
+      scheduler.setWaitForTasksToCompleteOnShutdown(false);
+      scheduler.setAwaitTerminationSeconds(5);
+      executors.add(scheduler.getScheduledExecutor());
+    }
+    for (var executor : context.getBeansOfType(
+        org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor.class, false, false).values()) {
+      executor.setWaitForTasksToCompleteOnShutdown(false);
+      executor.setAwaitTerminationSeconds(5);
+      executors.add(executor.getThreadPoolExecutor());
