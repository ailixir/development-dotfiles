+      this.key = key;
+      this.attempt = attempt;
+      this.kind = kind;
+      this.outputCap = outputCap;
+      this.request = request;
+      this.wireBytes = wireBytes;
+      this.failureCode = failureCode;
+      this.failureStatus = failureStatus;
