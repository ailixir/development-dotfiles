+  /** Controlled protocol evidence derived before immutable publication; never a native typing claim. */
+  private static com.fasterxml.jackson.databind.node.ObjectNode secretReportBasis() {
+    var basis = (com.fasterxml.jackson.databind.node.ObjectNode) observedFixtureDocument().path("basis").deepCopy();
+    var inputs = (com.fasterxml.jackson.databind.node.ArrayNode) basis.path("inputs");
+    String inputId = "input-config";
+    String stepId = null;
+    for (var input : inputs) {
+      if (!input.path("inputId").asText().equals(inputId)) { continue; }
+      var selected = (com.fasterxml.jackson.databind.node.ObjectNode) input;
+      selected.put("kind", "secretRef").remove("value");
+      ((com.fasterxml.jackson.databind.node.ObjectNode) selected.path("provenance")).put("kind", "secretRef");
+      stepId = selected.path("stepId").asText();
+    }
+    assertThat(stepId).isNotNull();
+    for (var source : basis.path("sourceSteps")) {
+      if (source.path("stepId").asText().equals(stepId)) {
+        ((com.fasterxml.jackson.databind.node.ObjectNode) source).put("source",
+            source.path("source").asText() + " Enter <secret PASS> as password.");
+      }
+    }
+    for (var reference : basis.path("configurationReferences")) {
+      if (reference.path("inputId").asText().equals(inputId)) {
+        ((com.fasterxml.jackson.databind.node.ObjectNode) reference).put("kind", "secretRef").put("referenceName", "PASS");
+      }
+    }
+    for (var preparation : basis.path("preparations")) {
+      var proposal = (com.fasterxml.jackson.databind.node.ObjectNode) preparation.path("proposal");
+      if (!proposal.path("operation").path("value").path("sourceInputId").asText().equals(inputId)) { continue; }
+      ((com.fasterxml.jackson.databind.node.ObjectNode) proposal.path("operation").path("value")).put("kind", "secretRef");
+      var target = proposal.putObject("target").put("kind", "passwordControl");
+      target.set("documentId", proposal.path("executionEvidence").path("documentId"));
+      target.set("generation", proposal.path("executionEvidence").path("generation"));
+      String operationHash = com.citi.put.checks.studio.guided.session.GuidedContracts.hash(proposal.path("operation"));
+      for (var action : basis.path("actions")) {
+        if (action.path("preparationId").equals(preparation.path("preparationId"))) {
+          ((com.fasterxml.jackson.databind.node.ObjectNode) action.path("ledger")).put("operationHash", operationHash);
+        }
+      }
+    }
+    return basis;
+  }
