+  private RunnerReport observedReport(
+      com.citi.put.checks.studio.guided.publication.GuidedSecretLoginMigrationTest.RetryFixture fixture,
+      String kind, long sequence, Map<String, String> usage) {
+    var binding = fixture.original();
+    UUID admission = jdbc.queryForObject("SELECT admission_id FROM studio_dispatch_ledger WHERE execution_id=?", UUID.class, fixture.id());
+    var versions = Map.<String, Object>of("observedProfile", binding.path("requiredProfile").toString(),
+        "observedBuild", binding.path("requiredBuild").toString());
+    return new RunnerReport(fixture.id(), UUID.fromString(binding.path("attemptId").asText()), admission, RUNNER,
+        kind, sequence, Instant.now(), Instant.parse(binding.path("startedAt").asText()),
+        RunnerReport.STARTED.equals(kind) ? List.of() : List.of(new RunnerStepState(2, "PASS", 0.25, 10.75, 10.5, null)),
+        List.of(), false, versions, null, null, false, usage);
+  }
