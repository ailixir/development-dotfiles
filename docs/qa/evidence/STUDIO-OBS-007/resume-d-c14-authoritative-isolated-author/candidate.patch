+  private ObjectNode p14CompletedAction(List<Map<String, Object>> rows, String step, int ordinal,
+      String operation) {
+    ObjectNode selected = null;
+    for (var row : rows) {
+      JsonNode ledger = C.parse((String) row.get("ledger")), proposal = C.parse((String) row.get("proposal"));
+      if (ledger.path("coordinate").path("stepId").asText().equals(step)
+          && ledger.path("coordinate").path("ordinal").asInt(-1) == ordinal) {
+        assertThat(selected == null).as("unique actual authored-coordinate action").isTrue();
+        assertThat(proposal.path("operation").path("kind").asText().equals(operation)).isTrue();
+        selected = C.object(); selected.set("ledger", ledger); selected.set("proposal", proposal);
+      }
+    }
+    assertThat(selected != null).as("actual completed action at original authored coordinate").isTrue();
+    return selected;
