+    String id =
+        sessions
+            .start(
+                user,
+                UUID.randomUUID().toString(),
+                C.object()
+                    .put("schemaVersion", 3)
+                    .put("testId", scenario.testId.toString())
+                    .put("sourceRevision", "source-1")
