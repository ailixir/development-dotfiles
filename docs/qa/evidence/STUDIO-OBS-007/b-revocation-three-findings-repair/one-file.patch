+              || sample.path("producer").asInt(-1) != producer || sample.path("epoch").asInt(-1) != state.ordinal
+              || sample.path("role").asInt(-1) != producer || !sample.path("failed").isBoolean()
+              || !sample.path("sealed").isBoolean()) {
+            throw new IOException("Private producer sample identity failed");
