+  private void p6WaitOriginalDeadline(P6ChildCut cut) throws Exception {
+    Instant deadline = ((java.sql.Timestamp) p6Owner(cut.execution).get("run_deadline_at")).toInstant();
+    long remaining = Duration.between(Instant.now(), deadline).toMillis();
+    assertThat(remaining).as("original accepted run deadline within case budget")
