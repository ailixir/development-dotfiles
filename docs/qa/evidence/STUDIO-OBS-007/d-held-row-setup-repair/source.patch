+  /** Actual authenticated controlled-relay assignment termination; no physical worker/browser claim. */
+  private static void acceptHeldRowAssignmentStop(HttpsExchange exchange, Scenario scenario,
+      JsonNode body, String id) throws IOException {
+    require(scenario.heldRowSetupCase && scenario.sessionId.equals(id), "FORBIDDEN_SCOPE", 403);
+    require(exchange.getRequestURI().getPath().equals(
+        "/internal/v2/studio/guided-sessions/" + id + "/stop")
+        && exchange.getRequestURI().getRawQuery() == null, "INVALID_CONTRACT", 422);
+    var fields = new java.util.HashSet<String>();
+    body.fieldNames().forEachRemaining(fields::add);
+    require(fields.equals(java.util.Set.of("schemaVersion", "kind", "assignment", "reason"))
+        && body.path("schemaVersion").isIntegralNumber() && body.path("schemaVersion").asInt() == 3
+        && body.path("kind").asText().equals("assignment")
+        && java.util.Set.of("CANCELLED", "EXPIRED", "REVOKED", "UNKNOWN_OUTCOME")
+            .contains(body.path("reason").asText()), "INVALID_CONTRACT", 422);
+    C.validate("v3/assignment", body.path("assignment"));
+    ObjectNode actualIntent = new GuidedAssignmentStore(actualJdbc, C).find(id);
+    require(actualIntent != null && actualIntent.equals(body.path("assignment")), "FORBIDDEN_SCOPE", 403);
+    JsonNode actualOwner = C.parse(actualJdbc.queryForObject(
+        "SELECT document->'owner' FROM studio_guided_sessions WHERE session_id=?",
+        String.class, id));
+    require(actualOwner.isObject() && actualOwner.path("workerId").isTextual()
+        && actualOwner.path("fence").isIntegralNumber(), "INVALID_CONTRACT", 422);
+    long baseFence = actualIntent.path("expectedFence").asLong();
+    var receipt = C.object().put("schemaVersion", 3).put("status", "STOPPED");
+    receipt.set("assignment", actualIntent);
+    if (actualOwner.path("workerId").asText().equals("unclaimed")
+        && actualOwner.path("fence").asLong() == baseFence) {
+      receipt.putNull("ownerFence").putNull("leaseExpiresAt");
+    } else {
+      require(actualOwner.path("workerId").equals(actualIntent.path("workerId"))
+          && actualOwner.path("fence").asLong() == baseFence + 1
+          && actualOwner.path("leaseExpiresAt").isTextual(), "STALE_FENCE", 409);
+      require(!Instant.parse(actualOwner.path("leaseExpiresAt").asText())
+          .isAfter(Instant.parse(actualIntent.path("expiresAt").asText())), "STALE_FENCE", 409);
+      receipt.set("ownerFence", actualOwner.path("fence"));
+      receipt.set("leaseExpiresAt", actualOwner.path("leaseExpiresAt"));
