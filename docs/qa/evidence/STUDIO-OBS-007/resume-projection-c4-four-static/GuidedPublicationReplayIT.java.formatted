    long flippedAt, cutoffAt, ackBracketMicros;

    P4RevocationState(int ordinal, int path, UUID test, JdbcTemplate actualJdbc) {
      this.ordinal = ordinal;
      this.path = path;
      this.test = test;
      this.actualJdbc = actualJdbc;
    }
  }

  private static volatile int p4PasswordControls = -1;
  private static volatile boolean p4AdversarialPasswordSelection;
  private static final java.util.concurrent.atomic.AtomicBoolean P4_WITNESS_FAILED =
