  @TestConfiguration
  static class RuntimeHooks {
    @Bean
    @org.springframework.context.annotation.Primary
    GuidedSessionRepository observedOriginalSessionRepository(
        JdbcTemplate jdbc,
        GuidedContracts contracts,
        org.springframework.transaction.PlatformTransactionManager manager) {
      var transactions =
          new org.springframework.transaction.support.TransactionTemplate(manager) {
            @Override
            public <T> T execute(
                org.springframework.transaction.support.TransactionCallback<T> callback) {
              try {
                return super.execute(callback);
              } catch (GuidedSessionException original) {
                if (p4AdversarialPasswordSelection && P4_FIRST_GUIDED_REQUEST.get() != null) {
                  try {
                    int line = -1;
                    for (StackTraceElement frame : original.getStackTrace()) {
                      if (frame
                              .getClassName()
                              .equals(
                                  "com.citi.put.checks.studio.guided.translation.GuidedProposalValidator")
                          && frame.getMethodName().equals("action")) {
                        line = frame.getLineNumber();
                        break;
                      }
                    }
                    boolean policyDenied = original.getMessage().equals("POLICY_DENIED");
                    P4_FIRST_GUARD.compareAndSet(
                        null,
                        C.object()
                            .put("policyDenied", policyDenied)
                            .put("status", original.status())
                            .put("validatorLine", line)
                            .put(
                                "validatorCountPredicate",
                                line == 363 && policyDenied && original.status() == 422)
                            .put(
                                "actualCallbackRollbackObserved",
                                !org.springframework.transaction.support
                                    .TransactionSynchronizationManager.isActualTransactionActive())
                            .put("phaseOrdinal", 1)
                            .put(
                                "passwordCount",
                                P4_FIRST_GUIDED_REQUEST.get().path("passwordCount").asInt(-1)));
                  } catch (RuntimeException | AssertionError observerFailure) {
                    P4_WITNESS_FAILED.set(true);
                  }
                }
                throw original;
              }
            }
          };
      assertThat(transactions.getTransactionManager()).isSameAs(manager);
      return new GuidedSessionRepository(jdbc, transactions, contracts);
    }

    @Bean
    static org.springframework.beans.factory.config.BeanPostProcessor ownedSchedulerTaskTracking() {
      return new org.springframework.beans.factory.config.BeanPostProcessor() {
        @Override
        public Object postProcessBeforeInitialization(Object bean, String name) {
          if (bean
              instanceof
              org.springframework.scheduling.concurrent.SimpleAsyncTaskScheduler scheduler) {
            scheduler.setTaskTerminationTimeout(60000);
          }
          return bean;
        }
      };
    }

    @Bean
    @org.springframework.context.annotation.Primary
    GuidedLlmGatewayClient actualCommittedModelBudgetDiagnostics(
        @Qualifier("guidedLlmGatewayClient") GuidedLlmGatewayClient actual, JdbcTemplate jdbc) {
      return (request, budget) -> {
        try {
          COMMITTED_MODEL_BUDGET_WITNESSES.add(committedModelBudgetWitness(jdbc, request));
        } catch (RuntimeException failure) {
          // Diagnostic failure must not replace the actual gateway result or skip its call.
          MODEL_BUDGET_WITNESS_FAILURES.incrementAndGet();
        }
        return actual.propose(request, budget);
      };
    }

    @Bean
    WebMvcConfigurer safeFinalizeDiagnostics(
        ObservedReplayProperties replay,
        GuidedPublicationProperties publication,
        ObservedReplayPins pins) {
      return new WebMvcConfigurer() {
        @Override
        public void extendHandlerExceptionResolvers(List<HandlerExceptionResolver> resolvers) {
          resolvers.add(
              0,
              (request, response, handler, failure) -> {
                String path = request.getRequestURI();
                boolean finalize =
                    path.startsWith("/api/v3/studio/guided-sessions/")
                        && path.endsWith("/finalize");
                boolean planning =
                    path.startsWith("/internal/v2/studio/guided-sessions/")
                        && List.of("plans", "dependency-admissions", "proposals")
                            .contains(path.substring(path.lastIndexOf('/') + 1));
                if ((finalize || planning) && failure instanceof GuidedSessionException guarded) {
                  persistFinalizeDiagnostic(guarded, replay, publication, pins);
                }
                // Observe metadata only; the existing production resolver still decides the
                // response.
                return null;
              });
        }
      };
    }

    @Bean
    @org.springframework.context.annotation.Primary
    RunnerDispatchClient actualDispatchDiagnostics(HttpRunnerDispatchClient actual) {
      return new RunnerDispatchClient() {
        @Override
        public DispatchOutcome send(RunJob job) {
          UUID id = job.executionId();
          try {
            DispatchOutcome result = actual.send(job);
            ACTUAL_DISPATCH_DIAGNOSTICS.compute(
                id,
                (key, prior) -> {
                  ObjectNode metadata = prior == null ? C.object() : prior.deepCopy();
                  metadata.set("sendOutcome", safeDispatchOutcome(result));
                  return metadata;
                });
            return result;
          } catch (RuntimeException failure) {
            ACTUAL_DISPATCH_DIAGNOSTICS.compute(
                id,
                (key, prior) -> {
                  ObjectNode metadata = prior == null ? C.object() : prior.deepCopy();
                  metadata.set("sendException", safeProbeFailure(failure));
                  return metadata;
                });
            throw failure;
          }
        }

        @Override
        public CancelOutcome cancel(UUID executionId) {
          CancelOutcome result = actual.cancel(executionId);
          ACTUAL_DISPATCH_DIAGNOSTICS.compute(
              executionId,
              (key, prior) -> {
                ObjectNode metadata = prior == null ? C.object() : prior.deepCopy();
                metadata.put("cancelOutcome", result.name());
                return metadata;
              });
          return result;
        }
      };
    }

    @Bean
    @org.springframework.context.annotation.Primary
    com.citi.put.checks.studio.secrets.StudioVaultProvider countedLoginVault() {
      return COUNTED_VAULT;
    }

    @Bean
    @org.springframework.context.annotation.Primary
    com.citi.put.checks.studio.secrets.StudioSecretUseAuthorization controlledLoginEntitlement() {
      return (principal, csi, environment, name) -> {
        P3_MAY_USE.add(new P3Entitlement(principal, csi, environment, name));
        return java.util.Set.of("fixture@example.invalid", "user-1").contains(principal)
                && csi.equals("CSI-123")
                && environment.equals("fixture")
                && name.equals("PASS")
            || p3Entitled(principal, csi, environment, name);
      };
    }

    @Bean
    com.citi.put.checks.studio.internal.ProgressReportService.ReportCommitHook
        observedCommitFault() {
      return id -> {
        if (id.equals(preReadyId) && FAIL_TERMINAL_COMMIT.compareAndSet(true, false)) {
          TERMINAL_ROLLBACKS.incrementAndGet();
          throw new IllegalStateException("Controlled observed terminal commit rollback");
        }
      };
    }

    @Bean
    org.springframework.boot.web.servlet.FilterRegistrationBean<jakarta.servlet.Filter>
        observedReportCapture() {
      jakarta.servlet.Filter filter =
          (request, response, chain) -> {
            var http = (jakarta.servlet.http.HttpServletRequest) request;
            C5Capture activeC5 = c5Capture;
            if (activeC5 != null
                && (activeC5.selectedLifecycle(http) || activeC5.selectedClaim(http))) {
              var wrapped =
                  new org.springframework.web.util.ContentCachingRequestWrapper(http, 262144);
              boolean claim = activeC5.selectedClaim(http);
              long ingress = System.nanoTime();
              if (claim && activeC5.claimSampler != null) {
                activeC5.claimSampler.enterCurrent();
              }
              try {
                chain.doFilter(wrapped, response);
              } finally {
                if (claim && activeC5.claimSampler != null) {
                  activeC5.claimSampler.leaveCurrent();
                }
                int status = ((jakarta.servlet.http.HttpServletResponse) response).getStatus();
                if (claim) {
                  activeC5.recordClaim(
                      wrapped.getContentAsByteArray(), status, System.nanoTime() - ingress);
                } else {
                  activeC5.recordLifecycle(wrapped.getContentAsByteArray(), status);
                }
              }
              return;
            }
            UUID p3Execution =
                P3_EXECUTIONS.stream()
                    .filter(
                        id ->
                            http.getRequestURI()
                                .equals("/internal/studio/executions/" + id + "/progress"))
                    .findFirst()
                    .orElse(null);
            if (p3Execution != null) {
              var wrapped =
                  new org.springframework.web.util.ContentCachingRequestWrapper(http, 262144);
              try {
                chain.doFilter(wrapped, response);
              } finally {
                P6ChildCut cut = p6ChildCut;
                if (cut != null && cut.execution.equals(p3Execution)) {
                  cut.capture(
                      http,
                      wrapped.getContentAsByteArray(),
                      ((jakarta.servlet.http.HttpServletResponse) response).getStatus());
                }
              }
              if (((jakarta.servlet.http.HttpServletResponse) response).getStatus() >= 200
                  && ((jakarta.servlet.http.HttpServletResponse) response).getStatus() < 300
                  && wrapped.getContentAsByteArray().length > 0) {
                p3CaptureOrdinaryReport(p3Execution, wrapped.getContentAsByteArray());
              }
              return;
            }
            UUID target = preReadyId;
            boolean capture =
                target != null
                    && http.getRequestURI()
                        .equals("/internal/studio/executions/" + target + "/progress")
                    && http.getHeader("X-Observed-Negative-Probe") == null;
            if (!capture) {
              chain.doFilter(request, response);
              return;
            }
            if (HOLD_TERMINAL_RETRY.get() && TERMINAL_ROLLBACKS.get() > 0) {
              retryPaused.countDown();
              try {
                if (!retryRelease.await(10, java.util.concurrent.TimeUnit.SECONDS)) {
                  throw new jakarta.servlet.ServletException("Controlled retry barrier timed out");
                }
              } catch (InterruptedException interrupted) {
                Thread.currentThread().interrupt();
                throw new jakarta.servlet.ServletException("Controlled retry barrier interrupted");
              }
            }
            var wrapped =
                new org.springframework.web.util.ContentCachingRequestWrapper(http, 262144);
            try {
              chain.doFilter(wrapped, response);
            } finally {
              if (wrapped.getContentAsByteArray().length > 0) {
                try {
                  RECEIVED_FAILURE_REPORTS.add(C.parseWire(wrapped.getContentAsByteArray()));
                } catch (RuntimeException invalid) {
                  /* Original production parsing still owns the response. */
                }
              }
            }
          };
      var registration = new org.springframework.boot.web.servlet.FilterRegistrationBean<>(filter);
      registration.addUrlPatterns(
          "/internal/studio/executions/*", "/internal/v2/studio/guided-sessions/*");
      return registration;
    }
  }

  @LocalServerPort int port;
  @Autowired JdbcTemplate jdbc;
  @Autowired org.springframework.context.ConfigurableApplicationContext ownedApplicationContext;
  private org.springframework.test.context.TestContext ownedFrameworkContext;
  private boolean ownedApplicationQuiescent;

  public static final class OwnedContextCapture
      extends org.springframework.test.context.support.AbstractTestExecutionListener {
    private GuidedPublicationReplayIT ownedInstance;

    @Override
    public int getOrder() {
      return 3500;
    }

    @Override
    public void prepareTestInstance(org.springframework.test.context.TestContext testContext) {
      assertThat(testContext.getTestClass()).isEqualTo(GuidedPublicationReplayIT.class);
      var instance = (GuidedPublicationReplayIT) testContext.getTestInstance();
      assertThat(testContext.getApplicationContext()).isSameAs(instance.ownedApplicationContext);
      instance.ownedFrameworkContext = testContext;
      ownedInstance = instance;
    }

    @Override
    public void afterTestClass(org.springframework.test.context.TestContext testContext)
        throws Exception {
      try {
        assertThat(testContext.getTestClass()).isEqualTo(GuidedPublicationReplayIT.class);
        assertThat(ownedInstance).isNotNull();
        assertThat(ownedInstance.ownedFrameworkContext).isSameAs(testContext);
        assertThat(testContext.getApplicationContext())
            .isSameAs(ownedInstance.ownedApplicationContext);
        ownedInstance.stop();
      } finally {
        ownedInstance = null;
      }
    }
  }

  @Autowired GuidedSessionRepository sessions;
  @Autowired GuidedTranslationStore plans;
  @Autowired StudioDispatcher dispatcher;
  @Autowired StudioGatewayProperties gatewayProperties;
  @Autowired com.citi.put.checks.studio.scheduling.StudioSchedulingProperties scheduling;
  @Autowired com.citi.put.checks.studio.scheduling.StudioScheduleProcessor scheduleProcessor;

  private final Map<String, String> testOwnedSessions = new java.util.LinkedHashMap<>();
  private Throwable failedTest;
  private boolean cleanupUnconfirmed;
  private int beforeFixtureModelCalls;
  private int beforeFixtureProviderReads;
  private int beforeFixtureProviderFailures;
  private int beforeFixtureModelKinds;

  @RegisterExtension
  final AfterTestExecutionCallback retainActualFailure =
      context -> failedTest = context.getExecutionException().orElse(null);

  @BeforeEach
  void beginOwnedSessionTracking() {
    assertThat(cleanupUnconfirmed)
        .as("prior failed-test actual worker teardown was not confirmed; inspect cleanup evidence")
        .isFalse();
    testOwnedSessions.clear();
    failedTest = null;
    beforeFixtureModelCalls = MODEL_WIRE.size();
    beforeFixtureModelKinds = MODEL_KINDS.size();
    beforeFixtureProviderReads = VAULT.readCount();
    beforeFixtureProviderFailures = PROVIDER_FAILURES.get();
    assertThat(safeExecutionMetadata(UUID.randomUUID()))
        .as("read-only empty execution diagnostic query preflight")
        .isEmpty();
  }

  @AfterEach
  void cancelFailedTestOwnedSessions(TestInfo testInfo) throws Exception {
    try {
      persistActualBudgetEvidence(testInfo);
    } catch (Exception | AssertionError evidenceFailure) {
      if (failedTest == null) {
        throw evidenceFailure;
      }
      failedTest.addSuppressed(evidenceFailure);
    }
    if (failedTest == null) {
      return;
    }
    var evidence = C.object().put("testMethod", testInfo.getTestMethod().orElseThrow().getName());
    var cleanups = evidence.putArray("sessions");
    for (var owned : testOwnedSessions.entrySet()) {
      var cleanup = cleanups.addObject().put("sessionId", owned.getKey());
      try {
        var metadata = C.object();
        var before =
            sessions.transaction(
                () -> {
                  var locked = sessions.lock(owned.getKey());
                  try {
                    metadata.setAll(safeFailureMetadata(locked));
                  } catch (RuntimeException metadataFailure) {
                    metadata.put("captureFailure", true);
                    failedTest.addSuppressed(
                        new IllegalStateException("Safe failure metadata unavailable"));
                  }
                  return locked;
                });
        metadata.put("testMethod", testInfo.getTestMethod().orElseThrow().getName());
        try {
          Files.writeString(
              TEMP.resolve(
                  "failed-test-state-"
                      + testInfo.getTestMethod().orElseThrow().getName()
                      + "-"
                      + owned.getKey()
                      + ".json"),
              metadata.toPrettyString());
        } catch (IOException writeFailure) {
          failedTest.addSuppressed(
              new IllegalStateException("Safe failure metadata could not be saved"));
        }
        try {
          metadata.set("executions", safeExecutionMetadata(UUID.fromString(owned.getValue())));
        } catch (RuntimeException probeFailure) {
          metadata.set("executionProbeFailure", safeProbeFailure(probeFailure));
          failedTest.addSuppressed(
              new IllegalStateException("Optional execution diagnostic unavailable"));
        }
        try {
          Files.writeString(
              TEMP.resolve(
                  "failed-test-state-"
                      + testInfo.getTestMethod().orElseThrow().getName()
                      + "-"
                      + owned.getKey()
                      + ".json"),
              metadata.toPrettyString());
        } catch (IOException writeFailure) {
          failedTest.addSuppressed(
              new IllegalStateException("Enriched safe failure metadata could not be saved"));
        }
        assertThat(before.document().path("testId").asText()).isEqualTo(owned.getValue());
        assertThat(before.document().path("scope").path("principalId").asText())
            .isEqualTo("user-1");
        String state = before.document().path("state").asText();
        cleanup.put("beforeState", state);
        if (!List.of(
                "SUCCEEDED",
                "PUBLICATION_CONFLICT",
                "FAILED",
                "UNKNOWN_OUTCOME",
                "CANCELLED",
                "EXPIRED")
            .contains(state)) {
          var request =
              HttpRequest.newBuilder(
                      URI.create(
                          "https://localhost:"
                              + port
                              + "/api/v3/studio/guided-sessions/"
                              + owned.getKey()
                              + "/cancel"))
                  .timeout(Duration.ofSeconds(15))
                  .header("Cookie", "put_session=" + COOKIE)
                  .header("Content-Type", "application/json")
                  .header("Idempotency-Key", UUID.randomUUID().toString())
                  .POST(
                      HttpRequest.BodyPublishers.ofString(
                          C.object()
                              .put("schemaVersion", 3)
                              .put("reason", "userRequested")
                              .toString()))
                  .build();
          var response =
              HttpClient.newBuilder()
                  .sslContext(TLS)
                  .build()
                  .send(request, HttpResponse.BodyHandlers.ofString());
          cleanup.put("cancelHttpStatus", response.statusCode());
          assertThat(response.statusCode())
              .as("actual authenticated fixture cancellation")
              .isEqualTo(202);
          assertThat(C.parse(response.body()).path("state").asText()).isEqualTo("CANCELLED");
        }
        long deadline = System.nanoTime() + Duration.ofSeconds(20).toNanos();
        String teardown;
        do {
          teardown =
              sessions.transaction(
                  () -> sessions.lock(owned.getKey()).progress().path("teardownStatus").asText());
          if (teardown.equals("CONFIRMED")) {
            break;
          }
          Thread.sleep(30);
        } while (System.nanoTime() < deadline);
        cleanup.put("teardownStatus", teardown);
        assertThat(teardown).as("actual worker stop/close acknowledgement").isEqualTo("CONFIRMED");
      } catch (Exception | AssertionError failure) {
        cleanupUnconfirmed = true;
        cleanup.put("cleanupFailureClass", failure.getClass().getName());
        failedTest.addSuppressed(failure);
        // Preserve the original test failure and block later bodies if actual teardown is unknown.
      }
    }
    evidence.put("allActualTeardownsConfirmed", !cleanupUnconfirmed);
    Files.writeString(
        TEMP.resolve(
            "failed-test-cleanup-" + testInfo.getTestMethod().orElseThrow().getName() + ".json"),
        evidence.toPrettyString());
  }

  private void persistActualBudgetEvidence(TestInfo testInfo) throws Exception {
    if (testOwnedSessions.isEmpty()) {
      return;
    }
    assertThat(gatewayProperties.maxOutputTokens()).isGreaterThanOrEqualTo(4000);
    var evidence = C.object().put("transportOutputCeiling", gatewayProperties.maxOutputTokens());
    var scopedSessions = evidence.putArray("sessions");
    for (String id : testOwnedSessions.keySet()) {
      var scoped = scopedSessions.addObject();
      long sessionOrdinal = budgetSessionOrdinal(jdbc, id);
      scoped.put("sessionOrdinal", sessionOrdinal);
      JsonNode limits =
          sessions.transaction(() -> sessions.lock(id).document().path("limits").deepCopy());
      assertThat(limits.path("maxModelOutputTokensTotal").asInt()).isEqualTo(32000);
      assertThat(limits.path("maxModelInputTokensTotal").asInt()).isEqualTo(128000);
      copyDiagnosticNumbers(
          limits,
          scoped.putObject("sessionLimits"),
          "maxModelOutputTokensTotal",
          "maxModelInputTokensTotal");
      var witnesses = scoped.putArray("beforeGatewaySend");
      COMMITTED_MODEL_BUDGET_WITNESSES.stream()
          .filter(witness -> witness.path("sessionOrdinal").asLong() == sessionOrdinal)
          .sorted(
              java.util.Comparator.comparingLong(
                  witness -> witness.path("attemptOrdinal").asLong()))
          .forEach(witnesses::add);
      long priorInput = 0, priorOutput = 0, priorProposals = 0;
      for (JsonNode witness : witnesses) {
        assertThat(witness.path("outsideCallerTransaction").asBoolean()).isTrue();
        assertThat(witness.path("committedCallingReservation").asBoolean()).isTrue();
        assertThat(witness.path("serviceReservationOutput").asLong()).isEqualTo(4000);
        assertThat(witness.path("persistedOutputCeiling").asLong()).isEqualTo(4000);
        assertThat(witness.path("actualGatewayOutputCeiling").asLong()).isEqualTo(4000);
        assertThat(witness.path("serviceReservationInput").asLong())
            .isEqualTo(witness.path("persistedInputCeiling").asLong());
        assertThat(witness.path("cumulativeInput").asLong())
            .isGreaterThanOrEqualTo(priorInput + witness.path("serviceReservationInput").asLong());
        assertThat(witness.path("cumulativeOutput").asLong())
            .isGreaterThanOrEqualTo(priorOutput + 4000);
        assertThat(witness.path("inputTotalLimit").asLong()).isEqualTo(128000);
        assertThat(witness.path("outputTotalLimit").asLong()).isEqualTo(32000);
        assertThat(witness.path("cumulativeInput").asLong()).isLessThanOrEqualTo(128000);
        assertThat(witness.path("cumulativeOutput").asLong()).isLessThanOrEqualTo(32000);
        assertThat(witness.path("cumulativeProposals").asLong()).isGreaterThan(priorProposals);
        priorProposals = witness.path("cumulativeProposals").asLong();
        priorInput = witness.path("cumulativeInput").asLong();
        priorOutput = witness.path("cumulativeOutput").asLong();
      }
      var attempts = scoped.putArray("attempts");
      for (var row :
          jdbc.queryForList(
              "SELECT a.request_id,a.attempt_number,a.status,a.identity->>'inputCeiling' AS input_ceiling,"
                  + " a.identity->>'outputCeiling' AS output_ceiling,"
                  + " (SELECT count(*) FROM studio_guided_model_attempts earlier"
                  + " WHERE earlier.session_id=a.session_id AND (earlier.created_at,earlier.attempt_id)"
                  + " <= (a.created_at,a.attempt_id)) AS attempt_ordinal"
                  + " FROM studio_guided_model_attempts a WHERE a.session_id=? ORDER BY a.created_at,a.attempt_id",
              id)) {
        long inputCeiling = Long.parseLong(String.valueOf(row.get("input_ceiling")));
        long outputCeiling = Long.parseLong(String.valueOf(row.get("output_ceiling")));
        assertThat(outputCeiling).isEqualTo(4000);
        long attemptOrdinal = ((Number) row.get("attempt_ordinal")).longValue();
        var safe =
            attempts
                .addObject()
                .put("attemptOrdinal", attemptOrdinal)
                .put("persistedInputCeiling", inputCeiling)
                .put("persistedOutputCeiling", outputCeiling)
                .put("wireFound", false);
        for (String raw : MODEL_WIRE) {
          JsonNode wire = C.parse(raw);
          JsonNode request =
              C.parse(wire.path("contents").get(0).path("parts").get(0).path("text").asText());
          if (request.path("requestId").asText().equals(String.valueOf(row.get("request_id")))) {
            int actualOutput = wire.path("generationConfig").path("maxOutputTokens").asInt();
            int actualEncodedInput = raw.getBytes(StandardCharsets.UTF_8).length;
            assertThat(actualOutput).isEqualTo(4000);
            assertThat((long) actualEncodedInput).isLessThanOrEqualTo(inputCeiling);
            safe.put("wireFound", true)
                .put("actualWireOutputCeiling", actualOutput)
                .put("actualCompleteEncodedInputBytes", actualEncodedInput);
          }
        }
        if ("APPLIED".equals(row.get("status"))) {
          assertThat(witnesses.findValues("attemptOrdinal"))
              .filteredOn(ordinal -> ordinal.asLong() == attemptOrdinal)
              .hasSize(1);
          assertThat(safe.path("wireFound").asBoolean())
              .as("applied attempt has actual scoped controlled gateway wire evidence")
              .isTrue();
        }
      }
    }
    assertThat(MODEL_BUDGET_WITNESS_FAILURES.get()).isZero();
    requireNumericBudgetEvidence(evidence);
    Files.writeString(
        TEMP.resolve(
            "model-budget-evidence-" + testInfo.getTestMethod().orElseThrow().getName() + ".json"),
        evidence.toPrettyString());
  }

  private static long budgetSessionOrdinal(JdbcTemplate jdbc, String id) {
    return jdbc.queryForObject(
        "SELECT count(*) FROM studio_guided_sessions earlier JOIN studio_guided_sessions scoped"
            + " ON scoped.session_id=? WHERE ((earlier.document->>'createdAt')::timestamptz,earlier.session_id)"
            + " <= ((scoped.document->>'createdAt')::timestamptz,scoped.session_id)",
        Long.class,
        id);
  }

  private static ObjectNode committedModelBudgetWitness(
      JdbcTemplate jdbc, GuidedModelRequest request) {
    String id = request.projection().document().path("sessionId").asText();
    var row =
        jdbc.queryForMap(
            "SELECT a.status,a.identity->>'inputCeiling' AS input_ceiling,"
                + " a.identity->>'outputCeiling' AS output_ceiling,"
                + " s.progress->'modelReservations'->a.reservation_key->>'input' AS reservation_input,"
                + " s.progress->'modelReservations'->a.reservation_key->>'output' AS reservation_output,"
                + " s.document->'counters'->>'modelInputTokens' AS cumulative_input,"
                + " s.document->'counters'->>'modelOutputTokens' AS cumulative_output,"
                + " s.document->'counters'->>'modelProposals' AS cumulative_proposals,"
                + " s.document->'limits'->>'maxModelInputTokensTotal' AS input_limit,"
                + " s.document->'limits'->>'maxModelOutputTokensTotal' AS output_limit,"
                + " (SELECT count(*) FROM studio_guided_model_attempts earlier"
                + " WHERE earlier.session_id=a.session_id AND (earlier.created_at,earlier.attempt_id)"
                + " <= (a.created_at,a.attempt_id)) AS attempt_ordinal"
                + " FROM studio_guided_model_attempts a JOIN studio_guided_sessions s USING(session_id)"
                + " WHERE a.session_id=? AND a.request_id=? AND a.attempt_number=?",
            id,
            request.requestId(),
            request.attempt());
    var witness =
        C.object()
            .put("sessionOrdinal", budgetSessionOrdinal(jdbc, id))
            .put("attemptOrdinal", ((Number) row.get("attempt_ordinal")).longValue())
            .put("actualGatewayOutputCeiling", request.maxOutputTokens())
            .put(
                "outsideCallerTransaction",
                !org.springframework.transaction.support.TransactionSynchronizationManager
                    .isActualTransactionActive())
            .put(
                "committedCallingReservation",
                "CALLING".equals(row.get("status"))
                    && row.get("reservation_input") != null
                    && row.get("reservation_output") != null);
    for (var field :
        Map.of(
                "persistedInputCeiling",
                "input_ceiling",
                "persistedOutputCeiling",
                "output_ceiling",
                "serviceReservationInput",
                "reservation_input",
                "serviceReservationOutput",
                "reservation_output",
                "cumulativeInput",
                "cumulative_input",
                "cumulativeOutput",
                "cumulative_output",
                "cumulativeProposals",
                "cumulative_proposals",
                "inputTotalLimit",
                "input_limit",
                "outputTotalLimit",
                "output_limit")
            .entrySet()) {
      witness.put(field.getKey(), Long.parseLong(String.valueOf(row.get(field.getValue()))));
    }
    requireNumericBudgetEvidence(witness);
    return witness;
  }

  private static void requireNumericBudgetEvidence(JsonNode value) {
    if (value.isContainerNode()) {
      value.forEach(GuidedPublicationReplayIT::requireNumericBudgetEvidence);
    } else {
      assertThat(value.isNumber() || value.isBoolean()).isTrue();
    }
  }

  private ObjectNode safeFailureMetadata(GuidedSessionRepository.Session locked) {
    JsonNode document = locked.document(), progress = locked.progress();
    String id = document.path("sessionId").asText();
    var out = C.object().put("schemaVersion", 1);
    putDiagnosticUuid(out, "sessionId", id);
    putDiagnosticUuid(out, "testId", document.path("testId").asText());
    out.put(
        "state",
        closedDiagnostic(
            document.path("state").asText(),
            "PREPARING",
            "OBSERVING",
            "PROPOSING",
            "ACTING",
            "AWAITING_CLARIFICATION",
            "FINALIZING",
            "SUCCEEDED",
            "PUBLICATION_CONFLICT",
            "FAILED",
            "UNKNOWN_OUTCOME",
            "CANCELLED",
            "EXPIRED"));
    out.put("errorCode", safeDiagnosticCode(progress.path("errorCode").asText()));
    out.put(
        "bootstrapPhase",
        closedDiagnostic(
            progress.path("translationBootstrap").path("phase").asText(),
            "SOURCE_PLAN",
            "PLAN_ACCEPTED",
            "MATERIALIZED",
            "ALLOCATED",
            "CONTEXT_PENDING",
            "READY"));
    out.put(
        "materializationPresent",
        Boolean.TRUE.equals(
            jdbc.queryForObject(
                "SELECT EXISTS(SELECT 1 FROM studio_guided_materializations WHERE session_id=?)",
                Boolean.class,
                id)));
    copyDiagnosticNumbers(
        document.path("counters"),
        out.putObject("counters"),
        "actions",
        "observations",
        "modelProposals",
        "modelInputTokens",
        "modelOutputTokens",
        "sanitizedEvidenceBytes");
    copyDiagnosticNumbers(
        progress,
        out.putObject("coordinate"),
        "stepIndex",
        "translationOrdinal",
        "generation",
        "contextRevision");
    int stepIndex = progress.path("stepIndex").asInt(-1);
    if (stepIndex >= 0 && stepIndex < document.path("sourceSteps").size()) {
      putDiagnosticUuid(
          out,
          "activeSourceStepId",
          document.path("sourceSteps").get(stepIndex).path("stepId").asText());
    }
    copyDiagnosticNumbers(
        progress.path("observation").path("coverage"),
        out.putObject("observationCounts"),
        "passwordControls",
        "withheldRegions");
    copyDiagnosticNumbers(
        progress.path("translationAcquisition"),
        out.putObject("acquisition"),
        "allowanceMs",
        "totalExtraPolls");
    copyDiagnosticNumbers(
        progress.path("translationAcquisition").path("active"),
        out.putObject("activeAcquisition"),
        "ordinal",
        "elapsedMs",
        "extraPolls");
    out.put("fixtureModelHttpCalls", MODEL_WIRE.size() - beforeFixtureModelCalls)
        .put("fixturePhysicalProviderReads", VAULT.readCount() - beforeFixtureProviderReads)
        .put("fixtureProviderFailures", PROVIDER_FAILURES.get() - beforeFixtureProviderFailures);
    var modelCounts = out.putObject("fixtureModelKinds");
    List<String> kinds = List.copyOf(MODEL_KINDS);
    for (String kind : List.of("SOURCE_PLAN", "NEXT_ACTION", "VERIFY_STEP")) {
      modelCounts.put(
          kind,
          kinds.subList(Math.min(beforeFixtureModelKinds, kinds.size()), kinds.size()).stream()
              .filter(kind::equals)
              .count());
    }
    if (plans.exists(id)) {
      JsonNode translation = plans.state(id);
      out.put(
          "continuation",
          closedDiagnostic(
              translation.path("continuation").asText(),
              "SOURCE_PLAN",
              "MATERIALIZE",
              "DEPENDENCIES",
              "NEXT",
              "REFRESH",
              "AWAITING_CLARIFICATION",
              "FINALIZING",
              "STOPPED"));
      copyDiagnosticNumbers(translation, out.putObject("translationCounters"), "planRevision");
      var declarations = out.putArray("declarations");
      for (JsonNode declared : translation.path("manifest").path("configurationReferences")) {
        var safe =
            declarations
                .addObject()
                .put(
                    "kind",
                    closedDiagnostic(
                        declared.path("kind").asText(),
                        "destination",
                        "nonsecretText",
                        "secretRef"));
        putDiagnosticUuid(safe, "stepId", declared.path("stepId").asText());
      }
      var obligations = out.putArray("obligations");
      for (JsonNode obligation : translation.path("plan").path("obligations")) {
        var safe =
            obligations
                .addObject()
                .put(
                    "operationKind",
                    closedDiagnostic(
                        obligation.path("operationKind").asText(),
                        "navigate",
                        "fill",
                        "click",
                        "read",
                        "assert",
                        "press",
                        "hover",
                        "check",
                        "uncheck",
                        "selectOption"));
        putDiagnosticUuid(safe, "stepId", obligation.path("stepId").asText());
        copyDiagnosticNumbers(obligation, safe, "occurrence", "referenceIndex");
      }
    }
    var actions = out.putArray("actions");
    for (var row :
        jdbc.queryForList(
            "SELECT document::text AS ledger,proposal->'operation'->>'kind' AS operation_kind"
                + " FROM studio_guided_actions WHERE session_id=? ORDER BY step_id,ordinal",
            id)) {
      JsonNode action = C.parse(String.valueOf(row.get("ledger")));
      var safe =
          actions
              .addObject()
              .put(
                  "operationKind",
                  closedDiagnostic(
                      String.valueOf(row.get("operation_kind")),
                      "navigate",
                      "fill",
                      "click",
                      "read",
                      "assert",
                      "press",
                      "hover",
                      "check",
                      "uncheck",
                      "selectOption"))
              .put(
                  "state",
                  closedDiagnostic(
                      action.path("state").asText(),
                      "ADMITTED",
                      "DISPATCHING",
                      "SUCCEEDED",
                      "FAILED",
                      "UNKNOWN_OUTCOME",
                      "REVOKED"))
              .put("outcomeCode", safeDiagnosticCode(action.path("outcomeCode").asText()));
      putDiagnosticUuid(safe, "stepId", action.path("coordinate").path("stepId").asText());
      putDiagnosticUuid(safe, "admissionId", action.path("admission").path("admissionId").asText());
      copyDiagnosticNumbers(action.path("coordinate"), safe, "ordinal");
      copyDiagnosticNumbers(action, safe, "dispatchCount", "ownerFence", "generation");
    }
    var associations = out.putArray("obligationAdmissions");
    jdbc.queryForList(
            "SELECT admission_id IS NOT NULL AS admitted,plan_revision,"
                + " (meaning->>'occurrence')::integer AS occurrence,"
                + " (proposal->'coordinate'->>'ordinal')::integer AS ordinal,"
                + " proposal->'operation'->>'kind' AS operation_kind"
                + " FROM studio_guided_obligation_admissions WHERE session_id=? ORDER BY created_at",
            id)
        .forEach(
            row -> {
              var association =
                  associations
                      .addObject()
                      .put("admitted", Boolean.TRUE.equals(row.get("admitted")))
                      .put(
                          "operationKind",
                          closedDiagnostic(
                              String.valueOf(row.get("operation_kind")),
                              "navigate",
                              "fill",
                              "read",
                              "click",
                              "assert",
                              "press",
                              "hover",
                              "check",
                              "uncheck",
                              "selectOption"));
              for (String field : List.of("plan_revision", "occurrence", "ordinal")) {
                Object number = row.get(field);
                if (number instanceof Number numeric) {
                  association.put(field.replace("_", ""), numeric.longValue());
                }
              }
            });
    var attempts = out.putArray("modelAttempts");
    jdbc.queryForList(
            "SELECT kind,status,attempt_number,input_tokens,output_tokens,"
                + " safe_result->>'code' AS provider_code,safe_result->>'status' AS response_status,"
                + " safe_result->>'schemaVersion' AS response_schema_version,"
                + " safe_result->'action'->'operation'->>'kind' AS response_operation_kind"
                + " FROM studio_guided_model_attempts"
                + " WHERE session_id=? ORDER BY created_at,attempt_number",
            id)
        .forEach(
            row -> {
              var safe =
                  attempts
                      .addObject()
                      .put(
                          "kind",
                          closedDiagnostic(
                              String.valueOf(row.get("kind")),
                              "SOURCE_PLAN",
                              "NEXT_ACTION",
                              "VERIFY_STEP"))
                      .put(
                          "status",
                          closedDiagnostic(
                              String.valueOf(row.get("status")),
                              "RESERVED",
                              "CALLING",
                              "APPLIED",
                              "REJECTED",
                              "SUPERSEDED",
                              "UNKNOWN_CALL"))
                      .put(
                          "providerCode",
                          closedDiagnostic(
                              String.valueOf(row.get("provider_code")),
                              "OK",
                              "INVALID_RESPONSE",
                              "TOO_LARGE",
                              "BUSY",
                              "TIMEOUT",
                              "TRANSPORT",
                              "DISABLED"));
              safe.put(
                  "responseStatus",
                  closedDiagnostic(
                      String.valueOf(row.get("response_status")),
                      "ACTION",
                      "CLARIFICATION",
                      "COMPLETE",
                      "UNSUPPORTED"));
              safe.put(
                  "responseOperationKind",
                  closedDiagnostic(
                      String.valueOf(row.get("response_operation_kind")),
                      "navigate",
                      "fill",
                      "read",
                      "click",
                      "assert",
                      "press",
                      "hover",
                      "check",
                      "uncheck",
                      "selectOption"));
              Object responseVersion = row.get("response_schema_version");
              if (responseVersion != null
                  && String.valueOf(responseVersion).matches("[0-9]{1,2}")) {
                safe.put(
                    "responseSchemaVersion", Integer.parseInt(String.valueOf(responseVersion)));
              }
              for (String key : List.of("attempt_number", "input_tokens", "output_tokens")) {
                Object value = row.get(key);
                if (value instanceof Number number && number.longValue() >= 0) {
                  safe.put(key.replace("_", ""), number.longValue());
                }
              }
            });
    return out;
  }

  private ArrayNode safeExecutionMetadata(UUID testId) {
    var executions = JSON.createArrayNode();
    jdbc.queryForList(
            "SELECT e.id,e.revision_id,e.status,e.error_code,e.snapshot_revision,"
                + " l.state AS ledger_state,l.attempt_id,l.last_runner_sequence,"
                + " e.observed_revision_binding->>'attemptId' AS accepted_attempt_id,"
                + " l.execution_id IS NOT NULL AS ledger_present,"
                + " l.admission_id IS NOT NULL AS admission_present,"
                + " e.observed_admission_receipt IS NOT NULL AS observed_receipt_present,"
                + " e.browser_started_at IS NOT NULL AS browser_started,"
                + " e.video_key IS NOT NULL AS video_present,"
                + " l.manifest_key IS NOT NULL AS manifest_present,"
                + " e.step_results IS NOT NULL AS step_results_present,"
                + " CASE WHEN e.ended_at IS NULL THEN NULL ELSE GREATEST(0,"
                + " FLOOR(EXTRACT(EPOCH FROM e.ended_at-e.started_at)*1000))::bigint END AS elapsed_ms"
                + " FROM ui_test_executions e LEFT JOIN studio_dispatch_ledger l"
                + " ON l.execution_id=e.id AND l.execution_accepted_at=e.started_at"
                + " WHERE e.ui_test_id=? ORDER BY e.started_at,e.id",
            testId)
        .forEach(
            row -> {
              var safe = executions.addObject();
              ObjectNode actualSend = ACTUAL_DISPATCH_DIAGNOSTICS.get((UUID) row.get("id"));
              safe.put("actualDispatchClientInvoked", actualSend != null);
              if (actualSend != null) {
                safe.set("actualDispatchClient", actualSend.deepCopy());
              }
              for (String key : List.of("id", "revision_id", "attempt_id", "accepted_attempt_id")) {
                putDiagnosticUuid(safe, key, String.valueOf(row.get(key)));
              }
              safe.put(
                  "status",
                  closedDiagnostic(
                      String.valueOf(row.get("status")),
                      "PENDING",
                      "RUNNING",
                      "PASSED",
                      "FAILED",
                      "ERROR"));
              safe.put(
                  "ledgerState",
                  closedDiagnostic(
                      String.valueOf(row.get("ledger_state")),
                      "QUEUED",
                      "CLAIMED",
                      "DISPATCHING",
                      "ADMITTED",
                      "RUNNING",
                      "FINALIZING",
                      "DONE"));
              Object error = row.get("error_code");
              safe.put(
                  "errorCode",
                  error == null
                      ? "NONE"
                      : ExecutionErrorCode.values().contains(String.valueOf(error))
                          ? String.valueOf(error)
                          : "OTHER");
              for (String key :
                  List.of(
                      "ledger_present",
                      "admission_present",
                      "observed_receipt_present",
                      "browser_started",
                      "video_present",
                      "manifest_present",
                      "step_results_present")) {
                if (row.get(key) instanceof Boolean present) {
                  safe.put(key, present);
                }
              }
              for (String key :
                  List.of("snapshot_revision", "last_runner_sequence", "elapsed_ms")) {
                if (row.get(key) instanceof Number number && number.longValue() >= 0) {
                  safe.put(key, number.longValue());
                }
              }
            });
    return executions;
  }

  private static ObjectNode safeDispatchOutcome(DispatchOutcome result) {
    var out = C.object().put("kind", result.kind().name()).put("retryable", result.retryable());
    String detail = result.detail();
    if (detail == null) {
      return out.put("reason", "NONE");
    }
    if (detail.equals("the run job could not be serialized")) {
      return out.put("reason", "SERIALIZATION_REFUSAL");
    }
    if (detail.equals(HttpRunnerDispatchClient.RUNNER_NOT_CONFIGURED)) {
      return out.put("reason", "RUNNER_NOT_CONFIGURED");
    }
    if (detail.equals(HttpRunnerDispatchClient.SERVICE_IDENTITY_NOT_CONFIGURED)) {
      return out.put("reason", "SERVICE_IDENTITY_NOT_CONFIGURED");
    }
    if (detail.equals("runner refused with 429")) {
      return out.put("reason", "HTTP_STATUS").put("classifiedHttpStatus", 429);
    }
    var status =
        java.util.regex.Pattern.compile("(?:runner|redirect) ([1-5][0-9]{2})").matcher(detail);
    if (status.matches()) {
      return out.put("reason", "HTTP_STATUS")
          .put("classifiedHttpStatus", Integer.parseInt(status.group(1)));
    }
    return out.put("reason", closedDiagnostic(detail, "timeout", "connection loss", "interrupted"));
  }

  private static ObjectNode safeProbeFailure(RuntimeException failure) {
    var out = C.object();
    var causes = out.putArray("causes");
    Throwable cursor = failure;
    for (int depth = 0; cursor != null && depth < 8; depth++, cursor = cursor.getCause()) {
      var cause = causes.addObject().put("class", cursor.getClass().getName());
      if (cursor instanceof SQLException sql) {
        cause.put(
            "sqlState",
            closedDiagnostic(
                sql.getSQLState(),
                "42703",
                "42P01",
                "42883",
                "22P02",
                "25P02",
                "57014",
                "08006",
                "23514",
                "40001",
                "55P03"));
      }
      var frames = cause.putArray("frames");
      StackTraceElement[] stack = cursor.getStackTrace();
      for (int index = 0; index < Math.min(stack.length, 8); index++) {
        StackTraceElement frame = stack[index];
        frames
            .addObject()
            .put("class", frame.getClassName())
            .put("method", frame.getMethodName())
            .put("line", frame.getLineNumber());
      }
    }
    return out;
  }

  private static String closedDiagnostic(String value, String... allowed) {
    return value != null && List.of(allowed).contains(value) ? value : "OTHER";
  }

  private static String safeDiagnosticCode(String value) {
    return closedDiagnostic(
        value,
        "OK",
        "PENDING",
        "INVALID_CONTRACT",
        "UNAUTHENTICATED",
        "FORBIDDEN_SCOPE",
        "REVISION_CONFLICT",
        "STALE_GENERATION",
        "TARGET_MISMATCH",
        "AMBIGUOUS_TARGET",
        "MISSING_SOURCE",
        "BINDING_ORDER",
        "SENSITIVE_SOURCE",
        "ORIGIN_NOT_ALLOWED",
        "UNSUPPORTED_SURFACE",
        "BUDGET_EXCEEDED",
        "STALE_FENCE",
        "IDEMPOTENCY_CONFLICT",
        "UNKNOWN_OUTCOME",
        "PUBLICATION_CONFLICT",
        "RUNTIME_INCOMPATIBLE",
        "ASSERTION_FAILED",
        "CANCELLED",
        "EXPIRED",
        "SECRET_UNAVAILABLE",
        "SECRET_USE_NOT_AUTHORIZED",
        "SECRET_USE_REVOKED",
        "VAULT_UNAVAILABLE",
        "LOGIN_REQUIRED",
        "SECRET_TOO_LONG",
        "ACK_LOST",
        "TIMEOUT",
        "TARGET_CHANGED",
        "POLICY_DENIED",
        "REFERENCE_MISMATCH");
  }

  private static void putDiagnosticUuid(ObjectNode out, String key, String value) {
    if (value.matches(
        "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")) {
      out.put(key, UUID.fromString(value).toString());
    }
  }

  private static void copyDiagnosticNumbers(JsonNode from, ObjectNode to, String... keys) {
    for (String key : keys) {
      JsonNode value = from.path(key);
      if (value.isIntegralNumber() && value.canConvertToLong() && value.longValue() >= 0) {
        to.put(key, value.longValue());
      }
    }
  }

  private UUID publishedTestId;
  private String currentPublishedSession;
  private JsonNode currentPublishedReceipt;

  @Test
  @org.junit.jupiter.api.Order(1)
  void actualLearningPublishesWithoutEffectsThenTwoOrdinaryRunsRecaptureFreshValues()
      throws Exception {
    startWorkers();
    // The real service-token filter precedes Spring path/body binding. These refusals have no
    // execution row and cannot reach the admission CAS or either model gateway.
    assertThat(observedAdmissionHttp("not-a-uuid", "{}").statusCode()).isEqualTo(400);
    assertThat(observedAdmissionHttp(UUID.randomUUID().toString(), null).statusCode())
        .isEqualTo(400);
    assertThat(observedAdmissionHttp(UUID.randomUUID().toString(), "{}").statusCode())
        .isEqualTo(422);
    for (var probe :
        List.of(
            Map.entry(
                "https://localhost:" + port + "/internal/v2/studio/guided-sessions/probe/plans",
                "studio-guided-runner"),
            Map.entry(
                "https://localhost:"
                    + GUIDED_PORT
                    + "/internal/v2/studio/guided-sessions/probe/observe",
                "studio-guided-controller"))) {
      var bad =
          HttpRequest.newBuilder(URI.create(probe.getKey()))
              .header(
                  "Authorization",
                  "Bearer " + token("backend-controller", "controller-1", probe.getValue()))
              .header("Content-Type", "application/json")
              .header("Idempotency-Key", UUID.randomUUID().toString())
              .header("X-Owner-Fence", "1")
              .POST(HttpRequest.BodyPublishers.ofString("{}"))
              .build();
      var refused =
          HttpClient.newBuilder()
              .sslContext(TLS)
              .build()
              .send(bad, HttpResponse.BodyHandlers.ofString());
      assertThat(refused.statusCode()).isIn(401, 403);
    }
    jdbc.update(
        "INSERT INTO users(id,sso_id,name,email,created_at) VALUES"
            + " (?,'user-1','Fixture','fixture@example.invalid',now()) ON CONFLICT DO NOTHING",
        UUID.randomUUID());
    jdbc.update(
        "INSERT INTO csi_systems(id,name,business_unit,criticality,owner_email,environment) VALUES"
            + " ('CSI-123','Orders','Ops','HIGH','fixture@example.invalid','Production') ON"
            + " CONFLICT DO NOTHING");
    UUID testId = UUID.randomUUID();
    var authoring =
        new AuthoringV2Request(
            2,
            null,
            List.of(
                new AuthoringStep(UUID.fromString(ONE), TEXT.get(0), null),
                new AuthoringStep(UUID.fromString(TWO), TEXT.get(1), null),
                new AuthoringStep(UUID.fromString(THREE), TEXT.get(2), null)));
    jdbc.update(
        "INSERT INTO"
            + " ui_tests(id,name,csi_id,environment,browser,steps,variables,auth"
            + "oring,authoring_revision_inputs,created_by,created_at,updated_at)"
            + " VALUES (?,'Observed"
            + " publication','CSI-123','fixture','chromium',?::jsonb,?::jsonb,?:"
            + ":jsonb,?::jsonb,'fixture@example.invalid',now(),now())",
        testId,
        JSON.writeValueAsString(TEXT),
        "[{\"name\":\"saved\",\"kind\":\"plain\",\"value\":\"" + SAVED + "\"}]",
        JSON.writeValueAsString(authoring),
        JSON.writeValueAsString(AuthoringRevisionIdentity.create(authoring, Map.of())));
    ObjectNode start =
        C.object()
            .put("schemaVersion", 3)
            .put("testId", testId.toString())
            .put("sourceRevision", "1")
            .put("configurationRevision", "1")
            .put("environmentId", "fixture")
            .put("applicationId", "orders");
    start.set("versions", versions());
    JsonNode started =
        publicCall("/api/v3/studio/guided-sessions", start, 202, UUID.randomUUID().toString());
    String id = started.path("session").path("sessionId").asText();
    assertThat(id).isNotBlank();
    JsonNode acquisition =
        sessions.transaction(
            () -> sessions.lock(id).progress().path("translationAcquisition").deepCopy());
    assertThat(acquisition.path("allowanceMs").asLong()).isEqualTo(30000);
    assertThat(acquisition.path("policy").asText()).isEqualTo("passive-target-1");
    assertThat(acquisition.path("sourceRevision").asText()).isEqualTo("1");
    long learningEnd = System.nanoTime() + Duration.ofSeconds(90).toNanos();
    while (System.nanoTime() < learningEnd) {
      JsonNode current = sessions.transaction(() -> sessions.lock(id).document().deepCopy());
      if (current.path("state").asText().equals("FINALIZING")) {
        break;
      }
      if (List.of("FAILED", "EXPIRED", "UNKNOWN_OUTCOME", "CANCELLED")
          .contains(current.path("state").asText())) {
        break;
      }
      Thread.sleep(50);
    }
    var learningState = sessions.transaction(() -> sessions.lock(id));
    ObjectNode diagnostic =
        C.object()
            .put("state", learningState.document().path("state").asText())
            .put("errorCode", learningState.progress().path("errorCode").asText());
    diagnostic
        .put("providerFailures", PROVIDER_FAILURES.get())
        .put("submits", RECEIPTS.size())
        .put("navigations", NAVIGATIONS.get());
    if (!MODEL_WIRE.isEmpty()) {
      JsonNode last =
          C.parse(
              C.parse(MODEL_WIRE.getLast())
                  .path("contents")
                  .get(0)
                  .path("parts")
                  .get(0)
                  .path("text")
                  .asText());
      var nodes = diagnostic.putArray("lastObservedNames");
      for (JsonNode node : last.path("context").path("observation").path("nodes")) {
        nodes
            .addObject()
            .setAll(
                Map.of(
                    "name",
                    node.path("name"),
                    "role",
                    node.path("role"),
                    "visible",
                    node.path("visible")));
      }
    }
    diagnostic.set("counters", learningState.document().path("counters"));
    diagnostic.set("modelKinds", JSON.valueToTree(MODEL_KINDS));
    Files.writeString(TEMP.resolve("learning-status.json"), diagnostic.toPrettyString());
    assertThat(learningState.document().path("state").asText())
        .as("%s logs=%s", diagnostic, TEMP)
        .isEqualTo("FINALIZING");
    assertThat(RECEIPTS).containsExactly(VALUES.get(0));
    assertThat(NAVIGATIONS.get()).isEqualTo(1);
    int learningCalls = MODEL_WIRE.size();
    assertThat(learningCalls).isPositive();
    String key = UUID.randomUUID().toString();
    JsonNode finalize =
        C.object()
            .put("schemaVersion", 3)
            .put("expectedSourceRevision", "1")
            .put("expectedConfigurationRevision", "1");
    JsonNode receipt =
        publicCall("/api/v3/studio/guided-sessions/" + id + "/finalize", finalize, 200, key);
    assertThat(publicCall("/api/v3/studio/guided-sessions/" + id + "/finalize", finalize, 200, key))
        .isEqualTo(receipt);
    assertThat(MODEL_WIRE).hasSize(learningCalls);
    assertThat(RECEIPTS).hasSize(1);
    assertThat(NAVIGATIONS.get()).isEqualTo(1);
    String artifact =
        jdbc.queryForObject(
            "SELECT artifact::text FROM ui_test_revisions WHERE id=?",
            String.class,
            UUID.fromString(receipt.path("revisionId").asText()));
    String artifactHash = GuidedContracts.hash(C.parse(artifact));
    for (int run = 0; run < 2; run++) {
      JsonNode accepted =
          publicCall(
              "/api/v1/studio/tests/" + testId + "/execute",
              C.object(),
              202,
              UUID.randomUUID().toString());
      UUID executionId = UUID.fromString(accepted.path("executionId").asText());
      assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
      long end = System.nanoTime() + Duration.ofSeconds(45).toNanos();
      String state;
      do {
        state =
            jdbc.queryForObject(
                "SELECT status FROM ui_test_executions WHERE id=?", String.class, executionId);
        if (List.of("PASSED", "FAILED", "ERROR").contains(state)) {
          break;
        }
        Thread.sleep(50);
      } while (System.nanoTime() < end);
      assertThat(state)
          .as("execution %s; runner log %s", executionId, TEMP.resolve("ordinary.log"))
          .isEqualTo("PASSED");
      assertThat(
              jdbc.queryForObject(
                  "SELECT observed_admission_receipt IS NOT NULL FROM ui_test_executions WHERE"
                      + " id=?",
                  Boolean.class,
                  executionId))
          .isTrue();
      assertThat(
              jdbc.queryForObject(
                  "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                  String.class,
                  UUID.fromString(receipt.path("revisionId").asText())))
          .isEqualTo(artifactHash);
    }
    assertThat(NAVIGATIONS.get()).isEqualTo(3);
    assertThat(RECEIPTS).containsExactlyElementsOf(VALUES);
    assertThat(VALUES).doesNotHaveDuplicates();
    assertThat(MODEL_WIRE).hasSize(learningCalls);
    assertThat(LEGACY_MODEL_CALLS.get()).isZero();
    for (String raw : MODEL_WIRE) {
      assertThat(raw).doesNotContain(SAVED);
      for (String value : VALUES) {
        assertThat(raw).doesNotContain(value);
      }
    }
    assertThat(String.join("\n", MODEL_WIRE)).contains("London");
    JsonNode result =
        publicCall("/api/v3/studio/guided-sessions/" + id + "/result", null, 200, null);
    assertThat(result.path("learnedFromThisRun").asBoolean()).isTrue();
    assertThat(result.path("replayVerified").asBoolean()).isFalse();
    assertThat(result.path("currentReadiness").path("ready").asBoolean()).isTrue();
    // Read the genuinely published row from new production application instances; historical
    // receipt reads do not require current replay authorization.
    coreRole = "viewer";
    int callsBeforeHistory = CORE_CALLS.get();
    assertThat(publicCall("/api/v3/studio/guided-sessions/" + id + "/finalize", finalize, 200, key))
        .isEqualTo(receipt);
    assertThat(CORE_CALLS.get()).isGreaterThan(callsBeforeHistory);
    historicalReplica(id, receipt, true, true, "READY");
    historicalReplica(id, receipt, false, true, "REPLAY_DISABLED");
    historicalReplica(id, receipt, true, false, "RUNTIME_INCOMPATIBLE");
    assertThat(MODEL_WIRE).hasSize(learningCalls);
    assertThat(LEGACY_MODEL_CALLS.get()).isZero();
    assertThat(RECEIPTS).hasSize(3);
    assertThat(NAVIGATIONS.get()).isEqualTo(3);
    ObjectNode evidence =
        C.object()
            .put("controlledProviderCalls", learningCalls)
            .put("initialSubmits", 1)
            .put("finalizationSubmits", 0)
            .put("ordinaryReplays", 2)
            .put("artifactHash", artifactHash)
            .put("productionImage", "NOT_ASSERTED_CONTROLLED_LOCAL_CATALOG");
    evidence.set("catalog", CATALOG);
    evidence.set("learningKinds", JSON.valueToTree(MODEL_KINDS));
    evidence.set(
        "counters",
        sessions.transaction(() -> sessions.lock(id).document().path("counters").deepCopy()));
    Files.writeString(TEMP.resolve("joined-evidence.json"), evidence.toPrettyString());
    schedulerAndNewHead(testId, id, start, finalize, receipt);
    publishedTestId = testId;
  }

  @Test
  @org.junit.jupiter.api.Order(2)
  void queuedAndPreReadyRefusals() throws Exception {
    UUID testId = publishedTestId;
    assertThat(testId)
        .as("Requires the genuinely published revision from the preceding integration flow")
        .isNotNull();
    coreRole = "owner";
    int submits = RECEIPTS.size(), navigations = NAVIGATIONS.get(), models = MODEL_WIRE.size();
    JsonNode cancelled =
        publicCall(
            "/api/v1/studio/tests/" + testId + "/execute",
            C.object(),
            202,
            UUID.randomUUID().toString());
    UUID cancelledId = UUID.fromString(cancelled.path("executionId").asText());
    publicCall(
        "/api/v1/studio/executions/" + cancelledId + "/cancel",
        C.object(),
        202,
        UUID.randomUUID().toString());
    assertThat(dispatcher.dispatchOnce()).isZero();
    assertThat(
            jdbc.queryForObject(
                "SELECT error_code FROM ui_test_executions WHERE id=?", String.class, cancelledId))
        .isEqualTo("CANCELLED");
    JsonNode expired =
        publicCall(
            "/api/v1/studio/tests/" + testId + "/execute",
            C.object(),
            202,
            UUID.randomUUID().toString());
    UUID expiredId = UUID.fromString(expired.path("executionId").asText());
    String expiresAt =
        jdbc.queryForObject(
            "SELECT observed_revision_binding->'replayGrant'->>'expiresAt' FROM ui_test_executions"
                + " WHERE id=?",
            String.class,
            expiredId);
    Thread.sleep(
        Math.max(1, Duration.between(Instant.now(), Instant.parse(expiresAt)).toMillis() + 30));
    assertThat(dispatcher.dispatchOnce()).isZero();
    assertThat(
            jdbc.queryForObject(
                "SELECT error_code FROM ui_test_executions WHERE id=?", String.class, expiredId))
        .isEqualTo("AUTHORIZATION_REVOKED");
    for (UUID id : List.of(cancelledId, expiredId)) {
      assertThat(
              jdbc.queryForObject(
                  "SELECT observed_admission_receipt IS NULL AND browser_started_at IS NULL FROM"
                      + " ui_test_executions WHERE id=?",
                  Boolean.class,
                  id))
          .isTrue();
    }
    Files.deleteIfExists(TEMP.resolve("initial-context-check-entered"));
    Files.writeString(TEMP.resolve("initial-context-state.json"), "{\"pause\":true,\"fail\":true}");
    JsonNode accepted =
        publicCall(
            "/api/v1/studio/tests/" + testId + "/execute",
            C.object(),
            202,
            UUID.randomUUID().toString());
    String id = accepted.path("executionId").asText();
    UUID failureId = UUID.fromString(id);
    preReadyId = failureId;
    var noReceipt =
        callback(
            failureId,
            failureReport(
                failureId,
                observedBinding(failureId),
                com.fasterxml.jackson.databind.node.NullNode.instance),
            CALLBACK);
    assertThat(noReceipt.statusCode()).isEqualTo(409);
    assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
    long enteredDeadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
    while (!Files.exists(TEMP.resolve("initial-context-check-entered"))
        && System.nanoTime() < enteredDeadline) {
      Thread.sleep(20);
    }
    assertThat(Files.exists(TEMP.resolve("initial-context-check-entered"))).isTrue();
    invalidPreReadyReports(failureId);
    var beforeRollback = failureState(failureId);
    HOLD_TERMINAL_RETRY.set(true);
    FAIL_TERMINAL_COMMIT.set(true);
    Files.writeString(
        TEMP.resolve("initial-context-state.json"), "{\"pause\":false,\"fail\":true}");
    try {
      assertThat(retryPaused.await(10, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      assertThat(TERMINAL_ROLLBACKS.get()).isEqualTo(1);
      assertThat(failureState(failureId)).isEqualTo(beforeRollback);
    } finally {
      HOLD_TERMINAL_RETRY.set(false);
      retryRelease.countDown();
    }
    JsonNode snapshot = null;
    long until = System.nanoTime() + Duration.ofSeconds(30).toNanos();
    while (System.nanoTime() < until) {
      snapshot = publicCall("/api/v1/studio/executions/" + id, null, 200, null);
      if (snapshot.path("streamComplete").asBoolean()) {
        break;
      }
      Thread.sleep(50);
    }
    assertThat(snapshot).isNotNull();
    assertThat(snapshot.path("streamComplete").asBoolean()).isTrue();
    assertThat(snapshot.path("status").asText()).isIn("FAILED", "ERROR");
    assertThat(snapshot.path("startedAt").isNull()).isTrue();
    assertThat(snapshot.path("stepResults")).hasSize(3);
    for (JsonNode step : snapshot.path("stepResults")) {
      assertThat(step.path("status").asText()).isEqualTo("SKIPPED");
      assertThat(step.path("offsetMs").isNull()).isTrue();
      assertThat(step.path("durationMs").isNull()).isTrue();
    }
    assertThat(snapshot.path("video").path("status").asText()).isEqualTo("AVAILABLE");
    // Initial-context refusal closes recording orderly; partiality remains independent of outcome.
    assertThat(snapshot.path("video").path("partial").asBoolean()).isFalse();
    try (var stored = Files.walk(TEMP.resolve("objects"))) {
      Path video =
          stored
              .filter(
                  path ->
                      path.toString().contains("/" + id + "/") && path.toString().endsWith(".webm"))
              .findFirst()
              .orElseThrow();
      byte[] bytes = Files.readAllBytes(video);
      assertThat(bytes.length).isGreaterThanOrEqualTo(512);
      assertThat(java.util.Arrays.copyOf(bytes, 4))
          .containsExactly((byte) 0x1a, (byte) 0x45, (byte) 0xdf, (byte) 0xa3);
    }
    var videoResponse =
        HttpClient.newBuilder()
            .sslContext(TLS)
            .build()
            .send(
                HttpRequest.newBuilder(
                        URI.create(
                            "https://localhost:" + port + snapshot.path("videoPath").asText()))
                    .header("Cookie", "put_session=" + COOKIE)
                    .header("Range", "bytes=0-3")
                    .GET()
                    .build(),
                HttpResponse.BodyHandlers.ofByteArray());
    assertThat(videoResponse.statusCode()).isEqualTo(206);
    assertThat(videoResponse.body())
        .containsExactly((byte) 0x1a, (byte) 0x45, (byte) 0xdf, (byte) 0xa3);
    assertThat(snapshot.toString()).doesNotContain(SAVED);
    long captureDeadline = System.nanoTime() + Duration.ofSeconds(2).toNanos();
    while (RECEIVED_FAILURE_REPORTS.size() < 2 && System.nanoTime() < captureDeadline) {
      Thread.sleep(10);
    }
    assertThat(RECEIVED_FAILURE_REPORTS).hasSizeGreaterThanOrEqualTo(2);
    for (JsonNode actual : RECEIVED_FAILURE_REPORTS) {
      assertThat(actual.path("kind").asText()).isEqualTo("FINAL");
      assertThat(actual.toString()).doesNotContain(SAVED);
    }
    JsonNode actualFinal = RECEIVED_FAILURE_REPORTS.getLast();
    var terminal = failureState(failureId);
    var duplicate = callback(failureId, actualFinal, CALLBACK);
    assertThat(duplicate.statusCode()).isEqualTo(200);
    assertThat(C.parse(duplicate.body()).path("applied").asBoolean()).isFalse();
    ObjectNode changedDuplicate = ((ObjectNode) actualFinal).deepCopy();
    changedDuplicate.withObject("/outcome").put("errorMessage", "INTERNAL_ERROR");
    var ignored = callback(failureId, changedDuplicate, CALLBACK);
    assertThat(ignored.statusCode()).isEqualTo(200);
    assertThat(C.parse(ignored.body()).path("applied").asBoolean()).isFalse();
    assertThat(failureState(failureId)).isEqualTo(terminal);
    ObjectNode late = ((ObjectNode) actualFinal).deepCopy().put("runnerSequence", 2);
    assertThat(callback(failureId, late, CALLBACK).statusCode()).isEqualTo(409);
    assertThat(failureState(failureId)).isEqualTo(terminal);
    assertThat(Files.readString(TEMP.resolve("ordinary.log"))).doesNotContain(SAVED);
    preReadyId = null;

    Files.writeString(TEMP.resolve("initial-context-state.json"), "{\"fail\":false}");
    assertThat(RECEIPTS).hasSize(submits);
    assertThat(NAVIGATIONS.get()).isEqualTo(navigations);
    assertThat(MODEL_WIRE).hasSize(models);
    assertThat(LEGACY_MODEL_CALLS.get()).isZero();
    Files.writeString(
        TEMP.resolve("queued-and-pre-ready-evidence.json"),
        C.object()
            .put("cancelBeforeDispatch", true)
            .put("expiredGrantBeforeDispatch", true)
            .put("initialContextRefusalRecording", true)
            .put("negativeCallbackAndImmutableCases", PRE_READY_NEGATIVE_CASES.get())
            .put("actualCommitRollbacks", TERMINAL_ROLLBACKS.get())
            .put("extraNavigations", 0)
            .put("extraSubmits", 0)
            .put("extraProviderCalls", 0)
            .toPrettyString());
  }

  private ObjectNode failureReport(UUID id, JsonNode binding, JsonNode receipt) {
    ObjectNode report =
        C.object()
            .put("executionId", id.toString())
            .put("attemptId", binding.path("attemptId").asText())
            .put(
                "admissionId",
                receipt.isNull()
                    ? UUID.randomUUID().toString()
                    : receipt.path("admissionId").asText())
            .put(
                "runnerInstanceId",
                receipt.isNull()
                    ? "observed-fixture"
                    : receipt.path("request").path("runnerInstanceId").asText())
            .put("kind", "FINAL")
            .put("runnerSequence", 1)
            .put("reportedAt", Instant.now().toString())
            .putNull("browserStartedAt")
            .put("logsTruncated", false)
            .put("payloadReduced", false);
    var steps = report.putArray("steps");
    int count =
        jdbc.queryForObject(
            "SELECT jsonb_array_length(source) FROM ui_test_revisions WHERE id=?",
            Integer.class,
            UUID.fromString(binding.path("revisionId").asText()));
    for (int i = 0; i < count; i++) {
      steps
          .addObject()
          .put("stepIndex", i)
          .put("status", "SKIPPED")
          .putNull("startedAtMs")
          .putNull("finishedAtMs")
          .putNull("durationMs")
          .putNull("failure");
    }
    report.putArray("logs");
    report
        .putObject("runtimeVersions")
        .put("observedProfile", binding.path("requiredProfile").toString())
        .put("observedBuild", binding.path("requiredBuild").toString());
    report
        .putObject("outcome")
        .put("result", "ERROR")
        .put("errorCode", "RUN_ERROR")
        .put("errorMessage", "TARGET_DRIFT");
    report
        .putObject("evidence")
        .putNull("videoKey")
        .putNull("manifestKey")
        .put("state", "UNAVAILABLE")
        .put("partial", false);
    return report;
  }

  private HttpResponse<String> callback(UUID id, JsonNode body, String bearer) throws Exception {
    var request =
        HttpRequest.newBuilder(
                URI.create(
                    "https://localhost:"
                        + port
                        + "/internal/studio/executions/"
                        + id
                        + "/progress"))
            .header("Authorization", "Bearer " + bearer)
            .header("X-Observed-Negative-Probe", "1")
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body.toString()))
            .build();
    return HttpClient.newBuilder()
        .sslContext(TLS)
        .build()
        .send(request, HttpResponse.BodyHandlers.ofString());
  }

  private Map<String, Object> failureState(UUID id) {
    return jdbc.queryForMap(
        "SELECT"
            + " e.status,e.browser_started_at,e.ended_at,e.snapshot_revision,e.video_key,e.video_status,"
            + " l.state AS"
            + " ledger_state,l.last_runner_sequence,l.attempt_id,l.admission_id,l.runner_instance_id"
            + " FROM ui_test_executions e JOIN studio_dispatch_ledger l ON l.execution_id=e.id AND"
            + " l.execution_accepted_at=e.started_at WHERE e.id=?",
        id);
  }

  private JsonNode observedBinding(UUID id) {
    return C.parse(
        jdbc.queryForObject(
            "SELECT observed_revision_binding::text FROM ui_test_executions WHERE id=?",
            String.class,
            id));
  }

  private void invalidPreReadyReports(UUID id) throws Exception {
    JsonNode binding = observedBinding(id);
    JsonNode receipt =
        C.parse(
            jdbc.queryForObject(
                "SELECT observed_admission_receipt::text FROM ui_test_executions WHERE id=?",
                String.class,
                id));
    ObjectNode baseline = failureReport(id, binding, receipt);
    var before = failureState(id);
    assertThat(before.get("ledger_state")).isEqualTo("ADMITTED");
    assertThat(before.get("last_runner_sequence")).isEqualTo(0L);
    assertThat(before.get("browser_started_at")).isNull();
    var mutations = new java.util.LinkedHashMap<String, java.util.function.Consumer<ObjectNode>>();
    mutations.put("wrong execution", r -> r.put("executionId", UUID.randomUUID().toString()));
    mutations.put("wrong attempt", r -> r.put("attemptId", UUID.randomUUID().toString()));
    mutations.put("wrong admission", r -> r.put("admissionId", UUID.randomUUID().toString()));
    mutations.put("wrong worker", r -> r.put("runnerInstanceId", "another-worker"));
    mutations.put("sequence zero", r -> r.put("runnerSequence", 0));
    mutations.put("first sequence two", r -> r.put("runnerSequence", 2));
    mutations.put("STARTED without origin", r -> r.put("kind", "STARTED"));
    mutations.put("PROGRESS before start", r -> r.put("kind", "PROGRESS"));
    mutations.put("forged origin", r -> r.put("browserStartedAt", Instant.now().toString()));
    mutations.put("PASSED outcome", r -> r.withObject("/outcome").put("result", "PASSED"));
    mutations.put(
        "FAILED assertion outcome", r -> r.withObject("/outcome").put("result", "FAILED"));
    mutations.put(
        "unsupported outer code", r -> r.withObject("/outcome").put("errorCode", "STEP_FAILED"));
    mutations.put(
        "unbounded private reason", r -> r.withObject("/outcome").put("errorMessage", SAVED));
    for (String code :
        List.of(
            "READ_REFUSED",
            "ASSERTION_FAILED",
            "REFERENCE_REFUSED",
            "OUTCOME_UNKNOWN",
            "account_unknown")) {
      mutations.put(
          "unsupported inner " + code, r -> r.withObject("/outcome").put("errorMessage", code));
    }
    for (String field : List.of("startedAtMs", "finishedAtMs", "durationMs")) {
      mutations.put("zero " + field, r -> ((ObjectNode) r.path("steps").get(0)).put(field, 0));
      mutations.put("positive " + field, r -> ((ObjectNode) r.path("steps").get(0)).put(field, 1));
    }
    for (String status : List.of("PENDING", "RUNNING", "PASS", "FAIL")) {
      mutations.put(
          "executed step " + status,
          r -> ((ObjectNode) r.path("steps").get(0)).put("status", status));
    }
    mutations.put(
        "step failure",
        r -> ((ObjectNode) r.path("steps").get(0)).put("failure", "forged failure"));
    mutations.put(
        "duplicate coordinate", r -> ((ObjectNode) r.path("steps").get(1)).put("stepIndex", 0));
    mutations.put("out of range", r -> ((ObjectNode) r.path("steps").get(0)).put("stepIndex", 99));
    mutations.put(
        "null coordinate", r -> ((ObjectNode) r.path("steps").get(0)).putNull("stepIndex"));
    mutations.put(
        "missing coordinate",
        r -> ((com.fasterxml.jackson.databind.node.ArrayNode) r.path("steps")).remove(2));
    mutations.put(
        "reduced incomplete",
        r -> {
          r.put("payloadReduced", true);
          ((com.fasterxml.jackson.databind.node.ArrayNode) r.path("steps")).remove(2);
        });
    mutations.put(
        "extra coordinate",
        r ->
            ((com.fasterxml.jackson.databind.node.ArrayNode) r.path("steps"))
                .add(r.path("steps").get(0).deepCopy()));
    mutations.put(
        "null step",
        r ->
            ((com.fasterxml.jackson.databind.node.ArrayNode) r.path("steps"))
                .set(0, com.fasterxml.jackson.databind.node.NullNode.instance));
    mutations.put(
        "log reading",
        r ->
            r.putArray("logs")
                .addObject()
                .put("atMs", 0)
                .put("level", "info")
                .put("message", SAVED));
    mutations.put(
        "claimed foreign revision", r -> r.put("revisionId", UUID.randomUUID().toString()));
    for (var mutation : mutations.entrySet()) {
      ObjectNode invalid = baseline.deepCopy();
      mutation.getValue().accept(invalid);
      var response = callback(id, invalid, CALLBACK);
      assertThat(response.statusCode())
          .as(mutation.getKey() + ": " + response.body())
          .isIn(400, 409);
      assertThat(response.body()).doesNotContain(SAVED);
      assertThat(failureState(id)).as(mutation.getKey()).isEqualTo(before);
    }
    assertThat(callback(id, baseline, "untrusted-service").statusCode()).isIn(401, 403);
    assertThat(failureState(id)).isEqualTo(before);
    for (String field : List.of("observed_revision_binding", "observed_admission_receipt")) {
      assertThatThrownBy(
              () -> jdbc.update("UPDATE ui_test_executions SET " + field + "=NULL WHERE id=?", id))
          .hasMessageContaining("observed execution identity immutable");
    }
    ObjectNode foreign =
        ((ObjectNode) binding).deepCopy().put("revisionId", UUID.randomUUID().toString());
    assertThatThrownBy(
            () ->
                jdbc.update(
                    "UPDATE ui_test_executions SET observed_revision_binding=?::jsonb WHERE id=?",
                    foreign.toString(),
                    id))
        .hasMessageContaining("observed execution identity immutable");
    ObjectNode otherReceipt =
        ((ObjectNode) receipt).deepCopy().put("admissionId", UUID.randomUUID().toString());
    assertThatThrownBy(
            () ->
                jdbc.update(
                    "UPDATE ui_test_executions SET observed_admission_receipt=?::jsonb WHERE id=?",
                    otherReceipt.toString(),
                    id))
        .hasMessageContaining("observed execution identity immutable");
    assertThat(failureState(id)).isEqualTo(before);
    PRE_READY_NEGATIVE_CASES.set(mutations.size() + 5);
  }

  @Test
  @org.junit.jupiter.api.Order(3)
  void editedSourceKeepsHistoricalReceiptWithoutRegainingReplayReadiness() throws Exception {
    assertThat(publishedTestId).isNotNull();
    assertThat(currentPublishedReceipt).isNotNull();
    coreRole = "owner";
    int models = MODEL_WIRE.size(), submissions = RECEIPTS.size(), navigations = NAVIGATIONS.get();
    JsonNode draft =
        publicCall(
            "/api/v1/studio/tests/" + publishedTestId + "?authoringSchemaVersion=2",
            null,
            200,
            null);
    ObjectNode changed = C.object();
    for (String field :
        List.of(
            "authoringSchemaVersion",
            "globalContext",
            "steps",
            "name",
            "description",
            "csiId",
            "environment",
            "variables",
            "configuration",
            "sourceRevision",
            "configurationRevision")) {
      changed.set(field, draft.path(field).deepCopy());
    }
    ((ObjectNode) changed.path("steps").get(0)).put("text", TEXT.get(0) + " Updated source.");
    var request =
        HttpRequest.newBuilder(
                URI.create("https://localhost:" + port + "/api/v1/studio/tests/" + publishedTestId))
            .header("Cookie", "put_session=" + COOKIE)
            .header("Content-Type", "application/json")
            .header("Idempotency-Key", UUID.randomUUID().toString())
            .PUT(HttpRequest.BodyPublishers.ofString(changed.toString()))
            .build();
    var response =
        HttpClient.newBuilder()
            .sslContext(TLS)
            .build()
            .send(request, HttpResponse.BodyHandlers.ofString());
    assertThat(response.statusCode()).as(response.body()).isEqualTo(200);
    assertThat(C.parse(response.body()).path("sourceRevision").asLong()).isEqualTo(2);
    JsonNode refused =
        publicCall(
            "/api/v1/studio/tests/" + publishedTestId + "/execute",
            C.object(),
            409,
            UUID.randomUUID().toString());
    assertThat(refused.toString()).contains("COMPILE_REQUIRED");
    coreRole = "viewer";
    JsonNode historical =
        publicCall(
            "/api/v3/studio/guided-sessions/" + currentPublishedSession + "/result",
            null,
            200,
            null);
    assertThat(historical.path("publication").path("receipt")).isEqualTo(currentPublishedReceipt);
    assertThat(historical.path("currentReadiness").path("code").asText())
        .isEqualTo("SOURCE_CHANGED");
    assertThat(historical.path("currentReadiness").path("ready").asBoolean()).isFalse();
    JsonNode finalRequest =
        C.object()
            .put("schemaVersion", 3)
            .put("expectedSourceRevision", "1")
            .put("expectedConfigurationRevision", "1");
    assertThat(
            publicCall(
                "/api/v3/studio/guided-sessions/" + currentPublishedSession + "/finalize",
                finalRequest,
                200,
                UUID.randomUUID().toString()))
        .isEqualTo(currentPublishedReceipt);
    assertThat(MODEL_WIRE).hasSize(models);
    assertThat(LEGACY_MODEL_CALLS.get()).isZero();
    assertThat(RECEIPTS).hasSize(submissions);
    assertThat(NAVIGATIONS.get()).isEqualTo(navigations);
    coreRole = "owner";
  }

  /**
   * Both revision heads come from genuine explicit learning; only activation setup is relational.
   */
  private void schedulerAndNewHead(
      UUID testId,
      String originalSession,
      JsonNode start,
      JsonNode finalize,
      JsonNode originalReceipt)
      throws Exception {
    assertThat(
            jdbc.queryForObject(
                "SELECT count(*) FROM studio_schedules WHERE test_id=?", Integer.class, testId))
        .isZero();
    UUID schedule = UUID.randomUUID(),
        oldRevision = UUID.fromString(originalReceipt.path("revisionId").asText());
    jdbc.update(
        "INSERT INTO"
            + (" studio_schedules(id,test_id,csi_id,cron_expression,time_zone,execution_principal,cre"
                + "ated_by,updated_by)")
            + " VALUES (?,?,'CSI-123','0 * * * *"
            + " *','UTC','user-1','fixture@example.invalid','fixture@example.invalid')",
        schedule,
        testId);
    UUID activation = arrangeActivation(schedule, testId, oldRevision, 2);
    Map<String, Object> before = activationIdentity(schedule);
    coreRole = "owner";
    int priorSubmits = RECEIPTS.size(), priorCalls = MODEL_WIRE.size();
    JsonNode started =
        publicCall("/api/v3/studio/guided-sessions", start, 202, UUID.randomUUID().toString());
    String secondSession = started.path("session").path("sessionId").asText();
    assertThat(secondSession).isNotEqualTo(originalSession);
    awaitFinalizing(secondSession);
    assertThat(RECEIPTS).hasSize(priorSubmits + 1);
    assertThat(RECEIPTS.getLast()).isEqualTo(VALUES.getLast());
    int afterLearningCalls = MODEL_WIRE.size();
    assertThat(afterLearningCalls).isGreaterThan(priorCalls);
    JsonNode nextReceipt =
        publicCall(
            "/api/v3/studio/guided-sessions/" + secondSession + "/finalize",
            finalize,
            200,
            UUID.randomUUID().toString());
    assertThat(nextReceipt.path("revisionId")).isNotEqualTo(originalReceipt.path("revisionId"));
    currentPublishedSession = secondSession;
    currentPublishedReceipt = nextReceipt.deepCopy();
    assertThat(activationIdentity(schedule)).isEqualTo(before);
    assertThat(RECEIPTS).hasSize(priorSubmits + 1);
    assertThat(MODEL_WIRE).hasSize(afterLearningCalls);
    int executions =
        jdbc.queryForObject(
            "SELECT count(*) FROM ui_test_executions WHERE ui_test_id=?", Integer.class, testId);
    scheduling.setEnabled(true);
    try {
      assertThat(scheduleProcessor.process(testId)).isEqualTo("ACTIVATION_REVISION_MISMATCH");
      assertThat(activationIdentity(schedule)).isEqualTo(before);
      assertThat(
              jdbc.queryForObject(
                  "SELECT activation_id FROM studio_schedules WHERE id=?", UUID.class, schedule))
          .isEqualTo(activation);
      UUID currentActivation =
          arrangeActivation(
              schedule, testId, UUID.fromString(nextReceipt.path("revisionId").asText()), 4);
      Map<String, Object> current = activationIdentity(schedule);
      assertThat(scheduleProcessor.process(testId)).isEqualTo("OBSERVED_SCHEDULE_AUTH_REQUIRED");
      assertThat(activationIdentity(schedule)).isEqualTo(current);
      assertThat(
              jdbc.queryForObject(
                  "SELECT activation_id FROM studio_schedules WHERE id=?", UUID.class, schedule))
          .isEqualTo(currentActivation);
    } finally {
      scheduling.setEnabled(false);
    }
    assertThat(
            jdbc.queryForObject(
                "SELECT count(*) FROM ui_test_executions WHERE ui_test_id=?",
                Integer.class,
                testId))
        .isEqualTo(executions);
    assertThat(dispatcher.dispatchOnce()).isZero();
    assertThat(RECEIPTS).hasSize(priorSubmits + 1);
    assertThat(MODEL_WIRE).hasSize(afterLearningCalls);
    coreRole = "viewer";
    JsonNode historic =
        publicCall(
            "/api/v3/studio/guided-sessions/" + originalSession + "/result", null, 200, null);
    assertThat(historic.path("publication").path("receipt")).isEqualTo(originalReceipt);
    assertThat(historic.path("currentReadiness").path("code").asText()).isEqualTo("HEAD_CHANGED");
    assertThat(
            publicCall(
                "/api/v3/studio/guided-sessions/" + originalSession + "/finalize",
                finalize,
                200,
                UUID.randomUUID().toString()))
        .isEqualTo(originalReceipt);
    coreRole = "none";
    publicCall("/api/v3/studio/guided-sessions/" + originalSession + "/result", null, 403, null);
    coreRole = "owner";
    ObjectNode proof =
        C.object()
            .put("separateExplicitLearningRuns", 1)
            .put("additionalLearningSubmits", 1)
            .put("finalizationSubmits", 0)
            .put("schedulerExecutions", 0)
            .put("activationMismatch", true)
            .put("unattendedAuthorityRefused", true)
            .put("historicalHeadChanged", true);
    Files.writeString(TEMP.resolve("scheduler-history-evidence.json"), proof.toPrettyString());
  }

  @Test
  @org.junit.jupiter.api.Order(4)
  void asynchronousReceiptRequiresPassiveLearningAndTwoFreshRecordedReplays() throws Exception {
    int beforeModels = MODEL_WIRE.size(),
        beforeNavigations = NAVIGATIONS.get(),
        beforeReceipts = RECEIPTS.size(),
        beforeFailures = PROVIDER_FAILURES.get();
    UUID testId = createSource(TEXT);
    Files.writeString(TEMP.resolve("initial-context-state.json"), "{}");
    asynchronousPage = true;
    try {
      String id = startLearning(testId);
      long deadline = System.nanoTime() + Duration.ofSeconds(60).toNanos();
      JsonNode missingCheckpoint = null;
      while (System.nanoTime() < deadline) {
        JsonNode checkpoint =
            sessions.transaction(
                () -> {
                  var session = sessions.lock(id);
                  JsonNode progress = session.progress();
                  JsonNode marker = progress.path("translationAcquisition");
                  JsonNode active = marker.path("active");
                  boolean missing = true;
                  for (JsonNode node : progress.path("observation").path("nodes")) {
                    if (node.path("name").asText().equals("Confirmation")) {
                      missing = false;
                    }
                  }
                  for (JsonNode action : sessions.actions(id)) {
                    if (action.path("coordinate").path("stepId").asText().equals(THREE)
                        && action.path("coordinate").path("ordinal").asInt() == 0
                        && action.path("state").asText().equals("SUCCEEDED")
                        && marker.path("totalExtraPolls").asInt() > 0
                        && active.path("pending").isNull()
                        && active.path("lastGeneration").equals(progress.path("generation"))
                        && progress.path("generation").asInt() > action.path("generation").asInt()
                        && missing) {
                      return C.object()
                          .put("generation", progress.path("generation").asInt())
                          .put("extraPolls", marker.path("totalExtraPolls").asInt())
                          .put("observationHash", progress.path("observationHash").asText());
                    }
                  }
                  return null;
                });
        var receiptRelease = ASYNC_RECEIPTS.get(beforeNavigations + 1);
        if (checkpoint != null && receiptRelease != null) {
          assertThat(RECEIPTS).hasSize(beforeReceipts + 1);
          missingCheckpoint = checkpoint;
          receiptRelease.countDown();
          break;
        }
        Thread.sleep(10);
      }
      assertThat(missingCheckpoint)
          .as("real committed missing-target observation; logs %s", TEMP)
          .isNotNull();
      awaitFinalizing(id);
      JsonNode marker =
          sessions.transaction(
              () -> sessions.lock(id).progress().path("translationAcquisition").deepCopy());
      assertThat(marker.path("totalExtraPolls").asInt()).isBetween(1, 32);
      assertThat(RECEIPTS).hasSize(beforeReceipts + 1);
      assertThat(NAVIGATIONS.get()).isEqualTo(beforeNavigations + 1);
      assertThat(MODEL_KINDS.subList(beforeModels, MODEL_KINDS.size()))
          .containsExactly(
              "SOURCE_PLAN",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION");
      int learnedCalls = MODEL_WIRE.size();
      JsonNode receipt =
          publicCall(
              "/api/v3/studio/guided-sessions/" + id + "/finalize",
              C.object()
                  .put("schemaVersion", 3)
                  .put("expectedSourceRevision", "1")
                  .put("expectedConfigurationRevision", "1"),
              200,
              UUID.randomUUID().toString());
      assertThat(RECEIPTS).hasSize(beforeReceipts + 1);
      assertThat(NAVIGATIONS.get()).isEqualTo(beforeNavigations + 1);
      assertThat(MODEL_WIRE).hasSize(learnedCalls);
      UUID revision = UUID.fromString(receipt.path("revisionId").asText());
      String artifact =
          jdbc.queryForObject(
              "SELECT artifact::text FROM ui_test_revisions WHERE id=?", String.class, revision);
      String artifactHash =
          jdbc.queryForObject(
              "SELECT artifact_hash FROM ui_test_revisions WHERE id=?", String.class, revision);
      for (int run = 0; run < 2; run++) {
        int beforeAbsent = java.util.Collections.frequency(PASSIVE_REPLAY, "ABSENT");
        JsonNode accepted =
            publicCall(
                "/api/v1/studio/tests/" + testId + "/execute",
                C.object(),
                202,
                UUID.randomUUID().toString());
        UUID execution = UUID.fromString(accepted.path("executionId").asText());
        assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
        long end = System.nanoTime() + Duration.ofSeconds(45).toNanos();
        JsonNode snapshot = null;
        do {
          snapshot = publicCall("/api/v1/studio/executions/" + execution, null, 200, null);
          if (snapshot.path("streamComplete").asBoolean()) {
            break;
          }
          Thread.sleep(30);
        } while (System.nanoTime() < end);
        assertThat(snapshot.path("status").asText())
            .as("async replay logs %s", TEMP)
            .isEqualTo("PASSED");
        assertThat(snapshot.path("video").path("status").asText()).isEqualTo("AVAILABLE");
        assertThat(java.util.Collections.frequency(PASSIVE_REPLAY, "ABSENT"))
            .isGreaterThan(beforeAbsent);
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact::text FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revision))
            .isEqualTo(artifact);
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revision))
            .isEqualTo(artifactHash);
      }
      assertThat(REPLAY_INVOCATIONS)
          .containsExactly("read", "fill", "click", "assert", "read", "fill", "click", "assert");
      assertThat(NAVIGATIONS.get()).isEqualTo(beforeNavigations + 3);
      assertThat(RECEIPTS.subList(beforeReceipts, RECEIPTS.size()))
          .containsExactlyElementsOf(VALUES.subList(beforeNavigations, VALUES.size()));
      assertThat(VALUES.subList(beforeNavigations, VALUES.size())).doesNotHaveDuplicates();
      assertThat(MODEL_WIRE).hasSize(learnedCalls);
      assertThat(LEGACY_MODEL_CALLS.get()).isZero();
      assertThat(PROVIDER_FAILURES.get()).isEqualTo(beforeFailures);
      ObjectNode metrics =
          C.object()
              .put("learningSubmits", 1)
              .put("finalizationEffects", 0)
              .put("freshReplays", 2)
              .put("sourcePlanCalls", 1)
              .put("nextActionCalls", 5)
              .put("verifyStepCalls", 0)
              .put("replayModelCalls", 0)
              .put("artifactHash", artifactHash);
      metrics.set("committedMissingCheckpoint", missingCheckpoint);
      metrics.set("passiveLearning", marker);
      metrics.set("passiveReplayStates", JSON.valueToTree(PASSIVE_REPLAY));
      metrics.set("nativeInvocations", JSON.valueToTree(REPLAY_INVOCATIONS));
      Files.writeString(TEMP.resolve("async-evidence.json"), metrics.toPrettyString());
    } finally {
      asynchronousPage = false;
      ASYNC_RECEIPTS.values().forEach(java.util.concurrent.CountDownLatch::countDown);
    }
  }

  @Test
  @org.junit.jupiter.api.Order(5)
  void modelAndSourceQuestionTimeDoNotConsumePassiveBrowserAllowance() throws Exception {
    int models = MODEL_WIRE.size(), navigations = NAVIGATIONS.get(), receipts = RECEIPTS.size();
    timingSourceText =
        "Open " + URL + " or " + URL + "?alternative=two and read the Order reference.";
    UUID testId = createSource(List.of(timingSourceText, TEXT.get(1), TEXT.get(2)), 1);
    askTimingSource = true;
    delayTimingModel = true;
    try {
      String id = startLearning(testId);
      long deadline = System.nanoTime() + Duration.ofSeconds(20).toNanos();
      String state = "";
      while (System.nanoTime() < deadline) {
        state = sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
        if (state.equals("AWAITING_CLARIFICATION")) {
          break;
        }
        Thread.sleep(20);
      }
      assertThat(state).isEqualTo("AWAITING_CLARIFICATION");
      JsonNode question =
          publicCall("/api/v3/studio/guided-sessions/" + id + "/clarification", null, 200, null);
      assertThat(question.path("phase").asText()).isEqualTo("source");
      String selected = null;
      for (JsonNode choice : question.path("choices")) {
        if (choice
            .path("safeLabel")
            .asText()
            .equals("Use authored text: " + URL + "?alternative=two")) {
          selected = choice.path("choiceId").asText();
        }
      }
      assertThat(selected).isNotBlank();
      Thread.sleep(1250);
      JsonNode beforeAnswer =
          sessions.transaction(
              () -> sessions.lock(id).progress().path("translationAcquisition").deepCopy());
      assertThat(beforeAnswer.path("allowanceMs").asLong()).isEqualTo(1000);
      assertThat(beforeAnswer.path("totalExtraPolls").asInt()).isZero();
      publicCall(
          "/api/v3/studio/guided-sessions/" + id + "/clarify",
          C.object()
              .put("schemaVersion", 3)
              .put("clarificationId", question.path("clarificationId").asText())
              .put("generation", 0)
              .put("choiceId", selected),
          202,
          UUID.randomUUID().toString());
      awaitFinalizing(id);
      JsonNode marker =
          sessions.transaction(
              () -> sessions.lock(id).progress().path("translationAcquisition").deepCopy());
      assertThat(marker.path("allowanceMs").asLong()).isEqualTo(1000);
      assertThat(marker.path("totalExtraPolls").asInt()).isZero();
      assertThat(marker.path("active").path("usedMs").asLong()).isZero();
      assertThat(delayTimingModel).isFalse();
      assertThat(NAVIGATION_PATHS.subList(navigations, NAVIGATION_PATHS.size()))
          .containsExactly("/flow?alternative=two");
      assertThat(RECEIPTS).hasSize(receipts + 1);
      assertThat(RECEIPTS.getLast()).isEqualTo(VALUES.getLast());
      assertThat(MODEL_KINDS.subList(models, MODEL_KINDS.size()))
          .containsExactly(
              "SOURCE_PLAN",
              "SOURCE_PLAN",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION");
      int calls = MODEL_WIRE.size();
      publicCall(
          "/api/v3/studio/guided-sessions/" + id + "/finalize",
          C.object()
              .put("schemaVersion", 3)
              .put("expectedSourceRevision", "1")
              .put("expectedConfigurationRevision", "1"),
          200,
          UUID.randomUUID().toString());
      assertThat(MODEL_WIRE).hasSize(calls);
      assertThat(RECEIPTS).hasSize(receipts + 1);
      assertThat(NAVIGATIONS.get()).isEqualTo(navigations + 1);
      Files.writeString(
          TEMP.resolve("source-question-timing-evidence.json"),
          C.object()
              .put("humanDelayMs", 1250)
              .put("modelDelayMs", 1250)
              .put("sourceStepTimeoutMs", 1000)
              .put("passiveExtraPolls", 0)
              .put("usedPassiveMs", 0)
              .put("sourcePlanCalls", 2)
              .put("nextActionCalls", 5)
              .put("finalizationEffects", 0)
              .put("sourceChoice", "alternative=two")
              .toPrettyString());
    } finally {
      askTimingSource = false;
      delayTimingModel = false;
    }
  }

  @Test
  @org.junit.jupiter.api.Order(6)
  void absentTargetStopsOnAllowanceOrCancellationWithoutRepeatingSubmittedWork() throws Exception {
    for (boolean cancel : List.of(false, true)) {
      int navigations = NAVIGATIONS.get(), receipts = RECEIPTS.size(), calls = MODEL_WIRE.size();
      UUID test = createSource(TEXT, cancel ? 30 : 1);
      asynchronousPage = true;
      try {
        String id = startLearning(test);
        long until = System.nanoTime() + Duration.ofSeconds(30).toNanos();
        JsonNode checkpoint = null;
        while (System.nanoTime() < until) {
          var current = sessions.transaction(() -> sessions.lock(id));
          JsonNode marker = current.progress().path("translationAcquisition");
          if (marker.path("totalExtraPolls").asInt() > 0
              && ASYNC_RECEIPTS.containsKey(navigations + 1)) {
            checkpoint = marker.deepCopy();
            break;
          }
          Thread.sleep(10);
        }
        assertThat(checkpoint).as("real passive wait before stopping; logs %s", TEMP).isNotNull();
        if (cancel) {
          publicCall(
              "/api/v3/studio/guided-sessions/" + id + "/cancel",
              C.object().put("schemaVersion", 3).put("reason", "userRequested"),
              202,
              UUID.randomUUID().toString());
        }
        String expected = cancel ? "CANCELLED" : "FAILED";
        until = System.nanoTime() + Duration.ofSeconds(10).toNanos();
        String state = "";
        while (System.nanoTime() < until) {
          state = sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
          if (state.equals(expected)) {
            break;
          }
          Thread.sleep(20);
        }
        assertThat(state).as("delayed terminal; logs %s", TEMP).isEqualTo(expected);
        var stopped = sessions.transaction(() -> sessions.lock(id));
        if (!cancel) {
          assertThat(stopped.progress().path("errorCode").asText()).isEqualTo("BUDGET_EXCEEDED");
          assertThat(
                  stopped
                      .progress()
                      .path("translationAcquisition")
                      .path("active")
                      .path("usedMs")
                      .asLong())
              .isEqualTo(1000);
        }
        var actions = sessions.transaction(() -> sessions.actions(id));
        assertThat(actions).hasSize(4);
        assertThat(actions).allMatch(a -> a.path("state").asText().equals("SUCCEEDED"));
        assertThat(MODEL_KINDS.subList(calls, MODEL_KINDS.size()))
            .containsExactly(
                "SOURCE_PLAN", "NEXT_ACTION", "NEXT_ACTION", "NEXT_ACTION", "NEXT_ACTION");
        assertThat(RECEIPTS).hasSize(receipts + 1);
        assertThat(NAVIGATIONS.get()).isEqualTo(navigations + 1);
        int stoppedCalls = MODEL_WIRE.size();
        ASYNC_RECEIPTS.get(navigations + 1).countDown();
        // The real application response may now arrive, but stopped authority cannot continue.
        Thread.sleep(350);
        List<ObjectNode> lateActions = sessions.transaction(() -> sessions.actions(id));
        assertThat(lateActions).isEqualTo(actions);
        String lateState =
            sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
        assertThat(lateState).isEqualTo(expected);
        assertThat(MODEL_WIRE).hasSize(stoppedCalls);
        assertThat(RECEIPTS).hasSize(receipts + 1);
        assertThat(NAVIGATIONS.get()).isEqualTo(navigations + 1);
        assertThat(
                jdbc.queryForObject(
                    "SELECT count(*) FROM ui_test_revisions WHERE test_id=?", Integer.class, test))
            .isZero();
      } finally {
        asynchronousPage = false;
        ASYNC_RECEIPTS.values().forEach(java.util.concurrent.CountDownLatch::countDown);
      }
    }
  }

  @Test
  @org.junit.jupiter.api.Order(7)
  void observedAlternateChoiceSurvivesHumanAndModelDelayAndTwoFreshRecordedReplays()
      throws Exception {
    int models = MODEL_WIRE.size(), navigations = NAVIGATIONS.get(), receipts = RECEIPTS.size();
    int choiceReceipts = CHOICE_RECEIPTS.size(), invocations = REPLAY_INVOCATIONS.size();
    int providerFailures = PROVIDER_FAILURES.get();
    UUID testId = createSource(TEXT, 1);
    observedChoicePage = true;
    askObservedChoice = true;
    try {
      String id = startLearning(testId);
      awaitState(id, "AWAITING_CLARIFICATION");
      JsonNode question =
          publicCall("/api/v3/studio/guided-sessions/" + id + "/clarification", null, 200, null);
      assertThat(question.path("phase").asText()).isEqualTo("observed");
      JsonNode selected = null;
      for (JsonNode choice : question.path("choices")) {
        if (choice.path("safeLabel").asText().equals("Alternate destination")) {
          selected = choice;
        }
      }
      assertThat(selected).isNotNull();
      JsonNode identity =
          C.parse(
              jdbc.queryForObject(
                  "SELECT identity::text FROM studio_guided_clarification_contexts WHERE"
                      + " session_id=? AND clarification_id=?",
                  String.class,
                  id,
                  question.path("clarificationId").asText()));
      JsonNode capture = identity.path("questionCapture");
      JsonNode originalObservation =
          C.parse(
              jdbc.queryForObject(
                  "SELECT observation::text FROM studio_guided_publication_observations WHERE"
                      + " session_id=? AND observation_hash=?",
                  String.class,
                  id,
                  capture.path("observationHash").asText()));
      assertThat(GuidedContracts.hash(originalObservation))
          .isEqualTo(capture.path("observationHash").asText());
      assertThat(originalObservation.path("generation")).isEqualTo(question.path("generation"));
      assertThat(RECEIPTS).hasSize(receipts);
      Thread.sleep(1250);
      publicCall(
          "/api/v3/studio/guided-sessions/" + id + "/clarify",
          C.object()
              .put("schemaVersion", 3)
              .put("clarificationId", question.path("clarificationId").asText())
              .put("generation", question.path("generation").asInt())
              .put("choiceId", selected.path("choiceId").asText()),
          202,
          UUID.randomUUID().toString());
      awaitFinalizing(id);
      JsonNode marker =
          sessions.transaction(
              () -> sessions.lock(id).progress().path("translationAcquisition").deepCopy());
      assertThat(marker.path("allowanceMs").asLong()).isEqualTo(1000);
      assertThat(marker.path("totalExtraPolls").asInt()).isZero();
      assertThat(marker.path("active").path("usedMs").asLong()).isZero();
      var proofRows =
          jdbc.queryForList(
              "SELECT observed_choice_receipt::text AS receipt,proposal::text AS proposal FROM"
                  + " studio_guided_publication_preparations WHERE session_id=? AND"
                  + " observed_choice_receipt IS NOT NULL",
              id);
      assertThat(proofRows).hasSize(1);
      JsonNode witnessReceipt = C.parse((String) proofRows.getFirst().get("receipt"));
      JsonNode exercised = C.parse((String) proofRows.getFirst().get("proposal"));
      assertThat(witnessReceipt.path("acceptedChoiceId")).isEqualTo(selected.path("choiceId"));
      assertThat(witnessReceipt.path("answer").path("nodeId")).isEqualTo(selected.path("nodeId"));
      assertThat(exercised.path("target").path("nodeId")).isNotEqualTo(selected.path("nodeId"));
      assertThat(exercised.path("generation").asInt())
          .isGreaterThan(question.path("generation").asInt());
      assertThat(exercised.path("target").path("locator").path("name").asText())
          .isEqualTo("Alternate destination");
      JsonNode currentPlan = sessions.transaction(() -> plans.state(id).path("plan").deepCopy());
      assertThat(
              GuidedPlanBuilder.unique(
                      currentPlan.path("obligations"),
                      "obligationId",
                      witnessReceipt.path("obligationId").asText())
                  .path("targetIntent")
                  .asText())
          .isEqualTo("Destination");
      assertThat(CHOICE_RECEIPTS).hasSize(choiceReceipts + 1);
      assertThat(CHOICE_RECEIPTS.getLast().path("chosen").asText()).isEqualTo(VALUES.getLast());
      assertThat(CHOICE_RECEIPTS.getLast().path("unchosen").asText()).isEmpty();
      assertThat(MODEL_KINDS.subList(models, MODEL_KINDS.size()))
          .containsExactly(
              "SOURCE_PLAN",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION",
              "NEXT_ACTION");
      int calls = MODEL_WIRE.size();
      JsonNode published =
          publicCall(
              "/api/v3/studio/guided-sessions/" + id + "/finalize",
              C.object()
                  .put("schemaVersion", 3)
                  .put("expectedSourceRevision", "1")
                  .put("expectedConfigurationRevision", "1"),
              200,
              UUID.randomUUID().toString());
      assertThat(MODEL_WIRE).hasSize(calls);
      assertThat(RECEIPTS).hasSize(receipts + 1);
      assertThat(NAVIGATIONS.get()).isEqualTo(navigations + 1);
      UUID revision = UUID.fromString(published.path("revisionId").asText());
      String artifact =
          jdbc.queryForObject(
              "SELECT artifact::text FROM ui_test_revisions WHERE id=?", String.class, revision);
      String artifactHash =
          jdbc.queryForObject(
              "SELECT artifact_hash FROM ui_test_revisions WHERE id=?", String.class, revision);
      for (int run = 0; run < 2; run++) {
        JsonNode accepted =
            publicCall(
                "/api/v1/studio/tests/" + testId + "/execute",
                C.object(),
                202,
                UUID.randomUUID().toString());
        UUID execution = UUID.fromString(accepted.path("executionId").asText());
        assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
        long end = System.nanoTime() + Duration.ofSeconds(45).toNanos();
        JsonNode snapshot;
        do {
          snapshot = publicCall("/api/v1/studio/executions/" + execution, null, 200, null);
          if (snapshot.path("streamComplete").asBoolean()) {
            break;
          }
          Thread.sleep(30);
        } while (System.nanoTime() < end);
        assertThat(snapshot.path("status").asText())
            .as("observed choice logs %s", TEMP)
            .isEqualTo("PASSED");
        assertThat(snapshot.path("video").path("status").asText()).isEqualTo("AVAILABLE");
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact::text FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revision))
            .isEqualTo(artifact);
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revision))
            .isEqualTo(artifactHash);
      }
      assertThat(REPLAY_INVOCATIONS.subList(invocations, REPLAY_INVOCATIONS.size()))
          .containsExactly("read", "fill", "click", "assert", "read", "fill", "click", "assert");
      assertThat(NAVIGATIONS.get()).isEqualTo(navigations + 3);
      assertThat(RECEIPTS).hasSize(receipts + 3);
      assertThat(CHOICE_RECEIPTS).hasSize(choiceReceipts + 3);
      for (int i = 0; i < 3; i++) {
        assertThat(CHOICE_RECEIPTS.get(choiceReceipts + i).path("chosen").asText())
            .isEqualTo(VALUES.get(navigations + i));
        assertThat(CHOICE_RECEIPTS.get(choiceReceipts + i).path("unchosen").asText()).isEmpty();
      }
      assertThat(VALUES.subList(navigations, VALUES.size())).doesNotHaveDuplicates();
      assertThat(MODEL_WIRE).hasSize(calls);
      assertThat(LEGACY_MODEL_CALLS.get()).isZero();
      assertThat(PROVIDER_FAILURES.get()).isEqualTo(providerFailures);
      ObjectNode metrics =
          C.object()
              .put("humanDelayMs", 1250)
              .put("modelDelayMs", 1250)
              .put("sourceStepTimeoutMs", 1000)
              .put("learningSubmits", 1)
              .put("finalizationEffects", 0)
              .put("freshRecordedReplays", 2)
              .put("replayModelCalls", 0)
              .put("bindingReadRetries", 0)
              .put("artifactHash", artifactHash);
      metrics.set("originalQuestionCapture", capture);
      metrics.set("preparationReceipt", witnessReceipt);
      metrics.set(
          "chosenAndUnchosenReceipts",
          JSON.valueToTree(CHOICE_RECEIPTS.subList(choiceReceipts, CHOICE_RECEIPTS.size())));
      metrics.set(
          "nativeInvocations",
          JSON.valueToTree(REPLAY_INVOCATIONS.subList(invocations, REPLAY_INVOCATIONS.size())));
      Files.writeString(TEMP.resolve("observed-choice-evidence.json"), metrics.toPrettyString());
    } finally {
      observedChoicePage = false;
      askObservedChoice = false;
      beforeObservedQuestion = null;
    }
  }

  @Test
  @org.junit.jupiter.api.Order(8)
  void originalQuestionDriftAndSqlCaptureRefusalRollbackAndCommitUsageWithoutAnotherCall()
      throws Exception {
    observedChoicePage = true;
    try {
      for (String mode : List.of("observation-body-drift", "sql-capture")) {
        int calls = MODEL_WIRE.size(), receipts = RECEIPTS.size();
        askObservedChoice = true;
        if (mode.equals("observation-body-drift")) {
          beforeObservedQuestion =
              context ->
                  sessions.transaction(
                      () -> {
                        var current = sessions.lock(context.path("sessionId").asText());
                        // Preserve the reserved attempt identity so this reaches actual question
                        // capture. The acknowledged hash must reject a changed sanitized body.
                        current
                            .progress()
                            .withObject("/observation")
                            .put("scopeHash", "0".repeat(64));
                        sessions.save(current);
                        return null;
                      });
        } else {
          beforeObservedQuestion = null;
          jdbc.execute(
              "CREATE FUNCTION fixture_reject_question_capture() RETURNS trigger LANGUAGE plpgsql"
                  + " AS $$ BEGIN IF EXISTS(SELECT 1 FROM studio_guided_clarification_contexts"
                  + " WHERE session_id=NEW.session_id) THEN RAISE EXCEPTION 'injected original"
                  + " question capture failure'; END IF; RETURN NEW; END $$");
          jdbc.execute(
              "CREATE TRIGGER fixture_reject_question_capture BEFORE INSERT ON"
                  + " studio_guided_publication_observations FOR EACH ROW EXECUTE FUNCTION"
                  + " fixture_reject_question_capture()");
        }
        String id = startLearning(createSource(TEXT));
        try {
          awaitState(id, "FAILED");
          JsonNode result =
              publicCall("/api/v3/studio/guided-sessions/" + id + "/result", null, 200, null);
          assertThat(result.path("errorCode").asText()).isEqualTo("INVALID_CONTRACT");
          assertThat(MODEL_WIRE).hasSize(calls + 4);
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_model_attempts WHERE session_id=? AND"
                          + " status='REJECTED' AND safe_result IS NULL AND input_tokens=20 AND"
                          + " output_tokens=40",
                      Integer.class,
                      id))
              .isEqualTo(1);
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_clarification_contexts WHERE"
                          + " session_id=?",
                      Integer.class,
                      id))
              .isZero();
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_publication_preparations WHERE"
                          + " session_id=? AND observed_choice_receipt IS NOT NULL",
                      Integer.class,
                      id))
              .isZero();
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_publication_observations WHERE"
                          + " session_id=?",
                      Integer.class,
                      id))
              .isEqualTo(1);
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_publications WHERE session_id=?",
                      Integer.class,
                      id))
              .isZero();
          JsonNode counters =
              sessions.transaction(() -> sessions.lock(id).document().path("counters").deepCopy());
          assertThat(counters.path("modelProposals").asInt()).isEqualTo(4);
          assertThat(counters.path("modelInputTokens").asLong()).isPositive();
          assertThat(counters.path("modelOutputTokens").asLong()).isPositive();
          Thread.sleep(1100);
          assertThat(MODEL_WIRE).hasSize(calls + 4);
          assertThat(RECEIPTS).hasSize(receipts);
          assertThat(LEGACY_MODEL_CALLS.get()).isZero();
          ObjectNode metrics =
              C.object()
                  .put("mode", mode)
                  .put("modelCalls", 4)
                  .put("rejectedAttemptInputTokens", 20)
                  .put("rejectedAttemptOutputTokens", 40)
                  .put("rolledBackContexts", 0)
                  .put("rolledBackQuestionObservations", 0)
                  .put("publishedRows", 0)
                  .put("laterGatewayCalls", 0)
                  .put("publicErrorCode", "INVALID_CONTRACT");
          metrics.set("committedCounters", counters);
          Files.writeString(
              TEMP.resolve("question-refusal-" + mode + ".json"), metrics.toPrettyString());
        } finally {
          beforeObservedQuestion = null;
          if (mode.equals("sql-capture")) {
            jdbc.execute(
                "DROP TRIGGER fixture_reject_question_capture ON"
                    + " studio_guided_publication_observations");
            jdbc.execute("DROP FUNCTION fixture_reject_question_capture()");
          }
        }
      }
    } finally {
      observedChoicePage = false;
      askObservedChoice = false;
      beforeObservedQuestion = null;
    }
  }

  private void awaitState(String id, String expected) throws Exception {
    long end = System.nanoTime() + Duration.ofSeconds(30).toNanos();
    while (System.nanoTime() < end) {
      String state =
          sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
      if (state.equals(expected)) {
        return;
      }
      if (List.of("FAILED", "EXPIRED", "UNKNOWN_OUTCOME", "CANCELLED").contains(state)) {
        throw new AssertionError("Expected " + expected + " but got " + state + "; logs " + TEMP);
      }
      Thread.sleep(20);
    }
    throw new AssertionError("Expected " + expected + "; logs " + TEMP);
  }

  private HttpResponse<String> observedAdmissionHttp(String execution, String body)
      throws Exception {
    HttpRequest request =
        HttpRequest.newBuilder(
                URI.create(
                    "https://localhost:"
                        + port
                        + "/internal/studio/executions/"
                        + execution
                        + "/observed-admission"))
            .header("Authorization", "Bearer " + CALLBACK)
            .header("Content-Type", "application/json")
            .POST(
                body == null
                    ? HttpRequest.BodyPublishers.noBody()
                    : HttpRequest.BodyPublishers.ofString(body))
            .build();
    return HttpClient.newBuilder()
        .sslContext(TLS)
        .build()
        .send(request, HttpResponse.BodyHandlers.ofString());
  }

  @Test
  @org.junit.jupiter.api.Order(9)
  void actualSecretLoginPublishesValueFreeAndTwoOrdinaryRunsResolveFreshWithoutModel()
      throws Exception {
    coreRole = "owner";
    String canary = "JOINED-LOGIN-" + UUID.randomUUID();
    var fixtureHttp = HttpClient.newHttpClient();
    fixtureHttp.send(
        HttpRequest.newBuilder(URI.create(SECRET_ORIGIN + "/__reset"))
            .POST(HttpRequest.BodyPublishers.noBody())
            .build(),
        HttpResponse.BodyHandlers.discarding());
    fixtureHttp.send(
        HttpRequest.newBuilder(URI.create(SECRET_ORIGIN + "/__rotate"))
            .POST(HttpRequest.BodyPublishers.ofString(canary))
            .build(),
        HttpResponse.BodyHandlers.discarding());
    UUID testId =
        createSource(
            List.of(
                "Open " + SECRET_ORIGIN + "/login.",
                "Enter <var USER> in User and <secret PASS> as password.",
                "Click Sign in, check Home, open Reports and check Reports appears."));
    jdbc.update(
        ("UPDATE ui_tests SET variables='[{\"name\":\"USER\",\"kind\":\"plain\","
            + "\"value\":\"fixture-user\"},{\"name\":\"PASS\",\"kind\":\"secretRef\"}]'::jsonb"
            + " WHERE id=?"),
        testId);
    var vaultScope = com.citi.put.checks.studio.secrets.VaultScope.of("CSI-123", "fixture", testId);
    VAULT.rotate(
        com.citi.put.checks.studio.secrets.StudioVaultProvider.ReferenceKind.SECRET,
        vaultScope,
        "PASS",
        canary);
    VAULT.bindOrigins(
        com.citi.put.checks.studio.secrets.StudioVaultProvider.ReferenceKind.SECRET,
        vaultScope,
        "PASS",
        SECRET_ORIGIN);
    int baselineReads =
        COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS");
    int baselineModels = MODEL_WIRE.size();
    var canaries = new java.util.ArrayList<String>();
    canaries.add(canary);
    var fixtureReceiptIds = new java.util.ArrayList<String>();
    var videoKeys = new java.util.ArrayList<String>();
    var videoHashes = new java.util.ArrayList<String>();
    var attemptIds = new java.util.ArrayList<String>();
    var decodedVideos = JSON.createArrayNode();
    var sinkBytes = new java.util.LinkedHashMap<String, byte[]>();
    var workerIdentity = joinedWorkerIdentity();
    C5Capture capture = new C5Capture(canaries);
    c5Capture = capture;
    Throwable c5PrimaryFailure = null;
    secretLoginScenario = true;
    try {
      capture.writeProfileValues();
      String sessionId = startLearning(testId);
      awaitFinalizing(sessionId);
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS")
                  - baselineReads)
          .as("one committed guided password dispatch")
          .isEqualTo(1);
      var learned =
          C.parse(
              fixtureHttp
                  .send(
                      HttpRequest.newBuilder(URI.create(SECRET_ORIGIN + "/__receipts"))
                          .GET()
                          .build(),
                      HttpResponse.BodyHandlers.ofString())
                  .body());
      assertThat(learned.size()).isEqualTo(1);
      assertThat(learned.get(0).path("accepted").asBoolean()).isTrue();
      assertThat(learned.get(0).path("username").asText()).isEqualTo("fixture-user");
      fixtureReceiptIds.add(learned.get(0).path("id").asText());
      assertThat(learned.get(0).path("password").asText().equals(canary)).isTrue();
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE session_id=?"
                      + " AND secret_id='PASS' AND row_kind='USAGE' AND usage_outcome='USED'",
                  Integer.class,
                  sessionId))
          .isEqualTo(1);
      int learningModels = MODEL_WIRE.size();
      assertThat(learningModels - baselineModels).isPositive();
      var finalize =
          C.object()
              .put("schemaVersion", 3)
              .put("expectedSourceRevision", "1")
              .put("expectedConfigurationRevision", "1");
      int beforePublicationReads = COUNTED_VAULT.reads.size();
      JsonNode publication =
          publicCall(
              "/api/v3/studio/guided-sessions/" + sessionId + "/finalize",
              finalize,
              200,
              UUID.randomUUID().toString());
      UUID revisionId = UUID.fromString(publication.path("revisionId").asText());
      String artifact =
          jdbc.queryForObject(
              "SELECT artifact::text FROM ui_test_revisions WHERE id=?", String.class, revisionId);
      String artifactHash =
          jdbc.queryForObject(
              "SELECT artifact_hash FROM ui_test_revisions WHERE id=?", String.class, revisionId);
      assertThat(independentArtifactHash(C.parse(artifact))).isEqualTo(artifactHash);
      assertThat(publication.path("artifactHash").asText()).isEqualTo(artifactHash);
      assertThat(COUNTED_VAULT.reads.size()).isEqualTo(beforePublicationReads);
      sinkBytes.put("publication", publication.toString().getBytes(StandardCharsets.UTF_8));
      sinkBytes.put("artifact", artifact.getBytes(StandardCharsets.UTF_8));
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS")
                  - baselineReads)
          .as("publication performs zero value reads")
          .isEqualTo(1);
      assertThat(MODEL_WIRE.size()).isEqualTo(learningModels);
      var executions = new java.util.ArrayList<UUID>();
      for (int run = 0; run < 2; run++) {
        String actual = run == 0 ? canary : "ROTATED-LOGIN-" + UUID.randomUUID();
        if (run == 1) {
          canaries.add(actual);
          capture.writeProfileValues();
          VAULT.rotate(
              com.citi.put.checks.studio.secrets.StudioVaultProvider.ReferenceKind.SECRET,
              vaultScope,
              "PASS",
              actual);
          VAULT.bindOrigins(
              com.citi.put.checks.studio.secrets.StudioVaultProvider.ReferenceKind.SECRET,
              vaultScope,
              "PASS",
              SECRET_ORIGIN);
          fixtureHttp.send(
              HttpRequest.newBuilder(URI.create(SECRET_ORIGIN + "/__rotate"))
                  .POST(HttpRequest.BodyPublishers.ofString(actual))
                  .build(),
              HttpResponse.BodyHandlers.discarding());
        }
        UUID execution =
            UUID.fromString(
                publicCall(
                        "/api/v1/studio/tests/" + testId + "/execute",
                        C.object(),
                        202,
                        UUID.randomUUID().toString())
                    .path("executionId")
                    .asText());
        executions.add(execution);
        capture.watchExecution(execution);
        JsonNode binding = observedBinding(execution);
        assertThat(binding.path("artifactHash").asText()).isEqualTo(artifactHash);
        assertThat(binding.path("revisionId").asText()).isEqualTo(revisionId.toString());
        attemptIds.add(binding.path("attemptId").asText());
        assertThat(attemptIds).doesNotHaveDuplicates();
        assertThat(
                COUNTED_VAULT.readCount(
                        StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS")
                    - baselineReads)
            .as("acceptance remains names-only")
            .isEqualTo(run + 1);
        assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
        long deadline = System.nanoTime() + Duration.ofSeconds(45).toNanos();
        String status = "";
        while (System.nanoTime() < deadline) {
          status =
              jdbc.queryForObject(
                  "SELECT status FROM ui_test_executions WHERE id=?", String.class, execution);
          if (List.of("PASSED", "FAILED", "ERROR").contains(status)) {
            break;
          }
          Thread.sleep(50);
        }
        assertThat(status)
            .as("actual compiled child login, evidence at %s", TEMP)
            .isEqualTo("PASSED");
        assertThat(
                COUNTED_VAULT.readCount(
                        StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS")
                    - baselineReads)
            .isEqualTo(run + 2);
        assertThat(MODEL_WIRE.size()).isEqualTo(learningModels);
        assertThat(LEGACY_MODEL_CALLS.get()).isZero();
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact::text FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revisionId))
            .isEqualTo(artifact);
        assertThat(
                jdbc.queryForObject(
                    "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                    String.class,
                    revisionId))
            .isEqualTo(artifactHash);
        JsonNode receipts =
            C.parse(
                fixtureHttp
                    .send(
                        HttpRequest.newBuilder(URI.create(SECRET_ORIGIN + "/__receipts"))
                            .GET()
                            .build(),
                        HttpResponse.BodyHandlers.ofString())
                    .body());
        assertThat(receipts.size()).isEqualTo(run + 2);
        assertThat(receipts.get(run + 1).path("accepted").asBoolean()).isTrue();
        assertThat(receipts.get(run + 1).path("username").asText()).isEqualTo("fixture-user");
        fixtureReceiptIds.add(receipts.get(run + 1).path("id").asText());
        assertThat(fixtureReceiptIds).doesNotHaveDuplicates();
        assertThat(receipts.get(run + 1).path("password").asText().equals(actual)).isTrue();
        assertThat(
                jdbc.queryForObject(
                    ("SELECT count(*) FROM studio_secret_use_audit WHERE execution_id=? AND row_kind='USAGE"
                        + "' AND usage_outcome='USED'"),
                    Integer.class,
                    execution))
            .isEqualTo(1);
        assertThat(
                jdbc.queryForObject(
                    "SELECT count(*) FROM studio_observed_secret_read_entries WHERE execution_id=?",
                    Integer.class,
                    execution))
            .isEqualTo(1);
        assertThat(
                jdbc.queryForObject(
                    ("SELECT browser_started_at IS NOT NULL AND video_key IS NOT NULL AND observed_admissio"
                        + "n_receipt IS NOT NULL FROM ui_test_executions WHERE id=?"),
                    Boolean.class,
                    execution))
            .isTrue();
        JsonNode snapshot = awaitJoinedVideo(execution);
        sinkBytes.put("snapshot-" + run, snapshot.toString().getBytes(StandardCharsets.UTF_8));
        String videoKey =
            jdbc.queryForObject(
                "SELECT video_key FROM ui_test_executions WHERE id=?", String.class, execution);
        Path video = TEMP.resolve("objects").resolve(videoKey).normalize();
        assertThat(video.startsWith(TEMP.resolve("objects"))).isTrue();
        assertThat(Files.isRegularFile(video, java.nio.file.LinkOption.NOFOLLOW_LINKS)).isTrue();
        assertThat(Files.isSymbolicLink(video)).isFalse();
        byte[] videoBytes = Files.readAllBytes(video);
        assertThat(videoBytes.length).isPositive();
        HttpResponse<byte[]> served =
            HttpClient.newBuilder()
                .sslContext(TLS)
                .build()
                .send(
                    HttpRequest.newBuilder(
                            URI.create(
                                "https://localhost:"
                                    + port
                                    + "/api/v1/studio/executions/"
                                    + execution
                                    + "/video"))
                        .timeout(Duration.ofSeconds(15))
                        .header("Cookie", "put_session=" + COOKIE)
                        .GET()
                        .build(),
                    HttpResponse.BodyHandlers.ofByteArray());
        assertThat(served.statusCode()).isEqualTo(200);
        assertThat(java.util.Arrays.equals(served.body(), videoBytes)).isTrue();
        videoKeys.add(videoKey);
        videoHashes.add(
            HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(videoBytes)));
        decodedVideos.add(decodeJoinedVideo(video, execution));
        sinkBytes.put("native-video-" + run, videoBytes);
        collectJoinedSinks(sinkBytes);
        for (String value : canaries) {
          assertJoinedSinkAbsent(sinkBytes, value);
          assertThat(MODEL_WIRE.stream().anyMatch(wire -> wire.contains(value))).isFalse();
          for (String file : List.of("guided.log", "ordinary.log")) {
            assertThat(Files.readString(TEMP.resolve(file)).contains(value))
                .as("redacted actual %s", file)
                .isFalse();
          }
        }
      }
      assertThat(
              jdbc.queryForObject(
                  ("SELECT count(DISTINCT vault_version) FROM studio_secret_use_audit WHERE execution_id "
                      + "IN (?,?) AND row_kind='RELEASE' AND decision_stage='DISPATCH'"),
                  Integer.class,
                  executions.get(0),
                  executions.get(1)))
          .isEqualTo(2);
      assertThat(executions).doesNotHaveDuplicates();
      assertThat(videoKeys).doesNotHaveDuplicates();
      assertThat(videoHashes).doesNotHaveDuplicates();
      assertThat(
              COUNTED_VAULT.readCount(
                  StudioVaultProvider.ReferenceKind.VARIABLE, vaultScope, "USER"))
          .as("plain USER comes from accepted configuration, not Vault")
          .isZero();
      var secretReads =
          COUNTED_VAULT.reads.stream()
              .filter(
                  read ->
                      read.key.equals(
                          com.citi.put.checks.studio.secrets.FakeStudioVaultProvider.key(
                              StudioVaultProvider.ReferenceKind.SECRET, vaultScope, "PASS")))
              .toList();
      assertThat(secretReads).hasSize(3);
      for (OwnedVaultRead read : secretReads) {
        assertThat(read.value != null && allErased(read.value))
            .as("actual delivered provider array erased")
            .isTrue();
      }
      assertThat(secretReads.stream().map(read -> read.version).distinct().count()).isEqualTo(2);
      assertThat(joinedWorkerIdentity()).isEqualTo(workerIdentity);
      var evidence =
          C.object()
              .put(
                  "scope",
                  "actual Core HTTP/PostgreSQL/counted Vault/compiled worker/full Chromium")
              .put("guidedValueReads", 1)
              .put("publicationValueReads", 0)
              .put("ordinaryValueReads", 2)
              .put("learningModelCalls", learningModels - baselineModels)
              .put("publicationReplayModelCalls", 0)
              .put("revisionId", revisionId.toString())
              .put("rotated", true)
              .put("artifactHash", artifactHash)
              .put("plainUserVaultReads", 0)
              .put("nativeVideosDecoded", decodedVideos.size())
              .put("fixturePasswordReceipts", "TEST_ONLY_ORACLE_EXCLUDED_FROM_PRODUCT_SINKS")
              .put(
                  "remaining",
                  "TRACE/SSE/metrics/profile-before-cleanup/all fault sinks and actual service"
                      + " consume/read/send/recovery remain unproved");
      evidence.set("workerIdentity", workerIdentity);
      evidence.set("nativeVideos", decodedVideos);
      evidence.set("videoKeys", JSON.valueToTree(videoKeys));
      evidence.set("executionIds", JSON.valueToTree(executions));
      evidence.set("attemptIds", JSON.valueToTree(attemptIds));
      evidence.set("videoHashes", JSON.valueToTree(videoHashes));
      evidence.set("fixtureReceiptIds", JSON.valueToTree(fixtureReceiptIds));
      evidence.set(
          "scannedSinkByteCounts",
          JSON.valueToTree(
              sinkBytes.entrySet().stream()
                  .collect(
                      java.util.stream.Collectors.toMap(
                          Map.Entry::getKey, e -> e.getValue().length))));
      evidence.put("imageProvenance", "NOT_ASSERTED_CONTROLLED_LOCAL_CATALOG");
      collectJoinedSinks(sinkBytes);
      for (String value : canaries) {
        assertJoinedSinkAbsent(sinkBytes, value);
      }
      capture.writeNumericEvidence();
      Files.writeString(
          TEMP.resolve("secret-login-joined-evidence.json"), evidence.toPrettyString());
    } catch (Exception | Error original) {
      c5PrimaryFailure = original;
      throw original;
    } finally {
      try {
        capture.close();
      } catch (Exception | Error cleanup) {
        if (c5PrimaryFailure != null) {
          c5PrimaryFailure.addSuppressed(cleanup);
        } else {
          throw cleanup;
        }
      } finally {
        c5Capture = null;
        secretLoginScenario = false;
      }
    }
  }

  /** Test-only accounting at the existing provider seam; it never resolves an extra value. */
  @Test
  @org.junit.jupiter.api.Order(10)
  void actualCoreMayUseDenialStartsNoSessionAndNoBrowser() throws Exception {
    p3Case(
        () -> {
          p3Mode = P3Mode.REGISTRATION;
          UUID positive = p3CreateSource("CSI-123", "fixture", false);
          String warm = p3Start(positive, "fixture");
          awaitFinalizing(warm);
          p3Publish(warm);
          JsonNode registered = p3LaunchCounter();
          assertThat(registered.path("registered").asBoolean()).isTrue();
          assertThat(registered.path("count").asLong()).isPositive();
          p3Mode = P3Mode.LOGIN;
          UUID denied = p3CreateSource("CSI-123", "fixture", true);
          VaultScope scope = VaultScope.of("CSI-123", "fixture", denied);
          p3Seed(scope, "P3-DENIED-" + UUID.randomUUID());
          String deniedCookie = p3CoreCookie("p3-denied", "p3-denied@example.invalid");
          int calls = MODEL_WIRE.size(),
              reads = COUNTED_VAULT.reads.size(),
              core = CORE_CALLS.get();
          long launches = p3LaunchCounter().path("count").asLong();
          JsonNode refusal =
              p3Call(
                  deniedCookie,
                  "/api/v3/studio/guided-sessions",
                  p3StartCommand(denied, "fixture"),
                  403);
          assertThat(refusal.path("code").asText()).isEqualTo("SECRET_USE_NOT_AUTHORIZED");
          assertThat(CORE_CALLS.get()).isGreaterThan(core);
          assertThat(
                  P3_MAY_USE.stream()
                      .anyMatch(
                          call ->
                              call.principal().equals("p3-denied")
                                  && call.csi().equals("CSI-123")
                                  && call.environment().equals("fixture")
                                  && call.name().equals("PASS")))
              .isTrue();
          assertThat(
                  jdbc.queryForObject(
                      "SELECT count(*) FROM studio_guided_sessions WHERE test_id=?",
                      Long.class,
                      denied.toString()))
              .isZero();
          assertThat(MODEL_WIRE.size()).isEqualTo(calls);
          assertThat(COUNTED_VAULT.reads.size()).isEqualTo(reads);
          assertThat(p3LaunchCounter().path("count").asLong()).isEqualTo(launches);
          p3WriteEvidence(
              "core-start-denial",
              C.object()
                  .put("coreCalls", CORE_CALLS.get() - core)
                  .put("valueReads", COUNTED_VAULT.reads.size() - reads)
                  .put("newLaunchCalls", p3LaunchCounter().path("count").asLong() - launches)
                  .put("registeredPositiveLaunchCount", registered.path("count").asLong())
                  .put(
                      "sessions",
                      jdbc.queryForObject(
                          "SELECT count(*) FROM studio_guided_sessions WHERE test_id=?",
                          Long.class,
                          denied.toString())));
        });
  }

  @Test
  @org.junit.jupiter.api.Order(11)
  void actualCoreGuidedSameSecretIdStaysWithinPersistedScope() throws Exception {
    p3Case(
        () -> {
          List<VaultScope> scopes = new java.util.ArrayList<>();
          List<String> canaries = new java.util.ArrayList<>();
          int ordinal = 0;
          for (var axis :
              List.of(
                  Map.entry("CSI-123", "fixture"),
                  Map.entry("CSI-456", "fixture"),
                  Map.entry("CSI-123", "fixture-other"),
                  Map.entry("CSI-123", "fixture"))) {
            p3Mode = P3Mode.LOGIN;
            p3Grant(axis.getKey(), axis.getValue());
            UUID test = p3CreateSource(axis.getKey(), axis.getValue(), true);
            VaultScope scope = VaultScope.of(axis.getKey(), axis.getValue(), test);
            String value = "P3-SCOPED-" + UUID.randomUUID();
            canaries.add(value);
            scopes.add(scope);
            p3ExpectedPassword = value;
            P3_RECEIPTS.clear();
            P3_NATIVE_SESSIONS.clear();
            p3Seed(scope, value);
            int read =
                COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
            List<Integer> foreignReads =
                scopes.stream()
                    .map(
                        other ->
                            COUNTED_VAULT.readCount(
                                StudioVaultProvider.ReferenceKind.SECRET, other, "PASS"))
                    .toList();
            String id = p3Start(test, axis.getValue());
            awaitFinalizing(id);
            assertThat(
                    COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                        - read)
                .isEqualTo(1);
            assertThat(P3_RECEIPTS).hasSize(1);
            assertThat(P3_RECEIPTS.getFirst().accepted()).isTrue();
            assertThat(P3_RECEIPTS.getFirst().password().equals(value)).isTrue();
            assertThat(P3_RECEIPTS.getFirst().username().equals("p3-user")).isTrue();
            for (int i = 0; i < scopes.size() - 1; i++) {
              assertThat(
                      COUNTED_VAULT.readCount(
                          StudioVaultProvider.ReferenceKind.SECRET, scopes.get(i), "PASS"))
                  .isEqualTo(foreignReads.get(i));
            }
            assertThat(COUNTED_VAULT.lists.stream().anyMatch(scope::equals)).isTrue();
            p3AssertUsed(id, null);
            p3AssertAuditScope(id, null, scope);
            p3Publish(id);
            p3Scan(canaries);
            // Missing test scope is a real names-only refusal, not a value read or a malformed
            // policy.
            UUID missing = p3CreateSource(axis.getKey(), axis.getValue(), true);
            int values = COUNTED_VAULT.reads.size(), calls = MODEL_WIRE.size();
            JsonNode refusal =
                p3Call(
                    p3Cookie,
                    "/api/v3/studio/guided-sessions",
                    p3StartCommand(missing, axis.getValue()),
                    404);
            assertThat(refusal.path("code").asText()).isEqualTo("SECRET_UNAVAILABLE");
            assertThat(COUNTED_VAULT.reads.size()).isEqualTo(values);
            assertThat(MODEL_WIRE.size()).isEqualTo(calls);
            assertThat(
                    jdbc.queryForObject(
                        "SELECT count(*) FROM studio_guided_sessions WHERE test_id=?",
                        Long.class,
                        missing.toString()))
                .isZero();
            p3WriteEvidence(
                "guided-scope-" + (++ordinal),
                C.object()
                    .put("ordinal", ordinal)
                    .put(
                        "ownReads",
                        COUNTED_VAULT.readCount(
                                StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                            - read)
                    .put("foreignReads", 0)
                    .put("acceptedPosts", P3_RECEIPTS.stream().filter(P3Receipt::accepted).count())
                    .put("missingScopeValueReads", COUNTED_VAULT.reads.size() - values)
                    .put(
                        "namesLookupObserved",
                        COUNTED_VAULT.lists.stream().anyMatch(scope::equals)));
          }
        });
  }

  @Test
  @org.junit.jupiter.api.Order(12)
  void actualCoreOrdinarySameSecretIdStaysWithinAcceptedScope() throws Exception {
    p3Case(
        () -> {
          List<VaultScope> scopes = new java.util.ArrayList<>();
          List<String> canaries = new java.util.ArrayList<>();
          int ordinal = 0;
          for (var axis :
              List.of(
                  Map.entry("CSI-123", "fixture"),
                  Map.entry("CSI-456", "fixture"),
                  Map.entry("CSI-123", "fixture-other"),
                  Map.entry("CSI-123", "fixture"))) {
            p3Mode = P3Mode.LOGIN;
            p3Grant(axis.getKey(), axis.getValue());
            UUID test = p3CreateSource(axis.getKey(), axis.getValue(), true);
            VaultScope scope = VaultScope.of(axis.getKey(), axis.getValue(), test);
            scopes.add(scope);
            String value = "P3-ORDINARY-" + UUID.randomUUID();
            canaries.add(value);
            p3ExpectedPassword = value;
            P3_RECEIPTS.clear();
            P3_NATIVE_SESSIONS.clear();
            p3Seed(scope, value);
            String id = p3Start(test, axis.getValue());
            awaitFinalizing(id);
            P3Publication published = p3Publish(id);
            int models = MODEL_WIRE.size();
            P3_NATIVE_SESSIONS.clear();
            P3_RECEIPTS.clear();
            List<Integer> beforeReads =
                scopes.stream()
                    .map(
                        other ->
                            COUNTED_VAULT.readCount(
                                StudioVaultProvider.ReferenceKind.SECRET, other, "PASS"))
                    .toList();
            UUID execution = p3Execute(test);
            p3AssertBinding(execution, scope, published);
            assertThat(
                    COUNTED_VAULT.readCount(
                        StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS"))
                .isEqualTo(beforeReads.getLast());
            assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
            JsonNode report = p3AwaitExecution(execution, "PASSED");
            assertThat(
                    COUNTED_VAULT.readCount(
                        StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS"))
                .isEqualTo(beforeReads.getLast() + 1);
            for (int i = 0; i < scopes.size() - 1; i++) {
              assertThat(
                      COUNTED_VAULT.readCount(
                          StudioVaultProvider.ReferenceKind.SECRET, scopes.get(i), "PASS"))
                  .isEqualTo(beforeReads.get(i));
            }
            assertThat(P3_RECEIPTS).hasSize(1);
            assertThat(P3_RECEIPTS.getFirst().accepted()).isTrue();
            assertThat(P3_RECEIPTS.getFirst().password().equals(value)).isTrue();
            assertThat(P3_RECEIPTS.getFirst().username().equals("p3-user")).isTrue();
            p3AssertUsed(null, execution);
            p3AssertAuditScope(null, execution, scope);
            p3DecodeVideo(execution, report);
            assertThat(MODEL_WIRE.size()).isEqualTo(models);
            // Genuine accepted scope remains fixed when its own entry vanishes at the actual read.
            P3_NATIVE_SESSIONS.clear();
            P3_RECEIPTS.clear();
            p3Seed(scope, value);
            UUID unavailable = p3Execute(test);
            p3AssertBinding(unavailable, scope, published);
            int reads =
                COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
            P3_FAIL_READ.set(scope);
            assertThat(dispatcher.dispatchOnce()).isZero();
            JsonNode refused = p3AwaitExecution(unavailable, "ERROR");
            assertThat(refused.path("errorCode").asText()).isEqualTo("REFERENCE_UNAVAILABLE");
            assertThat(
                    COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                        - reads)
                .isEqualTo(1);
            assertThat(P3_FAIL_READ.get()).isNull();
            assertThat(P3_RECEIPTS).isEmpty();
            for (int i = 0; i < scopes.size() - 1; i++) {
              assertThat(
                      COUNTED_VAULT.readCount(
                          StudioVaultProvider.ReferenceKind.SECRET, scopes.get(i), "PASS"))
                  .isEqualTo(beforeReads.get(i));
            }
            assertThat(ACTUAL_DISPATCH_DIAGNOSTICS.containsKey(unavailable)).isFalse();
            assertThat(
                    jdbc.queryForObject(
                        "SELECT browser_started_at IS NULL AND observed_admission_receipt IS NULL"
                            + " FROM ui_test_executions WHERE id=?",
                        Boolean.class,
                        unavailable))
                .isTrue();
            assertThat(
                    jdbc.queryForObject(
                        "SELECT count(*) FROM studio_secret_use_audit WHERE execution_id=?"
                            + " AND row_kind='RELEASE' AND outcome='UNAVAILABLE'",
                        Long.class,
                        unavailable))
                .isEqualTo(1);
            p3AssertAuditScope(null, unavailable, scope);
            p3Seed(scope, value);
            String denied =
                p3CoreCookie("p3-denied-ordinary", "p3-denied-ordinary@example.invalid");
            long accepted =
                jdbc.queryForObject(
                    "SELECT count(*) FROM ui_test_executions WHERE ui_test_id=?", Long.class, test);
            int deniedReads = COUNTED_VAULT.reads.size();
            JsonNode noPermission =
                p3Call(denied, "/api/v1/studio/tests/" + test + "/execute", C.object(), 400);
            assertThat(noPermission.path("error").asText()).isEqualTo("UNKNOWN_REFERENCE");
            assertThat(
                    jdbc.queryForObject(
                        "SELECT count(*) FROM ui_test_executions WHERE ui_test_id=?",
                        Long.class,
                        test))
                .isEqualTo(accepted);
            assertThat(COUNTED_VAULT.reads.size()).isEqualTo(deniedReads);
            assertThat(MODEL_WIRE.size()).isEqualTo(models);
            p3Scan(canaries);
            p3WriteEvidence(
                "ordinary-scope-" + (++ordinal),
                C.object()
                    .put("ordinal", ordinal)
                    .put("successfulOwnRead", reads - beforeReads.getLast())
                    .put("foreignReads", 0)
                    .put(
                        "missingOwnRead",
                        COUNTED_VAULT.readCount(
                                StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                            - reads)
                    .put(
                        "missingOwnSends",
                        ACTUAL_DISPATCH_DIAGNOSTICS.containsKey(unavailable) ? 1 : 0)
                    .put("deniedPrincipalReads", COUNTED_VAULT.reads.size() - deniedReads)
                    .put(
                        "artifactUnchanged",
                        jdbc.queryForObject(
                                "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                                String.class,
                                published.revision())
                            .equals(published.artifactHash())));
          }
        });
  }

