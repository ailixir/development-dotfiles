  @Test
  @org.junit.jupiter.api.Order(26)
  void actualCommittedSecretProgressSurvivesOwnedChildAndParentCrashThenRunningReaper()
      throws Exception {
    try {
      p3Case(this::p6CommittedChildCut);
    } finally {
      if (!cleanupUnconfirmed) {
        Files.writeString(
            TEMP.resolve("p4-revocation-state.json"), "{\"active\":false}", StandardCharsets.UTF_8);
        p6ChildCut = null;
      }
    }
  }

  /** Observations only; neither the PID header nor this handle grants execution authority. */
  private static volatile P6ChildCut p6ChildCut;

  private static final class P6ChildCut {
    final UUID execution;
    final VaultScope scope;
    final JsonNode binding;
    final Process parent;
    final Instant parentStarted;
    final java.util.concurrent.CountDownLatch positive = new java.util.concurrent.CountDownLatch(1);
    final java.util.concurrent.CountDownLatch signInEntered =
        new java.util.concurrent.CountDownLatch(1);
    final java.util.concurrent.CountDownLatch releaseSignIn =
        new java.util.concurrent.CountDownLatch(1);
    final java.util.concurrent.CountDownLatch signInExited =
        new java.util.concurrent.CountDownLatch(1);
    final AtomicInteger signInCalls = new AtomicInteger();
    volatile boolean failed, finalSeen;
    volatile long childPid;
    volatile JsonNode ready, report;
    ProcessHandle child;
    Instant childStarted;
    List<P6OwnedPid> childTree = List.of(), signalOrder = List.of();
    boolean stopIssued, childCutStarted, parentKilled, recovered, restarted;

    P6ChildCut(UUID execution, VaultScope scope, JsonNode binding) {
      this.execution = execution;
      this.scope = scope;
      this.binding = binding.deepCopy();
      parent = ordinaryWorker;
      parentStarted = parent.info().startInstant().orElseThrow();
    }

    synchronized void capture(
        jakarta.servlet.http.HttpServletRequest request, byte[] bytes, int status) {
      try {
        if (bytes.length > 262144) {
          throw new IllegalArgumentException("Child cut callback bound");
        }
        JsonNode body = C.parse(new String(bytes, StandardCharsets.UTF_8));
        if ("FINAL".equals(body.path("kind").asText())) {
          finalSeen = true;
        }
        if (status < 200
            || status >= 300
            || !"PROGRESS".equals(body.path("kind").asText())
            || !"USED".equals(body.path("secretUse").path("PASS").asText())) {
          return;
        }
        if (!("Bearer " + CALLBACK).equals(request.getHeader("Authorization"))
            || !execution.toString().equals(body.path("executionId").asText())
            || !binding.path("attemptId").equals(body.path("attemptId"))
            || !"observed-fixture".equals(body.path("runnerInstanceId").asText())
            || "1".equals(request.getHeader("X-Fixture-Child-Observer-Failed"))) {
          throw new IllegalArgumentException("Child cut accepted callback identity");
        }
        String pid = request.getHeader("X-Fixture-Child-Pid");
        String encoded = request.getHeader("X-Fixture-Child-Ready");
        if (pid == null
            || !pid.matches("[1-9][0-9]{0,12}")
            || encoded == null
            || encoded.length() > 4096) {
          throw new IllegalArgumentException("Child cut actual Ready observation missing");
        }
        JsonNode actualReady =
            C.parse(new String(Base64.getUrlDecoder().decode(encoded), StandardCharsets.UTF_8));
        if (!"ready".equals(actualReady.path("kind").asText())
            || actualReady.path("protocolVersion").asInt() != 3
            || !body.path("executionId").equals(actualReady.path("runId"))
            || !body.path("attemptId").equals(actualReady.path("attemptId"))
            || !body.path("admissionId").equals(actualReady.path("admissionId"))
            || !body.path("browserStartedAt").equals(actualReady.path("browserStartedAt"))
            || !GuidedContracts.hash(binding.path("requiredProfile"))
                .equals(actualReady.path("profileHash").asText())
            || !binding.path("requiredBuild").equals(actualReady.path("build"))) {
          throw new IllegalArgumentException("Child cut actual Ready binding differs");
        }
        if (report == null) {
          childPid = Long.parseLong(pid);
          ready = actualReady.deepCopy();
          report = body.deepCopy();
          positive.countDown();
        } else if (childPid != Long.parseLong(pid) || !ready.equals(actualReady)) {
          throw new IllegalArgumentException("Child cut actual Ready identity changed");
        }
      } catch (RuntimeException invalid) {
        failed = true;
        positive.countDown();
      }
    }
  }

  private record P6OwnedPid(ProcessHandle handle, Instant started, long parent, long group) {}

  private record P6ProcessStatus(long parent, long group, String state) {}

  private void p6CommittedChildCut() throws Exception {
    assertThat(Files.isExecutable(Path.of("/bin/kill"))).isTrue();
    assertThat(Files.isExecutable(Path.of("/bin/ps"))).isTrue();
    assertThat(
            ownedApplicationContext
                .getBean(com.citi.put.checks.studio.StudioExecutionProperties.class)
                .runDeadlineOrDefault()
                .toMillis())
        .as("unchanged production deadline within accepted case budget")
        .isLessThanOrEqualTo(Duration.ofSeconds(600).toMillis());
    p3Mode = P3Mode.LOGIN;
    p3Grant("CSI-123", "fixture");
    UUID test = p3CreateSource("CSI-123", "fixture", true);
    VaultScope scope = VaultScope.of("CSI-123", "fixture", test);
    String value = p3ExpectedPassword;
    p3Seed(scope, value);
    String guided = p3Start(test, "fixture");
    awaitFinalizing(guided);
    P3Publication publication = p3Publish(guided);
    P3_RECEIPTS.clear();
    P3_NATIVE_SESSIONS.clear();
    P3_REPORT_REQUESTS.set(0);
    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    int models = MODEL_WIRE.size();
    UUID execution = p3Execute(test);
    p3AssertBinding(execution, scope, publication);
    var cut = new P6ChildCut(execution, scope, observedBinding(execution));
    p6ChildCut = cut;
    Files.writeString(
        TEMP.resolve("p4-revocation-state.json"),
        C.object()
            .put("active", false)
            .put("childCut", true)
            .put("executionId", execution.toString())
            .toString(),
        StandardCharsets.UTF_8);
    Throwable primary = null;
    try {
      assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
      assertThat(cut.positive.await(30, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      assertThat(cut.failed).as("actual Ready/accepted progress observation valid").isFalse();
      assertThat(cut.signInEntered.await(10, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      assertThat(cut.signInCalls.get()).isEqualTo(1);
      assertThat(P3_RECEIPTS.size() == 1 && P3_RECEIPTS.getFirst().accepted()).isTrue();
      var owner = p6Owner(execution);
      JsonNode receipt = C.parse((String) owner.get("receipt"));
      assertThat("RUNNING".equals(owner.get("state"))).isTrue();
      assertThat(
              String.valueOf(owner.get("attempt_id")).equals(cut.report.path("attemptId").asText()))
          .isTrue();
      assertThat(
              String.valueOf(owner.get("admission_id"))
                  .equals(cut.report.path("admissionId").asText()))
          .isTrue();
      assertThat(receipt.path("admissionId").equals(cut.report.path("admissionId"))).isTrue();
      Instant originalDeadline = ((java.sql.Timestamp) owner.get("run_deadline_at")).toInstant();
      assertThat(originalDeadline.equals(Instant.parse(receipt.path("runDeadlineAt").asText())))
          .as("original authoritative admission deadline retained")
          .isTrue();
      assertThat(originalDeadline.isAfter(Instant.now())).isTrue();
      assertThat(((Number) owner.get("last_runner_sequence")).longValue())
          .isGreaterThanOrEqualTo(cut.report.path("runnerSequence").asLong());
      JsonNode artifact = C.parse(publication.artifact());
      int consumer = -1;
      for (int index = 0; index < artifact.path("steps").size(); index++) {
        if (TWO.equals(artifact.path("steps").get(index).path("stepId").asText())) {
          assertThat(consumer).isEqualTo(-1);
          consumer = index;
        }
      }
      boolean pass = false;
      for (JsonNode step : cut.report.path("steps")) {
        pass |=
            step.path("stepIndex").asInt(-1) == consumer
                && "PASS".equals(step.path("status").asText());
      }
      assertThat(consumer >= 0 && pass).as("actual secret source step completed PASS").isTrue();
      Map<String, Object> used = p6Usage(execution);
      Map<String, Object> release =
          jdbc.queryForMap(
              "SELECT * FROM studio_secret_use_audit WHERE id=? AND release_occurred_at=?",
              used.get("release_id"),
              used.get("release_occurred_at"));
      assertThat("USED".equals(used.get("usage_outcome"))).isTrue();
      assertThat(
              "RELEASE".equals(release.get("row_kind"))
                  && "DISPATCH".equals(release.get("decision_stage"))
                  && "RESOLVED".equals(release.get("outcome")))
          .isTrue();
      p4CompareAuditScope(release, used);
      p3AssertAuditScope(null, execution, scope);
      assertThat(String.valueOf(owner.get("attempt_id")).equals(release.get("attempt_id")))
          .isTrue();
      assertThat(execution.equals(release.get("execution_id"))).isTrue();
      p6VerifyChild(cut);
      p6AssertNoFinalManifest(cut);
      p6SameProcess(cut.parent.toHandle(), cut.parentStarted);
      cut.stopIssued = true;
      p6Signal("-STOP", Long.toString(cut.parent.pid()));
      long stoppedBy = System.nanoTime() + Duration.ofSeconds(5).toNanos();
      while (System.nanoTime() < stoppedBy
          && !p6Status(cut.parent.toHandle()).state().startsWith("T")) {
        Thread.sleep(10);
      }
      p6SameProcess(cut.parent.toHandle(), cut.parentStarted);
      assertThat(p6Status(cut.parent.toHandle()).state().startsWith("T"))
          .as("own parent actually STOPPED before child cut")
          .isTrue();
      p6SameProcess(cut.child, cut.childStarted);
      assertThat(p6Status(cut.child).group() == cut.child.pid()).isTrue();
      cut.childTree =
          java.util.stream.Stream.concat(
                  java.util.stream.Stream.of(cut.child), cut.child.descendants())
              .map(GuidedPublicationReplayIT::p6SnapshotPid)
              .toList();
      assertThat(cut.childTree.size()).isGreaterThan(1);
      p6KillOwnedTree(cut);
      p6AwaitProcesses(cut.childTree, false);
      // Z acknowledges execution termination only. The stopped owner cannot yet reap its child.
      p6SameProcess(cut.parent.toHandle(), cut.parentStarted);
      assertThat(p6Status(cut.parent.toHandle()).state().startsWith("T")).isTrue();
      cut.parentKilled = true;
      cut.parent.destroyForcibly();
      assertThat(cut.parent.waitFor(10, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      p6AwaitProcesses(cut.childTree, true);
      assertThat(cut.parent.isAlive()).isFalse();
      cut.releaseSignIn.countDown();
      assertThat(cut.signInExited.await(10, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      assertThat(cut.failed).isFalse();
      p6AssertNoFinalManifest(cut);
      assertThat("RUNNING".equals(p6Owner(execution).get("state"))).isTrue();
      var reaper =
          ownedApplicationContext.getBean(com.citi.put.checks.studio.recovery.RunningReaper.class);
      reaper.reapOnce();
      assertThat("RUNNING".equals(p6Owner(execution).get("state"))).isTrue();
      p6WaitOriginalDeadline(cut);
      p6AssertNoFinalManifest(cut);
      reaper.reapOnce();
      var terminal = p6Owner(execution);
      assertThat(
              "DONE".equals(terminal.get("state"))
                  && "ERROR".equals(terminal.get("status"))
                  && "STALE".equals(terminal.get("error_code")))
          .isTrue();
      cut.recovered = true;
      assertThat(used.equals(p6Usage(execution)))
          .as("positive USED not relabeled after crash")
          .isTrue();
      assertThat(
              release.equals(
                  jdbc.queryForMap(
                      "SELECT * FROM studio_secret_use_audit WHERE id=? AND release_occurred_at=?",
                      release.get("id"),
                      release.get("release_occurred_at"))))
          .isTrue();
      reaper.reapOnce();
      assertThat(terminal.equals(p6Owner(execution))).isTrue();
      assertThat(used.equals(p6Usage(execution))).isTrue();
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                  - reads)
          .isEqualTo(1);
      assertThat(MODEL_WIRE.size()).isEqualTo(models);
      assertThat(cut.signInCalls.get()).isEqualTo(1);
      p3Scan(List.of(value));
      startOrdinaryWorker(true);
      cut.restarted = true;
      p3WriteEvidence(
          "committed-child-parent-crash",
          C.object()
              .put("acceptedPositiveProgress", true)
              .put("actualReadyChildBound", true)
              .put("childExecutionTerminated", true)
              .put("parentKilled", true)
              .put("allOwnedPidsGone", true)
              .put("actualFinalObserved", false)
              .put("actualManifestObserved", false)
              .put("positiveUsageUnchanged", true)
              .put("originalDeadlineUsed", true)
              .put("valueReads", 1)
              .put("modelCalls", 0));
    } catch (Exception | AssertionError failure) {
      primary = failure;
      throw failure;
    } finally {
      var failures = new java.util.ArrayList<Throwable>();
      cut.releaseSignIn.countDown();
      if (cut.stopIssued && cut.parent.isAlive()) {
        p3AttemptTeardown(
            failures,
            () -> {
              p6SameProcess(cut.parent.toHandle(), cut.parentStarted);
              p6Signal("-CONT", Long.toString(cut.parent.pid()));
            });
      }
      if (primary != null && cut.childCutStarted) {
        // Captured descendants remain ours after reparenting; live PPID is not their authority.
        // Verify original start identity and unchanged group before every independent cleanup
        // signal.
        for (P6OwnedPid member : cut.signalOrder) {
          p3AttemptTeardown(
              failures,
              () -> {
                if (!member.handle().isAlive()) {
                  return;
                }
                p6SameProcess(member.handle(), member.started());
                P6ProcessStatus status = p6Status(member.handle());
                if ("X".equals(status.state()) || status.state().startsWith("Z")) {
                  return; // The later genuine-gone check still owns closure.
                }
                assertThat(status.group() == member.group()).isTrue();
                p6SameProcess(member.handle(), member.started());
                p6Signal(
                    "-KILL",
                    member.group() == member.handle().pid()
                        ? "-" + member.handle().pid()
                        : Long.toString(member.handle().pid()));
              });
        }
        p3AttemptTeardown(failures, () -> p6AwaitProcesses(cut.childTree, true));
      }
      if (cut.parentKilled) {
        p3AttemptTeardown(failures, () -> stopOwnedProcessTree(cut.parent));
        p3AttemptTeardown(failures, () -> p6AwaitProcesses(cut.childTree, true));
        p3AttemptTeardown(
            failures,
            () -> {
              assertThat(cut.signInExited.await(10, java.util.concurrent.TimeUnit.SECONDS))
                  .isTrue();
            });
        p3AttemptTeardown(
            failures,
            () -> {
              if (!cut.recovered) {
                p6WaitOriginalDeadline(cut);
                ownedApplicationContext
                    .getBean(com.citi.put.checks.studio.recovery.RunningReaper.class)
                    .reapOnce();
                assertThat("DONE".equals(p6Owner(execution).get("state"))).isTrue();
                cut.recovered = true;
              }
            });
        p3AttemptTeardown(failures, () -> p3Scan(List.of(value)));
        if (failures.isEmpty() && cut.recovered && !cut.restarted) {
          p3AttemptTeardown(
              failures,
              () -> {
                startOrdinaryWorker(true);
                cut.restarted = true;
              });
        }
      }
      if (!failures.isEmpty()) {
        cleanupUnconfirmed = true;
        if (primary != null) {
          failures.forEach(primary::addSuppressed);
        } else {
          var failure = new IllegalStateException("Owned child crash cleanup unconfirmed");
          failures.forEach(failure::addSuppressed);
          throw failure;
        }
      }
    }
  }

  private Map<String, Object> p6Owner(UUID execution) {
    return jdbc.queryForMap(
        "SELECT e.status,e.error_code,e.snapshot_revision,e.step_results::text AS step_results,"
            + "e.observed_admission_receipt::text AS receipt,l.state,l.attempt_id,l.admission_id,"
            + "l.last_runner_sequence,l.run_deadline_at FROM studio_dispatch_ledger l"
            + " JOIN ui_test_executions e ON e.id=l.execution_id"
            + " AND e.started_at=l.execution_accepted_at WHERE l.execution_id=?",
        execution);
  }

  private Map<String, Object> p6Usage(UUID execution) {
    var rows =
        jdbc.queryForList(
            "SELECT * FROM studio_secret_use_audit WHERE execution_id=? AND secret_id='PASS'"
                + " AND row_kind='USAGE'",
            execution);
    assertThat(rows.size()).as("one actual terminal summary for this released secret").isEqualTo(1);
    return java.util.Collections.unmodifiableMap(new java.util.LinkedHashMap<>(rows.getFirst()));
  }

  private void p6AssertNoFinalManifest(P6ChildCut cut) {
    assertThat(cut.finalSeen || P3_FINAL_REPORTS.containsKey(cut.execution)).isFalse();
    var store =
        ownedApplicationContext.getBean(
            com.citi.put.checks.studio.recovery.ResultManifestStore.class);
    assertThat(store.isAvailable()).as("real local manifest adapter available").isTrue();
    var identity =
        new com.citi.put.checks.studio.recovery.ResultManifestStore.ExecutionIdentity(
            cut.scope.csiId(),
            UUID.fromString(cut.scope.testId()),
            cut.execution,
            UUID.fromString(cut.binding.path("attemptId").asText()));
    assertThat(
            store
                .read(com.citi.put.checks.studio.recovery.ManifestKeys.manifestKey(identity))
                .isEmpty())
        .as("no authentic manifest was produced by the physically cut parent")
        .isTrue();
  }

  private void p6WaitOriginalDeadline(P6ChildCut cut) throws Exception {
    Instant deadline =
        ((java.sql.Timestamp) p6Owner(cut.execution).get("run_deadline_at")).toInstant();
    long remaining = Duration.between(Instant.now(), deadline).toMillis();
    assertThat(remaining)
        .as("original accepted run deadline within case budget")
        .isLessThanOrEqualTo(Duration.ofSeconds(620).toMillis());
    while (Instant.now().isBefore(deadline)) {
      Thread.sleep(
          Math.max(1, Math.min(1000, Duration.between(Instant.now(), deadline).toMillis())));
    }
  }

  private static P6OwnedPid p6SnapshotPid(ProcessHandle handle) {
    Instant started = handle.info().startInstant().orElseThrow();
    p6SameProcess(handle, started);
    P6ProcessStatus status = p6Status(handle);
    p6SameProcess(handle, started);
    return new P6OwnedPid(handle, started, status.parent(), status.group());
  }

  private static int p6Depth(P6OwnedPid member, P6ChildCut cut) {
    var byPid =
        cut.childTree.stream()
            .collect(
                java.util.stream.Collectors.toMap(
                    pid -> pid.handle().pid(), java.util.function.Function.identity()));
    int depth = 0;
    P6OwnedPid cursor = member;
    while (cursor.handle().pid() != cut.child.pid()) {
      assertThat(++depth).as("captured ancestry bounded").isLessThanOrEqualTo(128);
      cursor = byPid.get(cursor.parent());
      assertThat(cursor != null)
          .as("each captured process belongs to real child ancestry")
          .isTrue();
    }
    return depth;
  }

  private static void p6KillOwnedTree(P6ChildCut cut) throws Exception {
    // Java must retain start identities. The JS helper cannot consume them while its owner is
    // STOPPED.
    // Mirror run/tree.ts deepest-first enumeration, including Playwright's separate browser groups.
    assertThat(cut.childTree.size()).isLessThanOrEqualTo(128);
    var ordered =
        cut.childTree.stream()
            .sorted(
                java.util.Comparator.comparingInt((P6OwnedPid member) -> p6Depth(member, cut))
                    .reversed())
            .toList();
    cut.signalOrder = ordered;
    for (P6OwnedPid member : ordered) {
      if (!member.handle().isAlive()) {
        continue;
      }
      p6SameProcess(member.handle(), member.started());
      P6ProcessStatus status = p6Status(member.handle());
      if ("X".equals(status.state()) || status.state().startsWith("Z")) {
        continue; // Termination is intermediate; the later genuine-gone check still owns drainage.
      }
      assertThat(status.parent() == member.parent() && status.group() == member.group()).isTrue();
      p6SameProcess(member.handle(), member.started());
      cut.childCutStarted = true; // Set before the first actual tree signal attempt can fail.
      p6Signal(
          "-KILL",
          member.group() == member.handle().pid()
              ? "-" + member.handle().pid()
              : Long.toString(member.handle().pid()));
    }
  }

  private static void p6SameProcess(ProcessHandle handle, Instant started) {
    assertThat(handle.isAlive() && handle.info().startInstant().map(started::equals).orElse(false))
        .as("verified owned process identity retained")
        .isTrue();
  }

  private static void p6VerifyChild(P6ChildCut cut) {
    p6SameProcess(cut.parent.toHandle(), cut.parentStarted);
    cut.child = ProcessHandle.of(cut.childPid).orElseThrow();
    cut.childStarted = cut.child.info().startInstant().orElseThrow();
    assertThat(cut.parent.descendants().anyMatch(handle -> handle.pid() == cut.childPid)).isTrue();
    assertThat(
            cut.child
                .info()
                .commandLine()
                .map(command -> command.contains(TEMP.resolve("recorded-child.mjs").toString()))
                .orElse(false))
        .as("actual compiled recorded child module")
        .isTrue();
    P6ProcessStatus status = p6Status(cut.child);
    assertThat(status.parent() == cut.parent.pid() && status.group() == cut.childPid).isTrue();
  }

  private static P6ProcessStatus p6Status(ProcessHandle handle) {
    Process ps;
    try {
      ps =
          new ProcessBuilder(
                  "/bin/ps", "-p", Long.toString(handle.pid()), "-o", "ppid=,pgid=,stat=")
              .redirectErrorStream(true)
              .start();
    } catch (IOException failure) {
      throw new IllegalStateException("Owned process OS-state probe unavailable", failure);
    }
    Throwable primary = null;
    try {
      assertThat(ps.waitFor(5, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      if (ps.exitValue() != 0 && !handle.isAlive()) {
        return new P6ProcessStatus(-1, -1, "X");
      }
      assertThat(ps.exitValue()).isZero();
      String[] parts =
          new String(ps.getInputStream().readNBytes(1024), StandardCharsets.UTF_8)
              .trim()
              .split("\\s+");
      assertThat(parts.length).isEqualTo(3);
      return new P6ProcessStatus(Long.parseLong(parts[0]), Long.parseLong(parts[1]), parts[2]);
    } catch (Exception | AssertionError failure) {
      primary = failure;
      if (failure instanceof InterruptedException) {
        Thread.currentThread().interrupt();
      }
      throw new IllegalStateException("Owned process OS-state observation unavailable", failure);
    } finally {
      try {
        p6CloseCommand(ps);
      } catch (AssertionError cleanup) {
        if (primary != null) {
          primary.addSuppressed(cleanup);
        } else {
          throw cleanup;
        }
      }
    }
  }

  private static void p6Signal(String signal, String ownedTarget) throws Exception {
    assertThat(List.of("-STOP", "-CONT", "-KILL").contains(signal)).isTrue();
    assertThat(ownedTarget.matches("-?[1-9][0-9]{0,12}")).isTrue();
    Process command =
        new ProcessBuilder("/bin/kill", signal, "--", ownedTarget)
            .redirectErrorStream(true)
            .start();
    Throwable primary = null;
    try {
      assertThat(command.waitFor(5, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
      assertThat(command.exitValue()).as("actual signal delivered to verified owner").isZero();
    } catch (Exception | AssertionError failure) {
      primary = failure;
      if (failure instanceof InterruptedException) {
        Thread.currentThread().interrupt();
      }
      throw failure;
    } finally {
      try {
        p6CloseCommand(command);
      } catch (AssertionError cleanup) {
        if (primary != null) {
          primary.addSuppressed(cleanup);
        } else {
          throw cleanup;
        }
      }
    }
  }

  private static void p6CloseCommand(Process command) {
    boolean interrupted = Thread.interrupted();
    try {
      if (command.isAlive()) {
        command.destroyForcibly();
      }
      long deadline = System.nanoTime() + Duration.ofSeconds(5).toNanos();
      while (command.isAlive() && System.nanoTime() < deadline) {
        try {
          command.waitFor(20, java.util.concurrent.TimeUnit.MILLISECONDS);
        } catch (InterruptedException interruption) {
          interrupted = true;
        }
      }
      assertThat(command.isAlive()).as("owned OS probe/signal process genuinely joined").isFalse();
    } finally {
      if (interrupted) {
        Thread.currentThread().interrupt();
      }
    }
  }

  private static void p6AwaitProcesses(List<P6OwnedPid> owned, boolean gone) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(10).toNanos();
    do {
      boolean complete = true;
      for (P6OwnedPid pid : owned) {
        if (pid.handle().isAlive()) {
          var started = pid.handle().info().startInstant();
          if (!pid.handle().isAlive()) {
            continue;
          }
          assertThat(started.map(pid.started()::equals).orElse(false)).isTrue();
          if (gone) {
            complete = false;
          } else {
            String state = p6Status(pid.handle()).state();
            if (!state.startsWith("Z") && !"X".equals(state)) {
              complete = false;
            }
          }
        }
      }
      if (complete) {
        return;
      }
      Thread.sleep(20);
    } while (System.nanoTime() < deadline);
    throw new IllegalStateException(
        gone
            ? "Owned processes not genuinely reaped"
            : "Owned child group not execution-terminated");
  }

  @Test
  @org.junit.jupiter.api.Order(27)
  void actualPoolDefiniteRefusalThenFreshSecretAttemptResolvesRotatedValue() throws Exception {
    p7CapturedFaultAndRetry(true);
  }

  @Test
  @org.junit.jupiter.api.Order(28)
  void actualScopedVaultOutageThenFreshSecretAttemptResolvesRotatedValue() throws Exception {
    p7CapturedFaultAndRetry(false);
  }

  private static final java.util.concurrent.atomic.AtomicReference<VaultScope> P7_OUTAGE_SCOPE =
      new java.util.concurrent.atomic.AtomicReference<>();

  private void p7CapturedFaultAndRetry(boolean capacity) throws Exception {
    var canaries = List.of("C4-OLD-" + UUID.randomUUID(), "C4-FRESH-" + UUID.randomUUID());
    C5Capture capture = new C5Capture(canaries);
    c5Capture = capture;
    Throwable primary = null;
    try {
      capture.writeProfileValues();
      p3Case(() -> p7FaultAndRetry(capacity, canaries, capture));
      capture.c4WindowsExecuted =
          true; // Genuine whole workflow and original owner cleanup returned.
    } catch (Exception | Error failure) {
      primary = failure;
      throw failure;
    } finally {
      P7_OUTAGE_SCOPE.set(null);
      var failures = new java.util.ArrayList<Throwable>();
      if (!cleanupUnconfirmed) {
        // The same capture remains active until p3Case has genuinely drained its owners.
        p3AttemptTeardown(failures, () -> p3Scan(canaries));
        p3AttemptTeardown(failures, capture::writeNumericEvidence);
        p3AttemptTeardown(failures, capture::close);
        c5Capture = null;
      } else {
        // No timeout-as-drain: retain the original quarantine over unreaped producers.
        failures.add(new IllegalStateException("C4 actual owner closure remains unconfirmed"));
      }
      if (!failures.isEmpty()) {
        if (primary != null) {
          failures.forEach(primary::addSuppressed);
        } else {
          throwTeardownFailures(failures);
        }
      }
    }
  }

  private void p7FaultAndRetry(boolean capacity, List<String> canaries, C5Capture capture)
      throws Exception {
    UUID blockerTest = null;
    P3Publication blockerPublication = null;
    if (capacity) {
      p3Mode = P3Mode.REGISTRATION;
      blockerTest = p3CreateSource("CSI-123", "fixture", false);
      String holderLearning = p3Start(blockerTest, "fixture");
      capture.selectedGuidedSession = holderLearning;
      awaitFinalizing(holderLearning);
      blockerPublication = p3Publish(holderLearning);
    }
    p3Mode = P3Mode.LOGIN;
    p3Grant("CSI-123", "fixture");
    UUID test = p3CreateSource("CSI-123", "fixture", true);
    VaultScope scope = VaultScope.of("CSI-123", "fixture", test);
    p3ExpectedPassword = canaries.getFirst();
    p3Seed(scope, p3ExpectedPassword);
    String learning = p3Start(test, "fixture");
    capture.selectedGuidedSession = learning;
    awaitFinalizing(learning);
    P3Publication publication = p3Publish(learning);
    p3CleanupOwnedResources();
    P3_RECEIPTS.clear();
    P3_NATIVE_SESSIONS.clear();
    P3_REPORT_REQUESTS.set(0);
    int models = MODEL_WIRE.size(), attempted = VAULT.readCount();
    int successful =
        COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    boolean paused = false;
    Throwable workflowPrimary = null;
    try {
      UUID blocker = null;
      if (capacity) {
        Files.deleteIfExists(TEMP.resolve("initial-context-check-entered"));
        Files.writeString(
            TEMP.resolve("initial-context-state.json"), "{\"pause\":true,\"fail\":false}");
        paused = true;
        blocker = p3Execute(blockerTest);
        p3AssertBinding(
            blocker, VaultScope.of("CSI-123", "fixture", blockerTest), blockerPublication);
        assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
        long until = System.nanoTime() + Duration.ofSeconds(15).toNanos();
        while (!Files.exists(TEMP.resolve("initial-context-check-entered"))
            && System.nanoTime() < until) {
          Thread.sleep(20);
        }
        assertThat(Files.exists(TEMP.resolve("initial-context-check-entered"))).isTrue();
        assertThat("ADMITTED".equals(p6Owner(blocker).get("state"))).isTrue();
        assertThat(
                jdbc.queryForObject(
                    "SELECT browser_started_at IS NULL FROM ui_test_executions WHERE id=?",
                    Boolean.class,
                    blocker))
            .isTrue();
        assertThat(VAULT.readCount()).as("nonsecret actual browser holder").isEqualTo(attempted);
      }
      UUID execution = p3Execute(test);
      p3AssertBinding(execution, scope, publication);
      JsonNode first = observedBinding(execution).deepCopy();
      String attempt = first.path("attemptId").asText();
      if (!capacity) {
        assertThat(P7_OUTAGE_SCOPE.compareAndSet(null, scope)).isTrue();
      }
      assertThat(dispatcher.dispatchOnce()).isEqualTo(capacity ? 1 : 0);
      assertThat(VAULT.readCount() - attempted).isEqualTo(1);
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                  - successful)
          .isEqualTo(capacity ? 1 : 0);
      var owner =
          jdbc.queryForMap(
              "SELECT l.state,l.attempt_id,l.admission_id,l.definite_refusal_attempt_id,"
                  + "l.zero_send_decision_attempt_id,e.observed_admission_receipt,e.browser_started_at,"
                  + "e.error_code FROM studio_dispatch_ledger l JOIN ui_test_executions e"
                  + " ON e.id=l.execution_id AND e.started_at=l.execution_accepted_at"
                  + " WHERE l.execution_id=?",
              execution);
      assertThat("QUEUED".equals(owner.get("state"))).isTrue();
      for (String field :
          List.of(
              "attempt_id",
              "admission_id",
              "observed_admission_receipt",
              "browser_started_at",
              "error_code")) {
        assertThat(owner.get(field) == null).as("actual first fault is not admitted").isTrue();
      }
      assertThat(P3_RECEIPTS.isEmpty() && P3_NATIVE_SESSIONS.isEmpty()).isTrue();
      assertThat(P3_REPORT_REQUESTS.get()).isZero();
      List<Map<String, Object>> oldAudit = p7AttemptAudit(execution, attempt);
      assertThat(oldAudit.size()).isEqualTo(2);
      var oldRelease =
          oldAudit.stream()
              .filter(row -> "RELEASE".equals(row.get("row_kind")))
              .findFirst()
              .orElseThrow();
      var oldUsage =
          oldAudit.stream()
              .filter(row -> "USAGE".equals(row.get("row_kind")))
              .findFirst()
              .orElseThrow();
      assertThat("REFUSED".equals(oldUsage.get("usage_outcome"))).isTrue();
      assertThat(oldRelease.get("id").equals(oldUsage.get("release_id"))).isTrue();
      p4CompareAuditScope(oldRelease, oldUsage);
      p3AssertAuditScope(null, execution, scope);
      if (capacity) {
        var actual = ACTUAL_DISPATCH_DIAGNOSTICS.get(execution);
        assertThat(actual != null).isTrue();
        JsonNode refusal = actual.deepCopy();
        assertThat(
                "DEFINITE_REFUSAL".equals(refusal.path("kind").asText())
                    && refusal.path("retryable").asBoolean()
                    && refusal.path("classifiedHttpStatus").asInt() == 429)
            .isTrue();
        assertThat(attempt.equals(String.valueOf(owner.get("definite_refusal_attempt_id"))))
            .isTrue();
        assertThat(owner.get("zero_send_decision_attempt_id") == null).isTrue();
        assertThat(
                "RESOLVED".equals(oldRelease.get("outcome"))
                    && oldRelease.get("vault_version") != null)
            .isTrue();
        assertThat(
                jdbc.queryForObject(
                    "SELECT count(*) FROM studio_observed_no_send_decisions WHERE execution_id=? AND attempt_id=?",
                    Integer.class,
                    execution,
                    UUID.fromString(attempt)))
            .isZero();
        Files.writeString(
            TEMP.resolve("initial-context-state.json"), "{\"pause\":false,\"fail\":false}");
        paused = false;
        p3AwaitExecution(blocker, "PASSED");
        // Only the genuine holder is cleaned; global cleanup would cancel the queued retry owner.
        p3CleanupOrdinary(blocker, p3Cookie, System.nanoTime() + Duration.ofSeconds(60).toNanos());
        Thread.sleep(
            Duration.ofSeconds(5).toMillis()); // Original configured Retry-After pacing only.
      } else {
        assertThat(P7_OUTAGE_SCOPE.get() == null).isTrue();
        assertThat(ACTUAL_DISPATCH_DIAGNOSTICS.containsKey(execution)).isFalse();
        assertThat(owner.get("definite_refusal_attempt_id") == null).isTrue();
        assertThat(attempt.equals(String.valueOf(owner.get("zero_send_decision_attempt_id"))))
            .isTrue();
        assertThat(
                "VAULT_UNAVAILABLE".equals(oldRelease.get("outcome"))
                    && oldRelease.get("vault_version") == null)
            .isTrue();
        var receipt =
            jdbc.queryForMap(
                "SELECT disposition,not_entered_ids::text AS not_entered FROM"
                    + " studio_observed_no_send_decisions WHERE execution_id=? AND attempt_id=?",
                execution,
                UUID.fromString(attempt));
        assertThat("REQUEUED".equals(receipt.get("disposition"))).isTrue();
        JsonNode notEntered = C.parse((String) receipt.get("not_entered"));
        assertThat(notEntered.isArray()).isTrue();
        assertThat(notEntered.isEmpty()).isTrue();
        assertThat(
                jdbc.queryForObject(
                    "SELECT count(*) FROM studio_observed_secret_read_entries WHERE execution_id=?"
                        + " AND attempt_id=? AND secret_id='PASS'",
                    Integer.class,
                    execution,
                    UUID.fromString(attempt)))
            .isEqualTo(1);
      }
      p3ExpectedPassword = canaries.getLast();
      p3Seed(scope, p3ExpectedPassword);
      capture.writeProfileValues();
      assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
      JsonNode snapshot = p3AwaitExecution(execution, "PASSED");
      JsonNode second = observedBinding(execution);
      String freshAttempt = second.path("attemptId").asText();
      assertThat(attempt.equals(freshAttempt)).isFalse();
      assertThat(
              first
                  .path("replayGrant")
                  .path("grantId")
                  .equals(second.path("replayGrant").path("grantId")))
          .isFalse();
      var before = ((ObjectNode) first).deepCopy();
      var after = ((ObjectNode) second).deepCopy();
      before.remove(List.of("attemptId", "replayGrant"));
      after.remove(List.of("attemptId", "replayGrant"));
      assertThat(before.equals(after)).isTrue();
      var grant = second.path("replayGrant");
      assertThat(grant.path("attemptId").asText().equals(freshAttempt)).isTrue();
      assertThat(
              Duration.between(
                      Instant.parse(grant.path("issuedAt").asText()),
                      Instant.parse(grant.path("expiresAt").asText()))
                  .toMillis())
          .isBetween(1L, 30000L);
      assertThat(ACTUAL_DISPATCH_DIAGNOSTICS.get(execution).path("kind").asText())
          .isEqualTo("ACCEPTED");
      assertThat(
              jdbc.queryForObject(
                  "SELECT definite_refusal_attempt_id IS NULL AND zero_send_decision_attempt_id IS NULL"
                      + " FROM studio_dispatch_ledger WHERE execution_id=?",
                  Boolean.class,
                  execution))
          .isTrue();
      assertThat(VAULT.readCount() - attempted).isEqualTo(2);
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                  - successful)
          .isEqualTo(capacity ? 2 : 1);
      assertThat(MODEL_WIRE.size()).isEqualTo(models);
      assertThat(P3_RECEIPTS.size()).isEqualTo(1);
      assertThat(
              P3_RECEIPTS.getFirst().accepted()
                  && P3_RECEIPTS.getFirst().password().equals(canaries.getLast()))
          .isTrue();
      assertThat(P3_REPORT_REQUESTS.get()).isPositive();
      p3AssertUsed(null, execution);
      var freshAudit = p7AttemptAudit(execution, freshAttempt);
      assertThat(freshAudit.size()).isEqualTo(2);
      var freshRelease =
          freshAudit.stream()
              .filter(row -> "RELEASE".equals(row.get("row_kind")))
              .findFirst()
              .orElseThrow();
      assertThat("RESOLVED".equals(freshRelease.get("outcome"))).isTrue();
      if (capacity) {
        assertThat(oldRelease.get("vault_version").equals(freshRelease.get("vault_version")))
            .isFalse();
      }
      assertThat(oldAudit.equals(p7AttemptAudit(execution, attempt))).isTrue();
      p3AssertAuditScope(null, execution, scope);
      assertThat(p3DecodeVideo(execution, snapshot)).isPositive();
      p3CleanupOwnedResources();
      p3Scan(canaries);
      p3WriteEvidence(
          capacity ? "c4-real-429-fresh-retry" : "c4-real-outage-fresh-retry",
          C.object()
              .put("actualFirstStatus", capacity ? 429 : 0)
              .put("firstRunnerClientInvoked", capacity)
              .put("firstValueReturned", capacity)
              .put("providerAttempts", 2)
              .put("successfulValues", capacity ? 2 : 1)
              .put("freshAttemptGrant", true)
              .put("firstAuditImmutable", true)
              .put("rotatedNativeValueAccepted", true)
              .put("nativeVideoDecoded", true)
              .put("modelCallsDuringOrdinaryPasses", 0)
              .put("sameActiveC5Window", true));
    } catch (Exception | Error failure) {
      workflowPrimary = failure;
      throw failure;
    } finally {
      P7_OUTAGE_SCOPE.set(null);
      if (paused) {
        try {
          Files.writeString(
              TEMP.resolve("initial-context-state.json"), "{\"pause\":false,\"fail\":false}");
        } catch (Exception | Error cleanup) {
          if (workflowPrimary != null) {
            workflowPrimary.addSuppressed(cleanup);
          } else {
            throw cleanup;
          }
        }
      }
    }
  }

  private List<Map<String, Object>> p7AttemptAudit(UUID execution, String attempt) {
    return jdbc.queryForList(
        "SELECT * FROM studio_secret_use_audit WHERE execution_id=? AND attempt_id=?"
            + " AND secret_id='PASS' ORDER BY row_kind,id",
        execution,
        attempt);
  }

  private String p3Cookie;
  private final Map<String, String> p3OwnedGuidedCookies = new java.util.LinkedHashMap<>();
  private final Map<UUID, String> p3OwnedOrdinaryCookies = new java.util.LinkedHashMap<>();
  private long p3NextCleanupGetAt;
  private int p3CaptureCaseOrdinal;
  private int p4PublicationValueReads;

  private record P3Publication(UUID revision, String artifactHash, String artifact) {}

  @FunctionalInterface
  private interface P3Action {
    void run() throws Exception;
  }

  private void p3Case(P3Action operation) throws Exception {
    assertThat(cleanupUnconfirmed)
        .as("prior actual P3 owner cleanup remains unconfirmed")
        .isFalse();
    Throwable primary = null;
    p3OwnedGuidedCookies.clear();
    p3OwnedOrdinaryCookies.clear();
    p3CaptureCaseOrdinal++;
    P3_INVOCATIONS.clear();
    p3Cookie = p3CoreCookie("user-1", "fixture@example.invalid");
    P3_RECEIPTS.clear();
    P3_NATIVE_SESSIONS.clear();
    P3_REPORT_REQUESTS.set(0);
    p3ReportsProtected = false;
    p3ExpectedPassword = "P3-EXPECTED-" + UUID.randomUUID();
    jdbc.update(
        "INSERT INTO users(id,sso_id,name,email,created_at) VALUES"
            + " (?,'user-1','Fixture','fixture@example.invalid',now()) ON CONFLICT DO NOTHING",
        UUID.randomUUID());
    for (String csi : List.of("CSI-123", "CSI-456")) {
      jdbc.update(
          "INSERT INTO csi_systems(id,name,business_unit,criticality,owner_email,environment)"
              + " VALUES (?, 'Orders','Ops','HIGH','fixture@example.invalid','Production') ON CONFLICT DO NOTHING",
          csi);
    }
    try {
      if (guidedWorker == null || ordinaryWorker == null) {
        startWorkers();
      }
      operation.run();
    } catch (Exception | AssertionError failure) {
      primary = failure;
      throw failure;
    } finally {
      boolean confirmed = false;
      try {
        p3CleanupOwnedResources();
        confirmed = true;
      } catch (Exception | AssertionError cleanup) {
        cleanupUnconfirmed = true;
        if (primary != null) {
          primary.addSuppressed(cleanup);
        } else {
          throw cleanup;
        }
      } finally {
        if (confirmed) {
          p4PasswordControls = -1;
          p4AdversarialPasswordSelection = false;
          P4_FIRST_GUIDED_REQUEST.set(null);
          P4_FIRST_GUARD.set(null);
          p3Mode = null;
          p3ExpectedPassword = null;
          p3ReportsProtected = false;
          P3_FAIL_READ.set(null);
          P3_CORE.clear();
          P3_PERMITTED.clear();
          P3_NATIVE_SESSIONS.clear();
          P3_RECEIPTS.clear();
          p3OwnedGuidedCookies.clear();
          p3OwnedOrdinaryCookies.clear();
        }
        // Unconfirmed actual owners retain fixture authority; the sticky guard blocks new cases.
      }
    }
  }

  private static void p3CaptureOrdinaryReport(UUID execution, byte[] bytes) {
    int phase = 1;
    try {
      if (bytes.length > 262144) {
        throw new IllegalArgumentException("P3 callback witness bound");
      }
      String text =
          StandardCharsets.UTF_8
              .newDecoder()
              .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
              .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)
              .decode(java.nio.ByteBuffer.wrap(bytes))
              .toString();
      phase = 2;
      // Strict duplicates/trailing tokens remain; ordinary timing numbers are not canonical-v1
      // integers.
      JsonNode actual = C.parse(text);
      long[] numeric = p3ReportNumericCounts(actual, 0);
      phase = 3;
      new com.citi.put.checks.studio.internal.StrictInternalBodyReader(JSON)
          .read(bytes, com.citi.put.checks.studio.internal.dto.RunnerReport.class);
      boolean finalReport = actual.path("kind").asText().equals("FINAL");
      P3_CAPTURE_DIAGNOSTICS.compute(
          execution,
          (id, previous) -> {
            ObjectNode metrics = previous == null ? C.object() : previous.deepCopy();
            metrics.put("captureSuccesses", metrics.path("captureSuccesses").asLong() + 1);
            if (finalReport) {
              metrics
                  .put("finalSuccesses", metrics.path("finalSuccesses").asLong() + 1)
                  .put("finalBytes", bytes.length)
                  .put("finalFloatLexemes", numeric[0])
                  .put("finalFractionalValues", numeric[1])
                  .put("guidedIntegerParserWouldRefuse", numeric[0] > 0);
            }
            return metrics;
          });
      if (finalReport) {
        P3_FINAL_REPORTS.put(execution, actual);
      }
    } catch (Exception failure) {
      final int failedPhase = phase;
      P3_CAPTURE_DIAGNOSTICS.compute(
          execution,
          (id, previous) -> {
            ObjectNode metrics = previous == null ? C.object() : previous.deepCopy();
            return metrics
                .put("captureFailures", metrics.path("captureFailures").asLong() + 1)
                .put("lastFailurePhase", failedPhase)
                .put("lastFailureBytes", bytes.length);
          });
      // Metadata failure never changes the original controller response or creates a FINAL.
    }
  }

  private static long[] p3ReportNumericCounts(JsonNode node, int depth) {
    int structuralDepth = depth + (node.isContainerNode() ? 1 : 0);
    if (structuralDepth > 64) {
      throw new IllegalArgumentException("P3 callback witness depth");
    }
    long floats = 0, fractions = 0;
    if (node.isNumber()) {
      double number = node.doubleValue();
      if (!Double.isFinite(number)) {
        throw new IllegalArgumentException("P3 nonfinite callback number");
      }
      if (node.isFloatingPointNumber()) {
        floats = 1;
        fractions = number != Math.rint(number) ? 1 : 0;
      }
    }
    if (node.isContainerNode()) {
      for (JsonNode child : node) {
        long[] counts = p3ReportNumericCounts(child, structuralDepth);
        floats += counts[0];
        fractions += counts[1];
      }
    }
    return new long[] {floats, fractions};
  }

  private void p3WriteCaptureDiagnostics(UUID execution) throws Exception {
    int ordinal = new java.util.ArrayList<>(p3OwnedOrdinaryCookies.keySet()).indexOf(execution) + 1;
    assertThat(ordinal).isPositive();
    ObjectNode stored = P3_CAPTURE_DIAGNOSTICS.get(execution);
    var metrics = stored == null ? C.object() : stored.deepCopy();
    metrics
        .put("executionOrdinal", ordinal)
        .put("caseOrdinal", p3CaptureCaseOrdinal)
        .put("finalObserved", P3_FINAL_REPORTS.containsKey(execution));
    p3WriteEvidence("capture-" + p3CaptureCaseOrdinal + "-" + ordinal, metrics);
  }

  private static Duration p3CleanupRequestTimeout(long deadline) {
    long remaining = deadline - System.nanoTime();
    if (remaining <= 0) {
      throw new IllegalStateException("Actual ordinary cleanup deadline exhausted");
    }
    return Duration.ofNanos(Math.min(Duration.ofSeconds(15).toNanos(), remaining));
  }

  private JsonNode p3CleanupSnapshot(UUID execution, String cookie, long deadline)
      throws Exception {
    for (; ; ) {
      long now = System.nanoTime();
      long delay = Math.max(0, p3NextCleanupGetAt - now);
      long remaining = deadline - now;
      if (remaining <= delay) {
        throw new IllegalStateException("Actual ordinary cleanup wait exceeds deadline");
      }
      if (delay > 0) {
        java.util.concurrent.TimeUnit.NANOSECONDS.sleep(delay);
      }
      long requestStarted = System.nanoTime();
      p3NextCleanupGetAt = requestStarted + Duration.ofSeconds(1).toNanos();
      var request =
          HttpRequest.newBuilder(
                  URI.create(
                      "https://localhost:" + port + "/api/v1/studio/executions/" + execution))
              .timeout(p3CleanupRequestTimeout(deadline))
              .header("Cookie", "put_session=" + cookie)
              .GET()
              .build();
      var response =
          HttpClient.newBuilder()
              .sslContext(TLS)
              .build()
              .send(request, HttpResponse.BodyHandlers.ofString());
      if (response.statusCode() == 429) {
        assertThat(C.parse(response.body()).path("error").path("code").asText())
            .isEqualTo("RATE_LIMITED");
        String actualRetry =
            response
                .headers()
                .firstValue("Retry-After")
                .orElseThrow(
                    () -> new IllegalStateException("Actual rate response lacks Retry-After"));
        assertThat(actualRetry.matches("[1-9][0-9]{0,8}")).isTrue();
        long seconds = Long.parseLong(actualRetry);
        long retryNanos = Duration.ofSeconds(seconds).toNanos();
        now = System.nanoTime();
        if (retryNanos >= deadline - now) {
          throw new IllegalStateException("Actual Retry-After exceeds cleanup deadline");
        }
        p3NextCleanupGetAt = Math.max(p3NextCleanupGetAt, now + retryNanos);
        continue;
      }
      assertThat(response.statusCode())
          .as("actual bounded ordinary cleanup snapshot")
          .isEqualTo(200);
      if (System.nanoTime() >= deadline) {
        throw new IllegalStateException("Actual cleanup response arrived past deadline");
      }
      return C.parse(response.body());
    }
  }

  private void p3CleanupOwnedResources() throws Exception {
    var failures = new java.util.ArrayList<Throwable>();
    long ordinaryDeadline = System.nanoTime() + Duration.ofSeconds(60).toNanos();
    p3NextCleanupGetAt = System.nanoTime();
    for (var owned : new java.util.ArrayList<>(p3OwnedOrdinaryCookies.entrySet())) {
      try {
        p3CleanupOrdinary(owned.getKey(), owned.getValue(), ordinaryDeadline);
      } catch (Exception | AssertionError failure) {
        failures.add(failure);
      } finally {
        try {
          p3WriteCaptureDiagnostics(owned.getKey());
        } catch (Exception | AssertionError diagnosticsFailure) {
          failures.add(diagnosticsFailure);
        }
      }
    }
    for (var owned : new java.util.ArrayList<>(p3OwnedGuidedCookies.entrySet())) {
      try {
        String id = owned.getKey();
        String state =
            sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
        if (!List.of(
                "SUCCEEDED",
                "PUBLICATION_CONFLICT",
                "FAILED",
                "UNKNOWN_OUTCOME",
                "CANCELLED",
                "EXPIRED")
            .contains(state)) {
          p3Call(
              owned.getValue(),
              "/api/v3/studio/guided-sessions/" + id + "/cancel",
              C.object().put("schemaVersion", 3).put("reason", "userRequested"),
              202);
        }
        p3AwaitTeardown(id);
      } catch (Exception | AssertionError failure) {
        failures.add(failure);
      }
    }
    if (failures.isEmpty() && Files.exists(TEMP.resolve("p4-native-observer.json"))) {
      try {
        p4AssertObserverPhaseCompleted(P4_PHASE_ORDINAL.get());
        Files.writeString(
            TEMP.resolve("p4-native-observer.json"),
            "{\"active\":false,\"phase\":0}",
            StandardCharsets.UTF_8);
      } catch (IOException | AssertionError failure) {
        failures.add(failure);
      }
    }
    if (failures.isEmpty() && p4Revocation != null) {
      try {
        p4AwaitRevocationObserverCompletion(p4Revocation);
        p4SealPrivateProducersAfterOwnerCleanup(p4Revocation);
        Files.writeString(
            TEMP.resolve("p4-revocation-state.json"), "{\"active\":false}", StandardCharsets.UTF_8);
        p4Revocation = null;
      } catch (Exception | AssertionError failure) {
        failures.add(failure);
      }
    }
    if (!failures.isEmpty()) {
      var unconfirmed = new IllegalStateException("Actual owned P3 cleanup remains unconfirmed");
      failures.forEach(unconfirmed::addSuppressed);
      throw unconfirmed;
    }
  }

  private void p3CleanupOrdinary(UUID execution, String cookie, long deadline) throws Exception {
    P6ChildCut cut = p6ChildCut;
    if (cut != null && cut.execution.equals(execution) && cut.parentKilled && cut.recovered) {
      assertThat(cut.parent.isAlive()).isFalse();
      p6AwaitProcesses(cut.childTree, true);
      assertThat(cut.signInExited.getCount()).isZero();
      assertThat("DONE".equals(p6Owner(execution).get("state")) && cut.restarted).isTrue();
      return;
    }
    String status =
        jdbc.queryForObject(
            "SELECT status FROM ui_test_executions WHERE id=?", String.class, execution);
    if (!List.of("PASSED", "FAILED", "ERROR").contains(status)) {
      var request =
          HttpRequest.newBuilder(
                  URI.create(
                      "https://localhost:"
                          + port
                          + "/api/v1/studio/executions/"
                          + execution
                          + "/cancel"))
              .timeout(p3CleanupRequestTimeout(deadline))
              .header("Cookie", "put_session=" + cookie)
              .header("Content-Type", "application/json")
              .header("Idempotency-Key", UUID.randomUUID().toString())
              .POST(HttpRequest.BodyPublishers.ofString("{}"))
              .build();
      var cancelled =
          HttpClient.newBuilder()
              .sslContext(TLS)
              .build()
              .send(request, HttpResponse.BodyHandlers.ofString());
      if (cancelled.statusCode() == 409) {
        String code = C.parse(cancelled.body()).path("error").asText();
        assertThat(code).isIn("EXECUTION_TERMINAL", "CANCEL_ALREADY_REQUESTED");
      } else {
        assertThat(cancelled.statusCode()).as("genuine owned ordinary cancellation").isEqualTo(202);
      }
    }
    do {
      JsonNode snapshot = p3CleanupSnapshot(execution, cookie, deadline);
      var actual =
          jdbc.queryForMap(
              "SELECT l.state,l.attempt_id,l.admission_id,e.observed_admission_receipt"
                  + " FROM studio_dispatch_ledger l JOIN ui_test_executions e ON e.id=l.execution_id"
                  + " AND e.started_at=l.execution_accepted_at WHERE l.execution_id=?",
              execution);
      boolean terminal =
          List.of("PASSED", "FAILED", "ERROR").contains(snapshot.path("status").asText());
      if (terminal
          && snapshot.path("streamComplete").asBoolean()
          && "DONE".equals(actual.get("state"))) {
        boolean noTransportEntry =
            actual.get("attempt_id") == null
                && actual.get("admission_id") == null
                && actual.get("observed_admission_receipt") == null
                && !ACTUAL_DISPATCH_DIAGNOSTICS.containsKey(execution);
        if (noTransportEntry) {
          // Genuine pre-send DONE fences future dispatch; no attempted runner resource exists.
          p3WriteCaptureDiagnostics(execution);
          return;
        }
        if (P3_FINAL_REPORTS.containsKey(execution)) {
          JsonNode finalReport = p3RunnerReport(execution);
          assertThat(
                  List.of("PASSED", "FAILED", "ERROR")
                      .contains(finalReport.path("outcome").path("result").asText()))
              .isTrue();
          // The real runner wipes/closes owned resources before delivering this authenticated
          // FINAL.
          return;
        }
      }
    } while (System.nanoTime() < deadline);
    throw new IllegalStateException("Actual ordinary terminal/resource acknowledgement missing");
  }

  private void p4AssertRepositoryGraph() {
    var factory = ownedApplicationContext.getBeanFactory();
    assertThat(sessions).isSameAs(factory.getBean("observedOriginalSessionRepository"));
    assertThat(sessions).isSameAs(factory.getBean(GuidedSessionRepository.class));
    assertThat(factory.getDependentBeans("guidedSessionRepository")).isEmpty();
    assertThat(
            java.util.Arrays.asList(factory.getDependentBeans("observedOriginalSessionRepository")))
        .contains(
            "guidedSessionService",
            "guidedTranslationService",
            "guidedTranslationCoordinator",
            "guidedPlanPublisher",
            "publicationResultProjector");
    assertThat(jdbc).isSameAs(factory.getBean(JdbcTemplate.class));
    assertThat(jdbc.getDataSource()).isSameAs(factory.getBean(javax.sql.DataSource.class));
    var manager = factory.getBean(org.springframework.transaction.PlatformTransactionManager.class);
    assertThat(manager).isInstanceOf(org.springframework.orm.jpa.JpaTransactionManager.class);
    assertThat(((org.springframework.orm.jpa.JpaTransactionManager) manager).getDataSource())
        .isSameAs(jdbc.getDataSource());
  }

  private static boolean p4RevocationUsed(P4RevocationState state) {
    String ownerColumn = state.path == 1 ? "session_id" : "execution_id";
    Object owner = state.path == 1 ? state.guidedSession : state.execution;
    var usages =
        state.actualJdbc.queryForList(
            "SELECT u.* FROM studio_secret_use_audit u JOIN studio_secret_use_audit r"
                + " ON r.id=u.release_id AND r.release_occurred_at=u.release_occurred_at"
                + " WHERE u."
                + ownerColumn
                + "=? AND u.secret_id='PASS' AND u.row_kind='USAGE'"
                + " AND u.usage_outcome='USED' AND r.row_kind='RELEASE'"
                + " AND r.decision_stage='DISPATCH' AND r.outcome='RESOLVED'",
            owner);
    if (usages.isEmpty()) {
      return false;
    }
    p4AuditRequire(usages.size() == 1, "Actual positive usage is not unique");
    Map<String, Object> usage = usages.getFirst();
    var releases =
        state.actualJdbc.queryForList(
            "SELECT * FROM studio_secret_use_audit WHERE id=? AND release_occurred_at=?",
            usage.get("release_id"),
            usage.get("release_occurred_at"));
    p4AuditRequire(releases.size() == 1, "Actual positive release is not unique");
    Map<String, Object> release = releases.getFirst();
    p4AuditRequire(
        java.util.Objects.equals(release.get("id"), release.get("release_id"))
            && java.util.Objects.equals(release.get("id"), usage.get("release_id"))
            && release.get("affected_release_id") == null
            && usage.get("affected_release_id") == null,
        "Actual release usage links do not match");
    p4CompareAuditScope(release, usage);
    p4AuditRequire("RESOLVED".equals(usage.get("outcome")), "Positive usage outcome changed");
    if (!p4AuditOwnerIdentity(state, release)) {
      return false;
    }
    state.usedBefore = java.util.Collections.unmodifiableMap(new java.util.LinkedHashMap<>(usage));
    state.releaseBefore =
        java.util.Collections.unmodifiableMap(new java.util.LinkedHashMap<>(release));
    return true;
  }

  private static void p4AuditRequire(boolean condition, String code) {
    if (!condition) {
      throw new IllegalArgumentException(code);
    }
  }

  private static void p4CompareAuditScope(
      Map<String, Object> release, Map<String, Object> related) {
    for (String field :
        List.of(
            "path",
            "attempt_id",
            "release_seq",
            "execution_id",
            "session_id",
            "admission_id",
            "principal_id",
            "csi_id",
            "environment",
            "test_id",
            "secret_id",
            "vault_version",
            "coordinate_step_id",
            "coordinate_ordinal",
            "source_reference_id",
            "release_occurred_at")) {
      p4AuditRequire(
          java.util.Objects.equals(release.get(field), related.get(field)),
          "Actual immutable audit scope differs: " + field);
    }
  }

  private static boolean p4AuditOwnerIdentity(
      P4RevocationState state, Map<String, Object> release) {
    p4AuditRequire(
        "CSI-456".equals(release.get("csi_id"))
            && "fixture-other".equals(release.get("environment"))
            && state.test.equals(release.get("test_id"))
            && "PASS".equals(release.get("secret_id"))
            && release.get("vault_version") != null,
        "Actual audit selection scope differs");
    if (state.path == 1) {
      var owners =
          state.actualJdbc.queryForList(
              "SELECT g.document::text AS action,g.proposal::text AS proposal,s.document::text AS session,"
                  + " m.authored_inputs::text AS inputs FROM studio_guided_actions g"
                  + " JOIN studio_guided_sessions s ON s.session_id=g.session_id"
                  + " JOIN studio_guided_materializations m ON m.session_id=g.session_id"
                  + " WHERE g.session_id=? AND g.admission_id=?",
              state.guidedSession,
              release.get("admission_id"));
      p4AuditRequire(owners.size() == 1, "Actual consumed admission identity differs");
      var owner = owners.getFirst();
      JsonNode action = C.parse((String) owner.get("action")),
          proposal = C.parse((String) owner.get("proposal")),
          session = C.parse((String) owner.get("session"));
      p4AuditRequire(
          "GUIDED".equals(release.get("path"))
              && state.guidedSession.equals(release.get("session_id"))
              && release.get("execution_id") == null
              && action.path("dispatchCount").asInt() == 1
              && action
                  .path("admission")
                  .path("admissionId")
                  .asText()
                  .equals(release.get("admission_id"))
              && (state.guidedSession + ":" + action.path("ownerFence").asText())
                  .equals(release.get("attempt_id"))
              && action.path("ownerFence").equals(session.path("owner").path("fence"))
              && action.path("coordinate").path("stepId").asText().equals(TWO)
              && action.path("coordinate").path("ordinal").asInt(-1) == 1
              && TWO.equals(release.get("coordinate_step_id"))
              && ((Number) release.get("coordinate_ordinal")).intValue() == 1
              && proposal.path("coordinate").equals(action.path("coordinate"))
              && "fill".equals(proposal.path("operation").path("kind").asText())
              && "secretRef".equals(proposal.path("operation").path("value").path("kind").asText())
              && session
                  .path("scope")
                  .path("principalId")
                  .asText()
                  .equals(release.get("principal_id")),
          "Actual guided release action fence coordinate differs");
      boolean actualInput = false;
      for (JsonNode input : C.parse((String) owner.get("inputs")).path("inputs")) {
        actualInput |=
            input
                    .path("inputId")
                    .equals(proposal.path("operation").path("value").path("sourceInputId"))
                && input.path("kind").asText().equals("secretRef")
                && input.path("secretId").asText().equals("PASS")
                && input.path("sourceStepId").asText().equals(TWO)
                && input.path("intendedSlot").asText().equals("fill.value")
                && input
                    .path("provenance")
                    .path("referenceId")
                    .asText()
                    .equals(String.valueOf(release.get("source_reference_id")));
      }
      p4AuditRequire(actualInput, "Actual released secret materialization identity differs");
    } else {
      var owners =
          state.actualJdbc.queryForList(
              "SELECT l.attempt_id,l.admission_id,e.observed_admission_receipt::text AS receipt,"
                  + " e.observed_revision_binding::text AS binding FROM studio_dispatch_ledger l"
                  + " JOIN ui_test_executions e ON e.id=l.execution_id"
                  + " AND e.started_at=l.execution_accepted_at WHERE l.execution_id=?",
              state.execution);
      p4AuditRequire(owners.size() == 1, "Actual observed owner identity differs");
      var owner = owners.getFirst();
      if (owner.get("admission_id") == null || owner.get("receipt") == null) {
        return false;
      }
      JsonNode binding = C.parse((String) owner.get("binding")),
          receipt = C.parse((String) owner.get("receipt"));
      p4AuditRequire(
          "OBSERVED_REPLAY".equals(release.get("path"))
              && state.execution.equals(release.get("execution_id"))
              && String.valueOf(owner.get("attempt_id")).equals(release.get("attempt_id"))
              && binding.path("attemptId").asText().equals(release.get("attempt_id"))
              && binding.path("principalId").asText().equals(release.get("principal_id"))
              && receipt
                  .path("request")
                  .path("attemptId")
                  .asText()
                  .equals(release.get("attempt_id"))
              && receipt
                  .path("admissionId")
                  .asText()
                  .equals(String.valueOf(owner.get("admission_id")))
              && release.get("session_id") == null
              && release.get("admission_id") == null
              && release.get("coordinate_step_id") == null
              && release.get("coordinate_ordinal") == null,
          "Actual observed release attempt admission binding differs");
    }
    return true;
  }

  private void p4AssertAuditLineageAfterCleanup(P4RevocationState state) {
    assertThat(state.usedBefore != null && state.releaseBefore != null).isTrue();
    var usage =
        jdbc.queryForList(
            "SELECT * FROM studio_secret_use_audit WHERE id=? AND release_occurred_at=?",
            state.usedBefore.get("id"),
            state.usedBefore.get("release_occurred_at"));
    var release =
        jdbc.queryForList(
            "SELECT * FROM studio_secret_use_audit WHERE id=? AND release_occurred_at=?",
            state.releaseBefore.get("id"),
            state.releaseBefore.get("release_occurred_at"));
    assertThat(usage.size()).isEqualTo(1);
    assertThat(release.size()).isEqualTo(1);
    assertThat(state.usedBefore.equals(usage.getFirst()))
        .as("SAME preflip USED identity and immutable row")
        .isTrue();
    assertThat(state.releaseBefore.equals(release.getFirst()))
        .as("SAME original resolved release")
        .isTrue();
    assertThat(p4AuditOwnerIdentity(state, release.getFirst())).isTrue();
    String column = state.path == 1 ? "session_id" : "execution_id";
    Object owner = state.path == 1 ? state.guidedSession : state.execution;
    var rechecks =
        jdbc.queryForList(
            "SELECT * FROM studio_secret_use_audit WHERE "
                + column
                + "=? AND secret_id='PASS' AND decision_stage='LIVE_RECHECK'",
            owner);
    assertThat(rechecks.size())
        .as("ALL selected secret rechecks, regardless of outcome")
        .isEqualTo(1);
    var recheck = rechecks.getFirst();
    assertThat(
            "REVOKED_MID_RUN".equals(recheck.get("outcome"))
                && "RELEASE".equals(recheck.get("row_kind"))
                && state.releaseBefore.get("id").equals(recheck.get("affected_release_id"))
                && recheck.get("id").equals(recheck.get("release_id")))
        .isTrue();
    p4CompareAuditScope(state.releaseBefore, recheck);
    assertThat(
            jdbc.queryForObject(
                "SELECT count(*) FROM studio_secret_use_audit WHERE "
                    + column
                    + "=? AND secret_id='PASS' AND row_kind='USAGE'",
                Long.class,
                owner))
        .isEqualTo(1);
  }

  private static void p4RevocationNotice(com.sun.net.httpserver.HttpExchange exchange)
      throws IOException {
    boolean accepted = false, flipped = false;
    int sequence = 0;
    P4RevocationState state = p4Revocation;
    try {
      byte[] bytes = exchange.getRequestBody().readNBytes(1025);
      if (!exchange.getRequestMethod().equals("POST") || bytes.length > 1024 || state == null) {
        throw new IllegalArgumentException("Invalid scalar revocation observer");
      }
      JsonNode body = C.parse(new String(bytes, StandardCharsets.UTF_8));
      if (!body.isObject()
          || body.size() != 9
          || p4Number(body, "case") != state.ordinal
          || !body.path("ok").isBoolean()) {
        throw new IllegalArgumentException("Invalid scalar observer identity");
      }
      int producer = p4Number(body, "producer"),
          event = p4Number(body, "event"),
          ordinal = p4Number(body, "ordinal"),
          operation = p4Number(body, "operation"),
          reason = p4Number(body, "reason");
      sequence = p4Number(body, "seq");
      synchronized (state) {
        if (producer < 1
            || producer > 3
            || (state.path == 1 ? producer != 1 : producer == 1)
            || sequence != state.sequences.getOrDefault(producer, 0) + 1) {
          throw new IllegalArgumentException("Invalid scalar observer sequence");
        }
        state.sequences.put(producer, sequence);
        if (event == 1) {
          if (state.started || ordinal != 1) {
            throw new IllegalArgumentException("Unexpected selected owner");
          }
          state.started = true;
        } else if (event == 2) {
          if (!state.started
              || state.flippedAt != 0
              || state.active.putIfAbsent(ordinal, operation) != null) {
            throw new IllegalArgumentException("Native entry outside original authority");
          }
        } else if (event == 3) {
          Integer entered = state.active.remove(ordinal);
          if (entered == null || entered != operation) {
            throw new IllegalArgumentException("Unmatched original native settlement");
          }
          if (operation == 1 && body.path("ok").booleanValue()) {
            state.filled = true;
          }
          if (state.flippedAt != 0 && ordinal != state.inFlightOrdinal) {
            throw new IllegalArgumentException("Unidentified residual primitive");
          }
          if (state.flippedAt != 0 && ordinal == state.inFlightOrdinal) {
            state.residualSettlements++;
            state.residualFulfilled = body.path("ok").booleanValue();
            if (operation != 2 || state.residualSettlements != 1) {
              throw new IllegalArgumentException(
                  "Duplicate or mismatched identified click settlement");
            }
          }
        } else if (event == 4) {
          if (!body.path("ok").booleanValue() || (state.path == 2 && producer != 2)) {
            throw new IllegalArgumentException("Invalid real complete acknowledgement");
          }
          if (state.flippedAt == 0
              && state.started
              && state.filled
              && state.signInEntered
              && state.active.size() == 1
              && state.active.containsValue(2)
              && p4RevocationUsed(state)) {
            state.inFlightOrdinal = state.active.keySet().iterator().next();
            if (state.inFlightOrdinal != 3) {
              throw new IllegalArgumentException("Unexpected original Sign in invocation ordinal");
            }
            state.flippedAt = System.nanoTime();
            state.revoked.set(true);
            for (String actor : List.of("user-1", "fixture@example.invalid")) {
              if (!P3_PERMITTED.remove(
                  new P3Entitlement(actor, "CSI-456", "fixture-other", "PASS"))) {
                throw new IllegalArgumentException("Missing genuine granted tuple");
              }
            }
            flipped = true;
          }
        } else if (event == 5) {
          if (!state.started
              || state.flippedAt == 0
              || ordinal != 1
              || (state.path == 2 && (producer != 3 || reason != 4))) {
            throw new IllegalArgumentException("Unproved original authority cutoff");
          }
          if (state.cutoffAt == 0) {
            state.cutoffAt = System.nanoTime();
            state.cutoff.countDown();
          }
          if ((state.path == 1 && reason == 1) || (state.path == 2 && reason == 4)) {
            state.reasonProved = true;
          }
        } else if (event == 6) {
          state.restored = body.path("ok").booleanValue();
          if (!state.restored) {
            throw new IllegalArgumentException("Native descriptor restoration incomplete");
          }
        } else if (event == 8) {
          if (state.flippedAt == 0) {
            throw new IllegalArgumentException("Unmatched real ACK bracket");
          }
          state.ackBracketMicros = p4Number(body, "deltaMicros");
        } else if (event == 9) {
          if (state.path != 1 || !body.path("ok").booleanValue()) {
            throw new IllegalArgumentException("Unproved original owner closure");
          }
          state.closed = true;
        } else {
          throw new IllegalArgumentException("Unknown scalar observer phase");
        }
      }
      accepted = true;
    } catch (RuntimeException failure) {
      if (state != null) {
        state.failed = true;
      }
    } catch (IOException failure) {
      if (state != null) {
        state.failed = true;
      }
      throw failure;
    }
    byte[] response =
        C.object()
            .put("accepted", accepted)
            .put("flipped", flipped)
            .put("seq", sequence)
            .toString()
            .getBytes(StandardCharsets.UTF_8);
    try {
      exchange.getResponseHeaders().set("Content-Type", "application/json");
      exchange.sendResponseHeaders(accepted ? 200 : 409, response.length);
      exchange.getResponseBody().write(response);
    } catch (IOException failure) {
      if (state != null) {
        state.failed = true;
      }
      throw failure;
    }
  }

  private static void p4RequirePrivateProducerRoot(Path root) throws IOException {
    if (Files.isSymbolicLink(root)
        || !Files.isDirectory(root, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        || !root.toRealPath().getParent().equals(TEMP.toRealPath())
        || !Files.getPosixFilePermissions(root, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            .equals(java.nio.file.attribute.PosixFilePermissions.fromString("rwx------"))
        || !Files.getOwner(root, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            .equals(Files.getOwner(TEMP, java.nio.file.LinkOption.NOFOLLOW_LINKS))) {
      throw new IOException("Private observer directory confinement failed");
    }
  }

  private void p4WriteRevocationMode(P4RevocationState state) throws IOException {
    Path directory = TEMP.resolve("p4-revocation-producers");
    if (!Files.exists(directory, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
      Files.createDirectory(
          directory,
          java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
              java.nio.file.attribute.PosixFilePermissions.fromString("rwx------")));
    }
    p4RequirePrivateProducerRoot(directory);
    ObjectNode mode =
        C.object()
            .put("active", true)
            .put("case", state.ordinal)
            .put("epoch", state.ordinal)
            .put("path", state.path);
    if (state.execution != null) {
      mode.put("executionId", state.execution.toString());
      mode.put(
          "controlUrl",
          "https://localhost:"
              + port
              + "/internal/studio/executions/"
              + state.execution
              + "/control");
    }
    Files.writeString(
        TEMP.resolve("p4-revocation-state.json"), mode.toString(), StandardCharsets.UTF_8);
  }

  private void p4AwaitRevocationObserverCompletion(P4RevocationState state) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(10).toNanos();
    boolean complete;
    do {
      synchronized (state) {
        complete =
            state.active.isEmpty()
                && state.reasonProved
                && state.restored
                && state.residualSettlements == 1
                && state.residualFulfilled != null
                && state.ackBracketMicros > 0
                && (state.path == 2 || state.closed);
      }
      if (complete) {
        break;
      }
      Thread.sleep(20);
    } while (System.nanoTime() < deadline);
    assertThat(complete).as("all required original scalar witnesses settled").isTrue();
    assertThat(state.failed).as("no lost malformed or failed observer").isFalse();
    assertThat(Files.exists(TEMP.resolve("p4-revocation-observer-failed"))).isFalse();
  }

  private void p4SealPrivateProducersAfterOwnerCleanup(P4RevocationState state) throws Exception {
    Path root = TEMP.resolve("p4-revocation-producers");
    p4RequirePrivateProducerRoot(root);
    List<Integer> producers = state.path == 1 ? List.of(1) : List.of(2, 3);
    for (int producer : producers) {
      if (producer == 3) {
        continue; // Real nonreturning child exit publishes its exact synchronous final sample.
      }
      ObjectNode command =
          C.object()
              .put("case", state.ordinal)
              .put("producer", producer)
              .put("epoch", state.ordinal)
              .put("seal", true);
      Path target = root.resolve(state.ordinal + "-" + producer + "-seal.json");
      Path temporary = root.resolve(state.ordinal + "-" + producer + "-seal.tmp");
      p4RequirePrivateProducerRoot(root);
      Files.createFile(
          temporary,
          java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
              java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")));
      Files.writeString(
          temporary,
          command.toString(),
          StandardCharsets.UTF_8,
          java.nio.file.StandardOpenOption.WRITE);
      p4RequirePrivateProducerRoot(root);
      Files.move(temporary, target, java.nio.file.StandardCopyOption.ATOMIC_MOVE);
    }
    long deadline = System.nanoTime() + Duration.ofSeconds(10).toNanos();
    for (int producer : producers) {
      Path file = root.resolve(state.ordinal + "-" + producer + ".json");
      JsonNode finalSample = null;
      do {
        p4RequirePrivateProducerRoot(root);
        if (Files.exists(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
          if (Files.isSymbolicLink(file)
              || !Files.isRegularFile(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)
              || Files.size(file) > 1024
              || !file.toRealPath().getParent().equals(root.toRealPath())
              || !Files.getPosixFilePermissions(file)
                  .equals(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"))) {
            throw new IOException("Private producer sample confinement failed");
          }
          p4RequirePrivateProducerRoot(root);
          JsonNode sample = C.parse(Files.readString(file, StandardCharsets.UTF_8));
          if (!sample.isObject()
              || sample.size() != 10
              || sample.path("case").asInt(-1) != state.ordinal
              || sample.path("producer").asInt(-1) != producer
              || sample.path("epoch").asInt(-1) != state.ordinal
              || sample.path("role").asInt(-1) != producer
              || !sample.path("failed").isBoolean()
              || !sample.path("sealed").isBoolean()) {
            throw new IOException("Private producer sample identity failed");
          }
          if (sample.path("sealed").booleanValue()) {
            finalSample = sample;
            break;
          }
        }
        Thread.sleep(20);
      } while (System.nanoTime() < deadline);
      assertThat(finalSample != null)
          .as("actual producer final ACK/failure processing sample")
          .isTrue();
      assertThat(finalSample.path("failed").booleanValue()).isFalse();
      assertThat(p4Number(finalSample, "pending")).isZero();
      assertThat(p4Number(finalSample, "originalPending")).isZero();
      assertThat(p4Number(finalSample, "sent")).isPositive();
      assertThat(p4Number(finalSample, "acked")).isEqualTo(p4Number(finalSample, "sent"));
      assertThat(p4Number(finalSample, "sent")).isEqualTo(state.sequences.get(producer));
    }
    assertThat(state.failed).isFalse();
    assertThat(Files.exists(TEMP.resolve("p4-revocation-observer-failed"))).isFalse();
    // Preserve numeric final records in the owned evidence directory; remove only seal commands.
    for (int producer : producers) {
      p4RequirePrivateProducerRoot(root);
      Files.deleteIfExists(root.resolve(state.ordinal + "-" + producer + "-seal.json"));
    }
  }

  private void p4RevocationPair(int path) throws Exception {
    p3Mode = P3Mode.LOGIN;
    p3Grant("CSI-456", "fixture-other");
    UUID test = p3CreateSource("CSI-456", "fixture-other", true);
    VaultScope scope = VaultScope.of("CSI-456", "fixture-other", test);
    String value = "P4-REVOKE-" + UUID.randomUUID();
    p3ExpectedPassword = value;
    p3Seed(scope, value);
    P3Publication publication = null;
    if (path == 2) {
      String control = p3Start(test, "fixture-other");
      awaitFinalizing(control);
      publication = p3Publish(control);
      p3CleanupOwnedResources();
      p3OwnedGuidedCookies.clear();
      P3_RECEIPTS.clear();
      P3_NATIVE_SESSIONS.clear();
      P3_REPORT_REQUESTS.set(0);
    }
    int models = MODEL_WIRE.size();
    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    P4RevocationState state =
        new P4RevocationState(P4_REVOCATION_CASE.incrementAndGet(), path, test, jdbc);
    p4Revocation = state;
    p4WriteRevocationMode(state);
    try {
      if (path == 1) {
        state.guidedSession = p3Start(test, "fixture-other");
      } else {
        state.execution = p3Execute(test);
        p4WriteRevocationMode(state);
        p3AssertBinding(state.execution, scope, publication);
        assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
      }
      assertThat(state.cutoff.await(20, java.util.concurrent.TimeUnit.SECONDS))
          .as("original cutoff ingress after genuine ACK and exact tuple flip")
          .isTrue();
      assertThat(state.cutoffAt - state.flippedAt)
          .isPositive()
          .isLessThanOrEqualTo(Duration.ofMillis(2000).toNanos());
      assertThat(state.filled).isTrue();
      assertThat(state.signInEntered).isTrue();
      state.releaseSignIn.countDown();
      Object revokedAt;
      if (path == 1) {
        awaitState(state.guidedSession, "CANCELLED");
        p3AwaitTeardown(state.guidedSession);
        revokedAt =
            jdbc.queryForObject(
                "SELECT revoked_at FROM studio_guided_sessions WHERE session_id=?",
                Object.class,
                state.guidedSession);
        p3AssertUsed(state.guidedSession, null);
        assertThat(
                sessions.transaction(
                    () -> sessions.lock(state.guidedSession).progress().path("errorCode").asText()))
            .isEqualTo("SECRET_USE_REVOKED");
      } else {
        JsonNode result = p3AwaitExecution(state.execution, "ERROR");
        assertThat(result.path("errorCode").asText()).isEqualTo("AUTHORIZATION_REVOKED");
        assertThat(p3RunnerReport(state.execution).path("outcome").path("errorCode").asText())
            .isEqualTo("CANCELLED");
        revokedAt =
            jdbc.queryForObject(
                "SELECT revoked_at FROM studio_dispatch_ledger WHERE execution_id=?",
                Object.class,
                state.execution);
        assertThat(
                jdbc.queryForObject(
                    "SELECT cancel_requested_at FROM studio_dispatch_ledger WHERE execution_id=?",
                    Object.class,
                    state.execution))
            .isNull();
        assertThat(MODEL_WIRE.size()).isEqualTo(models);
        p3AssertBinding(state.execution, scope, publication);
        p3AssertUsed(null, state.execution);
      }
      assertThat(revokedAt).isNotNull();
      String ownerColumn = path == 1 ? "session_id" : "execution_id";
      Object owner = path == 1 ? state.guidedSession : state.execution;
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE "
                      + ownerColumn
                      + "=? AND secret_id='PASS' AND row_kind='RELEASE' AND outcome='RESOLVED'",
                  Long.class,
                  owner))
          .isEqualTo(1);
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE "
                      + ownerColumn
                      + "=? AND secret_id='PASS' AND decision_stage='LIVE_RECHECK' AND outcome='REVOKED_MID_RUN'",
                  Long.class,
                  owner))
          .isEqualTo(1);
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                  - reads)
          .isEqualTo(1);
      assertThat(P3_RECEIPTS).hasSize(1);
      assertThat(P3_RECEIPTS.getFirst().accepted()).isTrue();
      assertThat(P3_REPORT_REQUESTS.get()).isZero();
      p3AssertAuditScope(state.guidedSession, state.execution, scope);
      p3CleanupOwnedResources();
      p4AwaitRevocationObserverCompletion(state);
      p4AssertAuditLineageAfterCleanup(state);
      String table = path == 1 ? "studio_guided_sessions" : "studio_dispatch_ledger";
      assertThat(
              jdbc.queryForObject(
                  "SELECT revoked_at FROM " + table + " WHERE " + ownerColumn + "=?",
                  Object.class,
                  owner))
          .isEqualTo(revokedAt);
      p3Scan(List.of(value));
      p3WriteEvidence(
          "revocation-first-pair-" + path,
          C.object()
              .put("path", path)
              .put("cutoffNanosIncludingQueues", state.cutoffAt - state.flippedAt)
              .put("ackBracketMicrosSameNodeClock", state.ackBracketMicros)
              .put("identifiedInFlightOrdinal", state.inFlightOrdinal)
              .put("freshSecretReads", 1)
              .put("residualSettlementCount", state.residualSettlements)
              .put("residualFulfilled", state.residualFulfilled)
              .put("residualRejected", !state.residualFulfilled)
              .put("acceptedPostDistinctFromPromiseSettlement", true)
              .put("priorPositiveUsagePreserved", true)
              .put("actualLiveRecheckRows", 1)
              .put("nativeEntryOnlyNotDomWrite", true)
              .put("originalOwnerCleanupConfirmed", true));
    } finally {
      state.releaseSignIn.countDown();
    }
  }

  private int p4StartObserverPhase(int count) throws Exception {
    if (P4_PHASE_ORDINAL.get() > 0) {
      p4AssertObserverPhaseCompleted(P4_PHASE_ORDINAL.get());
    }
    assertThat(p3OwnedGuidedCookies).isEmpty();
    assertThat(p3OwnedOrdinaryCookies).isEmpty();
    P4_EFFECT_REGISTRATIONS.set(0);
    P4_PASSWORD_WRITES.set(0);
    P4_NATIVE_SUBMITS.set(0);
    p4PasswordControls = count;
    int phase = P4_PHASE_ORDINAL.incrementAndGet();
    Files.writeString(
        TEMP.resolve("p4-native-observer.json"),
        C.object().put("active", true).put("phase", phase).toString(),
        StandardCharsets.UTF_8);
    return phase;
  }

  private boolean p4OriginalCloseSettled(int phase) throws IOException {
    Path receipt = TEMP.resolve("p4-native-observer-settled");
    if (!Files.exists(receipt)) {
      return false;
    }
    List<String> lines = Files.readAllLines(receipt, StandardCharsets.UTF_8);
    for (String line : lines) {
      if (!line.matches("[1-9][0-9]{0,8}")) {
        P4_NOTIFICATION_FAILED.set(true);
        return false;
      }
    }
    return lines.contains(Integer.toString(phase));
  }

  private void p4AssertObserverPhaseCompleted(int phase) throws IOException {
    assertThat(p4OriginalCloseSettled(phase))
        .as("original SDK close settled after selected fence ACK completion")
        .isTrue();
    assertThat(P4_NOTIFICATION_FAILED.get())
        .as("all actual notification ACKs stayed valid")
        .isFalse();
    assertThat(Files.exists(TEMP.resolve("p4-native-observer-failed")))
        .as("original public SDK fence stayed available")
        .isFalse();
    assertThat(P4_CLOSED_PHASES.contains(phase))
        .as("actual original before-close fence ACK")
        .isTrue();
    List<P4DocumentWitness> documents =
        P4_DOCUMENTS.values().stream().filter(witness -> witness.phase == phase).toList();
    assertThat(documents).isNotEmpty();
    for (P4DocumentWitness witness : documents) {
      synchronized (witness) {
        assertThat(witness.fenced && witness.fenceCompleted)
            .as("actual final fence ACK and correlated completion receipt")
            .isTrue();
        assertThat(witness.acknowledged.size()).isEqualTo(witness.events.size());
        assertThat(witness.events.containsValue("registered")).isTrue();
      }
    }
  }

  private void p4AssertRegisteredAndNoPasswordEffects() throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(10).toNanos();
    while (!p4OriginalCloseSettled(P4_PHASE_ORDINAL.get()) && System.nanoTime() < deadline) {
      Thread.sleep(20);
    }
    p4AssertObserverPhaseCompleted(P4_PHASE_ORDINAL.get());
    assertThat(P4_EFFECT_REGISTRATIONS.get()).isPositive();
    assertThat(P4_PASSWORD_WRITES.get()).isZero();
    assertThat(P4_NATIVE_SUBMITS.get()).isZero();
    assertThat(P3_RECEIPTS).isEmpty();
    assertThat(P3_REPORT_REQUESTS.get()).isZero();
  }

  private P3Publication p4PositiveNativeControl(UUID test) throws Exception {
    int phase = p4StartObserverPhase(1);
    String control = p3Start(test, "fixture-other");
    awaitFinalizing(control);
    assertThat(P3_RECEIPTS).hasSize(1);
    assertThat(P3_RECEIPTS.getFirst().accepted()).isTrue();
    int beforePublicationReads = COUNTED_VAULT.reads.size();
    P3Publication publication = p3Publish(control);
    p4PublicationValueReads = COUNTED_VAULT.reads.size() - beforePublicationReads;
    assertThat(p4PublicationValueReads).isZero();
    p3CleanupOwnedResources();
    p4AssertObserverPhaseCompleted(phase);
    assertThat(P4_PASSWORD_WRITES.get()).isPositive();
    assertThat(P4_NATIVE_SUBMITS.get()).isEqualTo(1);
    p3AssertUsed(control, null);
    p3WriteEvidence(
        "native-positive-control-" + phase,
        C.object()
            .put("phase", phase)
            .put("realPasswordWrites", P4_PASSWORD_WRITES.get())
            .put("realNativeSubmits", P4_NATIVE_SUBMITS.get())
            .put("allNotificationsAcked", true)
            .put("originalOwnerCleanupConfirmed", true));
    p3OwnedGuidedCookies.clear();
    p3OwnedOrdinaryCookies.clear();
    P3_RECEIPTS.clear();
    P3_NATIVE_SESSIONS.clear();
    P3_REPORT_REQUESTS.set(0);
    return publication;
  }

  private void p4GuidedAdversarialPasswordCount(int count) throws Exception {
    Throwable primary = null;
    try {
      p4AssertRepositoryGraph();
      P4_WITNESS_FAILED.set(false);
      p3Mode = P3Mode.LOGIN;
      p4AdversarialPasswordSelection = false;
      P4_FIRST_GUIDED_REQUEST.set(null);
      P4_FIRST_GUARD.set(null);
      p3Grant("CSI-456", "fixture-other");
      UUID test = p3CreateSource("CSI-456", "fixture-other", true);
      VaultScope scope = VaultScope.of("CSI-456", "fixture-other", test);
      String value = "P4-GUIDED-COUNT-" + UUID.randomUUID();
      p3ExpectedPassword = value;
      p3Seed(scope, value);
      p4PositiveNativeControl(test);
      p4StartObserverPhase(count);
      p4AdversarialPasswordSelection = true;
      int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
      String id = p3Start(test, "fixture-other");
      awaitState(id, "FAILED");
      JsonNode publicResult =
          p3Call(p3Cookie, "/api/v3/studio/guided-sessions/" + id + "/result", null, 200);
      assertThat(publicResult.path("errorCode").asText())
          .isEqualTo(count == 2 ? "LOGIN_REQUIRED" : "INVALID_CONTRACT");
      if (count == 2) {
        assertThat(publicResult.path("failure").path("code").asText()).isEqualTo("LOGIN_REQUIRED");
        assertThat(publicResult.path("detail").path("stepId").asText()).isEqualTo(TWO);
        assertThat(publicResult.path("detail").path("loginStepsPresent").asBoolean()).isFalse();
      } else {
        assertThat(
                publicResult.path("detail").isMissingNode() || publicResult.path("detail").isNull())
            .isTrue();
      }
      boolean actualFailureStep =
          sessions.transaction(
              () -> {
                var current = sessions.lock(id);
                return current
                    .document()
                    .path("sourceSteps")
                    .get(current.progress().path("stepIndex").asInt())
                    .path("stepId")
                    .asText()
                    .equals(TWO);
              });
      assertThat(actualFailureStep).isTrue();
      ObjectNode request = P4_FIRST_GUIDED_REQUEST.get();
      assertThat(request).as("genuine USER-stage NEXT_ACTION reached").isNotNull();
      assertThat(request.path("actualNextAction").asBoolean()).isTrue();
      assertThat(request.path("availableUserOrdinal").asInt(-1)).isZero();
      assertThat(request.path("selectedPasswordOrdinal").asInt(-1)).isEqualTo(1);
      assertThat(request.path("passwordCount").asInt(-1)).isEqualTo(count);
      assertThat(request.path("actualSameStepSecretInput").asBoolean()).isTrue();
      assertThat(request.path("actualPublicUserAvailable").asBoolean()).isTrue();
      assertThat(P4_WITNESS_FAILED.get())
          .as("actual exception observer stayed available")
          .isFalse();
      ObjectNode refusal = P4_FIRST_GUARD.get();
      assertThat(refusal).as("FIRST original validator count predicate refused").isNotNull();
      assertThat(refusal.path("policyDenied").asBoolean()).isTrue();
      assertThat(refusal.path("status").asInt()).isEqualTo(422);
      assertThat(refusal.path("validatorCountPredicate").asBoolean()).isTrue();
      assertThat(refusal.path("validatorLine").asInt()).isEqualTo(363);
      assertThat(refusal.path("actualCallbackRollbackObserved").asBoolean()).isTrue();
      assertThat(refusal.path("passwordCount").asInt(-1)).isEqualTo(count);
      assertThat(
              COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                  - reads)
          .isZero();
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_guided_actions WHERE session_id=? AND step_id=?",
                  Long.class,
                  id,
                  TWO))
          .isZero();
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE session_id=? AND row_kind='RELEASE'",
                  Long.class,
                  id))
          .isZero();
      JsonNode progress = sessions.transaction(() -> sessions.lock(id).progress().deepCopy());
      assertThat(progress.path("stepIndex").asInt()).isEqualTo(1);
      assertThat(progress.path("observation").path("coverage").path("passwordControls").asInt(-1))
          .isEqualTo(count);
      p3AwaitTeardown(id);
      p4AssertRegisteredAndNoPasswordEffects();
      p3Scan(List.of(value));
      p3WriteEvidence(
          "guided-adversarial-count-" + count,
          C.object()
              .put("adversarialValidatorOnly", true)
              .put("passwordCount", count)
              .put("publicLoginRequired", count == 2)
              .put("publicInvalidContract", count == 0)
              .put("actualFailingStepMatched", actualFailureStep)
              .put("firstCountPredicate", true)
              .put("originalStatus", refusal.path("status").asInt())
              .put("originalLine", refusal.path("validatorLine").asInt())
              .put("actualSecretReads", 0)
              .put("secretAdmissions", 0)
              .put("passwordWrites", P4_PASSWORD_WRITES.get())
              .put("nativePosts", P3_RECEIPTS.size()));
    } catch (Exception | AssertionError failure) {
      primary = failure;
      throw failure;
    } finally {
      try {
        p4WriteFirstGuardDiagnostic(count);
      } catch (Exception | AssertionError diagnosticFailure) {
        if (primary != null) {
          primary.addSuppressed(diagnosticFailure);
        } else {
          throw diagnosticFailure;
        }
      }
    }
  }

  private void p4WriteFirstGuardDiagnostic(int count) throws Exception {
    JsonNode guard = P4_FIRST_GUARD.get(), request = P4_FIRST_GUIDED_REQUEST.get();
    ObjectNode diagnostic =
        C.object()
            .put("schemaVersion", 1)
            .put("requestedCount", count)
            .put("fixturePhase", P4_PHASE_ORDINAL.get())
            .put("actualFirstGuardCaptured", guard != null)
            .put("actualRequestCaptured", request != null)
            .put("observerFailed", P4_WITNESS_FAILED.get())
            .put("expectedGuardLine", 363);
    if (guard != null) {
      diagnostic
          .put("actualActionLine", guard.path("validatorLine").asInt())
          .put("actualStatus", guard.path("status").asInt())
          .put("actualCodeOrdinal", guard.path("policyDenied").asBoolean() ? 1 : 0)
          .put("actualPasswordCount", guard.path("passwordCount").asInt(-1))
          .put("actualGuardPhase", guard.path("phaseOrdinal").asInt())
          .put("actualRollbackObserved", guard.path("actualCallbackRollbackObserved").asBoolean())
          .put("actualPredicateMatched", guard.path("validatorCountPredicate").asBoolean());
    }
    if (request != null) {
      diagnostic
          .put("actualObservationCount", request.path("passwordCount").asInt(-1))
          .put("actualUserOrdinal", request.path("availableUserOrdinal").asInt(-1))
          .put("actualPasswordOrdinal", request.path("selectedPasswordOrdinal").asInt(-1));
    }
    Path source =
        Path.of(
            "src/main/java/com/citi/put/checks/studio/guided/translation/GuidedProposalValidator.java");
    diagnostic.put(
        "validatorSourceSha256",
        HexFormat.of()
            .formatHex(
                java.security.MessageDigest.getInstance("SHA-256")
                    .digest(Files.readAllBytes(source))));
    try (var bytes =
        com.citi.put.checks.studio.guided.translation.GuidedProposalValidator.class
            .getResourceAsStream("GuidedProposalValidator.class")) {
      if (bytes == null) {
        throw new IllegalStateException("Actual validator class identity unavailable");
      }
      diagnostic.put(
          "validatorClassSha256",
          HexFormat.of()
              .formatHex(
                  java.security.MessageDigest.getInstance("SHA-256").digest(bytes.readAllBytes())));
    }
    Files.writeString(
        TEMP.resolve("p4-first-guard-diagnostic-" + count + ".json"),
        diagnostic.toPrettyString(),
        StandardCharsets.UTF_8);
  }

  private void p4OrdinaryPasswordCount(int count) throws Exception {
    p4AssertRepositoryGraph();
    p3Mode = P3Mode.LOGIN;
    p3Grant("CSI-456", "fixture-other");
    UUID test = p3CreateSource("CSI-456", "fixture-other", true);
    VaultScope scope = VaultScope.of("CSI-456", "fixture-other", test);
    String value = "P4-ORDINARY-COUNT-" + UUID.randomUUID();
    p3ExpectedPassword = value;
    p3Seed(scope, value);
    P3Publication publication = p4PositiveNativeControl(test);
    // p3Publish inside the genuine positive control asserts zero publication value/model reads.
    int publicationValueReads = p4PublicationValueReads;
    int models = MODEL_WIRE.size();
    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    p4StartObserverPhase(count);
    P3_RECEIPTS.clear();
    P3_NATIVE_SESSIONS.clear();
    P3_REPORT_REQUESTS.set(0);
    UUID execution = p3Execute(test);
    p3AssertBinding(execution, scope, publication);
    assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
    p3AwaitExecution(execution, "ERROR");
    JsonNode report = p3RunnerReport(execution);
    assertThat(report.path("outcome").path("result").asText()).isEqualTo("ERROR");
    assertThat(report.path("steps").size()).isEqualTo(3);
    assertThat(report.path("steps").get(0).path("status").asText()).isEqualTo("PASS");
    assertThat(report.path("steps").get(1).path("status").asText()).isEqualTo("FAIL");
    assertThat(report.path("steps").get(1).path("failure").asText()).isEqualTo("POLICY_REFUSED");
    assertThat(report.path("steps").get(2).path("status").asText()).isEqualTo("SKIPPED");
    assertThat(report.path("steps").get(2).path("startedAtMs").isNull()).isTrue();
    assertThat(report.path("secretUse").path("PASS").asText()).isEqualTo("REFUSED");
    assertThat(
            COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                - reads)
        .isEqualTo(1);
    assertThat(MODEL_WIRE.size()).isEqualTo(models);
    assertThat(
            jdbc.queryForObject(
                "SELECT count(*) FROM studio_secret_use_audit WHERE execution_id=? AND row_kind='RELEASE'"
                    + " AND outcome='RESOLVED' AND secret_id='PASS'",
                Long.class,
                execution))
        .isEqualTo(1);
    assertThat(
            jdbc.queryForObject(
                "SELECT count(*) FROM studio_secret_use_audit WHERE execution_id=? AND row_kind='USAGE'"
                    + " AND usage_outcome='REFUSED' AND secret_id='PASS'",
                Long.class,
                execution))
        .isEqualTo(1);
    p3AssertAuditScope(null, execution, scope);
    p3AssertBinding(execution, scope, publication);
    p3CleanupOwnedResources();
    p4AssertRegisteredAndNoPasswordEffects();
    p3Scan(List.of(value));
    p3WriteEvidence(
        "ordinary-native-count-" + count,
        C.object()
            .put("passwordCount", count)
            .put("publicationValueReads", publicationValueReads)
            .put(
                "freshSecretReads",
                COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                    - reads)
            .put("ordinaryModelCalls", MODEL_WIRE.size() - models)
            .put("artifactUnchanged", true)
            .put("nativeRefusal", true)
            .put("passwordWrites", P4_PASSWORD_WRITES.get())
            .put("nativePosts", P3_RECEIPTS.size()));
  }

  private void p3GuidedLogin(P3Mode mode, boolean password) throws Exception {
    p3Mode = mode;
    p3ReportsProtected = mode == P3Mode.REPORTS;
    UUID test = p3CreateSource("CSI-123", "fixture", password);
    VaultScope scope = VaultScope.of("CSI-123", "fixture", test);
    String wrong = "P3-WRONG-" + UUID.randomUUID();
    if (password) {
      p3Seed(scope, wrong);
    }
    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    String id = p3Start(test, "fixture");
    if (mode == P3Mode.REGISTRATION) {
      awaitFinalizing(id);
      JsonNode observed =
          sessions.transaction(() -> sessions.lock(id).progress().path("observation").deepCopy());
      assertThat(
              com.citi.put.checks.studio.guided.translation.LoginRequiredSignature.matches(
                  observed))
          .isTrue();
      p3Publish(id);
      var result = p3Call(p3Cookie, "/api/v3/studio/guided-sessions/" + id + "/result", null, 200);
      assertThat(result.path("failure").path("code").asText()).isNotEqualTo("LOGIN_REQUIRED");
      assertThat(result.path("detail").isMissingNode() || result.path("detail").isNull()).isTrue();
    } else {
      awaitState(id, "FAILED");
      var result = p3Call(p3Cookie, "/api/v3/studio/guided-sessions/" + id + "/result", null, 200);
      assertThat(result.path("failure").path("code").asText()).isEqualTo("LOGIN_REQUIRED");
      assertThat(result.path("detail").path("stepId").asText()).isEqualTo(password ? THREE : TWO);
      assertThat(result.path("detail").path("loginStepsPresent").asBoolean()).isEqualTo(password);
      JsonNode observation =
          sessions.transaction(() -> sessions.lock(id).progress().path("observation").deepCopy());
      assertThat(
              com.citi.put.checks.studio.guided.translation.LoginRequiredSignature.matches(
                  observation))
          .isTrue();
      assertThat(observation.path("coverage").path("passwordControls").asInt()).isEqualTo(1);
      if (password) {
        assertThat(P3_RECEIPTS).hasSize(1);
        assertThat(P3_RECEIPTS.getFirst().accepted()).isFalse();
        assertThat(P3_RECEIPTS.getFirst().password().equals(wrong)).isTrue();
        assertThat(P3_RECEIPTS.getFirst().username().equals("p3-user")).isTrue();
        p3AssertUsed(id, null);
        p3AssertAuditScope(id, null, scope);
      } else {
        assertThat(P3_RECEIPTS).isEmpty();
      }
    }
    assertThat(
            COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                - reads)
        .isEqualTo(password ? 1 : 0);
    assertThat(P3_REPORT_REQUESTS.get()).isZero();
    p3Scan(password ? List.of(wrong, p3ExpectedPassword) : List.of(p3ExpectedPassword));
    p3WriteEvidence(
        "guided-login-" + mode.ordinal(),
        C.object()
            .put("branch", mode.ordinal())
            .put("loginStepsPresent", password)
            .put(
                "valueReads",
                COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                    - reads)
            .put(
                "nativeRejectedPosts",
                P3_RECEIPTS.stream().filter(receipt -> !receipt.accepted()).count())
            .put("protectedRequests", P3_REPORT_REQUESTS.get()));
  }

  private void p3PublishedLogin(P3Mode mode, boolean password) throws Exception {
    p3Mode = mode;
    UUID test = p3CreateSource("CSI-123", "fixture", password);
    VaultScope scope = VaultScope.of("CSI-123", "fixture", test);
    String correct = p3ExpectedPassword;
    if (password) {
      p3Seed(scope, correct);
    }
    String id = p3Start(test, "fixture");
    awaitFinalizing(id);
    P3Publication publication = p3Publish(id);
    int models = MODEL_WIRE.size();
    int reads = COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS");
    P3_NATIVE_SESSIONS.clear();
    P3_RECEIPTS.clear();
    P3_REPORT_REQUESTS.set(0);
    p3ReportsProtected = true;
    String wrong = "P3-ROTATED-WRONG-" + UUID.randomUUID();
    if (password) {
      p3Seed(scope, wrong);
    }
    int invocationStart = P3_INVOCATIONS.size();
    UUID execution = p3Execute(test);
    p3AssertBinding(execution, scope, publication);
    assertThat(dispatcher.dispatchOnce()).isEqualTo(1);
    JsonNode report =
        p3AwaitExecution(execution, mode == P3Mode.REGISTRATION ? "PASSED" : "FAILED");
    assertThat(MODEL_WIRE.size()).isEqualTo(models);
    assertThat(
            COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                - reads)
        .isEqualTo(password ? 1 : 0);
    if (mode == P3Mode.REGISTRATION) {
      assertThat(report.path("errorCode").asText()).isNotEqualTo("LOGIN_REQUIRED");
      assertThat(report.path("detail").isMissingNode() || report.path("detail").isNull()).isTrue();
      JsonNode runner = p3RunnerReport(execution);
      assertThat(runner.path("outcome").path("result").asText()).isEqualTo("PASSED");
      assertThat(runner.path("outcome").path("errorCode").isNull()).isTrue();
      assertThat(
              runner.path("outcome").path("detail").isMissingNode()
                  || runner.path("outcome").path("detail").isNull())
          .isTrue();
      assertThat(runner.path("steps").size()).isEqualTo(3);
      for (int index = 0; index < 3; index++) {
        JsonNode step = runner.path("steps").get(index);
        assertThat(step.path("stepIndex").asInt()).isEqualTo(index);
        assertThat(step.path("status").asText()).isEqualTo("PASS");
        assertThat(step.path("failure").isNull()).isTrue();
      }
    } else {
      // FAILED runner causes remain on the authenticated callback, not API-owned error_code.
      assertThat(report.path("errorCode").isNull() || report.path("errorCode").isMissingNode())
          .isTrue();
      JsonNode runner = p3RunnerReport(execution);
      assertThat(runner.path("outcome").path("errorCode").asText()).isEqualTo("LOGIN_REQUIRED");
      assertThat(runner.path("outcome").path("detail").path("stepId").asText())
          .isEqualTo(password ? THREE : TWO);
      assertThat(runner.path("outcome").path("detail").path("loginStepsPresent").asBoolean())
          .isEqualTo(password);
      assertThat(runner.path("steps").size()).isEqualTo(3);
      int failedIndex = password ? 2 : 1;
      for (int index = 0; index < 3; index++) {
        JsonNode step = runner.path("steps").get(index);
        assertThat(step.path("stepIndex").asInt()).isEqualTo(index);
        if (index < failedIndex) {
          assertThat(step.path("status").asText()).isEqualTo("PASS");
          assertThat(step.path("failure").isNull()).isTrue();
        } else if (index == failedIndex) {
          assertThat(step.path("status").asText()).isEqualTo("FAIL");
          assertThat(step.path("failure").asText()).isEqualTo("LOGIN_REQUIRED");
        } else {
          assertThat(step.path("status").asText()).isEqualTo("SKIPPED");
          assertThat(step.path("startedAtMs").isNull()).isTrue();
          assertThat(step.path("finishedAtMs").isNull()).isTrue();
        }
      }
      if (password) {
        assertThat(P3_RECEIPTS).hasSize(1);
        assertThat(P3_RECEIPTS.getFirst().accepted()).isFalse();
        assertThat(P3_RECEIPTS.getFirst().password().equals(wrong)).isTrue();
        assertThat(P3_RECEIPTS.getFirst().username().equals("p3-user")).isTrue();
        p3AssertUsed(null, execution);
        p3AssertAuditScope(null, execution, scope);
        assertThat(runner.path("secretUse").path("PASS").asText()).isEqualTo("USED");
      } else {
        assertThat(P3_RECEIPTS).isEmpty();
      }
    }
    if (mode != P3Mode.REGISTRATION) {
      List<String> calls = P3_INVOCATIONS.subList(invocationStart, P3_INVOCATIONS.size());
      if (password) {
        assertThat(calls).containsExactly("fill", "click");
      } else {
        assertThat(calls).isEmpty();
      }
      assertThat(P3_REPORT_REQUESTS.get()).isZero();
    }
    long decodedFrames = p3DecodeVideo(execution, report);
    assertThat(
            jdbc.queryForObject(
                "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                String.class,
                publication.revision()))
        .isEqualTo(publication.artifactHash());
    p3Scan(password ? List.of(correct, wrong) : List.of(correct));
    p3WriteEvidence(
        "ordinary-login-" + mode.ordinal(),
        C.object()
            .put("branch", mode.ordinal())
            .put("loginStepsPresent", password)
            .put(
                "valueReads",
                COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS")
                    - reads)
            .put("modelCalls", MODEL_WIRE.size() - models)
            .put(
                "nativeRejectedPosts",
                P3_RECEIPTS.stream().filter(receipt -> !receipt.accepted()).count())
            .put("decodedFrames", decodedFrames)
            .put(
                "artifactUnchanged",
                jdbc.queryForObject(
                        "SELECT artifact_hash FROM ui_test_revisions WHERE id=?",
                        String.class,
                        publication.revision())
                    .equals(publication.artifactHash())));
  }

  private UUID p3CreateSource(String csi, String environment, boolean password) throws Exception {
    String destination =
        ORIGIN
            + (p3Mode == P3Mode.LOGIN
                ? "/p3/login"
                : p3Mode == P3Mode.REPORTS ? "/p3/reports" : "/p3/registration");
    List<String> texts =
        password
            ? List.of(
                "Open " + destination + ".",
                "Enter <var USER> in User and <secret PASS> as password.",
                "Click Sign in, click the Reports link and check protected Reports heading.")
            : List.of(
                "Open " + destination + ".",
                "Check "
                    + (p3Mode == P3Mode.REGISTRATION ? "Registration" : "Reports")
                    + " heading.",
                "Check "
                    + (p3Mode == P3Mode.REGISTRATION ? "Registration" : "Reports")
                    + " heading remains visible.");
    UUID test = UUID.randomUUID();
    var authoring =
        new AuthoringV2Request(
            2,
            null,
            List.of(
                new AuthoringStep(UUID.fromString(ONE), texts.get(0), null),
                new AuthoringStep(UUID.fromString(TWO), texts.get(1), null),
                new AuthoringStep(UUID.fromString(THREE), texts.get(2), null)));
    String variables =
        password
            ? "[{\"name\":\"USER\",\"kind\":\"plain\",\"value\":\"p3-user\"},{\"name\":\"PASS\",\"kind\":\"secretRef\"}]"
            : "[]";
    jdbc.update(
        "INSERT INTO ui_tests(id,name,csi_id,environment,browser,steps,variables,authoring,authoring_revision_inputs,created_by,created_at,updated_at)"
            + " VALUES (?,'P3 controlled join',?,?,'chromium',?::jsonb,?::jsonb,?::jsonb,?::jsonb,'fixture@example.invalid',now(),now())",
        test,
        csi,
        environment,
        JSON.writeValueAsString(texts),
        variables,
        JSON.writeValueAsString(authoring),
        JSON.writeValueAsString(AuthoringRevisionIdentity.create(authoring, Map.of())));
    return test;
  }

  private static boolean p3Entitled(String principal, String csi, String environment, String name) {
    P4RevocationState current = p4Revocation;
    if (current != null
        && current.revoked.get()
        && List.of("user-1", "fixture@example.invalid").contains(principal)
        && csi.equals("CSI-456")
        && environment.equals("fixture-other")
        && name.equals("PASS")) {
      return false;
    }
    return P3_PERMITTED.contains(new P3Entitlement(principal, csi, environment, name));
  }

  private static void p3Grant(String csi, String environment) {
    for (String actor : List.of("user-1", "fixture@example.invalid")) {
      P3_PERMITTED.add(new P3Entitlement(actor, csi, environment, "PASS"));
    }
  }

  private static String p3CoreCookie(String principal, String email) {
    String cookie = "p3-core-" + UUID.randomUUID();
    P3_CORE.put(
        "put_session=" + cookie,
        new P3CoreIdentity(principal, email, List.of("CSI-123", "CSI-456")));
    return cookie;
  }

  private static void p3Seed(VaultScope scope, String value) {
    VAULT.rotate(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS", value);
    VAULT.bindOrigins(StudioVaultProvider.ReferenceKind.SECRET, scope, "PASS", ORIGIN);
    if (p3Mode == P3Mode.LOGIN) {
      p3ReportsProtected = true;
    }
  }

  private ObjectNode p3StartCommand(UUID test, String environment) throws Exception {
    var command =
        C.object()
            .put("schemaVersion", 3)
            .put("testId", test.toString())
            .put("sourceRevision", "1")
            .put("configurationRevision", "1")
            .put("environmentId", environment)
            .put("applicationId", "orders");
    command.set("versions", versions());
    return command;
  }

  private String p3Start(UUID test, String environment) throws Exception {
    return p3Call(
            p3Cookie, "/api/v3/studio/guided-sessions", p3StartCommand(test, environment), 202)
        .path("session")
        .path("sessionId")
        .asText();
  }

  private JsonNode p3Call(String cookie, String path, JsonNode body, int status) throws Exception {
    var request =
        HttpRequest.newBuilder(URI.create("https://localhost:" + port + path))
            .timeout(Duration.ofSeconds(15))
            .header("Cookie", "put_session=" + cookie);
    if (body == null) {
      request.GET();
    } else {
      request
          .header("Content-Type", "application/json")
          .header("Idempotency-Key", UUID.randomUUID().toString())
          .POST(HttpRequest.BodyPublishers.ofString(body.toString()));
    }
    var response =
        HttpClient.newBuilder()
            .sslContext(TLS)
            .build()
            .send(request.build(), HttpResponse.BodyHandlers.ofString());
    JsonNode parsed = null;
    if (response.statusCode() == 202) {
      parsed = C.parse(response.body());
      if (path.equals("/api/v3/studio/guided-sessions")) {
        String id = parsed.path("session").path("sessionId").asText();
        UUID.fromString(id);
        p3OwnedGuidedCookies.put(id, cookie);
        if (cookie.equals(p3Cookie)) {
          testOwnedSessions.put(id, parsed.path("session").path("testId").asText());
        }
      } else if (path.startsWith("/api/v1/studio/tests/") && path.endsWith("/execute")) {
        UUID execution = UUID.fromString(parsed.path("executionId").asText());
        p3OwnedOrdinaryCookies.put(execution, cookie);
        P3_EXECUTIONS.add(execution);
      }
    }
    C5Capture capture = c5Capture;
    if (capture != null) {
      capture.recordHttp(response); // Observe the original returned response; no extra HTTP call.
    }
    // Track genuine success, including an unexpected negative-test 202, before refusing its status.
    assertThat(response.statusCode()).as("actual P3 public route status").isEqualTo(status);
    return parsed == null ? C.parse(response.body()) : parsed;
  }

  private P3Publication p3Publish(String id) throws Exception {
    int models = MODEL_WIRE.size(), reads = COUNTED_VAULT.reads.size();
    JsonNode published =
        p3Call(
            p3Cookie,
            "/api/v3/studio/guided-sessions/" + id + "/finalize",
            C.object()
                .put("schemaVersion", 3)
                .put("expectedSourceRevision", "1")
                .put("expectedConfigurationRevision", "1"),
            200);
    UUID revision = UUID.fromString(published.path("revisionId").asText());
    String artifact =
        jdbc.queryForObject(
            "SELECT artifact::text FROM ui_test_revisions WHERE id=?", String.class, revision);
    String hash =
        jdbc.queryForObject(
            "SELECT artifact_hash FROM ui_test_revisions WHERE id=?", String.class, revision);
    assertThat(independentArtifactHash(C.parse(artifact))).isEqualTo(hash);
    assertThat(MODEL_WIRE.size()).isEqualTo(models);
    assertThat(COUNTED_VAULT.reads.size()).isEqualTo(reads);
    p3AwaitTeardown(id);
    return new P3Publication(revision, hash, artifact);
  }

  private UUID p3Execute(UUID test) throws Exception {
    UUID execution =
        UUID.fromString(
            p3Call(p3Cookie, "/api/v1/studio/tests/" + test + "/execute", C.object(), 202)
                .path("executionId")
                .asText());
    P3_EXECUTIONS.add(execution);
    return execution;
  }

  private void p3AssertBinding(UUID execution, VaultScope scope, P3Publication publication)
      throws Exception {
    JsonNode binding = observedBinding(execution);
    assertThat(binding.path("artifactHash").asText()).isEqualTo(publication.artifactHash());
    assertThat(binding.path("revisionId").asText()).isEqualTo(publication.revision().toString());
    assertThat(binding.path("csiId").asText()).isEqualTo(scope.csiId());
    assertThat(binding.path("environment").asText()).isEqualTo(scope.environment());
    assertThat(binding.path("testId").asText()).isEqualTo(scope.testId());
    assertThat(
            jdbc.queryForObject(
                "SELECT artifact::text FROM ui_test_revisions WHERE id=?",
                String.class,
                publication.revision()))
        .isEqualTo(publication.artifact());
  }

  private JsonNode p3AwaitExecution(UUID execution, String expected) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(60).toNanos();
    String actual = "";
    do {
      actual =
          jdbc.queryForObject(
              "SELECT status FROM ui_test_executions WHERE id=?", String.class, execution);
      if (List.of("PASSED", "FAILED", "ERROR").contains(actual)) {
        break;
      }
      Thread.sleep(30);
    } while (System.nanoTime() < deadline);
    assertThat(actual).as("actual P3 ordinary terminal status").isEqualTo(expected);
    return p3Call(p3Cookie, "/api/v1/studio/executions/" + execution, null, 200);
  }

  private JsonNode p3RunnerReport(UUID execution) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(5).toNanos();
    JsonNode report = P3_FINAL_REPORTS.get(execution);
    while (report == null && System.nanoTime() < deadline) {
      Thread.sleep(20);
      report = P3_FINAL_REPORTS.get(execution);
    }
    assertThat(report != null)
        .as("actual authenticated P3 FINAL was observed by the forwarding filter")
        .isTrue();
    assertThat(report.path("executionId").asText().equals(execution.toString())).isTrue();
    var ledger =
        jdbc.queryForMap(
            "SELECT attempt_id,admission_id,runner_instance_id,last_runner_sequence"
                + " FROM studio_dispatch_ledger WHERE execution_id=?",
            execution);
    assertThat(report.path("attemptId").asText().equals(String.valueOf(ledger.get("attempt_id"))))
        .isTrue();
    assertThat(
            report.path("admissionId").asText().equals(String.valueOf(ledger.get("admission_id"))))
        .isTrue();
    assertThat(
            report
                .path("runnerInstanceId")
                .asText()
                .equals(String.valueOf(ledger.get("runner_instance_id"))))
        .isTrue();
    assertThat(report.path("runnerSequence").asLong())
        .isEqualTo(((Number) ledger.get("last_runner_sequence")).longValue());
    p3WriteCaptureDiagnostics(execution);
    return report;
  }

  private void p3AssertUsed(String session, UUID execution) {
    if (session != null) {
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE session_id=?"
                      + " AND row_kind='USAGE' AND usage_outcome='USED' AND secret_id='PASS'",
                  Long.class,
                  session))
          .isEqualTo(1);
    } else {
      assertThat(
              jdbc.queryForObject(
                  "SELECT count(*) FROM studio_secret_use_audit WHERE execution_id=?"
                      + " AND row_kind='USAGE' AND usage_outcome='USED' AND secret_id='PASS'",
                  Long.class,
                  execution))
          .isEqualTo(1);
    }
  }

  private void p3AssertAuditScope(String session, UUID execution, VaultScope scope)
      throws Exception {
    List<Map<String, Object>> rows;
    String principal;
    if (session != null) {
      principal =
          sessions.transaction(
              () -> sessions.lock(session).document().path("scope").path("principalId").asText());
      rows =
          jdbc.queryForList(
              "SELECT principal_id,csi_id,environment,test_id,secret_id FROM studio_secret_use_audit WHERE session_id=?",
              session);
    } else {
      principal = observedBinding(execution).path("principalId").asText();
      rows =
          jdbc.queryForList(
              "SELECT principal_id,csi_id,environment,test_id,secret_id FROM studio_secret_use_audit WHERE execution_id=?",
              execution);
    }
    assertThat(rows.size()).isGreaterThanOrEqualTo(2);
    for (var row : rows) {
      assertThat(String.valueOf(row.get("principal_id")).equals(principal)).isTrue();
      assertThat(String.valueOf(row.get("csi_id")).equals(scope.csiId())).isTrue();
      assertThat(String.valueOf(row.get("environment")).equals(scope.environment())).isTrue();
      assertThat(String.valueOf(row.get("test_id")).equals(scope.testId())).isTrue();
      assertThat(String.valueOf(row.get("secret_id")).equals("PASS")).isTrue();
    }
    assertThat(COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.VARIABLE, scope, "USER"))
        .isZero();
  }

  private void p3AwaitTeardown(String id) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(20).toNanos();
    do {
      if (sessions
          .transaction(() -> sessions.lock(id).progress().path("teardownStatus").asText())
          .equals("CONFIRMED")) {
        return;
      }
      Thread.sleep(30);
    } while (System.nanoTime() < deadline);
    throw new AssertionError("Actual P3 owner teardown acknowledgement missing");
  }

  private long p3DecodeVideo(UUID execution, JsonNode current) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(45).toNanos();
    JsonNode report = current;
    while (!report.path("streamComplete").asBoolean() && System.nanoTime() < deadline) {
      Thread.sleep(30);
      report = p3Call(p3Cookie, "/api/v1/studio/executions/" + execution, null, 200);
    }
    assertThat(report.path("streamComplete").asBoolean()).isTrue();
    assertThat(report.path("video").path("status").asText()).isEqualTo("AVAILABLE");
    String key =
        jdbc.queryForObject(
            "SELECT video_key FROM ui_test_executions WHERE id=?", String.class, execution);
    Path video = TEMP.resolve("objects").resolve(key).normalize();
    assertThat(video.startsWith(TEMP.resolve("objects"))).isTrue();
    assertThat(Files.isRegularFile(video, java.nio.file.LinkOption.NOFOLLOW_LINKS)).isTrue();
    assertThat(Files.isSymbolicLink(video)).isFalse();
    JsonNode decoded = decodeJoinedVideo(video, execution);
    assertThat(decoded.path("decodedFrames").asLong()).isPositive();
    return decoded.path("decodedFrames").asLong();
  }

  private void p3Scan(List<String> values) throws Exception {
    var sinks = new java.util.LinkedHashMap<String, byte[]>();
    collectJoinedSinks(sinks);
    sinks.put(
        "p3-actual-final-callbacks",
        P3_FINAL_REPORTS.values().stream()
            .map(JsonNode::toString)
            .collect(java.util.stream.Collectors.joining("\n"))
            .getBytes(StandardCharsets.UTF_8));
    for (String value : values) {
      assertJoinedSinkAbsent(sinks, value);
      assertThat(
              COUNTED_VAULT.reads.stream()
                  .filter(read -> read.value != null)
                  .allMatch(read -> allErased(read.value)))
          .isTrue();
    }
  }

  private static JsonNode p3LaunchCounter() throws Exception {
    return C.parse(Files.readString(TEMP.resolve("p3-guided-launch-count.json")));
  }

  private static void p3WriteEvidence(String name, ObjectNode evidence) throws Exception {
    requireNumericBudgetEvidence(evidence);
    Files.writeString(TEMP.resolve("p3-" + name + ".json"), evidence.toPrettyString());
  }

  private static String p4RevocationScalarSupport(int producer) throws Exception {
    return """
        import * as revFs from 'node:fs';
        const revStateFile=%s,revFailedFile=%s,revOrigin=%s,revProducer=%d,revLedgerRoot=%s;
        let revCase=0,revSeq=0,revTail=Promise.resolve(),revStarted=false,revNativeOrdinal=0;
        let revPending=0,revOriginalPending=0,revAcked=0,revFailed=false,revSealing=false,revSealed=false;
        let revLocalMode=null,revWatching=false;
        const revActive=new Map(),revGroups=new Set();
        const revMode=()=>{try{return revFs.existsSync(revStateFile)?JSON.parse(revFs.readFileSync(revStateFile,'utf8')):null;}catch{return null;}};
        const revMarker=()=>{try{const fd=revFs.openSync(revFailedFile,
          revFs.constants.O_WRONLY|revFs.constants.O_CREAT|revFs.constants.O_APPEND|revFs.constants.O_NOFOLLOW,0o600);
          try{revFs.writeSync(fd,'1\\n');}finally{revFs.closeSync(fd);}}catch{}};
        const revCheckRoot=()=>{
          const root=revFs.lstatSync(revLedgerRoot);
          if(root.isSymbolicLink()||!root.isDirectory()||revFs.realpathSync(revLedgerRoot)!==revLedgerRoot
            ||(root.mode&0o777)!==0o700||root.uid!==process.getuid())throw new Error('ROOT');
        };
        const revPublish=(mode,sealed)=>{
          try{
            revCheckRoot();
            const target=revLedgerRoot+'/'+mode.case+'-'+revProducer+'.json',tmp=target+'.tmp';
            if(revFs.existsSync(target)){const old=revFs.lstatSync(target);
              if(old.isSymbolicLink()||!old.isFile()||(old.mode&0o777)!==0o600)throw new Error('FILE');}
            const body=JSON.stringify({case:mode.case,producer:revProducer,epoch:mode.epoch,role:revProducer,
              sent:revSeq,acked:revAcked,pending:revPending+revOriginalPending,originalPending:revOriginalPending,
              failed:revFailed,sealed});
            if(Buffer.byteLength(body)>1024)throw new Error('BOUND');
            revCheckRoot();
            const fd=revFs.openSync(tmp,revFs.constants.O_WRONLY|revFs.constants.O_CREAT|revFs.constants.O_EXCL|
              revFs.constants.O_NOFOLLOW,0o600);
            try{revFs.writeFileSync(fd,body);revFs.fsyncSync(fd);}finally{revFs.closeSync(fd);}
            revCheckRoot();
            revFs.renameSync(tmp,target);
          }catch{revFailed=true;revMarker();}
        };
        const revFail=()=>{revFailed=true;revMarker();if(revLocalMode)revPublish(revLocalMode,revSealed);};
        const revMaybeSeal=()=>{
          if(revSealing&&revPending===0&&revOriginalPending===0){revSealed=true;revPublish(revLocalMode,true);}
        };
        const revInit=mode=>{
          if(revCase===mode.case)return;
          if(revLocalMode&&!revSealed){revFail();return;}
          revCase=mode.case;revSeq=0;revPending=0;revAcked=0;revOriginalPending=0;
          revTail=Promise.resolve();revLocalMode=mode;revSealing=false;revSealed=false;
          if(revProducer!==3&&!revWatching){
            revCheckRoot();
            const command=revLedgerRoot+'/'+mode.case+'-'+revProducer+'-seal.json';revWatching=true;
            revFs.watchFile(command,{interval:25,persistent:false},()=>{
              try{revCheckRoot();if(!revFs.existsSync(command))return;
                const stat=revFs.lstatSync(command);
                if(stat.isSymbolicLink()||!stat.isFile()||stat.size>1024||(stat.mode&0o777)!==0o600)
                  throw new Error('COMMAND');
                revCheckRoot();
                const seal=JSON.parse(revFs.readFileSync(command,'utf8'));
                if(Object.keys(seal).sort().join(',')!=='case,epoch,producer,seal'||seal.case!==mode.case
                  ||seal.epoch!==mode.epoch||seal.producer!==revProducer||seal.seal!==true)throw new Error('EPOCH');
                revSealing=true;revFs.unwatchFile(command);revWatching=false;revMaybeSeal();
              }catch{revFail();revSealing=true;revFs.unwatchFile(command);revWatching=false;revMaybeSeal();}
            });
          }
        };
        const revEmit=(mode,event,ordinal=0,operation=0,reason=0,ok=true,deltaMicros=0)=>{
          if(!mode?.active)return;
          try{revInit(mode);}catch{revFail();return;}
          if(revSealing||revSealed){revFail();return;}
          revPending++;
          const body={case:mode.case,producer:revProducer,seq:++revSeq,event,ordinal,operation,reason,ok,deltaMicros};
          const acknowledgedAt=performance.now();
          revTail=revTail.then(async()=>{
            const response=await fetch(revOrigin+'/p3/revocation-observer',{method:'POST',
              headers:{'content-type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(1000)});
            const ack=await response.json();
            if(response.status!==200||Object.keys(ack).sort().join(',')!=='accepted,flipped,seq'
              ||ack.accepted!==true||ack.seq!==body.seq||typeof ack.flipped!=='boolean')throw new Error('OBSERVER');
            revAcked++;
            if(event===4&&ack.flipped)revEmit(mode,8,0,0,0,true,Math.ceil((performance.now()-acknowledgedAt)*1000));
          }).catch(()=>{revFail();}).finally(()=>{
            revPending--;revPublish(mode,revSealed);revMaybeSeal();
          });
        };
        const revRestore=()=>{
          let restored=true;
          for(const group of [...revGroups]){
            for(const [name,descriptor,wrapped] of [...group.methods]){
              const current=Object.getOwnPropertyDescriptor(group.cap,name);
              let success=false;
              try{if(current?.value===wrapped)success=descriptor?
                Reflect.defineProperty(group.cap,name,descriptor):Reflect.deleteProperty(group.cap,name);}catch{}
              if(success)group.methods=group.methods.filter(item=>item[0]!==name);else{restored=false;revFail();}
            }
            if(!group.methods.length){group.cap=null;revGroups.delete(group);}
          }
          return restored;
        };
        const revObserveNative=(cap,mode)=>{
          if(!mode?.active)return;
          if(!cap||revGroups.size||typeof cap.fillPassword!=='function'||typeof cap.invoke!=='function'){revFail();return;}
          const group={cap,methods:[]};revGroups.add(group);
          for(const name of ['fillPassword','invoke']){
            const descriptor=Object.getOwnPropertyDescriptor(cap,name),original=cap[name];
            const wrapped=function(...args){
              const operation=name==='fillPassword'?1:args[0]?.operation?.kind==='click'?2:3;
              const ordinal=++revNativeOrdinal;revActive.set(ordinal,operation);revEmit(mode,2,ordinal,operation);
              const settled=ok=>{revActive.delete(ordinal);revEmit(mode,3,ordinal,operation,0,ok);};
              let result;try{result=Reflect.apply(original,this,args);}catch(error){settled(false);throw error;}
              try{result.then(()=>settled(true),()=>settled(false)).catch(()=>{revFail();});}catch{revFail();}
              return result;
            };
            try{if(!Reflect.defineProperty(cap,name,{...(descriptor??{configurable:true,writable:true,enumerable:true}),value:wrapped}))throw new Error('DESCRIPTOR');
              group.methods.push([name,descriptor,wrapped]);}catch{revFail();}
          }
        };
        """
        .formatted(
            JSON.writeValueAsString(TEMP.resolve("p4-revocation-state.json").toString()),
            JSON.writeValueAsString(TEMP.resolve("p4-revocation-observer-failed").toString()),
            JSON.writeValueAsString(ORIGIN),
            producer,
            JSON.writeValueAsString(
                TEMP.toRealPath().resolve("p4-revocation-producers").toString()));
  }

  private static String p4GuidedRevocationObservers() throws Exception {
    String root = Path.of("../studio-runner/dist").toAbsolutePath().normalize().toUri().toString();
    return p4RevocationScalarSupport(1)
        + """
        import {GuidedRuntime as RevRuntime} from %s;
        import {GuidedOwnership as RevOwnership} from %s;
        const revOwners=new WeakMap(),revRuntimes=new WeakMap();
        const c5GrantFile=%s;let c5GrantOrdinal=0;
        const c5GrantFail=()=>{void revFs.promises.open(c5GrantFile+'-failed',revFs.constants.O_WRONLY|
          revFs.constants.O_CREAT|revFs.constants.O_APPEND|revFs.constants.O_NOFOLLOW,0o600).then(async fd=>{
            try{await fd.writeFile('1');}finally{await fd.close();}}).catch(()=>undefined);};
        const c5GrantRecord=(args,success,error,elapsedMs)=>{
          try{
            const entry=args[0],grant=args[1],now=Date.now();
            const previous=Date.parse(entry?.grant?.owner?.leaseExpiresAt),next=Date.parse(grant?.owner?.leaseExpiresAt),
              expiry=Date.parse(entry?.assignment?.expiresAt);
            const valid=number=>Number.isFinite(number),delta=(left,right)=>valid(left)&&valid(right)?Math.trunc(left-right):0;
            const code=success?0:['LEASE_LOST','CONTEXT_LOST','IDENTITY_MISMATCH','INVALID_CONTRACT','POLICY_DENIED',
              'BUDGET_EXCEEDED','REVISION_CONFLICT','REVOKED','CLAIM_DENIED','CALLBACK_DENIED','BUSY'].indexOf(error?.message)+1;
            const sample={ordinal:++c5GrantOrdinal,initial:args[2]===true,success,code,
              previousValid:valid(previous),nextValid:valid(next),expiryValid:valid(expiry),
              previousRemainingMs:delta(previous,now),nextRemainingMs:delta(next,now),
              assignmentRemainingMs:delta(expiry,now),leaseAdvanceMs:delta(next,previous),
              validationMicros:valid(elapsedMs)?Math.ceil(elapsedMs*1000):0};
            void (async()=>{const fd=await revFs.promises.open(c5GrantFile,revFs.constants.O_WRONLY|
              revFs.constants.O_CREAT|revFs.constants.O_APPEND|revFs.constants.O_NOFOLLOW,0o600);
              try{await fd.writeFile(JSON.stringify(sample)+'\\n');}finally{await fd.close();}})().catch(c5GrantFail);
          }catch{c5GrantFail();}
        };
        const revStart=RevRuntime.prototype.start;
        RevRuntime.prototype.start=function(...args){const result=Reflect.apply(revStart,this,args),mode=revMode();
          if(mode?.active&&mode.path===1){const runtime=this;
            result.then(()=>{try{if(!runtime.accepting||revStarted)throw new Error('OWNER');
              revStarted=true;revRuntimes.set(runtime,mode);revObserveNative(runtime.browser?.observations,mode);
              revEmit(mode,1,1);}catch{revFail();}},()=>{revFail();}).catch(()=>{revFail();});}
          return result;};
        const revCheck=RevOwnership.prototype.checkGrant;
        RevOwnership.prototype.checkGrant=function(...args){
          const selected=revFs.existsSync(c5ValuesFile),started=selected?performance.now():0;
          let result;try{result=Reflect.apply(revCheck,this,args);}catch(error){
            if(selected)c5GrantRecord(args,false,error,performance.now()-started);throw error;}
          if(selected)c5GrantRecord(args,true,null,performance.now()-started);
          const mode=revMode();
          if(mode?.active&&mode.path===1){try{const entry=args[0];
            if(entry.stopped!==false)throw new Error('OWNER');
            if(args[2]===true)revOwners.set(entry,mode.case);
            else if(revStarted&&revOwners.get(entry)===mode.case)revEmit(mode,4,1);
          }catch{revFail();}}return result;};
        const revInvalidate=RevOwnership.prototype.invalidate;
        RevOwnership.prototype.invalidate=function(...args){const result=Reflect.apply(revInvalidate,this,args),mode=revMode();
          if(mode?.active&&mode.path===1&&revOwners.get(args[0])===mode.case){
            if(args[0].stopped===true)revEmit(mode,5,1);else revFail();}return result;};
        const revStop=RevRuntime.prototype.stop;
        RevRuntime.prototype.stop=function(...args){const mode=revRuntimes.get(this);
          if(mode){const restored=revRestore();revEmit(mode,6,1,0,0,restored);}
          const result=Reflect.apply(revStop,this,args);
          if(mode){const reason=['REVOKED','LEASE_LOST','EXPIRED','CANCELLED','CONTEXT_LOST'].indexOf(args[0])+1;
            if(this.accepting===false&&reason>0)revEmit(mode,5,1,0,reason);else revFail();
            result.then(()=>revEmit(mode,9,1),()=>{revFail();}).catch(()=>{revFail();});revRuntimes.delete(this);}
          return result;};
        """
            .formatted(
                JSON.writeValueAsString(root + "guided/runtime.js"),
                JSON.writeValueAsString(root + "guided/ownership.js"),
                JSON.writeValueAsString(
                    TEMP.resolve("c5-grant-validation-diagnostic.jsonl").toString()));
  }

  private static String p4OrdinaryRevocationHttp() throws Exception {
    String root = Path.of("../studio-runner/dist").toAbsolutePath().normalize().toUri().toString();
    return p4RevocationScalarSupport(2)
        + """
        import {createFetchHttpClient as revRealClient} from %s;
        import {validSecretControl as revValidControl,ackRequestsCancel as revRequestsCancel} from %s;
        const revHttp=revRealClient(),revSend=revHttp.send;
        revHttp.send=function(...args){const mode=revMode();
          const selected=mode?.active&&mode.path===2&&args[0]?.method==='GET'
            &&args[0]?.url===mode.controlUrl;
          if(selected){try{revInit(mode);}catch{revFail();}revOriginalPending++;}
          let result;try{result=Reflect.apply(revSend,this,args);}catch(error){
            if(selected){revOriginalPending--;revFail();revPublish(mode,revSealed);revMaybeSeal();}throw error;}
          if(selected){result.then(outcome=>{try{
            if(outcome.kind==='response'&&outcome.status===200&&revValidControl(outcome.body,mode.executionId)){
              if(!revRequestsCancel(outcome.body))revEmit(mode,4,1);
            }
          }catch{revFail();}finally{revOriginalPending--;revPublish(mode,revSealed);revMaybeSeal();}},
            ()=>{revOriginalPending--;revFail();revPublish(mode,revSealed);revMaybeSeal();})
            .catch(()=>{revFail();});}
          return result;};
        """
            .formatted(
                JSON.writeValueAsString(root + "reporting/httpClient.js"),
                JSON.writeValueAsString(root + "reporting/reportClient.js"));
  }

  private static String p4OrdinaryRevocationChild() throws Exception {
    String root = Path.of("../studio-runner/dist").toAbsolutePath().normalize().toUri().toString();
    return p4RevocationScalarSupport(3)
        + """
        import {validateObserved as revValidateObserved} from %s;
        let revReady=false;
        const revProcess={
          on(event,listener){return Reflect.apply(process.on,process,[event,function(...args){
            const result=Reflect.apply(listener,this,args),mode=revMode();
            if(mode?.active&&mode.path===2&&args[0]?.kind==='stop'){
              try{revValidateObserved('replay-ipc#/definitions/Stop',args[0],128);
                if(!revReady||!revStarted)throw new Error('READY');
                revEmit(mode,6,1,0,0,revRestore());revEmit(mode,5,1,0,4);
              }catch{revFail();}}return result;}]);},
          send(...args){const result=Reflect.apply(process.send,process,args),mode=revMode();
            if(mode?.active&&mode.path===2&&args[0]?.kind==='ready'){
              try{const ready=revValidateObserved('replay-ipc#/definitions/Ready3',args[0],16384);
                if(result!==true||ready.runId!==mode.executionId)throw new Error('BINDING');
                revReady=true;revStarted=true;revEmit(mode,1,1);
              }catch{revFail();}}return result;},
          exit(...args){const mode=revMode();try{
            if(mode?.active&&mode.path===2){revInit(mode);revSealing=true;revSealed=true;revPublish(mode,true);}
          }catch{revFail();}finally{return Reflect.apply(process.exit,process,args);}}
        };
        """
            .formatted(JSON.writeValueAsString(root + "validator/observedReferencePolicy.js"));
  }

  private static String p4NativeCloseObserverSdk() throws Exception {
    String playwright =
        Path.of("../studio-runner/node_modules/playwright/index.mjs")
            .toAbsolutePath()
            .normalize()
            .toUri()
            .toString();
    return """
        import {chromium as p4Chromium} from %s;import * as p4Fs from 'node:fs';
        const p4ModeFile=%s,p4FailedFile=%s,p4SettledFile=%s,p4Origin=%s;
        const c5ValuesFile=%s,c5CountsFile=%s;
        const c5Variants=value=>{
          const utf8=Buffer.from(value,'utf8'),le=Buffer.from(value,'utf16le'),be=Buffer.from(le);be.swap16();
          const percent=[...utf8].map(byte=>String.fromCharCode(37)+byte.toString(16).padStart(2,'0').toUpperCase()).join('');
          const unicode=[...Array(value.length)].map((_,index)=>String.fromCharCode(92)+'u'+value.charCodeAt(index).toString(16).padStart(4,'0')).join('');
          const json=JSON.stringify(value),form=new URLSearchParams({v:value}).toString().slice(2);
          return [utf8,le,be,...[utf8.toString('base64'),utf8.toString('hex'),utf8.toString('hex').toUpperCase(),
            percent,percent.toLowerCase(),encodeURIComponent(value),form,form.replaceAll('+',String.fromCharCode(37)+'20'),
            unicode,unicode.toUpperCase().replaceAll('U','u'),json,json.slice(1,-1)].map(text=>Buffer.from(text,'utf8'))];
        };
        const c5ProfileScan=directory=>{
          let files=0,bytes=0,hits=0,links=0,failed=false,stage=0,errno=0;
          let linkName=0,linkRoot=false,linkType=0,linkBytes=0,linkTargetRead=false,linkTargetIsVersion=false;
          try{
            const root=p4Fs.realpathSync(directory),stat=p4Fs.lstatSync(directory);
            const canonical=p4Fs.lstatSync(root);
            if(stat.isSymbolicLink()||!stat.isDirectory()||stat.dev!==canonical.dev||stat.ino!==canonical.ino
              ||stat.uid!==process.getuid())throw new Error('ROOT');
            const valuesStat=p4Fs.lstatSync(c5ValuesFile);
            if(valuesStat.isSymbolicLink()||!valuesStat.isFile()||(valuesStat.mode&0o777)!==0o600||valuesStat.size>32768)throw new Error('VALUES');
            const values=JSON.parse(p4Fs.readFileSync(c5ValuesFile,'utf8'));
            if(!Array.isArray(values)||values.length<1||values.length>16||values.some(value=>typeof value!=='string'||value.length>4096))throw new Error('VALUES');
            const variants=values.flatMap(c5Variants),walk=path=>{
              for(const entry of p4Fs.readdirSync(path,{withFileTypes:true})){
                const child=path+'/'+entry.name,info=p4Fs.lstatSync(child);
                if(info.isSymbolicLink()){
                  if(path!==root||!['SingletonLock','SingletonCookie','SingletonSocket','RunningChromeVersion'].includes(entry.name)
                    ||info.size>1024){
                    linkName=['SingletonLock','SingletonCookie','SingletonSocket','RunningChromeVersion'].indexOf(entry.name)+1;
                    linkRoot=path===root;linkType=1;linkBytes=Number.isFinite(info.size)?info.size:0;
                    if(linkRoot&&linkName===4&&info.size<=1024){try{const target=p4Fs.readlinkSync(child);
                      linkTargetRead=true;
                      linkTargetIsVersion=target.length<=128&&/^[0-9]{1,4}(?:\\.[0-9]{1,6}){3}$/.test(target);
                    }catch{/* Metadata loss cannot change the original SYMLINK rejection. */}}
                    throw new Error('SYMLINK');
                  }
                  const text=Buffer.from(entry.name+' '+p4Fs.readlinkSync(child),'utf8');
                  if(text.length>2048)throw new Error('LINKBOUND');
                  links++;bytes+=text.length;
                  for(const variant of variants)if(text.includes(variant))hits++;
                  continue;
                }
                if(info.isDirectory()){walk(child);continue;}
                if(!info.isFile()||info.size>67108864||bytes+info.size>268435456)throw new Error('BOUND');
                const actual=p4Fs.realpathSync(child);if(!actual.startsWith(root+'/'))throw new Error('PATH');
                const fd=p4Fs.openSync(child,p4Fs.constants.O_RDONLY|p4Fs.constants.O_NOFOLLOW);
                try{
                  const opened=p4Fs.fstatSync(fd);
                  if(!opened.isFile()||opened.dev!==info.dev||opened.ino!==info.ino
                    ||opened.size>67108864||bytes+opened.size>268435456)throw new Error('FD');
                  const buffer=Buffer.alloc(opened.size+1);let length=0;
                  while(length<buffer.length){const read=p4Fs.readSync(fd,buffer,length,buffer.length-length,null);
                    if(read===0)break;length+=read;}
                  const after=p4Fs.fstatSync(fd);
                  if(length>opened.size||after.size!==length||after.dev!==opened.dev||after.ino!==opened.ino)
                    throw new Error('CHANGED');
                  const body=buffer.subarray(0,length);files++;bytes+=body.length;
                  for(const variant of variants)if(body.includes(variant))hits++;
                }finally{p4Fs.closeSync(fd);}
              }
            };walk(root);
          }catch(error){
            failed=true;
            stage=['ROOT','VALUES','SYMLINK','LINKBOUND','BOUND','PATH','FD','CHANGED'].indexOf(error?.message)+1;
            errno=['EACCES','EPERM','ENOENT','ELOOP','ENOTDIR','EISDIR','EIO','EBADF','EMFILE','ENFILE'].indexOf(error?.code)+1;
            if(stage===0){const operation=['open','read','scandir','lstat','realpath','fstat','close','readlink'].indexOf(error?.syscall);
              if(operation>=0)stage=9+operation;}
          }
          try{const fd=p4Fs.openSync(c5CountsFile,p4Fs.constants.O_WRONLY|p4Fs.constants.O_CREAT|
            p4Fs.constants.O_APPEND|p4Fs.constants.O_NOFOLLOW,0o600);
            try{p4Fs.writeSync(fd,JSON.stringify({files,bytes,hits,links,failed,stage,errno,linkName,linkRoot,linkType,linkBytes,linkTargetRead,linkTargetIsVersion})+'\\n');}finally{p4Fs.closeSync(fd);}}
          catch{try{const fd=p4Fs.openSync(c5CountsFile+'-failed',p4Fs.constants.O_WRONLY|p4Fs.constants.O_CREAT|
            p4Fs.constants.O_APPEND|p4Fs.constants.O_NOFOLLOW,0o600);try{p4Fs.writeSync(fd,'1');}finally{p4Fs.closeSync(fd);}}catch{}}
        };
        const p4NativeLaunch=p4Chromium.launchPersistentContext;
        p4Chromium.launchPersistentContext=function(...args){
          const launched=Reflect.apply(p4NativeLaunch,this,args);let mode=null;
          try{if(p4Fs.existsSync(p4ModeFile))mode=JSON.parse(p4Fs.readFileSync(p4ModeFile,'utf8'));}catch{}
          const c5Active=p4Fs.existsSync(c5ValuesFile);
          if(mode?.active!==true&&!c5Active)return launched;
          const phase=mode?.phase;
          return launched.then(context=>{
            const originalClose=context.close;
            context.close=function(...closeArgs){const receiver=this;
              return (async()=>{
                const fail=()=>{try{p4Fs.appendFileSync(p4FailedFile,'1\\n',{mode:0o600});}catch{}};
                let fenceSucceeded=false;
                try{
                  if(c5Active){c5ProfileScan(args[0]);if(mode?.active!==true)return;}
                  if(!Number.isInteger(phase)||phase<1)throw new Error('PHASE');
                  const deadline=performance.now()+3000;let timer;
                  const fence=async()=>{
                    for(const page of context.pages()){
                      const location=new URL(page.url());
                      if(location.origin===p4Origin&&location.pathname.startsWith('/p3/')){
                        const state=await page.evaluate(async()=>{
                          const observer=globalThis.__p4NativeObserver;
                          return observer?await observer.seal():null;
                        });
                        if(state!==null&&(Object.keys(state).sort().join(',')!=='failed,pending,sequence'
                          ||state.failed!==false||state.pending!==0||!Number.isInteger(state.sequence)
                          ||state.sequence<1))throw new Error('FENCE');
                      }
                    }
                    const remaining=deadline-performance.now();if(remaining<=0)throw new Error('TIME');
                    const response=await fetch(p4Origin+'/p3/password-effects?kind=closed&phase='+phase,
                      {method:'POST',headers:{'content-type':'application/json'},body:'{"seq":0}',
                       signal:AbortSignal.timeout(Math.max(1,Math.floor(remaining)))});
                    const ack=await response.json();
                    if(response.status!==200||Object.keys(ack).sort().join(',')!=='accepted,seq'
                      ||ack.accepted!==true||ack.seq!==0)throw new Error('ACK');
                  };
                  try{await Promise.race([fence(),new Promise((_,reject)=>{
                    timer=setTimeout(()=>reject(new Error('TIME')),Math.max(1,deadline-performance.now()));})]);}
                  finally{clearTimeout(timer);}
                  fenceSucceeded=true;
                }catch{fail();}
                finally{
                  let result;
                  try{result=await Reflect.apply(originalClose,receiver,closeArgs);}
                  catch(originalFailure){fail();throw originalFailure;}
                  if(fenceSucceeded){try{p4Fs.appendFileSync(p4SettledFile,phase+'\\n',{mode:0o600});}
                    catch{fail();}}
                  return result;
                }
              })();
            };
            return context;
          });
        };
        """
        .formatted(
            JSON.writeValueAsString(playwright),
            JSON.writeValueAsString(TEMP.resolve("p4-native-observer.json").toString()),
            JSON.writeValueAsString(TEMP.resolve("p4-native-observer-failed").toString()),
            JSON.writeValueAsString(TEMP.resolve("p4-native-observer-settled").toString()),
            JSON.writeValueAsString(ORIGIN),
            JSON.writeValueAsString(TEMP.resolve("c5-private-values.json").toString()),
            JSON.writeValueAsString(TEMP.resolve("c5-profile-counts.jsonl").toString()));
  }

  private static String p3GuidedLaunchCounter() throws Exception {
    String playwright =
        Path.of("../studio-runner/node_modules/playwright/index.mjs")
            .toAbsolutePath()
            .normalize()
            .toUri()
            .toString();
    String main =
        Path.of("../studio-runner/dist/run/guidedMain.js")
            .toAbsolutePath()
            .normalize()
            .toUri()
            .toString();
    String file = JSON.writeValueAsString(TEMP.resolve("p3-guided-launch-count.json").toString());
    return "import {chromium} from '"
        + playwright
        + "';import fs from 'node:fs';"
        + "const original=chromium.launchPersistentContext;const registered=typeof original==='function';"
        + "fs.writeFileSync("
        + file
        + ",JSON.stringify({registered,count:0}),{mode:0o600});"
        + "if(registered){chromium.launchPersistentContext=function(...args){const state=JSON.parse(fs.readFileSync("
        + file
        + ",'utf8'));"
        + "state.count++;fs.writeFileSync("
        + file
        + ",JSON.stringify(state),{mode:0o600});return Reflect.apply(original,this,args);};}"
        + p4NativeCloseObserverSdk()
        + p4GuidedRevocationObservers()
        + "await import('"
        + main
        + "');";
  }

  private static void p3Application(com.sun.net.httpserver.HttpExchange exchange)
      throws IOException {
    P6ChildCut heldCut = null;
    try {
      if (p3Mode == null) {
        exchange.sendResponseHeaders(404, -1);
        return;
      }
      String path = exchange.getRequestURI().getPath();
      if (path.equals("/p3/revocation-observer") && p4Revocation != null) {
        p4RevocationNotice(exchange);
        return;
      }
      if (path.equals("/p3/password-effects") && p4PasswordControls >= 0) {
        p4HandleObserver(exchange);
        return;
      }
      String document;
      if (path.equals("/p3/login") && exchange.getRequestMethod().equals("POST")) {
        String raw = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
        var values = new java.util.HashMap<String, String>();
        for (String pair : raw.split("&")) {
          String[] parts = pair.split("=", 2);
          values.put(
              java.net.URLDecoder.decode(parts[0], StandardCharsets.UTF_8),
              java.net.URLDecoder.decode(
                  parts.length == 2 ? parts[1] : "", StandardCharsets.UTF_8));
        }
        String password = values.getOrDefault("password", "");
        boolean accepted = password.equals(p3ExpectedPassword);
        P3_RECEIPTS.add(new P3Receipt(password, values.getOrDefault("username", ""), accepted));
        P6ChildCut selectedCut = p6ChildCut;
        if (selectedCut != null) {
          heldCut = selectedCut;
          if (!accepted || selectedCut.signInCalls.incrementAndGet() != 1) {
            selectedCut.failed = true;
          }
          selectedCut.signInEntered.countDown();
          try {
            if (!selectedCut.releaseSignIn.await(30, java.util.concurrent.TimeUnit.SECONDS)) {
              selectedCut.failed = true;
            }
          } catch (InterruptedException interrupted) {
            selectedCut.failed = true;
            Thread.currentThread().interrupt();
          }
        }
        P4RevocationState held = p4Revocation;
        if (held != null) {
          synchronized (held) {
            held.signInEntered = accepted;
            if (!accepted) {
              held.failed = true;
            }
          }
          try {
            if (!held.releaseSignIn.await(20, java.util.concurrent.TimeUnit.SECONDS)) {
              held.failed = true;
            }
          } catch (InterruptedException interrupted) {
            Thread.currentThread().interrupt();
            held.failed = true;
          }
        }
        if (p4PasswordControls >= 0) {
          p4AwaitNativeSubmitFence(exchange.getRequestURI().getRawQuery());
        }
        if (accepted) {
          String session = UUID.randomUUID().toString();
          P3_NATIVE_SESSIONS.add(session);
          exchange
              .getResponseHeaders()
              .set(
                  "Set-Cookie", "p3_session=" + session + "; HttpOnly; SameSite=Strict; Path=/p3/");
          exchange.getResponseHeaders().set("Location", "/p3/home");
          exchange.sendResponseHeaders(302, -1);
          return;
        }
        document = p3LoginDocument();
      } else if (path.equals("/p3/registration")) {
        document = p3LoginDocument() + "<h1>Registration</h1>";
      } else if (path.equals("/p3/login")) {
        document = p3LoginDocument();
      } else {
        String cookies = exchange.getRequestHeaders().getFirst("Cookie");
        boolean signedIn =
            cookies != null
                && java.util.Arrays.stream(cookies.split(";"))
                    .map(String::trim)
                    .filter(cookie -> cookie.startsWith("p3_session="))
                    .map(cookie -> cookie.substring("p3_session=".length()))
                    .anyMatch(P3_NATIVE_SESSIONS::contains);
        if ((!path.equals("/p3/reports") || p3ReportsProtected) && !signedIn) {
          exchange.getResponseHeaders().set("Location", "/p3/login");
          exchange.sendResponseHeaders(302, -1);
          return;
        }
        if (path.equals("/p3/home")) {
          document = "<main><h1>Home</h1><a href='/p3/reports'>Reports</a></main>";
        } else if (path.equals("/p3/reports")) {
          P3_REPORT_REQUESTS.incrementAndGet();
          document = "<main><h1>Reports</h1><p>Protected report</p></main>";
        } else {
          exchange.sendResponseHeaders(404, -1);
          return;
        }
      }
      byte[] body =
          ("<!doctype html><html><body>" + document + "</body></html>")
              .getBytes(StandardCharsets.UTF_8);
      exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
      exchange.getResponseHeaders().set("Cache-Control", "no-store");
      exchange.sendResponseHeaders(200, body.length);
      exchange.getResponseBody().write(body);
    } finally {
      try {
        exchange.close();
      } finally {
        if (heldCut != null) {
          heldCut.signInExited.countDown();
        }
      }
    }
  }

  private static Map<String, String> p4Query(String query) {
    Map<String, String> parsed = new java.util.HashMap<>();
    if (query != null) {
      for (String pair : query.split("&")) {
        String[] parts = pair.split("=", 2);
        if (parts.length != 2 || parsed.putIfAbsent(parts[0], parts[1]) != null) {
          throw new IllegalArgumentException("Invalid private observer query");
        }
      }
    }
    return parsed;
  }

  private static int p4PositiveOrdinal(String value) {
    if (value == null || !value.matches("[1-9][0-9]{0,8}")) {
      throw new IllegalArgumentException("Invalid private observer ordinal");
    }
    return Integer.parseInt(value);
  }

  private static int p4Number(JsonNode body, String name) {
    JsonNode number = body.path(name);
    if (!number.isIntegralNumber() || !number.canConvertToInt() || number.intValue() < 0) {
      throw new IllegalArgumentException("Invalid private observer count");
    }
    return number.intValue();
  }

  private static void p4HandleObserver(com.sun.net.httpserver.HttpExchange exchange)
      throws IOException {
    boolean accepted = false;
    int sequence = 0;
    P4DocumentWitness completion = null;
    try {
      if (!exchange.getRequestMethod().equals("POST")) {
        throw new IllegalArgumentException("Invalid private observer method");
      }
      Map<String, String> query = p4Query(exchange.getRequestURI().getRawQuery());
      String kind = query.get("kind");
      byte[] bytes = exchange.getRequestBody().readNBytes(1025);
      if (bytes.length > 1024) {
        throw new IllegalArgumentException("Private observer body bound");
      }
      JsonNode body = C.parse(new String(bytes, StandardCharsets.UTF_8));
      if (!body.isObject()) {
        throw new IllegalArgumentException("Invalid private observer body");
      }
      if ("closed".equals(kind)) {
        int phase = p4PositiveOrdinal(query.get("phase"));
        if (query.size() != 2 || body.size() != 1 || p4Number(body, "seq") != 0) {
          throw new IllegalArgumentException("Invalid original close fence");
        }
        List<P4DocumentWitness> documents =
            P4_DOCUMENTS.values().stream().filter(witness -> witness.phase == phase).toList();
        if (documents.isEmpty() || P4_NOTIFICATION_FAILED.get()) {
          throw new IllegalArgumentException("Missing actual page observer fence");
        }
        for (P4DocumentWitness witness : documents) {
          synchronized (witness) {
            if (!witness.fenced
                || !witness.fenceCompleted
                || witness.events.size() != witness.acknowledged.size()) {
              throw new IllegalArgumentException("Incomplete actual page observer fence");
            }
          }
        }
        P4_CLOSED_PHASES.add(phase);
      } else {
        int document = p4PositiveOrdinal(query.get("document"));
        P4DocumentWitness witness = P4_DOCUMENTS.get(document);
        if (query.size() != 2 || witness == null || P4_CLOSED_PHASES.contains(witness.phase)) {
          throw new IllegalArgumentException("Missing actual observer document");
        }
        sequence = p4Number(body, "seq");
        if (sequence < 1 || sequence > 1024) {
          throw new IllegalArgumentException("Private observer sequence bound");
        }
        synchronized (witness) {
          if (witness.fenced && !"fence-complete".equals(kind)) {
            throw new IllegalArgumentException("Notification after real observer fence");
          }
          if ("fence-complete".equals(kind)) {
            if (body.size() != 1
                || !witness.fenced
                || witness.fenceCompleted
                || sequence != witness.events.size()
                || sequence != witness.acknowledged.size()) {
              throw new IllegalArgumentException("Invalid actual final fence ACK completion");
            }
            completion = witness;
          } else if (List.of("registered", "write", "submit").contains(kind)) {
            if (body.size() != 1 || witness.events.putIfAbsent(sequence, kind) != null) {
              throw new IllegalArgumentException("Invalid original event notification");
            }
            switch (kind) {
              case "registered" -> P4_EFFECT_REGISTRATIONS.incrementAndGet();
              case "write" -> P4_PASSWORD_WRITES.incrementAndGet();
              case "submit" -> P4_NATIVE_SUBMITS.incrementAndGet();
              default -> throw new IllegalArgumentException("Invalid original event kind");
            }
          } else if ("ack".equals(kind)) {
            if (body.size() != 1
                || !witness.events.containsKey(sequence)
                || !witness.acknowledged.add(sequence)) {
              throw new IllegalArgumentException("Invalid actual event ACK");
            }
          } else if ("fence".equals(kind)) {
            if (body.size() != 5
                || p4Number(body, "pending") != 0
                || !body.path("failed").isBoolean()
                || body.path("failed").booleanValue()
                || sequence != witness.events.size()
                || sequence != witness.acknowledged.size()
                || !"registered".equals(witness.events.get(1))
                || p4Number(body, "writes")
                    != witness.events.values().stream().filter("write"::equals).count()
                || p4Number(body, "submits")
                    != witness.events.values().stream().filter("submit"::equals).count()) {
              throw new IllegalArgumentException("Invalid authoritative event completion fence");
            }
            for (int ordinal = 1; ordinal <= sequence; ordinal++) {
              if (!witness.acknowledged.contains(ordinal)) {
                throw new IllegalArgumentException("Missing actual ordered event ACK");
              }
            }
            witness.fenced = true;
          } else {
            throw new IllegalArgumentException("Invalid private observer phase");
          }
          witness.notifyAll();
        }
      }
      accepted = true;
    } catch (RuntimeException failure) {
      P4_NOTIFICATION_FAILED.set(true);
    } catch (IOException failure) {
      P4_NOTIFICATION_FAILED.set(true);
      throw failure;
    }
    byte[] response =
        C.object()
            .put("accepted", accepted)
            .put("seq", sequence)
            .toString()
            .getBytes(StandardCharsets.UTF_8);
    if (accepted && completion != null) {
      synchronized (completion) {
        p4WriteObserverResponse(exchange, accepted, response);
        completion.fenceCompleted = true;
        completion.notifyAll();
      }
    } else {
      p4WriteObserverResponse(exchange, accepted, response);
    }
  }

  private static void p4WriteObserverResponse(
      com.sun.net.httpserver.HttpExchange exchange, boolean accepted, byte[] response)
      throws IOException {
    try {
      exchange.getResponseHeaders().set("Content-Type", "application/json");
      exchange.sendResponseHeaders(accepted ? 200 : 409, response.length);
      exchange.getResponseBody().write(response);
      exchange.getResponseBody().close();
    } catch (IOException | RuntimeException failure) {
      P4_NOTIFICATION_FAILED.set(true);
      throw failure;
    }
  }

  private static void p4AwaitNativeSubmitFence(String query) {
    try {
      List<P4DocumentWitness> documents =
          P4_DOCUMENTS.values().stream()
              .filter(witness -> witness.phase == P4_PHASE_ORDINAL.get())
              .toList();
      if (query != null || documents.size() != 1) {
        throw new IllegalArgumentException("Missing unique actual native submit document");
      }
      P4DocumentWitness witness = documents.getFirst();
      long deadline = System.nanoTime() + Duration.ofMillis(2500).toNanos();
      synchronized (witness) {
        while (!witness.fenceCompleted
            && !P4_NOTIFICATION_FAILED.get()
            && System.nanoTime() < deadline) {
          long remaining = deadline - System.nanoTime();
          if (remaining <= 0) {
            break;
          }
          java.util.concurrent.TimeUnit.NANOSECONDS.timedWait(witness, remaining);
        }
        if (!witness.fenced
            || !witness.fenceCompleted
            || !witness.events.containsValue("submit")
            || witness.events.size() != witness.acknowledged.size()) {
          P4_NOTIFICATION_FAILED.set(true);
        }
      }
    } catch (RuntimeException failure) {
      P4_NOTIFICATION_FAILED.set(true);
    } catch (InterruptedException interrupted) {
      Thread.currentThread().interrupt();
      P4_NOTIFICATION_FAILED.set(true);
    }
  }

  private static String p4PageObserverScript(int document) {
    return """
        <script>(()=>{
          const s={sequence:0,pending:new Set(),failed:false,sealed:false,writes:0,submits:0};
          const request=async(kind,payload,deadline)=>{
            const remaining=deadline-performance.now();if(remaining<=0)throw new Error('FENCE');
            const response=await fetch('/p3/password-effects?document=%d&kind='+kind,
              {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload),
               signal:AbortSignal.timeout(Math.max(1,Math.floor(remaining)))});
            const ack=await response.json();
            if(response.status!==200||Object.keys(ack).sort().join(',')!=='accepted,seq'
              ||ack.accepted!==true||ack.seq!==payload.seq)throw new Error('ACK');
          };
          const notify=kind=>{
            if(s.sealed)s.failed=true;
            const seq=++s.sequence;if(kind==='write')s.writes++;if(kind==='submit')s.submits++;
            const deadline=performance.now()+1000;
            const p=(async()=>{await request(kind,{seq},deadline);await request('ack',{seq},deadline);})()
              .catch(()=>{s.failed=true;});
            s.pending.add(p);void p.finally(()=>{s.pending.delete(p);});return p;
          };
          let closing=null;
          const seal=()=>closing??=(async()=>{
            s.sealed=true;const deadline=performance.now()+2500;let timer;
            try{
              await Promise.race([Promise.all([...s.pending]),new Promise((_,reject)=>{
                timer=setTimeout(()=>reject(new Error('PENDING')),Math.max(1,deadline-performance.now()));})]);
              if(s.pending.size||s.failed)throw new Error('FAILED');
              await request('fence',{seq:s.sequence,pending:s.pending.size,failed:s.failed,
                writes:s.writes,submits:s.submits},deadline);
              // Sent only after the page received and validated the real final fence ACK.
              await request('fence-complete',{seq:s.sequence},deadline);
              return {pending:0,failed:false,sequence:s.sequence};
            }catch{ s.failed=true;throw new Error('FENCE'); }finally{clearTimeout(timer);}
          })();
          globalThis.__p4NativeObserver={seal};
          document.addEventListener('input',event=>{
            if(event.target instanceof HTMLInputElement&&event.target.type==='password')void notify('write');});
          document.addEventListener('submit',()=>{void notify('submit');void seal().catch(()=>{s.failed=true;});});
          void notify('registered');
        })();</script>
        """
        .formatted(document);
  }

  private static String p3LoginDocument() {
    if (p4PasswordControls >= 0) {
      int ordinal = P4_DOCUMENT_ORDINAL.incrementAndGet();
      P4_DOCUMENTS.put(ordinal, new P4DocumentWitness(P4_PHASE_ORDINAL.get()));
      String passwords = "<input name='password' type='password'>".repeat(p4PasswordControls);
      return "<form method='post' action='/p3/login'><label>User<input name='username'></label>"
          + passwords
          + "<button type='submit'>Sign in</button></form><button type='button'>Reports</button>"
          + p4PageObserverScript(ordinal);
    }
    return "<form method='post' action='/p3/login'><label>User<input name='username'></label>"
        + "<input name='password' type='password'><button type='submit'>Sign in</button></form>"
        + "<button type='button'>Reports</button>";
  }

  private static ObjectNode p3Model(ObjectNode result, JsonNode context, String kind) {
    if (kind.equals("SOURCE_PLAN")) {
      String destination =
          ORIGIN
              + (p3Mode == P3Mode.LOGIN
                  ? "/p3/login"
                  : p3Mode == P3Mode.REPORTS ? "/p3/reports" : "/p3/registration");
      var references = result.putArray("sourceReferences");
      references
          .addObject()
          .put("referenceKind", "sourceSpan")
          .put("sourceRevision", "1")
          .put("stepId", ONE)
          .put("startUtf16", 5)
          .put("endUtf16", 5 + destination.length())
          .put("kind", "destination")
          .put("intendedSlot", "navigate.destination");
      var obligations = result.putArray("obligations");
      obligations.add(obligation(ONE, 0, "navigate", "page", 0, null));
      if (p3Mode == P3Mode.LOGIN) {
        for (String name : List.of("USER", "PASS")) {
          JsonNode declaring = null;
          for (JsonNode configured : context.path("configurationReferences")) {
            if (configured.path("referenceName").asText().equals(name)
                && configured.path("stepId").asText().equals(TWO)
                && configured.path("intendedSlot").asText().equals("fill.value")) {
              declaring = configured;
            }
          }
          if (declaring == null) {
            throw new IllegalStateException("Authentic P3 declaration missing");
          }
          var reference =
              ((ObjectNode) declaring)
                  .deepCopy()
                  .put("referenceKind", "configuration")
                  .put("configurationRevision", "1");
          if (name.equals("USER")) {
            reference.remove("referenceName");
          }
          references.add(reference);
        }
        obligations.add(obligation(TWO, 0, "fill", "User", 1, null));
        obligations.add(obligation(TWO, 1, "fill", "password", 2, null));
        obligations.add(obligation(THREE, 0, "click", "Sign in", null, null));
        obligations.add(obligation(THREE, 1, "click", "Reports", null, null));
        obligations.add(
            obligation(THREE, 2, "assert", "Reports", null, null).put("predicate", "visible"));
      } else {
        String target = p3Mode == P3Mode.REGISTRATION ? "Registration" : "Reports";
        obligations.add(
            obligation(TWO, 0, "assert", target, null, null).put("predicate", "visible"));
        obligations.add(
            obligation(THREE, 0, "assert", target, null, null).put("predicate", "visible"));
      }
      result.putArray("needs");
      return result;
    }
    JsonNode obligation = context.path("obligations").get(0);
    if (p4AdversarialPasswordSelection
        && kind.equals("NEXT_ACTION")
        && obligation.path("stepId").asText().equals(TWO)) {
      if (!obligation.path("stepId").asText().equals(TWO)
          || obligation.path("occurrence").asInt(-1) != 0
          || !obligation.path("targetIntent").asText().equals("User")) {
        throw new IllegalStateException("Actual USER-stage inference was not reached");
      }
      JsonNode password = null;
      for (JsonNode remaining : context.path("obligations")) {
        if (remaining.path("stepId").asText().equals(TWO)
            && remaining.path("occurrence").asInt(-1) == 1
            && remaining.path("operationKind").asText().equals("fill")
            && remaining.path("targetIntent").asText().equals("password")) {
          if (password != null) {
            throw new IllegalStateException("Actual password obligation is not unique");
          }
          password = remaining;
        }
      }
      if (password == null) {
        throw new IllegalStateException("Actual accepted password obligation is missing");
      }
      JsonNode input = context.path("inputs").get(password.path("referenceIndex").asInt());
      if (input == null
          || !input.path("kind").asText().equals("secretRef")
          || !input.path("sourceStepId").asText().equals(TWO)
          || !input.path("intendedSlot").asText().equals("fill.value")) {
        throw new IllegalStateException("Actual accepted password input identity is missing");
      }
      P4_FIRST_GUIDED_REQUEST.compareAndSet(
          null,
          C.object()
              .put("actualNextAction", true)
              .put("availableUserOrdinal", obligation.path("occurrence").asInt())
              .put("selectedPasswordOrdinal", password.path("occurrence").asInt())
              .put(
                  "passwordCount",
                  context.path("observation").path("coverage").path("passwordControls").asInt(-1))
              .put("actualSameStepSecretInput", true)
              .put(
                  "actualPublicUserAvailable",
                  java.util.stream.StreamSupport.stream(
                          context.path("observation").path("nodes").spliterator(), false)
                      .anyMatch(
                          node ->
                              node.path("name").asText().equals("User")
                                  && node.path("role").asText().equals("textbox")
                                  && node.path("visible").asBoolean()
                                  && node.path("actionable").asBoolean())));
      obligation = password;
    }
    String operationKind = obligation.path("operationKind").asText();
    String targetName = obligation.path("targetIntent").asText();
    if (operationKind.equals("navigate")) {
      result
          .put("status", "ACTION")
          .put("obligationId", obligation.path("obligationId").asText())
          .putNull("question");
      result
          .putObject("action")
          .putObject("operation")
          .put("kind", "navigate")
          .put("destinationInputId", context.path("inputs").get(0).path("inputId").asText());
      result.withObject("/action").putObject("target").put("kind", "page");
      return result;
    }
    if (targetName.equals("password")) {
      result
          .put("status", "ACTION")
          .put("obligationId", obligation.path("obligationId").asText())
          .putNull("question");
      var action = result.putObject("action");
      action
          .putObject("operation")
          .put("kind", "fill")
          .putObject("value")
          .put("kind", "secretRef")
          .put(
              "sourceInputId",
              context
                  .path("inputs")
                  .get(obligation.path("referenceIndex").asInt())
                  .path("inputId")
                  .asText());
      action.putObject("target").put("kind", "passwordControl");
      return result;
    }
    String role =
        operationKind.equals("assert")
            ? "heading"
            : targetName.equals("Reports")
                ? "link"
                : operationKind.equals("fill") ? "textbox" : "button";
    JsonNode selected = null;
    for (JsonNode node : context.path("observation").path("nodes")) {
      if (node.path("name").asText().equals(targetName)
          && node.path("role").asText().equals(role)) {
        if (selected != null) {
          throw new IllegalStateException("P3 target is not unique");
        }
        selected = node;
      }
    }
    if (selected == null) {
      result.put("status", "UNSUPPORTED").put("reasonCode", "INSUFFICIENT_EVIDENCE");
      return result;
    }
    result
        .put("status", "ACTION")
        .put("obligationId", obligation.path("obligationId").asText())
        .putNull("question");
    var action = result.putObject("action");
    var operation = action.putObject("operation").put("kind", operationKind);
    action
        .putObject("target")
        .put("nodeId", selected.path("nodeId").asText())
        .putObject("locator")
        .put("kind", "role")
        .put("role", role)
        .put("name", targetName)
        .put("exact", true);
    if (operationKind.equals("fill")) {
      operation
          .putObject("value")
          .put("kind", "authoredLiteral")
          .put(
              "sourceInputId",
              context
                  .path("inputs")
                  .get(obligation.path("referenceIndex").asInt())
                  .path("inputId")
                  .asText());
    }
    if (operationKind.equals("assert")) {
      operation.put("predicate", "visible").putNull("expected");
    }
    return result;
  }

  private static final class CountedLoginVault implements StudioVaultProvider {
    final List<OwnedVaultRead> reads = new CopyOnWriteArrayList<>();
    final List<VaultScope> lists = new CopyOnWriteArrayList<>();

    @Override
    public String name() {
      return VAULT.name();
    }

    @Override
    public Optional<VaultEntry> read(ReferenceKind kind, VaultScope scope, String name) {
      VaultScope disappearing = P3_FAIL_READ.get();
      if (kind == ReferenceKind.SECRET
          && name.equals("PASS")
          && scope.equals(disappearing)
          && P3_FAIL_READ.compareAndSet(disappearing, null)) {
        // The current entry vanishes only at its real value-read boundary; another scope remains.
        VAULT.delete(kind, scope, name);
      }
      Optional<VaultEntry> result;
      VaultScope unavailableScope = P7_OUTAGE_SCOPE.get();
      if (kind == ReferenceKind.SECRET
          && name.equals("PASS")
          && scope.equals(unavailableScope)
          && P7_OUTAGE_SCOPE.compareAndSet(unavailableScope, null)) {
        VAULT.makeUnavailable();
        try {
          result = VAULT.read(kind, scope, name); // Original provider increments and throws itself.
        } finally {
          VAULT.makeAvailable(); // Preserve every counter, entry, version and returned array.
        }
      } else {
        result = VAULT.read(kind, scope, name);
      }
      reads.add(
          new OwnedVaultRead(
              com.citi.put.checks.studio.secrets.FakeStudioVaultProvider.key(kind, scope, name),
              result.map(VaultEntry::versionIdentifier).orElse(null),
              result.map(VaultEntry::value).orElse(null)));
      return result;
    }

    @Override
    public String create(VaultScope scope, String name, char[] value, List<String> origins) {
      return VAULT.create(scope, name, value, origins);
    }

    @Override
    public List<String> listSecretNames(VaultScope scope) {
      lists.add(scope);
      return VAULT.listSecretNames(scope);
    }

    int readCount(ReferenceKind kind, VaultScope scope, String name) {
      String key =
          com.citi.put.checks.studio.secrets.FakeStudioVaultProvider.key(kind, scope, name);
      return Math.toIntExact(reads.stream().filter(read -> read.key.equals(key)).count());
    }
  }

  /** No printable representation of the actual delivered array, even on assertion failure. */
  private static final class OwnedVaultRead {
    final String key;
    final String version;
    final char[] value;

    OwnedVaultRead(String key, String version, char[] value) {
      this.key = key;
      this.version = version;
      this.value = value;
    }
  }

  private static boolean allErased(char[] value) {
    for (char character : value) {
      if (character != '\0') {
        return false;
      }
    }
    return true;
  }

  private JsonNode awaitJoinedVideo(UUID execution) throws Exception {
    long deadline = System.nanoTime() + Duration.ofSeconds(45).toNanos();
    JsonNode snapshot;
    do {
      snapshot = publicCall("/api/v1/studio/executions/" + execution, null, 200, null);
      if (snapshot.path("streamComplete").asBoolean()) {
        break;
      }
      Thread.sleep(30);
    } while (System.nanoTime() < deadline);
    assertThat(snapshot.path("streamComplete").asBoolean()).isTrue();
    assertThat(snapshot.path("status").asText()).isEqualTo("PASSED");
    assertThat(snapshot.path("video").path("status").asText()).isEqualTo("AVAILABLE");
    return snapshot;
  }

  /** Independent recursive key sorting; does not call production hash/canonical helpers. */
  private static String independentArtifactHash(JsonNode artifact) throws Exception {
    return HexFormat.of()
        .formatHex(
            MessageDigest.getInstance("SHA-256")
                .digest(independentCanonical(artifact).getBytes(StandardCharsets.UTF_8)));
  }

  private static String independentCanonical(JsonNode value) throws Exception {
    if (value.isObject()) {
      var names = new java.util.ArrayList<String>();
      value.fieldNames().forEachRemaining(names::add);
      names.sort(String::compareTo);
      var fields = new java.util.ArrayList<String>();
      for (String name : names) {
        fields.add(JSON.writeValueAsString(name) + ":" + independentCanonical(value.get(name)));
      }
      return "{" + String.join(",", fields) + "}";
    }
    if (value.isArray()) {
      var items = new java.util.ArrayList<String>();
      for (JsonNode item : value) {
        items.add(independentCanonical(item));
      }
      return "[" + String.join(",", items) + "]";
    }
    return JSON.writeValueAsString(value);
  }

  private static ObjectNode joinedWorkerIdentity() throws Exception {
    var identity = C.object();
    for (String relative :
        List.of(
            "run/child.js",
            "guided/runtime.js",
            "versions.js",
            "runtime-versions.json",
            "validator/observedSchemas.json")) {
      identity.put(
          relative,
          HexFormat.of()
              .formatHex(
                  MessageDigest.getInstance("SHA-256")
                      .digest(
                          Files.readAllBytes(Path.of("../studio-runner/dist").resolve(relative)))));
    }
    return identity;
  }

  private static ObjectNode decodeJoinedVideo(Path video, UUID execution) throws Exception {
    Path decoder = null;
    for (String directory : System.getenv("PATH").split(java.io.File.pathSeparator)) {
      Path candidate = Path.of(directory).resolve("ffmpeg").toAbsolutePath().normalize();
      if (Files.isRegularFile(candidate) && Files.isExecutable(candidate)) {
        decoder = candidate.toRealPath();
        break;
      }
    }
    assertThat(decoder)
        .as("installed native decoder, also used by runner fixture gates")
        .isNotNull();
    Path output = TEMP.resolve("native-decode-" + execution + ".log");
    Process decode =
        new ProcessBuilder(
                decoder.toString(),
                "-nostdin",
                "-i",
                video.toString(),
                "-map",
                "0:v:0",
                "-f",
                "null",
                "-")
            .redirectErrorStream(true)
            .redirectOutput(output.toFile())
            .start();
    awaitJoinedProcess(decode, 30, "native application video decode");
    String report = Files.readString(output);
    var dimensions = java.util.regex.Pattern.compile("Video:.*? (\\d+)x(\\d+)").matcher(report);
    assertThat(dimensions.find()).as("decoder returned actual video dimensions").isTrue();
    int width = Integer.parseInt(dimensions.group(1));
    int height = Integer.parseInt(dimensions.group(2));
    assertThat(width).isPositive();
    assertThat(height).isPositive();
    var frames = java.util.regex.Pattern.compile("frame=\\s*(\\d+)").matcher(report);
    int count = 0;
    while (frames.find()) {
      count = Integer.parseInt(frames.group(1));
    }
    assertThat(count).as("actual native frames decoded through EOF").isPositive();
    return C.object()
        .put("executionId", execution.toString())
        .put("width", width)
        .put("height", height)
        .put("decodedFrames", count)
        .put(
            "decoderSha256",
            HexFormat.of()
                .formatHex(
                    MessageDigest.getInstance("SHA-256").digest(Files.readAllBytes(decoder))));
  }

  private static void awaitJoinedProcess(Process process, int seconds, String label)
      throws Exception {
    try {
      boolean finished = process.waitFor(seconds, java.util.concurrent.TimeUnit.SECONDS);
      assertThat(finished).as("bounded %s", label).isTrue();
      assertThat(process.exitValue()).as("%s exit", label).isZero();
    } finally {
      if (process.isAlive()) {
        process.destroyForcibly();
        process.waitFor(5, java.util.concurrent.TimeUnit.SECONDS);
      }
    }
  }

  /** Private capture of actual existing sinks; usable around the required C4 sub-runs too. */
  private static final class C5ClaimSampler implements AutoCloseable {
    private enum Segment {
      OWNER_LOCK,
      JDBC_PATH,
      CURRENT_AUTH,
      SOURCE_CHECK,
      SCHEMA,
      JSON_RENDER,
      LOG_ENCODER,
      COMMIT,
      OTHER
    }

    private enum Status {
      OFF,
      UNOBSERVED,
      OBSERVED,
      FAILED,
      NON_QUIESCENT
    }

    private static final int MAX_THREADS = 8;
    private final Object gate = new Object();
    private final java.util.Set<Thread> executing =
        java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
    private final long[][] counts = new long[Segment.values().length][Thread.State.values().length];
    private final java.util.Map<Thread, Long> entered = new java.util.IdentityHashMap<>();
    private final java.util.concurrent.atomic.AtomicBoolean pgOnce =
        new java.util.concurrent.atomic.AtomicBoolean();
    private volatile Thread pgObserver;

    private enum PgStatus {
      NOT_TRIGGERED,
      RUNNING,
      OBSERVED,
      UNOBSERVED,
      FAILED,
      AMBIGUOUS,
      TRUNCATED,
      NON_QUIESCENT
    }

    private volatile PgStatus pgStatus = PgStatus.NOT_TRIGGERED;
    private final long[][] pgStagesAndWaits = new long[7][10];
    private final long[] pgBlockerStages = new long[7],
        pgRelations = new long[3],
        pgWaitEvents = new long[8];
    private long pgRows, pgCandidates, pgBlockers;
    private volatile boolean stopping;
    private volatile Status status = Status.OFF;
    private long empty, unattributed, cycles;
    private final Thread sampler;
    private final long end;

    C5ClaimSampler(boolean selected) {
      if (!selected) {
        sampler = null;
        end = 0;
        return;
      }
      status = Status.UNOBSERVED;
      end = System.nanoTime() + java.time.Duration.ofSeconds(30).toNanos();
      sampler =
          Thread.ofPlatform().daemon().name("private-c5-claim-sampler").unstarted(this::sample);
      try {
        sampler.start();
      } catch (Throwable unavailable) {
        status = Status.FAILED;
      }
    }

    void enterCurrent() {
      if (sampler == null || stopping || System.nanoTime() >= end) return;
      try {
        synchronized (gate) {
          if (stopping) return;
          if (executing.size() >= MAX_THREADS) {
            status = Status.FAILED;
            return;
          }
          Thread current = Thread.currentThread();
          executing.add(current); // Only original selected filter's executing thread.
          entered.putIfAbsent(current, System.nanoTime());
        }
      } catch (Throwable unsupported) {
        status = Status.FAILED;
      }
    }

    void leaveCurrent() {
      try {
        synchronized (gate) {
          Thread current = Thread.currentThread();
          executing.remove(current);
          entered.remove(current);
        }
      } catch (Throwable unsupported) {
        status = Status.FAILED;
      }
    }

    private void sample() {
      try {
        while (!stopping && System.nanoTime() < end) {
          Thread[] snapshot;
          synchronized (gate) {
            snapshot = executing.toArray(Thread[]::new);
          }
          try {
            for (Thread target : snapshot) {
              if (stopping || System.nanoTime() >= end) break;
              StackTraceElement[] stack = target.getStackTrace();
              try {
                Thread.State state = target.getState(); // Observed state; not atomic with stack.
                if (stack.length == 0 || stack.length > 512) {
                  empty++;
                  continue;
                }
                Segment segment = classify(stack);
                if (segment == Segment.OTHER) unattributed++;
                counts[segment.ordinal()][state.ordinal()]++;
                if (segment == Segment.JDBC_PATH && state == Thread.State.WAITING) {
                  triggerPgOnce(target);
                }
                if (segment != Segment.OTHER
                    && status != Status.FAILED
                    && status != Status.NON_QUIESCENT) status = Status.OBSERVED;
              } finally {
                java.util.Arrays.fill(stack, null);
              }
            }
          } finally {
            java.util.Arrays.fill(snapshot, null);
          }
          cycles++;
          Thread.sleep(20); // Diagnostic cadence only; no authority poll/action changed.
        }
      } catch (InterruptedException stopped) {
        Thread.currentThread().interrupt();
      } catch (Throwable unsupported) {
        status = Status.FAILED; // No exception/message/raw stack retained or emitted.
      } finally {
        synchronized (gate) {
          executing.clear();
          entered.clear();
        }
      }
    }

    private void triggerPgOnce(Thread target) {
      synchronized (gate) {
        Long start = entered.get(target);
        if (stopping
            || start == null
            || !executing.contains(target)
            || System.nanoTime() - start < Duration.ofMillis(500).toNanos()
            || !pgOnce.compareAndSet(false, true)) {
          return;
        }
        pgStatus = PgStatus.RUNNING;
        pgObserver =
            Thread.ofPlatform().daemon().name("private-c5-pg-once").unstarted(this::snapshotPg);
        try {
          pgObserver.start();
        } catch (Throwable failed) {
          pgStatus = PgStatus.FAILED;
        }
      }
    }

    private static int pgStage(String original) {
      if (original == null || original.length() > 4096) return 6;
      String sql = original.toLowerCase(java.util.Locale.ROOT).replaceAll("\\s+", " ").trim();
      if (sql.startsWith("select state,revoked_at from studio_guided_sessions")
          && sql.contains("for update")) return 0;
      if (sql.startsWith("select document::text,progress::text from studio_guided_sessions")
          && sql.contains("for update")) return 1;
      if (sql.contains(" from ui_tests ")
          && (sql.contains("for update") || sql.contains("for no key update"))) return 2;
      if (sql.startsWith("select m.manifest::text from studio_guided_translation_state")) return 3;
      if (sql.startsWith("with updated as (update studio_guided_sessions")) return 4;
      if (sql.startsWith("update studio_guided_sessions")) return 5;
      return 6;
    }

    private static int pgWait(String type) {
      if (type == null) return 0;
      int index =
          List.of("Lock", "LWLock", "IO", "Client", "IPC", "Timeout", "Activity", "BufferPin")
              .indexOf(type);
      return index < 0 ? 9 : index + 1;
    }

    private static int pgEvent(String event) {
      if (event == null) return 0;
      int index =
          List.of("transactionid", "tuple", "relation", "ClientRead", "ClientWrite", "DataFileRead")
              .indexOf(event);
      return index < 0 ? 7 : index + 1;
    }

    private void snapshotPg() {
      var privatePids = new java.util.HashSet<Integer>();
      var candidates = new java.util.HashSet<Integer>();
      var blockers = new java.util.HashSet<Integer>();
      var settings = new java.util.Properties();
      settings.setProperty("user", DB.getUsername());
      settings.setProperty("password", DB.getPassword());
      settings.setProperty("connectTimeout", "1");
      settings.setProperty("socketTimeout", "1");
      settings.setProperty("ApplicationName", "c5-private-pg-observer");
      try (var connection = java.sql.DriverManager.getConnection(DB.getJdbcUrl(), settings)) {
        connection.setReadOnly(true);
        connection.setAutoCommit(false);
        try {
          try (var statement = connection.createStatement()) {
            statement.setQueryTimeout(1);
            statement.execute("SET LOCAL statement_timeout='250ms'");
            statement.setMaxRows(64);
            String catalog =
                "SELECT a.pid,a.query,a.wait_event_type,a.wait_event,b.pid AS blocker_pid,b.query AS blocker_query,"
                    + " EXISTS(SELECT 1 FROM pg_locks l WHERE l.pid=a.pid AND l.relation='studio_guided_sessions'::regclass) AS owner_relation,"
                    + " EXISTS(SELECT 1 FROM pg_locks l WHERE l.pid=a.pid AND l.relation='ui_tests'::regclass) AS source_relation"
                    + " FROM pg_stat_activity a LEFT JOIN LATERAL unnest(pg_blocking_pids(a.pid)) blocked(pid) ON true"
                    + " LEFT JOIN pg_stat_activity b ON b.pid=blocked.pid"
                    + " WHERE a.datname=current_database() AND a.backend_type='client backend'"
                    + " AND a.pid<>pg_backend_pid() AND a.state<>'idle'";
            try (var rows = statement.executeQuery(catalog)) {
              while (rows.next()) {
                if (++pgRows >= 64) {
                  pgStatus = PgStatus.TRUNCATED;
                  break;
                }
                String original = rows.getString("query"),
                    blockerQuery = rows.getString("blocker_query");
                if (original != null && original.length() > 4096
                    || blockerQuery != null && blockerQuery.length() > 4096) {
                  pgStatus = PgStatus.TRUNCATED;
                  break;
                }
                int pid = rows.getInt("pid"),
                    stage = pgStage(original),
                    wait = pgWait(rows.getString("wait_event_type"));
                if (privatePids.add(pid)) {
                  pgStagesAndWaits[stage][wait]++;
                  pgWaitEvents[pgEvent(rows.getString("wait_event"))]++;
                  if (stage < 6) candidates.add(pid);
                  boolean owner = rows.getBoolean("owner_relation"),
                      source = rows.getBoolean("source_relation");
                  if (owner) pgRelations[0]++;
                  if (source) pgRelations[1]++;
                  if (!owner && !source) pgRelations[2]++;
                }
                int blocker = rows.getInt("blocker_pid");
                if (!rows.wasNull() && blockers.add(blocker))
                  pgBlockerStages[pgStage(blockerQuery)]++;
              }
            }
          }
        } finally {
          connection.rollback();
        }
        pgCandidates = candidates.size();
        pgBlockers = blockers.size();
        if (pgStatus != PgStatus.TRUNCATED && pgStatus != PgStatus.NON_QUIESCENT) {
          pgStatus =
              pgCandidates > 1
                  ? PgStatus.AMBIGUOUS
                  : pgCandidates == 1 ? PgStatus.OBSERVED : PgStatus.UNOBSERVED;
        }
      } catch (Throwable failed) {
        if (pgStatus != PgStatus.NON_QUIESCENT) pgStatus = PgStatus.FAILED;
        // Never retain/log raw SQL/IDs/credentials/exception.
      } finally {
        privatePids.clear();
        candidates.clear();
        blockers.clear();
        settings.clear();
      }
    }

    private boolean pgJoined() {
      Thread observer = pgObserver;
      return observer == null || !observer.isAlive();
    }

    private static Segment classify(StackTraceElement[] stack) {
      boolean claim =
          java.util.Arrays.stream(stack)
              .anyMatch(
                  frame ->
                      frame
                              .getClassName()
                              .equals(
                                  "com.citi.put.checks.studio.guided.session.GuidedSessionService")
                          && (frame.getMethodName().equals("claim")
                              || frame.getMethodName().startsWith("lambda$claim$")));
      if (!claim) return Segment.OTHER;
      // Fixed source categories only; no arbitrary class/method/file/line/name/ID export.
      for (StackTraceElement frame : stack) {
        String type = frame.getClassName(), method = frame.getMethodName();
        if (type.startsWith("ch.qos.logback.") || type.startsWith("net.logstash.logback."))
          return Segment.LOG_ENCODER;
        if (type.startsWith("com.networknt.") || type.endsWith("GuidedContracts"))
          return Segment.SCHEMA;
        if (type.startsWith("com.fasterxml.jackson.")) return Segment.JSON_RENDER;
        if (type.startsWith("org.postgresql.") || type.startsWith("org.springframework.jdbc."))
          return Segment.JDBC_PATH;
        if (type.endsWith("GuidedSessionRepository") && method.equals("lock"))
          return Segment.OWNER_LOCK;
        if (type.endsWith("GuidedProductionSessionAccess") && method.equals("checkCurrent"))
          return Segment.CURRENT_AUTH;
        if (type.endsWith("GuidedProductionSessionAccess") && method.equals("checkSourceCurrent")
            || type.endsWith("GuidedSourceSnapshotRepository")) return Segment.SOURCE_CHECK;
        if (type.startsWith("org.springframework.transaction.") && method.equals("commit"))
          return Segment.COMMIT;
      }
      return Segment.OTHER;
    }

    @Override
    public void close() {
      stopping = true;
      synchronized (gate) {
        executing.clear();
      }
      if (sampler == null) return;
      boolean restoreInterrupt = Thread.interrupted();
      long deadline = System.nanoTime() + java.time.Duration.ofSeconds(1).toNanos();
      try {
        sampler.interrupt();
        while (sampler.isAlive()) {
          long remaining = deadline - System.nanoTime();
          if (remaining <= 0) break;
          try {
            sampler.join(java.time.Duration.ofNanos(remaining));
          } catch (InterruptedException interrupted) {
            restoreInterrupt = true;
          }
        }
        if (sampler.isAlive()) status = Status.NON_QUIESCENT;
        Thread observer = pgObserver;
        if (observer != null) {
          observer.interrupt();
          long pgDeadline = System.nanoTime() + Duration.ofSeconds(3).toNanos();
          while (observer.isAlive()) {
            long remaining = pgDeadline - System.nanoTime();
            if (remaining <= 0) break;
            try {
              observer.join(Duration.ofNanos(remaining));
            } catch (InterruptedException interrupted) {
              restoreInterrupt = true;
            }
          }
          if (observer.isAlive()) pgStatus = PgStatus.NON_QUIESCENT;
        }
      } finally {
        synchronized (gate) {
          executing.clear();
          entered.clear();
        }
        if (restoreInterrupt) Thread.currentThread().interrupt();
      }
      // Export counts ONLY if sampler joined. NON_QUIESCENT never claims all refs discarded:
      // public virtual-thread getStackTrace can retry/yield without honoring interruption.
      // Future caller uses fixed status/segment/thread-state ordinal and counts only.
    }
  }

  private final class C5Capture implements AutoCloseable {
    private static final int MAX_BYTES = 128 * 1024 * 1024;
    private final C5ClaimSampler claimSampler;
    private final List<String> values;
    private volatile String selectedGuidedSession;
    private int lifecycleOrdinal, claimOrdinal;
    private volatile boolean lifecycleDiagnosticFailed;
    private final Map<String, byte[]> produced = new java.util.LinkedHashMap<>();
    private final List<C5Stream> streams = new java.util.ArrayList<>();
    private final java.io.ByteArrayOutputStream encoded = new java.io.ByteArrayOutputStream();
    private final ch.qos.logback.classic.Logger rootLogger;
    private final ch.qos.logback.classic.Logger appLogger;
    private final ch.qos.logback.classic.Level rootLevel, appLevel;
    private final ch.qos.logback.core.OutputStreamAppender<ch.qos.logback.classic.spi.ILoggingEvent>
        appender;
    private final ch.qos.logback.core.encoder.Encoder<ch.qos.logback.classic.spi.ILoggingEvent>
        originalEncoder;
    private final java.io.OutputStream originalStream;
    private final ch.qos.logback.classic.LoggerContext loggerContext;
    private final long statusSince;
    private long rootEvents, appEvents;
    private boolean failed, c4WindowsExecuted;
    private int httpBodies,
        httpErrors,
        jsonBodies,
        problemBodies,
        cacheEntries,
        metricBytes,
        profileFiles,
        profileLinks;

    C5Capture(List<String> values) {
      this.values = values;
      var context =
          (ch.qos.logback.classic.LoggerContext) org.slf4j.LoggerFactory.getILoggerFactory();
      loggerContext = context;
      statusSince = System.currentTimeMillis();
      rootLogger = context.getLogger(org.slf4j.Logger.ROOT_LOGGER_NAME);
      appLogger = context.getLogger("com.citi.put.checks");
      rootLevel = rootLogger.getLevel();
      appLevel = appLogger.getLevel();
      var installed = rootLogger.getAppender("JSON_CONSOLE");
      assertThat(installed).isInstanceOf(ch.qos.logback.core.ConsoleAppender.class);
      var iterator = rootLogger.iteratorForAppenders();
      assertThat(iterator.next()).isSameAs(installed);
      assertThat(iterator.hasNext()).as("all original root appenders mapped").isFalse();
      for (var logger : context.getLoggerList()) {
        if (logger != rootLogger) {
          assertThat(logger.iteratorForAppenders().hasNext())
              .as("no unmapped independently attached appender")
              .isFalse();
        }
      }
      @SuppressWarnings("unchecked")
      var actual =
          (ch.qos.logback.core.OutputStreamAppender<ch.qos.logback.classic.spi.ILoggingEvent>)
              installed;
      appender = actual;
      originalEncoder = appender.getEncoder();
      assertThat(appender.isStarted() && originalEncoder.isStarted()).isTrue();
      assertThat(((ch.qos.logback.core.ConsoleAppender<?>) installed).getTarget())
          .isEqualTo("System.out");
      originalStream = appender.getOutputStream();
      assertThat(originalStream).isNotNull();
      appender.setOutputStream(
          new java.io.OutputStream() {
            @Override
            public void write(int value) {
              synchronized (C5Capture.this) {
                if (encoded.size() < MAX_BYTES) {
                  encoded.write(value);
                } else {
                  failed = true;
                }
              }
            }

            @Override
            public void write(byte[] bytes, int offset, int length) {
              synchronized (C5Capture.this) {
                if (encoded.size() <= MAX_BYTES - length) {
                  encoded.write(bytes, offset, length);
                } else {
                  failed = true;
                }
              }
            }

            @Override
            public void close() {
              // Appender stream replacement closes this private target; retain bytes until scan.
            }
          });
      assertThat(appender.getEncoder()).isSameAs(originalEncoder);
      rootLogger.setLevel(ch.qos.logback.classic.Level.TRACE);
      appLogger.setLevel(ch.qos.logback.classic.Level.TRACE);
      claimSampler =
          "true".equals(System.getenv("STUDIO_C5_CLAIM_DIAGNOSTIC"))
              ? new C5ClaimSampler(true)
              : null;
    }

    void writeProfileValues() throws Exception {
      Path file = TEMP.resolve("c5-private-values.json");
      if (!Files.exists(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
        Files.createFile(
            file,
            java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
                java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")));
      }
      assertThat(Files.isSymbolicLink(file)).isFalse();
      assertThat(Files.getPosixFilePermissions(file))
          .isEqualTo(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"));
      Path temporary = TEMP.resolve("c5-private-values.tmp");
      Files.createFile(
          temporary,
          java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
              java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")));
      try {
        Files.writeString(temporary, JSON.writeValueAsString(values), StandardCharsets.UTF_8);
        Files.move(
            temporary,
            file,
            java.nio.file.StandardCopyOption.ATOMIC_MOVE,
            java.nio.file.StandardCopyOption.REPLACE_EXISTING);
      } finally {
        Files.deleteIfExists(temporary);
      }
    }

    boolean selectedLifecycle(jakarta.servlet.http.HttpServletRequest request) {
      String selected = selectedGuidedSession;
      return selected != null
          && request.getMethod().equals("POST")
          && request
              .getRequestURI()
              .equals("/internal/v2/studio/guided-sessions/" + selected + "/lifecycle");
    }

    boolean selectedClaim(jakarta.servlet.http.HttpServletRequest request) {
      String selected = selectedGuidedSession;
      return selected != null
          && request.getMethod().equals("POST")
          && request
              .getRequestURI()
              .equals("/internal/v2/studio/guided-sessions/" + selected + "/claim");
    }

    synchronized void recordClaim(byte[] bytes, int status, long handlerNanos) {
      try {
        ObjectNode sample =
            C.object()
                .put("ordinal", ++claimOrdinal)
                .put("status", status)
                .put("handlerNanos", handlerNanos)
                .put("consumed", bytes.length > 0 && bytes.length < 262144);
        Path file = TEMP.resolve("c5-claim-server-diagnostic.jsonl");
        if (!Files.exists(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
          Files.createFile(
              file,
              java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
                  java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")));
        }
        if (Files.isSymbolicLink(file)
            || !Files.isRegularFile(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            || !Files.getPosixFilePermissions(file)
                .equals(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"))) {
          throw new IOException("Unsafe private claim diagnostic target");
        }
        Files.writeString(
            file,
            sample.toString() + "\n",
            StandardCharsets.UTF_8,
            java.nio.file.StandardOpenOption.APPEND);
      } catch (Exception failure) {
        lifecycleDiagnosticFailed = true;
      }
    }

    synchronized void recordLifecycle(byte[] bytes, int status) {
      String kind = "UNCLASSIFIED", reason = "UNCLASSIFIED";
      boolean consumed = bytes.length > 0 && bytes.length < 262144;
      try {
        if (consumed) {
          JsonNode original = C.parseWire(bytes);
          String session =
              original.path("kind").asText().equals("assignment")
                  ? original.path("assignment").path("sessionId").asText()
                  : original.path("sessionId").asText();
          if (session.equals(selectedGuidedSession)) {
            kind =
                original.path("kind").asText().equals("assignment")
                    ? "ASSIGNMENT"
                    : original.has("contextId") ? "RUNTIME" : "UNCLASSIFIED";
            String actualReason = original.path("reason").asText();
            if (List.of(
                    "CANCELLED",
                    "EXPIRED",
                    "UNKNOWN_OUTCOME",
                    "LEASE_LOST",
                    "CONTEXT_LOST",
                    "REVOKED")
                .contains(actualReason)) {
              reason = actualReason;
            }
          }
        }
      } catch (RuntimeException invalid) {
        // The original chain already owns parsing/errors; export no diagnostic parser exception.
      }
      try {
        ObjectNode sample =
            C.object()
                .put("ordinal", ++lifecycleOrdinal)
                .put("status", status)
                .put("kind", kind)
                .put("reason", reason)
                .put("consumed", consumed);
        Path file = TEMP.resolve("c5-lifecycle-diagnostic.jsonl");
        if (!Files.exists(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
          Files.createFile(
              file,
              java.nio.file.attribute.PosixFilePermissions.asFileAttribute(
                  java.nio.file.attribute.PosixFilePermissions.fromString("rw-------")));
        }
        if (Files.isSymbolicLink(file)
            || !Files.isRegularFile(file, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            || !Files.getPosixFilePermissions(file)
                .equals(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"))) {
          throw new IOException("Unsafe private lifecycle diagnostic target");
        }
        Files.writeString(
            file,
            sample.toString() + "\n",
            StandardCharsets.UTF_8,
            java.nio.file.StandardOpenOption.APPEND);
      } catch (Exception failure) {
        lifecycleDiagnosticFailed = true;
      }
    }

    synchronized void recordHttp(HttpResponse<String> response) {
      byte[] bytes = response.body().getBytes(StandardCharsets.UTF_8);
      for (String value : values) {
        assertJoinedSinkAbsent(Map.of("c5-private-http-response", bytes), value);
      }
      if (bytes.length > MAX_BYTES) {
        failed = true;
        throw new AssertionError("C5 actual HTTP response exceeds the capture bound");
      }
      produced.put("c5-http-" + ++httpBodies, bytes);
      if (response.statusCode() >= 400) {
        httpErrors++;
      }
      String media = response.headers().firstValue("Content-Type").orElse("");
      if (media.startsWith("application/problem+json")) {
        problemBodies++;
      } else if (media.startsWith("application/json")) {
        jsonBodies++;
      }
    }

    void watchExecution(UUID execution) throws Exception {
      var response =
          HttpClient.newBuilder()
              .sslContext(TLS)
              .build()
              .send(
                  HttpRequest.newBuilder(
                          URI.create(
                              "https://localhost:"
                                  + port
                                  + "/api/v1/studio/executions/"
                                  + execution
                                  + "/events"))
                      .timeout(Duration.ofSeconds(15))
                      .header("Cookie", "put_session=" + COOKIE)
                      .header("Accept", "text/event-stream")
                      .GET()
                      .build(),
                  HttpResponse.BodyHandlers.ofInputStream());
      C5Stream stream = null;
      try {
        assertThat(response.statusCode()).isEqualTo(200);
        assertThat(response.headers().firstValue("Content-Type").orElse(""))
            .startsWith("text/event-stream");
        stream = new C5Stream(response.body());
        streams.add(stream);
      } catch (Exception | Error original) {
        try {
          if (stream == null) {
            response.body().close();
          } else {
            stream.close();
          }
        } catch (Exception | Error cleanup) {
          original.addSuppressed(cleanup);
        }
        throw original;
      }
    }

    void collect(Map<String, byte[]> sinks) throws Exception {
      for (int index = 0; index < streams.size(); index++) {
        sinks.put("c5-sse-" + index, streams.get(index).completed());
      }
      var metrics =
          HttpClient.newBuilder()
              .sslContext(TLS)
              .build()
              .send(
                  HttpRequest.newBuilder(
                          URI.create("https://localhost:" + port + "/actuator/prometheus"))
                      .timeout(Duration.ofSeconds(15))
                      .GET()
                      .build(),
                  HttpResponse.BodyHandlers.ofByteArray());
      assertThat(metrics.statusCode()).isEqualTo(200);
      assertThat(metrics.body().length).isPositive().isLessThanOrEqualTo(MAX_BYTES);
      metricBytes = metrics.body().length;
      sinks.put("c5-prometheus", metrics.body());
      @SuppressWarnings("unchecked")
      var cache =
          (com.github.benmanes.caffeine.cache.Cache<
                  String, com.citi.put.checks.config.CachedResponse>)
              ownedApplicationContext.getBean(
                  "idempotencyCache", com.github.benmanes.caffeine.cache.Cache.class);
      cacheEntries = cache.asMap().size();
      assertThat(cacheEntries).as("real accepted mutation cache entries").isPositive();
      int ordinal = 0;
      for (var entry : cache.asMap().values()) {
        sinks.put("c5-cache-body-" + ordinal, entry.body());
        sinks.put("c5-cache-headers-" + ordinal++, JSON.writeValueAsBytes(entry.headers()));
      }
      synchronized (this) {
        assertThat(failed).as("actual capture bound/observer integrity").isFalse();
        assertThat(appender.getEncoder()).isSameAs(originalEncoder);
        assertThat(appender.isStarted() && originalEncoder.isStarted()).isTrue();
        for (var status : loggerContext.getStatusManager().getCopyOfStatusList()) {
          if (status.getDate() >= statusSince) {
            assertThat(status.getEffectiveLevel()).as("original appender status").isZero();
          }
        }
        byte[] actualLogs = encoded.toByteArray();
        rootEvents = 0;
        appEvents = 0;
        for (String line : new String(actualLogs, StandardCharsets.UTF_8).split("\n")) {
          if (!line.isBlank()) {
            JsonNode event = C.parse(line);
            rootEvents++;
            if (event.path("logger").asText().startsWith("com.citi.put.checks")) {
              appEvents++;
            }
          }
        }
        sinks.putAll(produced);
        sinks.put("c5-original-JSON_CONSOLE", actualLogs);
      }
      Path profiles = TEMP.resolve("c5-profile-counts.jsonl");
      assertThat(Files.exists(profiles)).as("actual profile before-close scan produced").isTrue();
      assertThat(Files.exists(TEMP.resolve("c5-profile-counts.jsonl-failed"))).isFalse();
      assertThat(Files.isSymbolicLink(profiles)).isFalse();
      assertThat(Files.getPosixFilePermissions(profiles))
          .isEqualTo(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"));
      profileFiles = 0;
      profileLinks = 0;
      List<String> profileSamples = Files.readAllLines(profiles);
      assertThat(profileSamples.size())
          .as("guided and completed ordinary profile scans")
          .isGreaterThanOrEqualTo(streams.size() + 1);
      for (String line : profileSamples) {
        JsonNode sample = C.parse(line);
        assertThat(sample.size()).isEqualTo(13);
        assertThat(sample.path("failed").isBoolean()).isTrue();
        for (String field :
            List.of(
                "files",
                "bytes",
                "hits",
                "links",
                "stage",
                "errno",
                "linkName",
                "linkType",
                "linkBytes")) {
          assertThat(sample.path(field).isIntegralNumber()).isTrue();
          assertThat(sample.path(field).asLong()).isGreaterThanOrEqualTo(0);
        }
        assertThat(sample.path("linkRoot").isBoolean()).isTrue();
        assertThat(sample.path("linkTargetRead").isBoolean()).isTrue();
        assertThat(sample.path("linkTargetIsVersion").isBoolean()).isTrue();
        assertThat(sample.path("linkName").asInt()).isBetween(0, 4);
        assertThat(sample.path("linkType").asInt()).isBetween(0, 1);
        assertThat(sample.path("stage").asInt()).isBetween(0, 16);
        assertThat(sample.path("errno").asInt()).isBetween(0, 10);
        assertThat(sample.path("failed").asBoolean(true)).isFalse();
        assertThat(sample.path("hits").asLong(-1)).isZero();
        assertThat(sample.path("files").asInt()).isPositive();
        assertThat(sample.path("bytes").asLong()).isPositive();
        profileFiles += sample.path("files").asInt();
        profileLinks += sample.path("links").asInt();
      }
    }

    void writeNumericEvidence() throws Exception {
      ObjectNode evidence =
          C.object()
              .put("mappedAppenders", 1)
              .put("rootEvents", rootEvents)
              .put("appEvents", appEvents)
              .put("encodedBytes", encoded.size())
              .put("httpBodies", httpBodies)
              .put("httpErrors", httpErrors)
              .put("jsonBodies", jsonBodies)
              .put("problemBodies", problemBodies)
              .put("sseStreams", streams.size())
              .put("metricBytes", metricBytes)
              .put("cacheEntries", cacheEntries)
              .put("profileFiles", profileFiles)
              .put("knownRootLinks", profileLinks)
              .put("externalLinkTargetBytesScanned", false)
              .put("c4WindowsExecuted", c4WindowsExecuted)
              .put("appEventsObserved", appEvents > 0);
      Files.writeString(TEMP.resolve("c5-numeric-evidence.json"), evidence.toString());
    }

    private void closeClaimSampler() throws Exception {
      try {
        claimSampler.close();
      } finally {
        if (claimSampler.sampler.isAlive() || !claimSampler.pgJoined()) {
          cleanupUnconfirmed = true;
        }
      }
      boolean joined = !claimSampler.sampler.isAlive();
      boolean pgJoined = claimSampler.pgJoined();
      Path path = TEMP.resolve("c5-numeric-evidence.json");
      ObjectNode evidence =
          Files.exists(path, java.nio.file.LinkOption.NOFOLLOW_LINKS)
              ? (ObjectNode) C.parse(Files.readString(path, StandardCharsets.UTF_8))
              : C.object();
      evidence
          .put("claimSamplerStatus", claimSampler.status.ordinal())
          .put("claimSamplerJoined", joined)
          .put("claimSamplerCleanupConfirmed", joined && pgJoined)
          .put("claimSamplerDiagnosticOnly", true);
      if (!joined) {
        evidence.remove(
            List.of(
                "claimSamplerCycles",
                "claimSamplerEmpty",
                "claimSamplerUnattributed",
                "claimSamplerCounts"));
      }
      if (joined) {
        evidence
            .put("claimSamplerCycles", claimSampler.cycles)
            .put("claimSamplerEmpty", claimSampler.empty)
            .put("claimSamplerUnattributed", claimSampler.unattributed);
        evidence.set("claimSamplerCounts", JSON.valueToTree(claimSampler.counts));
      }
      evidence.remove(
          List.of(
              "pgSnapshotRows",
              "pgSnapshotCandidates",
              "pgSnapshotBlockers",
              "pgSnapshotStageWaitCounts",
              "pgSnapshotBlockerStageCounts",
              "pgSnapshotRelationCounts",
              "pgSnapshotWaitEventCounts"));
      evidence
          .put("pgSnapshotStatus", claimSampler.pgStatus.ordinal())
          .put("pgSnapshotJoined", pgJoined)
          .put("pgSnapshotExactClaimAttribution", false);
      if (pgJoined) {
        evidence
            .put("pgSnapshotRows", claimSampler.pgRows)
            .put("pgSnapshotCandidates", claimSampler.pgCandidates)
            .put("pgSnapshotBlockers", claimSampler.pgBlockers);
        if (claimSampler.pgStatus == C5ClaimSampler.PgStatus.OBSERVED
            || claimSampler.pgStatus == C5ClaimSampler.PgStatus.AMBIGUOUS) {
          evidence.set(
              "pgSnapshotStageWaitCounts", JSON.valueToTree(claimSampler.pgStagesAndWaits));
          evidence.set(
              "pgSnapshotBlockerStageCounts", JSON.valueToTree(claimSampler.pgBlockerStages));
          evidence.set("pgSnapshotRelationCounts", JSON.valueToTree(claimSampler.pgRelations));
          evidence.set("pgSnapshotWaitEventCounts", JSON.valueToTree(claimSampler.pgWaitEvents));
        }
      }
      Files.writeString(path, evidence.toString(), StandardCharsets.UTF_8);
      if (!joined || !pgJoined) {
        throw new IllegalStateException("Private claim sampler cleanup remains unconfirmed");
      }
    }

    @Override
    public void close() throws Exception {
      var failures = new java.util.ArrayList<Throwable>();
      try {
        if (claimSampler != null) {
          p3AttemptTeardown(failures, this::closeClaimSampler);
        }
        for (C5Stream stream : streams) {
          p3AttemptTeardown(failures, stream::close);
        }
        p3AttemptTeardown(failures, () -> rootLogger.setLevel(rootLevel));
        p3AttemptTeardown(failures, () -> appLogger.setLevel(appLevel));
        p3AttemptTeardown(failures, () -> appender.setOutputStream(originalStream));
        p3AttemptTeardown(
            failures,
            () -> {
              synchronized (this) {
                assertThat(lifecycleDiagnosticFailed)
                    .as("private lifecycle diagnostic integrity")
                    .isFalse();
                assertThat(
                        Files.exists(TEMP.resolve("c5-grant-validation-diagnostic.jsonl-failed")))
                    .as("private grant diagnostic integrity")
                    .isFalse();
                assertThat(failed).as("final private appender capture integrity").isFalse();
                var finalBytes = new java.util.LinkedHashMap<>(produced);
                finalBytes.put("c5-final-original-JSON_CONSOLE", encoded.toByteArray());
                for (String value : values) {
                  assertJoinedSinkAbsent(finalBytes, value);
                }
              }
            });
      } finally {
        p3AttemptTeardown(
            failures, () -> Files.deleteIfExists(TEMP.resolve("c5-private-values.json")));
        encoded.reset();
        produced.clear();
      }
      throwTeardownFailures(failures);
    }
  }

  private static final class C5Stream implements AutoCloseable {
    private final java.io.InputStream input;
    private final java.util.concurrent.FutureTask<byte[]> result;
    private final Thread reader;
    private byte[] bytes;

    C5Stream(java.io.InputStream input) {
      this.input = input;
      result = new java.util.concurrent.FutureTask<>(() -> input.readNBytes(4 * 1024 * 1024 + 1));
      reader = Thread.ofVirtual().name("private-c5-sse").start(result);
    }

    byte[] completed() throws Exception {
      if (bytes == null) {
        try {
          bytes = result.get(15, java.util.concurrent.TimeUnit.SECONDS);
        } catch (Exception primary) {
          try {
            close();
          } catch (Exception cleanup) {
            primary.addSuppressed(cleanup);
          }
          throw primary;
        }
        close();
        assertThat(bytes.length).isPositive().isLessThanOrEqualTo(4 * 1024 * 1024);
        String framing = new String(bytes, StandardCharsets.UTF_8);
        assertThat(framing.contains("event:execution.snapshot")).isTrue();
        assertThat(framing.contains("\"streamComplete\":true")).isTrue();
      }
      return bytes;
    }

    @Override
    public void close() throws Exception {
      try {
        input.close();
      } finally {
        result.cancel(true);
        reader.join(1000);
      }
      assertThat(reader.isAlive()).as("owned SSE reader released").isFalse();
    }
  }

  private void collectJoinedSinks(Map<String, byte[]> sinks) throws Exception {
    // Values never become SQL parameters or query text, including when JDBC TRACE is enabled.
    for (String table :
        List.of(
            "ui_test_revisions",
            "ui_test_executions",
            "studio_guided_source_manifests",
            "studio_guided_materializations",
            "studio_guided_actions",
            "studio_secret_use_audit",
            "studio_guided_commands",
            "studio_guided_translation_plans",
            "studio_guided_translation_state",
            "studio_guided_model_attempts",
            "studio_observed_secret_read_entries",
            "studio_guided_publications")) {
      List<String> rows =
          jdbc.queryForList("SELECT row_to_json(t)::text FROM " + table + " t", String.class);
      sinks.put("postgres-" + table, String.join("\n", rows).getBytes(StandardCharsets.UTF_8));
    }
    sinks.put("gateway", String.join("\n", MODEL_WIRE).getBytes(StandardCharsets.UTF_8));
    for (String file : List.of("guided.log", "ordinary.log")) {
      sinks.put(file, Files.readAllBytes(TEMP.resolve(file)));
    }
    for (String directory : List.of("journal", "scratch", "objects")) {
      Path root = TEMP.resolve(directory);
      if (Files.isDirectory(root)) {
        try (var paths = Files.walk(root)) {
          for (Path file :
              paths
                  .filter(
                      path -> Files.isRegularFile(path, java.nio.file.LinkOption.NOFOLLOW_LINKS))
                  .toList()) {
            assertThat(Files.isSymbolicLink(file)).isFalse();
            sinks.put("owned-" + TEMP.relativize(file), Files.readAllBytes(file));
          }
        }
      }
    }
    C5Capture capture = c5Capture;
    if (capture != null) {
      capture.collect(sinks);
    }
    // Fixture /__receipts deliberately contains the password; it is not a production sink.
  }

  private static void assertJoinedSinkAbsent(Map<String, byte[]> sinks, String value) {
    var variants = new java.util.ArrayList<byte[]>();
    byte[] utf8 = value.getBytes(StandardCharsets.UTF_8);
    variants.add(utf8);
    variants.add(value.getBytes(StandardCharsets.UTF_16LE));
    variants.add(value.getBytes(StandardCharsets.UTF_16BE));
    variants.add(Base64.getEncoder().encode(utf8));
    variants.add(HexFormat.of().formatHex(utf8).getBytes(StandardCharsets.UTF_8));
    variants.add(HexFormat.of().withUpperCase().formatHex(utf8).getBytes(StandardCharsets.UTF_8));
    StringBuilder unicode = new StringBuilder();
    for (char character : value.toCharArray()) {
      unicode.append(String.format(java.util.Locale.ROOT, "\\u%04x", (int) character));
    }
    variants.add(unicode.toString().getBytes(StandardCharsets.UTF_8));
    variants.add(
        unicode
            .toString()
            .toUpperCase(java.util.Locale.ROOT)
            .replace("\\U", "\\u")
            .getBytes(StandardCharsets.UTF_8));
    StringBuilder percent = new StringBuilder();
    StringBuilder component = new StringBuilder();
    for (byte octet : utf8) {
      int unsigned = Byte.toUnsignedInt(octet);
      String escape = String.format(java.util.Locale.ROOT, "%%%02X", unsigned);
      percent.append(escape);
      // JavaScript encodeURIComponent leaves these ASCII bytes unescaped.
      if (unsigned >= 'a' && unsigned <= 'z'
          || unsigned >= 'A' && unsigned <= 'Z'
          || unsigned >= '0' && unsigned <= '9'
          || "-_.!~*'()".indexOf(unsigned) >= 0) {
        component.append((char) unsigned);
      } else {
        component.append(escape);
      }
    }
    variants.add(percent.toString().getBytes(StandardCharsets.UTF_8));
    variants.add(
        percent.toString().toLowerCase(java.util.Locale.ROOT).getBytes(StandardCharsets.UTF_8));
    variants.add(component.toString().getBytes(StandardCharsets.UTF_8));
    String form = java.net.URLEncoder.encode(value, StandardCharsets.UTF_8);
    variants.add(form.getBytes(StandardCharsets.UTF_8));
    variants.add(form.replace("+", "%20").getBytes(StandardCharsets.UTF_8));
    try {
      String json = JSON.writeValueAsString(value);
      variants.add(json.getBytes(StandardCharsets.UTF_8));
      variants.add(json.substring(1, json.length() - 1).getBytes(StandardCharsets.UTF_8));
    } catch (com.fasterxml.jackson.core.JsonProcessingException failure) {
      throw new IllegalStateException("Synthetic sink JSON encoding unavailable", failure);
    }
    for (var sink : sinks.entrySet()) {
      for (byte[] variant : variants) {
        assertThat(containsBytes(sink.getValue(), variant))
            .as("released value absent from actual sink %s", sink.getKey())
            .isFalse();
      }
    }
  }

  private static boolean containsBytes(byte[] bytes, byte[] needle) {
    for (int start = 0; start <= bytes.length - needle.length; start++) {
      int offset = 0;
      while (offset < needle.length && bytes[start + offset] == needle[offset]) {
        offset++;
      }
      if (offset == needle.length) {
        return true;
      }
    }
    return false;
  }

  private UUID createSource(List<String> texts) throws Exception {
    return createSource(texts, 30);
  }

  private UUID createSource(List<String> texts, int timeoutSeconds) throws Exception {
    UUID id = UUID.randomUUID();
    var authoring =
        new AuthoringV2Request(
            2,
            null,
            List.of(
                new AuthoringStep(UUID.fromString(ONE), texts.get(0), null),
                new AuthoringStep(UUID.fromString(TWO), texts.get(1), null),
                new AuthoringStep(UUID.fromString(THREE), texts.get(2), null)));
    jdbc.update(
        "INSERT INTO ui_tests(id,name,csi_id,environment,browser,steps,variables,authoring,"
            + "authoring_revision_inputs,timeout_seconds,created_by,created_at,updated_at) VALUES"
            + " (?,'Delayed observed','CSI-123','fixture','chromium',?::jsonb,'[]'::jsonb,?::jsonb,"
            + "?::jsonb,?,'fixture@example.invalid',now(),now())",
        id,
        JSON.writeValueAsString(texts),
        JSON.writeValueAsString(authoring),
        JSON.writeValueAsString(AuthoringRevisionIdentity.create(authoring, Map.of())),
        timeoutSeconds);
    return id;
  }

  private String startLearning(UUID id) throws Exception {
    ObjectNode start =
        C.object()
            .put("schemaVersion", 3)
            .put("testId", id.toString())
            .put("sourceRevision", "1")
            .put("configurationRevision", "1")
            .put("environmentId", "fixture")
            .put("applicationId", "orders");
    start.set("versions", versions());
    return publicCall("/api/v3/studio/guided-sessions", start, 202, UUID.randomUUID().toString())
        .path("session")
        .path("sessionId")
        .asText();
  }

  private void awaitFinalizing(String id) throws Exception {
    long end = System.nanoTime() + Duration.ofSeconds(90).toNanos();
    while (System.nanoTime() < end) {
      String state =
          c5Capture != null
              ? jdbc.queryForObject(
                  "SELECT state FROM studio_guided_sessions WHERE session_id=?", String.class, id)
              : sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
      if (List.of("FINALIZING", "FAILED", "EXPIRED", "UNKNOWN_OUTCOME", "CANCELLED")
          .contains(state)) {
        assertThat(state).as("second explicit learning; logs %s", TEMP).isEqualTo("FINALIZING");
        return;
      }
      Thread.sleep(50);
    }
    throw new AssertionError("Second explicit learning did not finalize; logs " + TEMP);
  }

  private UUID arrangeActivation(UUID schedule, UUID testId, UUID revision, long version) {
    UUID activation = UUID.randomUUID();
    Instant due =
        Instant.now()
            .truncatedTo(java.time.temporal.ChronoUnit.MINUTES)
            .minusSeconds(version == 2 ? 60 : 30);
    sessions.transaction(
        () -> {
          jdbc.update(
              "INSERT INTO studio_schedule_activations(id, schedule_id, test_id, csi_id,"
                  + " schedule_version, revision_id, environment, execution_principal,"
                  + " activated_by) VALUES"
                  + " (?,?,?,'CSI-123',?,?,'fixture','user-1','fixture@example.invalid')",
              activation,
              schedule,
              testId,
              version,
              revision);
          if (version == 4) {
            jdbc.update(
                "UPDATE studio_schedules SET cron_expression='30 * * * * *' WHERE id=?", schedule);
          }
          jdbc.update(
              "UPDATE studio_schedules SET version=?, state='ENABLED', requested_enabled=true,"
                  + " blocked_code=NULL, activated_revision_id=?, activation_id=?, next_due_at=?,"
                  + " poll_after_at=? WHERE id=?",
              version,
              revision,
              activation,
              java.sql.Timestamp.from(due),
              java.sql.Timestamp.from(due),
              schedule);
          return null;
        });
    return activation;
  }

  private Map<String, Object> activationIdentity(UUID schedule) {
    return jdbc.queryForMap(
        "SELECT a.* FROM studio_schedule_activations a JOIN studio_schedules s ON"
            + " s.activation_id=a.id WHERE s.id=?",
        schedule);
  }

  private void historicalReplica(
      String id, JsonNode receipt, boolean replay, boolean support, String readinessCode)
      throws Exception {
    Map<String, Object> settings = new java.util.LinkedHashMap<>();
    settings.put("spring.datasource.driver-class-name", "org.postgresql.Driver");
    settings.put("spring.datasource.url", DB.getJdbcUrl());
    settings.put("spring.datasource.username", DB.getUsername());
    settings.put("spring.datasource.password", DB.getPassword());
    settings.put("server.port", "0");
    settings.put("server.ssl.enabled", "false");
    settings.put("spring.jmx.enabled", "false");
    settings.put("spring.main.banner-mode", "off");
    settings.put("logging.level.root", "WARN");
    settings.put("checks.core-service.base-url", ORIGIN);
    settings.put("studio.guided-authoring.enabled", "true");
    settings.put(
        "studio.guided-authoring.service-public-key",
        Base64.getEncoder().encodeToString(ISSUER.getPublic().getEncoded()));
    settings.put("studio.guided-authoring.translation.enabled", "false");
    settings.put("studio.guided.publication.enabled", "false");
    settings.put("studio.observed-replay.enabled", replay);
    settings.put(
        "studio.observed-replay.catalog-json",
        support ? C.object().putArray("catalog").add(CATALOG).toString() : "[]");
    settings.put(
        "studio.observed-replay.policies-json",
        C.object().putArray("policies").add(POLICY).toString());
    settings.put("studio.compile.gateway.provider", "disabled");
    settings.put("studio.compile.gateway.model", "benign-new-learning-default");
    settings.put("studio.execution.dispatcher.enabled", "false");
    try (var replica =
        new org.springframework.boot.builder.SpringApplicationBuilder(ChecksApplication.class)
            .profiles("test")
            .initializers(
                context ->
                    context
                        .getEnvironment()
                        .getPropertySources()
                        .addFirst(
                            new org.springframework.core.env.MapPropertySource(
                                "observed-history-fixture", settings)))
            .run("--spring.profiles.active=test", "--checks.local-dev-auth.enabled=false")) {
      assertThat(replica.getEnvironment().getActiveProfiles()).containsExactly("test");
      int localPort =
          ((org.springframework.boot.web.servlet.context.ServletWebServerApplicationContext)
                  replica)
              .getWebServer()
              .getPort();
      var request =
          HttpRequest.newBuilder(
                  URI.create(
                      "http://localhost:"
                          + localPort
                          + "/api/v3/studio/guided-sessions/"
                          + id
                          + "/result"))
              .header("Cookie", "put_session=" + COOKIE)
              .GET()
              .build();
      int before = CORE_CALLS.get();
      var response = HttpClient.newHttpClient().send(request, HttpResponse.BodyHandlers.ofString());
      assertThat(response.statusCode()).as(response.body()).isEqualTo(200);
      assertThat(CORE_CALLS.get()).isGreaterThan(before);
      JsonNode result = C.parse(response.body());
      assertThat(result.path("publication").path("receipt")).isEqualTo(receipt);
      assertThat(result.path("currentReadiness").path("code").asText()).isEqualTo(readinessCode);
      assertThat(result.path("learnedFromThisRun").asBoolean()).isTrue();
      assertThat(result.path("replayVerified").asBoolean()).isFalse();
      assertThat(result.path("evidence").path("video").isNull()).isTrue();
    }
  }

  private void startWorkers() throws Exception {
    Files.writeString(
        TEMP.resolve("worker.jwt"), token("owning-worker", "worker-1", "studio-guided-controller"));
    ObjectNode config =
        C.object()
            .put("workerId", "worker-1")
            .put("host", "127.0.0.1")
            .put("port", GUIDED_PORT)
            .put("journalDirectory", TEMP.resolve("journal").toString())
            .put("tlsKeyFile", TEMP.resolve("tls.key").toString())
            .put("tlsCertFile", TEMP.resolve("tls.crt").toString())
            .put("tlsCaFile", TEMP.resolve("tls.crt").toString())
            .put("controllerIssuer", "fixture-issuer")
            .put("controllerSubject", "controller-1")
            .put("controllerPublicKeyFile", TEMP.resolve("issuer.pub").toString())
            .put("controllerCertificateFingerprint256", FINGERPRINT)
            .put("callbackBaseUrl", "https://localhost:" + port)
            .put("callbackTokenFile", TEMP.resolve("worker.jwt").toString());
    config.putArray("rules");
    config.set("applicationPolicy", POLICY.path("applicationPolicy"));
    Files.writeString(TEMP.resolve("worker.json"), config.toString());
    Path guidedMain = TEMP.resolve("p3-guided-launch-counter.mjs");
    Files.writeString(guidedMain, p3GuidedLaunchCounter());
    var guided = new ProcessBuilder("node", guidedMain.toString());
    guided.environment().put("STUDIO_GUIDED_CONFIG_FILE", TEMP.resolve("worker.json").toString());
    guided.redirectErrorStream(true).redirectOutput(TEMP.resolve("guided.log").toFile());
    guidedWorker = guided.start();
    String root = Path.of("../studio-runner/dist").toAbsolutePath().normalize().toUri().toString();
    String browsers =
        System.getenv()
            .getOrDefault(
                "PLAYWRIGHT_BROWSERS_PATH",
                Path.of(System.getProperty("user.home"), "Library", "Caches", "ms-playwright")
                    .toString());
    ObjectNode startup =
        C.object()
            .put("STUDIO_RUNNER_OBSERVED_CATALOG_FILE", TEMP.resolve("catalog.json").toString())
            .put("STUDIO_RUNNER_OBSERVED_IMAGE_DIGEST", "c".repeat(64))
            .put("PLAYWRIGHT_BROWSERS_PATH", browsers);
    Files.writeString(TEMP.resolve("initial-context-state.json"), "{\"fail\":false}");
    String initialContextCheck =
        ("const checkInitial=async(handle)=>{const fs=await import('node:fs');const state=()=>J"
                + "SON.parse(fs.readFileSync(")
            + JSON.writeValueAsString(TEMP.resolve("initial-context-state.json").toString())
            + ",'utf8'));fs.writeFileSync("
            + JSON.writeValueAsString(TEMP.resolve("initial-context-check-entered").toString())
            + ",'entered');while(state().pause)await new Promise(r=>setTimeout(r,20));"
            + "if(state().fail)return false;return handle();};";
    Path child = TEMP.resolve("recorded-child.mjs");
    Files.writeString(
        child,
        "import {startChild} from '"
            + root
            + "run/child.js';import {loadObservedBuild} from '"
            + root
            + "compat/runtime-versions.js';import {playwrightBrowserFactory} from '"
            + root
            + "run/browser.js';"
            + p4NativeCloseObserverSdk()
            + p4OrdinaryRevocationChild()
            + initialContextCheck
            + "const launch=playwrightBrowserFactory.launch.bind(playwrightBrowserFactory);"
            + "playwrightBrowserFactory.launch=async request=>{const handle=await launch(request);"
            + ("if(request.observedScope){const matches=handle.observedInitialContextMatches.bind(han"
                + "dle);handle.observedInitialContextMatches=()=>checkInitial(matches);}")
            + "const create=handle.createObservationSession.bind(handle);"
            + "handle.createObservationSession=config=>{const session=create(config),"
            + "acquire=session.acquire.bind(session),invoke=session.invoke.bind(session);"
            + "session.acquire=async request=>{const result=await acquire(request);"
            + "if(request.locator.kind==='role'&&request.locator.name==='Confirmation')"
            + "await fetch('"
            + ORIGIN
            + "/acquisition',{method:'POST',body:result.kind});return result;};"
            + "session.invoke=async (...args)=>{const result=await invoke(...args);"
            + "await fetch('"
            + ORIGIN
            + "/invocation',{method:'POST',body:args[0].operation.kind});"
            + "return result;};const revSelected=revMode();if(revSelected?.active&&revSelected.path===2){"
            + "if(!revReady)revFail();else revObserveNative(session,revSelected);}return session;};return handle;};"
            + "startChild(revProcess,{observedBuild:loadObservedBuild("
            + startup
            + ")});");
    ObjectNode env =
        C.object()
            .put("STUDIO_RUNNER_PORT", Integer.toString(NORMAL_PORT))
            .put("STUDIO_RUNNER_HOST", "127.0.0.1")
            .put("STUDIO_RUNNER_SERVICE_IDENTITY", SERVICE)
            .put("STUDIO_RUNNER_CALLBACK_IDENTITY", CALLBACK)
            .put("STUDIO_RUNNER_CALLBACK_BASE_URL", "https://localhost:" + port)
            .put("STUDIO_RUNNER_INSTANCE_ID", "observed-fixture")
            .put("STUDIO_RUNNER_SCRATCH_DIR", TEMP.resolve("scratch").toString())
            .put("STUDIO_RUNNER_OBJECT_STORE_DIR", TEMP.resolve("objects").toString());
    Path server = TEMP.resolve("ordinary.mjs");
    Files.writeString(
        server,
        "import {createApplication} from '"
            + root
            + "server/application.js';import {loadConfig} from '"
            + root
            + "server/config.js';import {createChildBrowserLauncher} from '"
            + root
            + "run/launcher.js';import {createForkSpawner} from '"
            + root
            + "run/launcher.js';import {loadObservedBuild,loadRuntimeVersions} from '"
            + root
            + "compat/runtime-versions.js';import {playwrightBrowserFactory} from '"
            + root
            + "run/browser.js';"
            + initialContextCheck
            + ordinaryAdmissionRefusalTap()
            + p4OrdinaryRevocationHttp()
            + p6ChildCutSpawner(root)
            + "const launch=playwrightBrowserFactory.launch.bind(playwrightBrowserFactory);"
            + "playwrightBrowserFactory.launch=async request=>{const handle=await launch(request);"
            + ("if(request.observedScope){const matches=handle.observedInitialContextMatches.bind(han"
                + "dle);handle.observedInitialContextMatches=()=>checkInitial(matches);}")
            + "const create=handle.createObservationSession.bind(handle);"
            + "handle.createObservationSession=config=>{const session=create(config),"
            + "acquire=session.acquire.bind(session),invoke=session.invoke.bind(session);"
            + "session.acquire=async request=>{const result=await acquire(request);"
            + "if(request.locator.kind==='role'&&request.locator.name==='Confirmation')"
            + "await fetch('"
            + ORIGIN
            + "/acquisition',{method:'POST',body:result.kind});return result;};"
            + "session.invoke=async (...args)=>{const result=await invoke(...args);"
            + "await fetch('"
            + ORIGIN
            + "/invocation',{method:'POST',body:args[0].operation.kind});"
            + "return result;};return session;};return handle;};"
            + "const build=loadObservedBuild("
            + startup
            + ");const"
            + " launcher=createChildBrowserLauncher({recording:{width:1280,heigh"
            + "t:720},stepTimeoutMs:30000,launchTimeoutMs:30000,maxFailureMessag"
            + "eLength:400,seekOriginCalibrationMs:0,spawner:cutSpawner,childModulePath:"
            + JSON.writeValueAsString(child.toString())
            + "});const app=createApplication(loadConfig("
            + env
            + "),{launcher,http:revHttp,runtimeVersions:loadRuntimeVersions(),observed:{build,policies:["
            + POLICY
            + ","
            + P3_OTHER_POLICY
            + "],validationEnabled:true,replayEnabled:true}});await"
            + " app.start();process.on('SIGTERM',()=>{void"
            + " app.drain().then(()=>process.exit(0));});");
    startOrdinaryWorker(false);
    for (int wanted : new int[] {GUIDED_PORT, NORMAL_PORT}) {
      long until = System.nanoTime() + Duration.ofSeconds(20).toNanos();
      boolean ready = false;
      while (System.nanoTime() < until) {
        try (var socket = new java.net.Socket("127.0.0.1", wanted)) {
          ready = true;
          break;
        } catch (java.io.IOException pending) {
          Thread.sleep(30);
        }
      }
      assertThat(ready).as("worker port %s logs at %s", wanted, TEMP).isTrue();
    }
  }

  private void startOrdinaryWorker(boolean preserveExistingLog) throws Exception {
    String browsers =
        System.getenv()
            .getOrDefault(
                "PLAYWRIGHT_BROWSERS_PATH",
                Path.of(System.getProperty("user.home"), "Library", "Caches", "ms-playwright")
                    .toString());
    var ordinary = new ProcessBuilder("node", TEMP.resolve("ordinary.mjs").toString());
    ordinary.environment().put("NODE_EXTRA_CA_CERTS", TEMP.resolve("tls.crt").toString());
    ordinary.environment().put("PLAYWRIGHT_BROWSERS_PATH", browsers);
    ordinary
        .redirectErrorStream(true)
        .redirectOutput(
            preserveExistingLog
                ? ProcessBuilder.Redirect.appendTo(TEMP.resolve("ordinary.log").toFile())
                : ProcessBuilder.Redirect.to(TEMP.resolve("ordinary.log").toFile()));
    ordinaryWorker = ordinary.start();
    if (!preserveExistingLog) {
      return; // Original startWorkers owns its unchanged initial two-port readiness check.
    }
    long deadline = System.nanoTime() + Duration.ofSeconds(20).toNanos();
    while (System.nanoTime() < deadline) {
      try (var socket = new java.net.Socket("127.0.0.1", NORMAL_PORT)) {
        assertThat(ordinaryWorker.isAlive()).isTrue();
        return;
      } catch (IOException pending) {
        Thread.sleep(30);
      }
    }
    throw new IllegalStateException("Actual ordinary worker restart readiness unconfirmed");
  }

  private static String p6ChildCutSpawner(String root) throws Exception {
    return """
        import {validateObserved as cutValidate} from %s;
        const cutRealSpawner=createForkSpawner(),cutReady=new Map();
        const cutSpawner={spawn(request){
          const handle=cutRealSpawner.spawn(request);
          handle.onMessage(message=>{
            const mode=revMode();
            if(mode?.childCut!==true||message?.kind!=='ready'||message.runId!==mode.executionId)return;
            try{
              const ready=cutValidate('replay-ipc#/definitions/Ready3',message,16384);
              if(!Number.isSafeInteger(handle.pid)||handle.pid<1||cutReady.has(ready.runId))
                throw new Error('IDENTITY');
              cutReady.set(ready.runId,{pid:handle.pid,ready});
            }catch{cutReady.set(mode.executionId,{failed:true});}
          });
          return handle;
        }};
        const cutOriginalSend=revHttp.send;
        revHttp.send=function(...args){
          let request=args[0];
          const mode=revMode();
          if(mode?.childCut===true&&request?.method==='POST'){
            try{
              const body=JSON.parse(request.body);
              if(body.executionId===mode.executionId){
                const witness=cutReady.get(body.executionId);
                if(witness?.failed)request={...request,headers:{...request.headers,
                  'X-Fixture-Child-Observer-Failed':'1'}};
                else if(witness){
                  if(body.attemptId!==witness.ready.attemptId||body.admissionId!==witness.ready.admissionId)
                    throw new Error('IDENTITY');
                  const encoded=Buffer.from(JSON.stringify(witness.ready),'utf8').toString('base64url');
                  if(encoded.length>4096)throw new Error('BOUND');
                  request={...request,headers:{...request.headers,
                    'X-Fixture-Child-Pid':String(witness.pid),'X-Fixture-Child-Ready':encoded}};
                }
              }
            }catch{request={...request,headers:{...request.headers,'X-Fixture-Child-Observer-Failed':'1'}};}
          }
          return Reflect.apply(cutOriginalSend,this,[request,...args.slice(1)]);
        };
        """
        .formatted(JSON.writeValueAsString(root + "validator/observedReferencePolicy.js"));
  }

  private static String ordinaryAdmissionRefusalTap() throws Exception {
    String witnessFile =
        JSON.writeValueAsString(TEMP.resolve("ordinary-admission-refusals.jsonl").toString());
    return "import {ServerResponse as FixtureServerResponse} from 'node:http';"
        + "import {appendFileSync as appendRefusalWitness} from 'node:fs';"
        + "const originalResponseEnd=FixtureServerResponse.prototype.end;"
        + "const refusalClockOrigin=process.hrtime.bigint();"
        + "const permittedRefusalCodes=['PROFILE_MISMATCH','AUTHORIZATION_EXPIRED',"
        + "'POLICY_REFUSED','REFERENCE_REFUSED'];"
        + "FixtureServerResponse.prototype.end=function(...args){"
        + "const status=this.statusCode;const result=Reflect.apply(originalResponseEnd,this,args);"
        + "try{if(status===409){let code='OTHER';const chunk=args[0];"
        + "for(const allowed of permittedRefusalCodes){"
        + "const expected='{\"code\":\"'+allowed+'\"}';"
        + "if(typeof chunk==='string'&&chunk===expected||Buffer.isBuffer(chunk)"
        + "&&chunk.equals(Buffer.from(expected,'utf8'))){code=allowed;break;}}"
        + "const ms=Number(process.hrtime.bigint()-refusalClockOrigin)/1e6;"
        + "appendRefusalWitness("
        + witnessFile
        + ",'{\"status\":409,\"code\":\"'+code+'\",\"monotonicMs\":'+ms+'}\\n',"
        + "{mode:0o600});}}catch{}return result;};";
  }

  private JsonNode invoke(String id, String route) throws Exception {
    JsonNode session = sessions.transaction(() -> sessions.lock(id).document().deepCopy());
    ObjectNode body =
        C.object()
            .put("schemaVersion", 3)
            .put("sessionId", id)
            .put("expectedSourceRevision", "1")
            .put("expectedConfigurationRevision", "1")
            .put("expectedPlanRevision", plans.state(id).path("planRevision").asInt());
    HttpRequest request =
        HttpRequest.newBuilder(
                URI.create(
                    "https://localhost:"
                        + port
                        + "/internal/v2/studio/guided-sessions/"
                        + id
                        + "/"
                        + route))
            .header(
                "Authorization",
                "Bearer " + token("backend-controller", "controller-1", "studio-guided-controller"))
            .header("X-Owner-Fence", session.path("owner").path("fence").asText())
            .header("Idempotency-Key", UUID.randomUUID().toString())
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body.toString()))
            .build();
    var response =
        HttpClient.newBuilder()
            .sslContext(TLS)
            .build()
            .send(request, HttpResponse.BodyHandlers.ofString());
    assertThat(response.statusCode()).as("%s; logs %s", response.body(), TEMP).isEqualTo(202);
    return C.parse(response.body());
  }

  private JsonNode publicCall(String path, JsonNode body, int status, String key) throws Exception {
    var builder =
        HttpRequest.newBuilder(URI.create("https://localhost:" + port + path))
            .header("Cookie", "put_session=" + COOKIE);
    if (body == null) {
      builder.GET();
    } else {
      builder
          .header("Content-Type", "application/json")
          .POST(HttpRequest.BodyPublishers.ofString(body.toString()));
      if (key != null) {
        builder.header("Idempotency-Key", key);
      }
    }
    var response =
        HttpClient.newBuilder()
            .sslContext(TLS)
            .build()
            .send(builder.build(), HttpResponse.BodyHandlers.ofString());
    C5Capture capture = c5Capture;
    if (capture != null) {
      capture.recordHttp(response);
    }
    if (capture != null) {
      assertThat(response.statusCode()).as("C5 actual HTTP response status").isEqualTo(status);
    } else {
      assertThat(response.statusCode())
          .as("%s %s; logs %s", path, response.body(), TEMP)
          .isEqualTo(status);
    }
    JsonNode parsed = C.parse(response.body());
    if (path.equals("/api/v3/studio/guided-sessions") && response.statusCode() == 202) {
      String sessionId = parsed.path("session").path("sessionId").asText();
      String testId = parsed.path("session").path("testId").asText();
      assertThat(sessionId).isNotBlank();
      assertThat(testId).isEqualTo(body.path("testId").asText());
      testOwnedSessions.put(sessionId, testId);
      if (capture != null) {
        capture.selectedGuidedSession = sessionId;
      }
    }
    return parsed;
  }

  private static void persistFinalizeDiagnostic(
      GuidedSessionException failure,
      ObservedReplayProperties replay,
      GuidedPublicationProperties publication,
      ObservedReplayPins pins) {
    var diagnostic =
        C.object()
            .put("schemaVersion", 1)
            .put("exceptionCode", safeDiagnosticCode(failure.getMessage()))
            .put("publicationEnabled", publication.enabled())
            .put("replayEnabled", replay.enabled())
            .put(
                "resolverTransactionActive",
                org.springframework.transaction.support.TransactionSynchronizationManager
                    .isActualTransactionActive());
    var frames = diagnostic.putArray("stackFrames");
    for (StackTraceElement frame : failure.getStackTrace()) {
      frames
          .addObject()
          .put("class", frame.getClassName())
          .put("method", frame.getMethodName())
          .put("line", frame.getLineNumber());
    }
    try {
      diagnostic.set("selectedRuntime", pins.selected());
    } catch (RuntimeException pinFailure) {
      diagnostic.put("selectedRuntimeFailureClass", pinFailure.getClass().getName());
      if (pinFailure instanceof GuidedSessionException guarded) {
        diagnostic.put("selectedRuntimeFailureCode", safeDiagnosticCode(guarded.getMessage()));
      }
    }
    try {
      Files.writeString(
          TEMP.resolve("finalize-exception-" + FINALIZE_DIAGNOSTICS.incrementAndGet() + ".json"),
          diagnostic.toPrettyString());
    } catch (IOException writeFailure) {
      failure.addSuppressed(
          new IllegalStateException("Safe finalize diagnostic could not be saved"));
    }
  }

  private static JsonNode versions() throws Exception {
    return C.parse(
            Files.readString(
                Path.of("../docs/specs/studio-observed-authoring/contracts/v3/fixtures.json")))
        .path("documents")
        .path("versions");
  }

  private static ObjectNode model(JsonNode request) {
    String kind = request.path("kind").asText();
    JsonNode context = request.path("context");
    ObjectNode result =
        C.object()
            .put("schemaVersion", 3)
            .put("kind", kind)
            .put("requestId", request.path("requestId").asText());
    if (p3Mode != null) {
      return p3Model(result, context, kind);
    }
    if (secretLoginScenario) {
      return secretLoginModel(result, context, kind);
    }
    if (kind.equals("SOURCE_PLAN")) {
      if (askTimingSource) {
        askTimingSource = false;
        var choices =
            result.putObject("question").put("reason", "AMBIGUOUS_BINDING").putArray("choices");
        for (int i = 0; i < 2; i++) {
          String destination = i == 0 ? URL : URL + "?alternative=two";
          int start = i == 0 ? 5 : timingSourceText.indexOf(destination, 6);
          ObjectNode reference =
              C.object()
                  .put("referenceKind", "sourceSpan")
                  .put("sourceRevision", "1")
                  .put("stepId", ONE)
                  .put("startUtf16", start)
                  .put("endUtf16", start + destination.length())
                  .put("kind", "destination")
                  .put("intendedSlot", "navigate.destination");
          ObjectNode meaning = C.object();
          meaning.set("reference", reference);
          meaning.set(
              "need",
              C.object()
                  .put("stepId", ONE)
                  .put("occurrence", 0)
                  .put("operationKind", "navigate")
                  .put("argumentSlot", "navigate.destination"));
          choices
              .addObject()
              .put("choiceId", "timing-" + i)
              .put(
                  "safeLabel",
                  i == 0 ? "Primary authored destination" : "Alternative authored destination")
              .set("meaning", meaning);
        }
        return result;
      }
      result
          .putArray("sourceReferences")
          .addObject()
          .put("referenceKind", "sourceSpan")
          .put("sourceRevision", "1")
          .put("stepId", ONE)
          .put("startUtf16", 5)
          .put("endUtf16", 5 + URL.length())
          .put("kind", "destination")
          .put("intendedSlot", "navigate.destination");
      if (!context.path("clarificationSelections").isEmpty()) {
        result
            .withArray("sourceReferences")
            .set(0, context.path("clarificationSelections").get(0).path("reference"));
      }
      var items = result.putArray("obligations");
      items.add(obligation(ONE, 0, "navigate", "page", 0, null));
      items.add(obligation(ONE, 1, "read", "Order reference", null, "order"));
      items.add(obligation(TWO, 0, "fill", "Destination", null, "order"));
      items.add(obligation(THREE, 0, "click", "Submit", null, null));
      items.add(
          obligation(THREE, 1, "assert", "Confirmation", null, null).put("predicate", "visible"));
      result
          .putArray("needs")
          .addObject()
          .put("needId", "order")
          .put("producerStepId", ONE)
          .putArray("consumers")
          .addObject()
          .put("stepId", TWO)
          .put("argumentSlot", "fill.value");
      return result;
    }
    if (delayTimingModel) {
      delayTimingModel = false;
      try {
        Thread.sleep(1250);
      } catch (InterruptedException interrupted) {
        Thread.currentThread().interrupt();
        throw new IllegalStateException("Fixture interrupted");
      }
    }
    JsonNode obligation = context.path("obligations").get(0);
    String op = obligation.path("operationKind").asText();
    if (askObservedChoice && op.equals("fill")) {
      askObservedChoice = false;
      try {
        Thread.sleep(1250);
      } catch (InterruptedException interrupted) {
        Thread.currentThread().interrupt();
        throw new IllegalStateException("Fixture interrupted");
      }
      result.put("status", "CLARIFICATION").putNull("obligationId").putNull("action");
      var choices =
          result.putObject("question").put("reason", "AMBIGUOUS_BINDING").putArray("choices");
      for (String name : List.of("Destination", "Alternate destination")) {
        JsonNode node = null;
        for (JsonNode candidate : context.path("observation").path("nodes")) {
          if (candidate.path("name").asText().equals(name)) {
            node = candidate;
          }
        }
        if (node == null) {
          throw new IllegalStateException("Expected observed choice missing");
        }
        ObjectNode meaning =
            C.object()
                .put("obligationId", obligation.path("obligationId").asText())
                .put("nodeId", node.path("nodeId").asText())
                .putNull("bindingId");
        meaning.set(
            "locator",
            C.object()
                .put("kind", "role")
                .put("role", "textbox")
                .put("name", name)
                .put("exact", true));
        choices
            .addObject()
            .put("choiceId", "provider-" + choices.size())
            .put("safeLabel", name)
            .set("meaning", meaning);
      }
      var hook = beforeObservedQuestion;
      if (hook != null) {
        hook.accept(context);
      }
      return result;
    }
    result
        .put("status", "ACTION")
        .put("obligationId", obligation.path("obligationId").asText())
        .putNull("question");
    ObjectNode action = result.putObject("action"),
        operation = action.putObject("operation").put("kind", op),
        target = action.putObject("target");
    if (op.equals("navigate")) {
      target.put("kind", "page");
      operation.put("destinationInputId", context.path("inputs").get(0).path("inputId").asText());
    } else {
      JsonNode node = null;
      for (JsonNode candidate : context.path("observation").path("nodes")) {
        if (candidate.path("name").equals(obligation.path("targetIntent"))) {
          node = candidate;
        }
      }
      if (node == null) {
        throw new IllegalStateException("Expected controlled node missing");
      }
      target
          .put("nodeId", node.path("nodeId").asText())
          .putObject("locator")
          .put("kind", "role")
          .put("role", node.path("role").asText())
          .put("name", node.path("name").asText())
          .put("exact", true);
      if (op.equals("read")) {
        operation
            .put("bindingId", context.path("needs").get(0).path("bindingId").asText())
            .putObject("recipe")
            .put("kind", "visibleText")
            .put("classification", "permittedBusinessData")
            .put("policyRuleId", "business-read");
      }
      if (op.equals("fill")) {
        operation
            .putObject("value")
            .put("kind", "binding")
            .put("bindingId", context.path("needs").get(0).path("bindingId").asText());
      }
      if (op.equals("assert")) {
        operation.put("predicate", "visible").putNull("expected");
      }
    }
    return result;
  }

  private static ObjectNode secretLoginModel(ObjectNode result, JsonNode context, String kind) {
    if (kind.equals("SOURCE_PLAN")) {
      String destination = SECRET_ORIGIN + "/login";
      var references = result.putArray("sourceReferences");
      references
          .addObject()
          .put("referenceKind", "sourceSpan")
          .put("sourceRevision", "1")
          .put("stepId", ONE)
          .put("startUtf16", 5)
          .put("endUtf16", 5 + destination.length())
          .put("kind", "destination")
          .put("intendedSlot", "navigate.destination");
      for (String name : List.of("USER", "PASS")) {
        JsonNode declared = null;
        for (JsonNode reference : context.path("configurationReferences")) {
          if (reference.path("referenceName").asText().equals(name)
              && reference.path("intendedSlot").asText().equals("fill.value")
              && reference.path("stepId").asText().equals(TWO)) {
            declared = reference;
          }
        }
        if (declared == null) {
          throw new IllegalStateException("Missing authentic login declaration");
        }
        ObjectNode sourceReference =
            ((ObjectNode) declared)
                .deepCopy()
                .put("referenceKind", "configuration")
                .put("configurationRevision", "1");
        if (name.equals("USER")) {
          // The closed nonsecret branch identifies the declaration by its authentic referenceId.
          sourceReference.remove("referenceName");
        }
        references.add(sourceReference);
      }
      var obligations = result.putArray("obligations");
      obligations.add(obligation(ONE, 0, "navigate", "page", 0, null));
      obligations.add(obligation(TWO, 0, "fill", "User", 1, null));
      obligations.add(obligation(TWO, 1, "fill", "password", 2, null));
      obligations.add(obligation(THREE, 0, "click", "Sign in", null, null));
      obligations.add(
          obligation(THREE, 1, "assert", "Home", null, null).put("predicate", "visible"));
      obligations.add(obligation(THREE, 2, "click", "Reports", null, null));
      obligations.add(
          obligation(THREE, 3, "assert", "Reports", null, null).put("predicate", "visible"));
      result.putArray("needs");
      return result;
    }
    JsonNode obligation = context.path("obligations").get(0);
    String operationKind = obligation.path("operationKind").asText();
    result
        .put("status", "ACTION")
        .put("obligationId", obligation.path("obligationId").asText())
        .putNull("question");
    var action = result.putObject("action");
    var operation = action.putObject("operation").put("kind", operationKind);
    var target = action.putObject("target");
    if (operationKind.equals("navigate")) {
      target.put("kind", "page");
      for (JsonNode input : context.path("inputs")) {
        if (input.path("intendedSlot").asText().equals("navigate.destination")) {
          operation.put("destinationInputId", input.path("inputId").asText());
        }
      }
    } else {
      if (operationKind.equals("fill")
          && obligation.path("targetIntent").asText().equals("password")) {
        target.put("kind", "passwordControl");
        for (JsonNode input : context.path("inputs")) {
          if (input.path("kind").asText().equals("secretRef")) {
            operation
                .putObject("value")
                .put("kind", "secretRef")
                .put("sourceInputId", input.path("inputId").asText());
          }
        }
      } else {
        JsonNode selected = null;
        for (JsonNode node : context.path("observation").path("nodes")) {
          if (node.path("name").equals(obligation.path("targetIntent"))) {
            selected = node;
          }
        }
        if (selected == null) {
          throw new IllegalStateException("Missing controlled login node");
        }
        target
            .put("nodeId", selected.path("nodeId").asText())
            .putObject("locator")
            .put("kind", "role")
            .put("role", selected.path("role").asText())
            .put("name", selected.path("name").asText())
            .put("exact", true);
        if (operationKind.equals("fill")) {
          for (JsonNode input : context.path("inputs")) {
            if (input.path("kind").asText().equals("nonsecretText")
                && input.path("sourceStepId").asText().equals(TWO)
                && input.path("intendedSlot").asText().equals("fill.value")) {
              operation
                  .putObject("value")
                  .put("kind", "authoredLiteral")
                  .put("sourceInputId", input.path("inputId").asText());
            }
          }
        }
        if (operationKind.equals("assert")) {
          operation.put("predicate", "visible").putNull("expected");
        }
      }
    }
    return result;
  }

  private static ObjectNode obligation(
      String step, int occurrence, String op, String target, Integer reference, String need) {
    ObjectNode o =
        C.object()
            .put("stepId", step)
            .put("occurrence", occurrence)
            .put("operationKind", op)
            .put("targetIntent", target)
            .putNull("predicate")
            .put("needId", need);
    if (reference == null) {
      o.putNull("referenceIndex");
    } else {
      o.put("referenceIndex", reference);
    }
    return o;
  }

  private static String token(String role, String subject, String audience) throws Exception {
    var encoder = Base64.getUrlEncoder().withoutPadding();
    String header =
        encoder.encodeToString(
            "{\"alg\":\"RS256\",\"typ\":\"JWT\"}".getBytes(StandardCharsets.UTF_8));
    ObjectNode claims =
        C.object()
            .put("iss", "fixture-issuer")
            .put("sub", subject)
            .put("aud", audience)
            .put("role", role)
            .put("exp", Instant.now().plusSeconds(299).getEpochSecond())
            .put("iat", Instant.now().minusSeconds(1).getEpochSecond());
    String unsigned =
        header + "." + encoder.encodeToString(claims.toString().getBytes(StandardCharsets.UTF_8));
    Signature signature = Signature.getInstance("SHA256withRSA");
    signature.initSign(ISSUER.getPrivate());
    signature.update(unsigned.getBytes(StandardCharsets.UTF_8));
    return unsigned + "." + encoder.encodeToString(signature.sign());
  }

  private static String command(String... args) throws Exception {
    Process p = new ProcessBuilder(args).redirectErrorStream(true).start();
    String output = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
    if (!p.waitFor(30, java.util.concurrent.TimeUnit.SECONDS) || p.exitValue() != 0) {
      throw new IllegalStateException(output);
    }
    return output;
  }

  private void stopOwnedApplicationJobs() throws Exception {
    assertThat(ownedApplicationContext.getBean(JdbcTemplate.class)).isSameAs(jdbc);
    assertThat(ownedApplicationContext.getBean(GuidedSessionRepository.class)).isSameAs(sessions);
    assertThat(
            ownedApplicationContext
                .getEnvironment()
                .getProperty("spring.datasource.url")
                .equals(DB.getJdbcUrl()))
        .isTrue();
    assertThat(
            ownedApplicationContext
                .getEnvironment()
                .getProperty("local.server.port", Integer.class))
        .isEqualTo(port);
    var factory = ownedApplicationContext.getBeanFactory();
    var scheduled =
        java.util.Collections.newSetFromMap(
            new java.util.IdentityHashMap<java.util.concurrent.ExecutorService, Boolean>());
    var executors =
        java.util.Collections.newSetFromMap(
            new java.util.IdentityHashMap<java.util.concurrent.ExecutorService, Boolean>());
    var simple =
        new java.util.ArrayList<
            org.springframework.scheduling.concurrent.SimpleAsyncTaskScheduler>();
    int cancelledTasks = 0, fixedDelayTasks = 0, fixedRateTasks = 0, cronTasks = 0;
    // Only actual local singleton identities: never instantiate or inspect another context's beans.
    var failures = new java.util.ArrayList<Throwable>();
    for (String name : factory.getSingletonNames()) {
      try {
        Object bean = factory.getSingleton(name);
        if (bean
            instanceof
            org.springframework.scheduling.annotation.ScheduledAnnotationBeanPostProcessor holder) {
          cancelledTasks += holder.getScheduledTasks().size();
          for (var scheduledTask : holder.getScheduledTasks()) {
            Object task = scheduledTask.getTask();
            if (task instanceof org.springframework.scheduling.config.FixedDelayTask) {
              fixedDelayTasks++;
            } else if (task instanceof org.springframework.scheduling.config.FixedRateTask) {
              fixedRateTasks++;
            } else if (task instanceof org.springframework.scheduling.config.CronTask) {
              cronTasks++;
            }
            scheduledTask.cancel(false);
          }
        }
        if (bean
            instanceof
            org.springframework.scheduling.concurrent.SimpleAsyncTaskScheduler scheduler) {
          Object actual =
              org.springframework.test.util.ReflectionTestUtils.getField(
                  scheduler, "scheduledExecutor");
          assertThat(actual instanceof java.util.concurrent.ExecutorService).isTrue();
          scheduled.add((java.util.concurrent.ExecutorService) actual);
          Object tracked =
              org.springframework.test.util.ReflectionTestUtils.getField(
                  scheduler, "activeThreads");
          assertThat(tracked instanceof java.util.Set<?>)
              .as("before-init tracking of actual scheduler bodies")
              .isTrue();
          simple.add(scheduler);
        } else if (bean
            instanceof
            org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler scheduler) {
          scheduled.add(scheduler.getScheduledThreadPoolExecutor());
        }
        if (bean instanceof org.springframework.core.task.support.TaskExecutorAdapter adapter) {
          Object bounded =
              org.springframework.test.util.ReflectionTestUtils.getField(
                  adapter, "concurrentExecutor");
          assertThat(bounded instanceof com.citi.put.checks.config.SemaphoreBoundedExecutor)
              .isTrue();
          Object actual =
              org.springframework.test.util.ReflectionTestUtils.getField(bounded, "delegate");
          assertThat(actual instanceof java.util.concurrent.ExecutorService).isTrue();
          executors.add((java.util.concurrent.ExecutorService) actual);
        } else if (bean
            instanceof org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor executor) {
          executors.add(executor.getThreadPoolExecutor());
        } else if (bean instanceof java.util.concurrent.ExecutorService executor) {
          executors.add(executor);
        }
      } catch (Exception | AssertionError captureFailure) {
        failures.add(captureFailure);
      }
    }
    p3AttemptTeardown(
        failures,
        () -> assertThat(scheduled.size()).as("actual owned scheduler services").isPositive());
    p3AttemptTeardown(
        failures,
        () ->
            assertThat(executors.size())
                .as("actual owned async delegates")
                .isGreaterThanOrEqualTo(3));
    for (var services : java.util.List.of(scheduled, executors)) {
      for (var executor : new java.util.ArrayList<>(services)) {
        if (executor instanceof java.util.concurrent.ForkJoinPool) {
          failures.add(
              new IllegalStateException("Global or unsupported ForkJoin ownership refused"));
          services.remove(executor);
        }
      }
    }
    long deadline = System.nanoTime() + Duration.ofSeconds(90).toNanos();
    // All safe captured resources are attempted, even when another resource cannot be confirmed.
    for (var scheduler : scheduled) {
      p3AttemptTeardown(failures, scheduler::shutdown);
    }
    for (var scheduler : scheduled) {
      p3AttemptTeardown(failures, () -> awaitOwnedExecutorTermination(scheduler, deadline));
    }
    for (var scheduler : simple) {
      p3AttemptTeardown(
          failures,
          () -> {
            Object tracked =
                org.springframework.test.util.ReflectionTestUtils.getField(
                    scheduler, "activeThreads");
            assertThat(tracked instanceof java.util.Set<?>).isTrue();
            while (!((java.util.Set<?>) tracked).isEmpty() && System.nanoTime() < deadline) {
              Thread.sleep(20);
            }
            assertThat(((java.util.Set<?>) tracked).isEmpty())
                .as("actual scheduler virtual bodies drained")
                .isTrue();
            scheduler.close();
          });
    }
    for (var executor : executors) {
      p3AttemptTeardown(failures, executor::shutdown);
    }
    for (var executor : executors) {
      p3AttemptTeardown(failures, () -> awaitOwnedExecutorTermination(executor, deadline));
    }
    throwTeardownFailures(failures);
    // Context destruction (including managed private pools) happens only after observed jobs drain.
    assertThat(ownedFrameworkContext != null).isTrue();
    assertThat(ownedFrameworkContext.getTestClass()).isEqualTo(GuidedPublicationReplayIT.class);
    assertThat(ownedFrameworkContext.getApplicationContext()).isSameAs(ownedApplicationContext);
    var closer =
        java.util.concurrent.Executors.newSingleThreadExecutor(
            task -> {
              Thread thread = new Thread(task, "obs007-owned-context-close");
              thread.setDaemon(true);
              return thread;
            });
    Throwable closePrimary = null;
    java.util.concurrent.Future<?> closeFuture = null;
    try {
      closeFuture =
          closer.submit(
              () ->
                  ownedFrameworkContext.markApplicationContextDirty(
                      org.springframework.test.annotation.DirtiesContext.HierarchyMode
                          .CURRENT_LEVEL));
      long remaining = deadline - System.nanoTime();
      assertThat(remaining).isPositive();
      closeFuture.get(remaining, java.util.concurrent.TimeUnit.NANOSECONDS);
    } catch (Exception | AssertionError failure) {
      closePrimary = failure;
      if (closeFuture != null) {
        closeFuture.cancel(true);
      }
    } finally {
      try {
        closer.shutdownNow();
        assertThat(closer.awaitTermination(5, java.util.concurrent.TimeUnit.SECONDS)).isTrue();
        assertThat(closer.isTerminated()).isTrue();
      } catch (Exception | AssertionError terminationFailure) {
        if (closePrimary == null) {
          closePrimary = terminationFailure;
        } else {
          closePrimary.addSuppressed(terminationFailure);
        }
      }
    }
    if (closePrimary != null) {
      throwTeardownFailures(java.util.List.of(closePrimary));
    }
    assertThat(ownedFrameworkContext.hasApplicationContext()).isFalse();
    assertThat(ownedApplicationContext.isActive()).isFalse();
    for (var scheduler : scheduled) {
      assertThat(scheduler.isTerminated()).isTrue();
    }
    for (var executor : executors) {
      assertThat(executor.isTerminated()).isTrue();
    }
    ownedApplicationQuiescent = true;
    var metadata =
        C.object()
            .put("owningContextIdentity", System.identityHashCode(ownedApplicationContext))
            .put("cancelledScheduledTasks", cancelledTasks)
            .put("fixedDelayTasks", fixedDelayTasks)
            .put("fixedRateTasks", fixedRateTasks)
            .put("cronTasks", cronTasks)
            .put("terminatedSchedulerServices", scheduled.size())
            .put("terminatedAsyncDelegates", executors.size())
            .put("trackedSchedulerBodiesEmpty", true)
            .put("contextClosed", true)
            .put("afterClassCacheEvictionConfigured", true)
            .put("actualFrameworkCacheEntryEvicted", !ownedFrameworkContext.hasApplicationContext())
            .put("commonPoolTerminationClaimed", false);
    p3WriteEvidence("owned-context-teardown", metadata);
  }

  private static void p3AttemptTeardown(java.util.List<Throwable> failures, P3Action operation) {
    try {
      operation.run();
    } catch (Exception | AssertionError failure) {
      failures.add(failure);
    }
  }

  private static void throwTeardownFailures(java.util.List<Throwable> failures) throws Exception {
    if (failures.isEmpty()) {
      return;
    }
    Throwable first = failures.getFirst();
    for (int index = 1; index < failures.size(); index++) {
      if (failures.get(index) != first) {
        first.addSuppressed(failures.get(index));
      }
    }
    if (first instanceof Exception exception) {
      throw exception;
    }
    throw (Error) first;
  }

  private static void awaitOwnedExecutorTermination(
      java.util.concurrent.ExecutorService executor, long deadline) throws InterruptedException {
    long remaining = deadline - System.nanoTime();
    assertThat(remaining).as("bounded owning executor drain deadline").isPositive();
    assertThat(executor.awaitTermination(remaining, java.util.concurrent.TimeUnit.NANOSECONDS))
        .as("actual owning executor terminated before PostgreSQL teardown")
        .isTrue();
    assertThat(executor.isTerminated()).isTrue();
  }

  private static void stopOwnedProcessTree(Process process) throws Exception {
    if (process == null) {
      return;
    }
    var descendants = process.toHandle().descendants().toList();
    process.destroy();
    long deadline = System.nanoTime() + Duration.ofSeconds(30).toNanos();
    while ((process.isAlive() || descendants.stream().anyMatch(ProcessHandle::isAlive))
        && System.nanoTime() < deadline) {
      Thread.sleep(30);
    }
    if (process.isAlive() || descendants.stream().anyMatch(ProcessHandle::isAlive)) {
      descendants.stream().filter(ProcessHandle::isAlive).forEach(ProcessHandle::destroyForcibly);
      if (process.isAlive()) {
        process.destroyForcibly();
      }
      deadline = System.nanoTime() + Duration.ofSeconds(5).toNanos();
      while ((process.isAlive() || descendants.stream().anyMatch(ProcessHandle::isAlive))
          && System.nanoTime() < deadline) {
        Thread.sleep(20);
      }
    }
    assertThat(process.isAlive()).as("actual owned fixture process exit acknowledged").isFalse();
    assertThat(descendants.stream().anyMatch(ProcessHandle::isAlive))
        .as("actual owned fixture descendant exits acknowledged")
        .isFalse();
  }

  void stop() throws Exception {
    retryRelease.countDown();
    var failures = new java.util.ArrayList<Throwable>();
    ownedApplicationQuiescent = false;
    try {
      p3AttemptTeardown(failures, this::stopOwnedApplicationJobs);
      int processFailuresBefore = failures.size();
      for (Process process : new Process[] {guidedWorker, ordinaryWorker, SECRET_FIXTURE}) {
        p3AttemptTeardown(failures, () -> stopOwnedProcessTree(process));
      }
      boolean processesQuiescent = failures.size() == processFailuresBefore;
      if (ownedApplicationQuiescent && processesQuiescent) {
        p3AttemptTeardown(failures, () -> PROVIDER.stop(0));
        p3AttemptTeardown(failures, () -> APP.stop(0));
        p3AttemptTeardown(failures, DB::stop);
      } else {
        failures.add(
            new IllegalStateException(
                "Endpoints/PostgreSQL retained because actual owned dependencies remain unconfirmed"));
      }
      throwTeardownFailures(failures);
    } finally {
      SSLContext.setDefault(PREVIOUS_TLS);
    }
  }
}
