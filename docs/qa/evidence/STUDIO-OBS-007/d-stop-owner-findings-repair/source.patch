+  private static void joinUninterruptibly(Thread ownedThread) {
+    if (ownedThread == null) {
+      return;
+    }
+    boolean interrupted = Thread.interrupted();
+    try {
+      while (ownedThread.isAlive()) {
+        try {
+          ownedThread.join();
+        } catch (InterruptedException interruption) {
+          interrupted = true;
+        }
+      }
+    } finally {
+      if (interrupted) {
+        Thread.currentThread().interrupt();
+      }
+    }
+  }
