{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json",
  "title": "Observed v3 exercised-plan candidate",
  "description": "Contract for exact exercised metadata and initial-context precondition. It does not implement lowering, publication or replay readiness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialContext": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "initialBlank"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observedDocument"
            },
            "origin": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "origin"
          ]
        }
      ]
    },
    "sourceSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "versions": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/blankAction"
          },
          {
            "$ref": "#/definitions/observedAction"
          }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/binding.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "authoredInputsHash",
    "initialContext",
    "sourceSteps",
    "versions",
    "actions",
    "bindings"
  ],
  "definitions": {
    "blankAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stepId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "ordinal": {
              "const": 0
            }
          },
          "required": [
            "stepId",
            "ordinal"
          ]
        },
        "origin": {
          "type": "null"
        },
        "locator": {
          "type": "null"
        },
        "operation": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/operation/oneOf/4"
        },
        "admissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "coordinate",
        "origin",
        "locator",
        "operation",
        "admissionId",
        "operationHash"
      ]
    },
    "observedAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
          "maxLength": 256
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/target/oneOf/0/properties/locator"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/operation"
        },
        "admissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "coordinate",
        "origin",
        "locator",
        "operation",
        "admissionId",
        "operationHash"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "fill"
                  },
                  "value": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "secretRef"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "value"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "locator": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "initialContext": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "initialBlank"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "actions": {
            "type": "array",
            "contains": {
              "$ref": "#/definitions/blankAction"
            }
          }
        }
      },
      "else": {
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/observedAction"
            }
          }
        }
      }
    }
  ]
}
