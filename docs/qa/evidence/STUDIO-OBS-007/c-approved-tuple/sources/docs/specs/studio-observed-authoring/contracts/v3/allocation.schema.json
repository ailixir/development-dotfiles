{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/allocation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "needId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producerStepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "argumentSlot": {
            "enum": [
              "fill.value",
              "selectOption.value",
              "assert.expected"
            ]
          }
        },
        "required": [
          "stepId",
          "argumentSlot"
        ]
      }
    }
  },
  "required": [
    "bindingId",
    "needId",
    "producerStepId",
    "consumers"
  ]
}
