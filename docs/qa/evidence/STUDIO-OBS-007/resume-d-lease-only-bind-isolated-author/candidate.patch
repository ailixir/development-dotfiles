+      repository.saveRenewalAndCommand(current, "lease-drift-invalid-final", "digest", bound);
+      return null;
+    })).hasMessage("INVALID_CONTRACT");
+    assertThat(persistedDocument(id).equals(beforeInvalid)).isTrue();
+    assertThat(jdbc.queryForObject(
+        "SELECT count(*) FROM studio_guided_commands WHERE namespace=?"
