+  @Test
+  void completedPublicRenewalLeaseDriftBindsWithoutMutatingEitherInputAndStillWritesFreshOwner() {
+    String id = observing();
+    ObjectNode original = (ObjectNode) persistedDocument(id);
+    String originalRepresentation = original.toString();
+    var proof = contracts.prepareRenewalValidation(original);
+    assertThat(proof).isNotNull();
+    clock.now = clock.now.plusSeconds(1);
+    JsonNode renewed = service.claim(worker, id, "intervening-real-renewal", claim(id, "worker-1", 1));
+    assertThat(renewed.path("owner").path("leaseExpiresAt")
+        .equals(original.path("owner").path("leaseExpiresAt"))).isFalse();
+    assertThat(original.toString().equals(originalRepresentation)).isTrue();
+    repository.transaction(() -> {
+      var current = repository.lock(id);
+      String beforeBind = current.document().toString();
+      var bound = contracts.bindRenewalValidation(proof, current.document());
+      assertThat(bound).isNotNull();
+      assertThat(current.document().toString().equals(beforeBind)).isTrue();
+      assertThat(original.toString().equals(originalRepresentation)).isTrue();
+      assertThat(contracts.validateRenewalOwner(bound, current.document().deepCopy())).isFalse();
+      current.document().withObject("/owner").put("leaseExpiresAt",
+          clock.instant().plusSeconds(30).toString());
+      repository.saveRenewalAndCommand(current, "lease-drift-bound-renewal", "digest", bound);
+      return null;
+    });
+    assertThat(persistedDocument(id).path("owner").path("leaseExpiresAt").asText())
+        .isEqualTo(clock.instant().plusSeconds(30).toString());
+    JsonNode beforeInvalid = persistedDocument(id);
