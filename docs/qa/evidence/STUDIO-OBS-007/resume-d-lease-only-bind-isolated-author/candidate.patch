+    assertThat(freshProof).isNotNull();
+    assertThatThrownBy(() -> repository.transaction(() -> {
+      var current = repository.lock(id);
+      var bound = contracts.bindRenewalValidation(freshProof, current.document());
+      assertThat(bound).isNotNull();
