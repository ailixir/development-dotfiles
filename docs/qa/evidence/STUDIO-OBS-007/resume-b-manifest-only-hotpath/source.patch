+  @Test
+  void currentAuthorizationPreservesScopedReferenceOrderDuplicatesAndRevocation() throws Exception {
+    var fixture = new DelayedFixture(false, List.of("PASS", "SECOND", "PASS"));
+    var calls = new java.util.ArrayList<List<String>>();
+    var revoked = new java.util.concurrent.atomic.AtomicBoolean();
+    var access = currentAccess((principal, csi, environment, secret) -> {
+      calls.add(List.of(principal, csi, environment, secret));
+      return !revoked.get() && principal.equals("delayed-owner@citi.com")
+          && csi.equals("60457") && environment.equals("Production");
+    });
+    delayedDb.tx.executeWithoutResult(tx -> access.checkCurrent(delayedDb.sessions.lock(fixture.id).document()));
+    assertThat(calls).containsExactly(
+        List.of("delayed-owner@citi.com", "60457", "Production", "PASS"),
+        List.of("delayed-owner@citi.com", "60457", "Production", "SECOND"),
+        List.of("delayed-owner@citi.com", "60457", "Production", "PASS"));
+    calls.clear();
+    revoked.set(true);
+    assertThatThrownBy(() -> delayedDb.tx.executeWithoutResult(tx ->
+        access.checkCurrent(delayedDb.sessions.lock(fixture.id).document())))
+        .hasMessage("SECRET_USE_REVOKED");
+    assertThat(calls).containsExactly(List.of("delayed-owner@citi.com", "60457", "Production", "PASS"));
+    calls.clear();
+    revoked.set(false);
+    delayedDb.tx.executeWithoutResult(tx -> {
+      ObjectNode wrongScope = delayedDb.sessions.lock(fixture.id).document().deepCopy();
+      wrongScope.withObject("/scope").put("csiId", "OTHER-CSI");
+      assertThatThrownBy(() -> access.checkCurrent(wrongScope)).hasMessage("SECRET_USE_REVOKED");
+    });
+    assertThat(calls).containsExactly(List.of("delayed-owner@citi.com", "OTHER-CSI", "Production", "PASS"));
+  }
