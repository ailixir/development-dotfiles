+  private UUID p14CreateSource(P14Recipe recipe) throws Exception {
+    List<String> texts = recipe == P14Recipe.CONTROL_VALUE
+        ? List.of("Open " + URL + ".", "Read Field value.",
+            "Enter captured Field value in Destination, click Submit and check Confirmation.")
+        : List.of("Open " + URL + ".", "Check Field value equals <var EXPECTED>.",
+            "Check Complete heading remains visible.");
+    var authoring = new AuthoringV2Request(2, null, List.of(
+        new AuthoringStep(UUID.fromString(ONE), texts.get(0), null),
+        new AuthoringStep(UUID.fromString(TWO), texts.get(1), null),
+        new AuthoringStep(UUID.fromString(THREE), texts.get(2), null)));
+    UUID test = UUID.randomUUID();
+    String variables = recipe == P14Recipe.HAS_VALUE
+        ? JSON.createArrayNode().add(C.object().put("name", "EXPECTED").put("kind", "plain")
+            .put("value", p14Expected)).toString() : "[]";
+    jdbc.update("INSERT INTO ui_tests(id,name,csi_id,environment,browser,steps,variables,authoring,"
+        + "authoring_revision_inputs,created_by,created_at,updated_at)"
+        + " VALUES (?,'C14 controlled Field','CSI-123','fixture','chromium',?::jsonb,?::jsonb,"
+        + "?::jsonb,?::jsonb,'fixture@example.invalid',now(),now())", test,
+        JSON.writeValueAsString(texts), variables, JSON.writeValueAsString(authoring),
+        JSON.writeValueAsString(AuthoringRevisionIdentity.create(authoring, Map.of())));
+    return test;
+  }
