+  private static void p14PasswordObservation(JsonNode observation) {
+    assertThat(observation.path("coverage").path("passwordControls").asInt(-1)).isEqualTo(1);
+    assertThat(observation.path("coverage").path("complete").asBoolean()).isTrue();
+    assertThat(java.util.stream.StreamSupport.stream(observation.path("nodes").spliterator(), false)
+        .anyMatch(node -> node.path("name").asText().equals("Field"))).isFalse();
+    assertThat(com.citi.put.checks.studio.guided.translation.LoginRequiredSignature.matches(observation))
+        .isFalse();
+  }
