+  private void p14Run(P14Recipe recipe, boolean published, C5Capture capture) throws Exception {
+    UUID test = p14CreateSource(recipe);
+    VaultScope scope = VaultScope.of("CSI-123", "fixture", test);
+    int reads = COUNTED_VAULT.reads.size();
+    capture.armTrace();
+    String session = p3Start(test, "fixture");
+    capture.selectedGuidedSession = session;
+    if (!published) {
+      awaitState(session, "FAILED");
+      JsonNode result = p3Call(p3Cookie,
+          "/api/v3/studio/guided-sessions/" + session + "/result", null, 200);
+      assertThat(result.path("failure").path("code").asText())
+          .isEqualTo("RUNTIME_INCOMPATIBLE");
+      JsonNode observation = sessions.transaction(
+          () -> sessions.lock(session).progress().path("observation").deepCopy());
+      p14PasswordObservation(observation);
+      assertThat(P3_INVOCATIONS.stream().anyMatch(kind -> kind.equals("read") || kind.equals("assert")))
+          .as("no successful requested password operation; pre-admission guard is distinct")
+          .isFalse();
+      assertThat(jdbc.queryForObject(
+          "SELECT count(*) FROM studio_guided_actions WHERE session_id=?"
+              + " AND step_id IN (?,?) AND admission_id IS NOT NULL",
+          Long.class, session, TWO, THREE)).isZero();
+      p3AwaitTeardown(session);
+      p3WriteEvidence("c14-guided-" + recipe.ordinal(), C.object()
+          .put("operator", recipe.ordinal()).put("path", 1)
+          .put("signatureFalse", true).put("passwordControls", 1)
+          .put("groundingGuardRuntimeIncompatible", true)
+          .put("requestedPasswordOperations", 0).put("vaultValueReads", 0));
+    } else {
+      awaitFinalizing(session);
+      // A successful actual TEXT read/consumer or assertion is mandatory BEFORE mutation.
+      assertThat(P3_INVOCATIONS.contains(recipe == P14Recipe.CONTROL_VALUE ? "read" : "assert"))
+          .isTrue();
+      if (recipe == P14Recipe.CONTROL_VALUE) {
+        assertThat(P3_INVOCATIONS.contains("fill") && P3_INVOCATIONS.contains("click")).isTrue();
+      }
+      P3Publication publication = p3Publish(session);
+      int models = MODEL_WIRE.size();
+      p14Page = P14Page.PASSWORD;
+      UUID passwordRun = p14Ordinary(test, scope, publication, capture, "TARGET_DRIFT", "ERROR");
+      assertThat(MODEL_WIRE.size()).isEqualTo(models);
+      p3WriteEvidence("c14-published-" + recipe.ordinal(), C.object()
+          .put("operator", recipe.ordinal()).put("path", 2)
+          .put("authenticTextPublication", true).put("actualSameHintPasswordMutation", true)
+          .put("firstGuardTargetDrift", true).put("requestedPasswordOperations", 0)
+          .put("vaultValueReads", 0).put("ordinaryModelCalls", 0));
+      // Close the genuine password-refusal owner BEFORE reusing the same immutable publication.
+      p3CleanupOrdinary(passwordRun, p3Cookie, System.nanoTime() + Duration.ofSeconds(60).toNanos());
+      if (recipe == P14Recipe.HAS_VALUE) {
+        p14Page = P14Page.TEXT_CANARY;
+        UUID textRun = p14Ordinary(test, scope, publication, capture, "ASSERTION_FAILED", "FAILED");
+        assertThat(MODEL_WIRE.size()).isEqualTo(models);
+        p3CleanupOrdinary(textRun, p3Cookie, System.nanoTime() + Duration.ofSeconds(60).toNanos());
+        p3WriteEvidence("c14-text-canary", C.object()
+            .put("operator", recipe.ordinal()).put("path", 2)
+            .put("sameAuthenticHasValuePublication", true).put("actualTextAssertionFalse", true)
+            .put("firstGuardAssertionFailed", true).put("vaultValueReads", 0)
+            .put("ordinaryModelCalls", 0).put("separateVaultSecretCredit", false));
+      }
+    }
+    assertThat(COUNTED_VAULT.reads.size()).isEqualTo(reads);
+    assertThat(jdbc.queryForObject("SELECT count(*) FROM studio_secret_use_audit WHERE test_id=?",
+        Long.class, test)).isZero();
+    p3Scan(List.of(p14Canary));
+  }
