+  private static String p14Markup() {
+    boolean password = p14Page == P14Page.PASSWORD;
+    String actual = p14Page == P14Page.TEXT_MATCH ? p14Expected : p14Canary;
+    String consumer = p14Recipe == P14Recipe.CONTROL_VALUE && !password
+        ? "<label for='destination'>Destination</label><textarea id='destination'></textarea>"
+            + "<output id='done' aria-label='Confirmation' hidden>Submitted</output>"
+            + "<button id='submit'>Submit</button><script>document.getElementById('submit').onclick=()=>{"
+            + "document.getElementById('done').hidden=false;fetch('/receipt',{method:'POST',"
+            + "body:document.getElementById('destination').value});};</script>" : "";
+    return "<!doctype html><html><head><title>Operations</title></head><body>"
+        + "<main aria-label='Operations'><input aria-label='Field' type='"
+        + (password ? "password" : "text") + "' value='" + actual
+        + "'><h1>Complete</h1>" + consumer + "</main></body></html>";
+  }
