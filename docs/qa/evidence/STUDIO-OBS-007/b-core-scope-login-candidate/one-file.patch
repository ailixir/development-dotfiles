+  private void p3Scan(List<String> values) throws Exception {
+    var sinks = new java.util.LinkedHashMap<String, byte[]>();
+    collectJoinedSinks(sinks);
+    sinks.put("p3-actual-final-callbacks", P3_FINAL_REPORTS.values().stream().map(JsonNode::toString)
+        .collect(java.util.stream.Collectors.joining("\n")).getBytes(StandardCharsets.UTF_8));
+    for (String value : values) {
+      assertJoinedSinkAbsent(sinks, value);
+      assertThat(COUNTED_VAULT.reads.stream().filter(read -> read.value != null).allMatch(read -> allErased(read.value))).isTrue();
+    }
+  }
