+  private void p3AssertAuditScope(String session, UUID execution, VaultScope scope) throws Exception {
+    List<Map<String, Object>> rows;
+    String principal;
+    if (session != null) {
+      principal = sessions.transaction(() -> sessions.lock(session).document().path("scope").path("principalId").asText());
+      rows = jdbc.queryForList("SELECT principal_id,csi_id,environment,test_id,secret_id FROM studio_secret_use_audit WHERE session_id=?", session);
+    } else {
+      principal = observedBinding(execution).path("principalId").asText();
+      rows = jdbc.queryForList("SELECT principal_id,csi_id,environment,test_id,secret_id FROM studio_secret_use_audit WHERE execution_id=?", execution);
+    }
+    assertThat(rows.size()).isGreaterThanOrEqualTo(2);
+    for (var row : rows) {
+      assertThat(String.valueOf(row.get("principal_id")).equals(principal)).isTrue();
+      assertThat(String.valueOf(row.get("csi_id")).equals(scope.csiId())).isTrue();
+      assertThat(String.valueOf(row.get("environment")).equals(scope.environment())).isTrue();
+      assertThat(String.valueOf(row.get("test_id")).equals(scope.testId())).isTrue();
+      assertThat(String.valueOf(row.get("secret_id")).equals("PASS")).isTrue();
+    }
+    assertThat(COUNTED_VAULT.readCount(StudioVaultProvider.ReferenceKind.VARIABLE, scope, "USER")).isZero();
+  }
