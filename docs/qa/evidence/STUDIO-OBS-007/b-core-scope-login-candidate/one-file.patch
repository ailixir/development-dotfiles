+  private JsonNode p3RunnerReport(UUID execution) throws Exception {
+    long deadline = System.nanoTime() + Duration.ofSeconds(5).toNanos();
+    JsonNode report = P3_FINAL_REPORTS.get(execution);
+    while (report == null && System.nanoTime() < deadline) {
+      Thread.sleep(20);
+      report = P3_FINAL_REPORTS.get(execution);
+    }
+    assertThat(report != null).as("actual authenticated P3 FINAL was observed by the forwarding filter").isTrue();
+    assertThat(report.path("executionId").asText().equals(execution.toString())).isTrue();
+    var ledger = jdbc.queryForMap("SELECT attempt_id,admission_id,runner_instance_id,last_runner_sequence"
+        + " FROM studio_dispatch_ledger WHERE execution_id=?", execution);
+    assertThat(report.path("attemptId").asText().equals(String.valueOf(ledger.get("attempt_id")))).isTrue();
+    assertThat(report.path("admissionId").asText().equals(String.valueOf(ledger.get("admission_id")))).isTrue();
+    assertThat(report.path("runnerInstanceId").asText().equals(String.valueOf(ledger.get("runner_instance_id")))).isTrue();
+    assertThat(report.path("runnerSequence").asLong()).isEqualTo(((Number) ledger.get("last_runner_sequence")).longValue());
+    return report;
+  }
