+  private void p3Case(P3Action operation) throws Exception {
+    Throwable primary = null;
+    p3Cookie = p3CoreCookie("user-1", "fixture@example.invalid");
+    P3_RECEIPTS.clear();
+    P3_NATIVE_SESSIONS.clear();
+    P3_REPORT_REQUESTS.set(0);
+    p3ReportsProtected = false;
+    p3ExpectedPassword = "P3-EXPECTED-" + UUID.randomUUID();
+    jdbc.update("INSERT INTO users(id,sso_id,name,email,created_at) VALUES"
+        + " (?,'user-1','Fixture','fixture@example.invalid',now()) ON CONFLICT DO NOTHING", UUID.randomUUID());
+    for (String csi : List.of("CSI-123", "CSI-456")) {
+      jdbc.update("INSERT INTO csi_systems(id,name,business_unit,criticality,owner_email,environment)"
+          + " VALUES (?, 'Orders','Ops','HIGH','fixture@example.invalid','Production') ON CONFLICT DO NOTHING", csi);
+    }
+    try {
+      if (guidedWorker == null || ordinaryWorker == null) {
+        startWorkers();
+      }
+      operation.run();
+    } catch (Exception | AssertionError failure) {
+      primary = failure;
+      throw failure;
+    } finally {
+      try {
+        for (String id : testOwnedSessions.keySet()) {
+          String state = sessions.transaction(() -> sessions.lock(id).document().path("state").asText());
+          if (!List.of("SUCCEEDED", "PUBLICATION_CONFLICT", "FAILED", "UNKNOWN_OUTCOME", "CANCELLED", "EXPIRED").contains(state)) {
+            p3Call(p3Cookie, "/api/v3/studio/guided-sessions/" + id + "/cancel",
+                C.object().put("schemaVersion", 3).put("reason", "userRequested"), 202);
+          }
+          p3AwaitTeardown(id);
+        }
+      } catch (Exception | AssertionError cleanup) {
+        if (primary != null) {
+          primary.addSuppressed(cleanup);
+        } else {
+          throw cleanup;
+        }
+      } finally {
+        p3Mode = null;
+        p3ExpectedPassword = null;
+        p3ReportsProtected = false;
+        P3_FAIL_READ.set(null);
+        P3_CORE.clear();
+        P3_PERMITTED.clear();
+        P3_NATIVE_SESSIONS.clear();
+        P3_RECEIPTS.clear();
+      }
+    }
+  }
