+  private UUID p3CreateSource(String csi, String environment, boolean password) throws Exception {
+    String destination = ORIGIN + (p3Mode == P3Mode.LOGIN ? "/p3/login" : p3Mode == P3Mode.REPORTS ? "/p3/reports" : "/p3/registration");
+    List<String> texts = password ? List.of("Open " + destination + ".",
+        "Enter <var USER> in User and <secret PASS> as password.",
+        "Click Sign in, click the Reports link and check protected Reports heading.")
+        : List.of("Open " + destination + ".", "Check " + (p3Mode == P3Mode.REGISTRATION ? "Registration" : "Reports") + " heading.",
+            "Check " + (p3Mode == P3Mode.REGISTRATION ? "Registration" : "Reports") + " heading remains visible.");
+    UUID test = UUID.randomUUID();
+    var authoring = new AuthoringV2Request(2, null, List.of(new AuthoringStep(UUID.fromString(ONE), texts.get(0), null),
+        new AuthoringStep(UUID.fromString(TWO), texts.get(1), null), new AuthoringStep(UUID.fromString(THREE), texts.get(2), null)));
+    String variables = password ? "[{\"name\":\"USER\",\"kind\":\"plain\",\"value\":\"p3-user\"},{\"name\":\"PASS\",\"kind\":\"secretRef\"}]" : "[]";
+    jdbc.update("INSERT INTO ui_tests(id,name,csi_id,environment,browser,steps,variables,authoring,authoring_revision_inputs,created_by,created_at,updated_at)"
+        + " VALUES (?,'P3 controlled join',?,?,'chromium',?::jsonb,?::jsonb,?::jsonb,?::jsonb,'fixture@example.invalid',now(),now())",
+        test, csi, environment, JSON.writeValueAsString(texts), variables, JSON.writeValueAsString(authoring),
+        JSON.writeValueAsString(AuthoringRevisionIdentity.create(authoring, Map.of())));
+    return test;
+  }
