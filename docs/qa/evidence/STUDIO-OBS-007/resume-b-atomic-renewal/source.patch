+  @Test
+  void atomicRenewalUniqueCommandConflictRollsBackOwnerUpdate() {
+    String id = observing();
+    ObjectNode request = claim(id, "worker-1", 1);
+    service.claim(worker, id, "conflicting-renew", request);
+    JsonNode before = repository.transaction(() -> repository.lock(id).document().deepCopy());
+    JsonNode beforeProgress = persistedProgress(id);
+    clock.now = clock.now.plusSeconds(5);
+    assertThatThrownBy(() -> repository.transaction(() -> {
+      var session = repository.lock(id);
+      session.document().withObject("/owner").put("leaseExpiresAt", clock.now.plusSeconds(30).toString());
+      repository.saveRenewalAndCommand(session, "conflicting-renew", GuidedContracts.hash(request));
+      return null;
+    })).isInstanceOf(org.springframework.dao.DuplicateKeyException.class);
+    assertThat(persistedDocument(id)).isEqualTo(before);
+    assertThat(persistedProgress(id)).isEqualTo(beforeProgress);
+    assertThat(jdbc.queryForObject("SELECT count(*) FROM studio_guided_commands"
+        + " WHERE namespace=? AND route='claim' AND idempotency_key=?", Integer.class, id, "conflicting-renew"))
+        .isEqualTo(1);
+    assertThat(contracts.parse(jdbc.queryForObject("SELECT response::text FROM studio_guided_commands"
+        + " WHERE namespace=? AND route='claim' AND idempotency_key=?", String.class, id, "conflicting-renew")))
+        .isEqualTo(before);
+  }
