+    var cancelled = new CountedSubscription();
+    over.onSubscribe(cancelled);
+    over.onNext(List.of(ByteBuffer.wrap(new byte[REFUSAL_LIMIT])));
+    ByteBuffer excess = ByteBuffer.wrap(new byte[] {62});
+    over.onNext(List.of(excess));
