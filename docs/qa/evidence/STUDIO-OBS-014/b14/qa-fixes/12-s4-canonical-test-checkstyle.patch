+  /** The normative canonical-v1 form of one C0 control as a JSON string. */
+  private static String normative(int c) {
+    return switch (c) {
+      case 0x08 -> "\"\\b\"";
+      case 0x09 -> "\"\\t\"";
+      case 0x0A -> "\"\\n\"";
+      case 0x0C -> "\"\\f\"";
+      case 0x0D -> "\"\\r\"";
+      default -> "\"" + String.format(Locale.ROOT, "\\u%04x", c) + "\"";
+    };
+  }
+
