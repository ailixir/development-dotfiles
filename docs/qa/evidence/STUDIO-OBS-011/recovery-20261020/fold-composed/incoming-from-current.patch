+  private GuidedSessionService manualFallback() {
+    var manual = new GuidedSessionService(repository, contracts, access, sessionProperties,
+        Clock.systemUTC());
+    manual.installPresentation(presentation);
+    manual.installEvidence(evidence);
+    return manual;
+  }
