+    @Override
+    public synchronized void onSubscribe(java.util.concurrent.Flow.Subscription next) {
+      subscription = next;
+      if (closed || !accepted) {
+        next.cancel();
+        body.completeExceptionally(new java.io.IOException("Guided response refused"));
