+    verify(bases, times(1)).find(id);
+    state("PREPARING");
+    clearInvocations(bases);
+    sessions.read(owner, id, "result");
+    verify(bases, never()).find(id);
+    state("FINALIZING");
+    clearInvocations(bases);
+    sessions.read(owner, id, "result");
+    verify(bases, never()).find(id);
+  }
