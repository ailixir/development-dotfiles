+        .pollInterval(Duration.ofMillis(20)).until(
+            () -> executor.getActiveCount() == 0 && executor.getQueue().isEmpty());
+    service.redriveTeardowns(WINDOW, BATCH);
+    service.redriveTeardowns(WINDOW, BATCH);
+    await().alias("next tick acknowledges the original durable request").atMost(Duration.ofSeconds(5))
+        .pollInterval(Duration.ofMillis(20)).untilAsserted(() -> {
+          assertThat(sends).hasValue(1);
+          assertThat(durable.get().progress().path("teardownStatus").asText()).isEqualTo("CONFIRMED");
+          assertThat(durable.get().progress().has("teardownRequest")).isFalse();
+          assertThat(service.teardownInFlight(id)).isFalse();
+        });
+    assertThat(warnings()).hasSize(2);
+    assertThat(durable.get().document()).isEqualTo(document);
+  }
+
+  @Test
+  void anIdAlreadyQueuedOrInFlightIsNeverSubmittedTwice() throws Exception {
+    blockWorker();
+    service.installStopSender((target, reason) -> {
+      sends.incrementAndGet();
+      blockUntil(releaseSender);
+    });
+    service.redriveTeardowns(WINDOW, BATCH);
+    assertThat(executor.getQueue()).hasSize(1);
+    service.redriveTeardowns(WINDOW, BATCH);
+    assertThat(executor.getQueue()).hasSize(1);
+    assertThat(warnings()).isEmpty();
+    assertThat(durable.get().progress().path("teardownStatus").asText()).isEqualTo("PENDING");
+
+    releaseWorker.countDown();
+    await().alias("one queued teardown starts").atMost(Duration.ofSeconds(5))
+        .pollInterval(Duration.ofMillis(20)).until(() -> service.teardownInFlight(id) && sends.get() == 1);
+    service.redriveTeardowns(WINDOW, BATCH);
+    assertThat(executor.getQueue()).isEmpty();
+    assertThat(sends).hasValue(1);
+    assertThat(durable.get().progress().path("teardownStatus").asText()).isEqualTo("PENDING");
+    releaseSender.countDown();
+    await().alias("one acknowledged attempt completes").atMost(Duration.ofSeconds(5))
+        .pollInterval(Duration.ofMillis(20)).untilAsserted(() -> {
+          assertThat(durable.get().progress().path("teardownStatus").asText()).isEqualTo("CONFIRMED");
+          assertThat(service.teardownInFlight(id)).isFalse();
+        });
+    service.redriveTeardowns(WINDOW, BATCH);
+    assertThat(sends).hasValue(1);
+    assertThat(warnings()).isEmpty();
+  }
+
+  private void blockWorker() throws InterruptedException {
+    executor.execute(() -> {
+      workerBlocked.countDown();
+      blockUntil(releaseWorker);
+    });
+    assertThat(workerBlocked.await(5, TimeUnit.SECONDS)).isTrue();
+  }
+
+  private static void blockUntil(CountDownLatch latch) {
+    try {
+      if (!latch.await(10, TimeUnit.SECONDS)) {
+        throw new IllegalStateException("Test did not release its owned executor");
+      }
+    } catch (InterruptedException interrupted) {
+      Thread.currentThread().interrupt();
+      throw new IllegalStateException(interrupted);
+    }
+  }
+
+  private List<String> warnings() {
+    return log.list.stream().filter(event -> event.getLevel().equals(Level.WARN))
+        .map(ILoggingEvent::getFormattedMessage).toList();
+  }
+
+  private static final class MutableClock extends Clock {
+    private Instant now = Instant.parse("2026-10-18T00:00:00Z");
+
+    void advance(Duration duration) {
+      now = now.plus(duration);
+    }
+
+    @Override
+    public ZoneId getZone() {
+      return ZoneOffset.UTC;
+    }
+
+    @Override
+    public Clock withZone(ZoneId zone) {
+      return this;
+    }
+
+    @Override
+    public Instant instant() {
+      return now;
+    }
+  }
+}
