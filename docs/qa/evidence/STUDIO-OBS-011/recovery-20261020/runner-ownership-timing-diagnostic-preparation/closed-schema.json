{
  "kind": "CLOSED_DIAGNOSTIC_METADATA_ALLOWLIST_NO_PRODUCT_API",
  "maxRecords": 64,
  "topLevel": [
    "schemaVersion",
    "selectedCaseWasLostBodyLateGrant",
    "capacity",
    "overflow",
    "instrumentationFailed",
    "originalCleanupComplete",
    "mocksRestored",
    "records"
  ],
  "perRecord": [
    "event",
    "monoMs",
    "wallMs",
    "observerEndMonoMs",
    "fields"
  ],
  "eventFields": {
    "schedule-enter": [
      "nextRenewalWallMs",
      "secretContext"
    ],
    "schedule-return": [
      "nextRenewalWallMs",
      "secretContext"
    ],
    "request-claim-enter": [
      "initial",
      "nextRenewalWallMs",
      "secretContext"
    ],
    "request-claim-sync-return": [
      "initial"
    ],
    "grant-validated": [
      "initial",
      "stopped"
    ],
    "invalidate-enter": [
      "stopped"
    ],
    "invalidate-return": [
      "stopped"
    ],
    "stop-entry": [
      "reason",
      "alreadyStopped"
    ],
    "runtime-stop-enter": [
      "reason",
      "stopped"
    ],
    "runtime-post-stop-observer": [
      "reason",
      "stopped",
      "observedMonoMs",
      "observedWallMs"
    ],
    "claim-port-enter": [
      "timeoutMs",
      "aborted"
    ],
    "claim-abort-event": [
      "timeoutMs",
      "aborted"
    ],
    "complete-ack": [
      "lastAckT0MonoMs",
      "focusSeen"
    ],
    "claim-rejected": [
      "timeoutMs"
    ]
  },
  "numericOrBooleanOrNullFieldsOnlyExceptReason": true,
  "reasonEnum": [
    "CANCELLED",
    "EXPIRED",
    "UNKNOWN_OUTCOME",
    "LEASE_LOST",
    "CONTEXT_LOST",
    "REVOKED"
  ],
  "pairedSamples": "monoMs=performance.now then wallMs=Date.now, observation only; never used by an original decision",
  "overhead": "observerEndMonoMs-monoMs measures sink body after argument construction; it is not total wrapper/getter/mock/listener overhead or a correction to original cutoff",
  "incompleteIf": [
    "overflow",
    "instrumentationFailed",
    "missing closed output or required boundary events",
    "original cleanup incomplete or mocks not restored",
    "wrong case selection/discovery",
    "any nonallowlisted field/type or nonfinite number",
    "setup/import/fixture failure preventing relevant boundaries"
  ],
  "neverExport": [
    "payloads",
    "IDs",
    "scope/session/fence/key fields",
    "messages",
    "paths",
    "canaries",
    "captures",
    "native DOM/pixels/video",
    "errors or stack bodies"
  ],
  "recordedValuesNeverInfluenceControl": true
}
