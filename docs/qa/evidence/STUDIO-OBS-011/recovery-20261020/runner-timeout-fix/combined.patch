+      clear();
+      if (signal?.aborted) reject(new Error('CANCELLED'));
+      else if (Date.now() >= deadline) reject(absoluteStartupTimeout(new Error('TIMEOUT'), deadline));
+      else resolve(value);
+    }, (error: unknown) => {
+      clear();
+      reject(error instanceof Error ? error : new Error('BOOTSTRAP_FAILED'));
+    });
