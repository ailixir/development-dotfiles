    "correctedSQLTierSource": "                // J8 SQL tier: immutable expiry UPDATE is refused before any writer call.\n                // The original probe also stopped here; this is not Java expiry-branch proof.\n                assertThatThrownBy(\n                        () ->\n                            db.tx.executeWithoutResult(\n                                t -> {\n                                  t.setRollbackOnly();\n                                  db.jdbc.update(\n                                      \"UPDATE studio_guided_sessions SET expires_at='2000-01-01',\"\n                                          + \"document=jsonb_set(document,'{expiresAt}',\"\n                                          + \"'\\\"2000-01-01T00:00:00Z\\\"') WHERE session_id=?\",\n                                      command.sessionId());\n                                }))\n                    .as(\"J8 SQL immutable-expiry guard rejects the UPDATE before commit\")\n                    .isInstanceOf(org.springframework.dao.DataAccessException.class)\n                    .hasMessageContaining(\"guided identity is immutable\")\n                    .satisfies(\n                        error -> {\n                          Throwable cause =\n                              ((org.springframework.dao.DataAccessException) error)\n                                  .getMostSpecificCause();\n                          assertThat(cause).isInstanceOf(org.postgresql.util.PSQLException.class);\n                          var sql = (org.postgresql.util.PSQLException) cause;\n                          assertThat(sql.getSQLState()).isEqualTo(\"P0001\");\n                          assertThat(sql.getServerErrorMessage()).isNotNull();\n                          assertThat(sql.getServerErrorMessage().getMessage())\n                              .isEqualTo(\"guided identity is immutable\");\n                        });\n                assertThat(commandRows(db.jdbc, command))\n                    .as(\"J8 SQL expiry mutation rolls back every authority row\")\n                    .isEqualTo(before);\n",
