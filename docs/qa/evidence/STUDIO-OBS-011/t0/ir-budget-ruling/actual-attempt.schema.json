{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IT-R actual full-class attempt receipt index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actualOrdinal",
    "label",
    "classification",
    "command",
    "sourceSha256",
    "startedAtUtc",
    "endedAtUtc",
    "collectorReceipt",
    "collectorReceiptSha256",
    "nativeExit",
    "collectorExit",
    "rawValidationSucceeded",
    "rawTaskCollectionComplete",
    "outcomeClass",
    "proofDisposition",
    "ownedProcessTerminalReceipt",
    "restoredSha256",
    "restoreCompilationReceipt",
    "remainingFullClassSlots",
    "applyDeadlineUtc",
    "rootAuthorizationRef",
    "quinnDispositionRef",
    "paxDispositionRef"
  ],
  "properties": {
    "actualOrdinal": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "const": "FULL_CLASS"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "startedAtUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "endedAtUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "collectorReceipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "collectorReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nativeExit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "collectorExit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rawValidationSucceeded": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rawTaskCollectionComplete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "outcomeClass": {
      "enum": [
        "CANONICAL_FULL_CLASS_GREEN",
        "NAMED_GATE_EVIDENCE_REJECTION",
        "EXPECTED_NATIVE_AUDIT_ASSERTION_RED",
        "UNEXPECTED_FAILURE",
        "INTERRUPTED",
        "SETUP_OR_COMPILE_ERROR",
        "INCOMPLETE_OBSERVATION"
      ]
    },
    "proofDisposition": {
      "enum": [
        "ACCEPTED_BY_INDEPENDENT_QUINN",
        "REJECTED",
        "PENDING"
      ]
    },
    "ownedProcessTerminalReceipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "restoredSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "restoreCompilationReceipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "remainingFullClassSlots": {
      "type": "integer",
      "minimum": 0
    },
    "applyDeadlineUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootAuthorizationRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "quinnDispositionRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "paxDispositionRef": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
