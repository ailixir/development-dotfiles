+      if (available.isNegative() || available.isZero()) {
+        throw new GuidedSessionException("UNKNOWN_OUTCOME", 409);
+      }
+      if (available.compareTo(Duration.ofSeconds(15)) < 0) {
+        nanos = available.toNanos();
+      }
