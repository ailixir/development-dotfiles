+        invocation -> "PENDING".equals(durable.get().progress().path("teardownStatus").asText())
+            ? List.of(id) : List.of());
+    when(repository.teardownRequest(id)).thenAnswer(
+        invocation -> durable.get().progress().path("teardownRequest").deepCopy());
+    when(repository.lock(id)).thenAnswer(
+        invocation -> new GuidedSessionRepository.Session(
+            durable.get().document().deepCopy(), durable.get().progress().deepCopy()));
+    doAnswer(invocation -> {
