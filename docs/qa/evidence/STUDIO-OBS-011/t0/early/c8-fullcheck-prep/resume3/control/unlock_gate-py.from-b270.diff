+def loaded_metadata_unchanged(loaded_hashes,read_bytes):
+    return all(digest(read_bytes(path))==expected for path,expected in loaded_hashes.items())
+
+def task_reducer(assessor_source,expected_sha):
+    need(isinstance(assessor_source,bytes) and digest(assessor_source)==expected_sha==REDUCER_ASSESSOR_SHA,'TASK_REDUCER_CODE_HASH')
+    tree=ast.parse(assessor_source.decode('utf-8'))
+    names={'task_event_proof','task_statuses'}
+    nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names]
+    need(len(nodes)==2 and {n.name for n in nodes}==names,'TASK_REDUCER_EXPORTS')
+    namespace={'re':re}
+    exec(compile(ast.Module(body=nodes,type_ignores=[]),'<pinned-task-reducer-only>','exec'),namespace)
+    return namespace
+
+def load_pure_execution(checks_source,inventory_source,expected_checks_sha,expected_inventory_sha):
+    """Fixed pair only: no sys.path, PYTHONPATH or global report_inventory cache lookup."""
+    need(isinstance(checks_source,bytes) and digest(checks_source)==expected_checks_sha==EXECUTION_CHECKS_SHA,'EXECUTION_CHECKS_CODE_HASH')
+    need(isinstance(inventory_source,bytes) and digest(inventory_source)==expected_inventory_sha==REPORT_INVENTORY_SHA,'REPORT_INVENTORY_CODE_HASH')
+    standard_import=builtins.__import__
+    stdlib={'collections','hashlib','json','math','html.parser','posixpath','re','urllib.parse','xml.etree.ElementTree'}
+    dependency=types.ModuleType('_c8_pinned_report_inventory')
+    def fixed_import(name,globals=None,locals=None,fromlist=(),level=0):
+        if level==0 and name=='report_inventory':
+            need(all(n in ('ROOT_PAGES','canonical_path') for n in fromlist),'REPORT_INVENTORY_IMPORT_EXPORT')
+            return dependency
+        need(level==0 and name in stdlib,'PURE_MODULE_IMPORT_SCOPE')
+        return standard_import(name,globals,locals,fromlist,level)
+    private_builtins=dict(vars(builtins));private_builtins['__import__']=fixed_import
+    inventory_namespace=dependency.__dict__
+    inventory_namespace['__builtins__']=private_builtins
+    exec(compile(inventory_source,'<pinned-report-inventory>','exec'),inventory_namespace)
+    need(callable(inventory_namespace.get('canonical_path')) and isinstance(inventory_namespace.get('ROOT_PAGES'),tuple),'REPORT_INVENTORY_EXPORTS')
+    namespace={'__name__':'_c8_pinned_execution_checks','__builtins__':private_builtins}
+    exec(compile(checks_source,'<pinned-execution-checks>','exec'),namespace)
+    need(callable(namespace.get('validate_close_evidence')) and callable(namespace.get('coverage_errors')),'EXECUTION_CHECKS_EXPORTS')
+    namespace['_pinned_report_inventory']=inventory_namespace
+    return namespace
