+         and events['buildSuccessfulMarker'] is True and events['buildFailedMarker'] is False,'ACTUAL_EXECUTED_COMPILE_REQUIRED')
+    return events
+
+def native_task_log_requirements(reducer,log,assessment,coverage,native_exit):
+    events=reducer['task_event_proof'](log)
+    need(assessment['taskEventProof']==coverage['taskEventProof']==events,'NATIVE_TASK_EVENT_PROOF_LINK')
+    required={t:events['statuses'].get(t,'ABSENT') for t in ['test','guidedIncrementalTest','crossReplicaTest','requireFreshGuidedPartitions','jacocoTestReport','jacocoTestCoverageVerification','check']}
+    need(assessment['requiredTaskStatuses']==coverage['requiredTaskStatuses']==required,'NATIVE_TASK_STATUS_PROOF_LINK')
+    if assessment['validationOutcome']=='PASS':
+        need(type(native_exit) is int and native_exit==0 and events['buildSuccessfulMarker'] is True and events['buildFailedMarker'] is False,'ACTUAL_EXECUTED_C8_TASK_REQUIRED')
+        for task in required:need(required[task]=='EXECUTED','ACTUAL_EXECUTED_C8_TASK_REQUIRED')
+    return events
