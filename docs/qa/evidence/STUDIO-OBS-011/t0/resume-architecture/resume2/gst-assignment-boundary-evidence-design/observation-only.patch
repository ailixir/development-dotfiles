+  // Temporary evidence only: success is silent; original operations and failures are unchanged.
+  private static void observeGstCallback(String route, int status, String responseBody) {
+    if (status == 202) return;
+    try {
+      String code = "UNPROVEN";
+      if (responseBody != null && responseBody.length() <= 4096) {
+        JsonNode error = C.parseWire(responseBody.getBytes(StandardCharsets.UTF_8));
+        C.validate("v3/error", error);
+        code = gstFixedCode(error.path("code").asText());
+      }
+      String fixedRoute = switch (route) {
+        case "claim" -> "CLAIM";
+        case "observations" -> "OBSERVATIONS";
+        case "bootstrap-evidence" -> "BOOTSTRAP_EVIDENCE";
+        case "outcomes" -> "OUTCOMES";
+        default -> "OTHER";
+      };
+      gstDiagnosticLine("CALLBACK_STATUS", fixedRoute, gstFixedStatus(status),
+          "HTTP_ERROR", code, "NONE", 0);
+    } catch (Throwable observationFailure) {
+      gstDiagnosticUnproven();
+    }
+  }
+
+  private static void observeGstCutPrimary(Throwable primary) {
+    try {
+      String family = primary instanceof GuidedSessionException ? "GUIDED_SESSION"
+          : primary instanceof org.springframework.dao.DataIntegrityViolationException ? "DATA_INTEGRITY"
+          : primary instanceof AssertionError ? "ASSERTION"
+          : primary instanceof InterruptedException ? "INTERRUPTED"
+          : primary instanceof IOException ? "IO"
+          : primary instanceof RuntimeException ? "RUNTIME"
+          : primary instanceof Error ? "ERROR" : "OTHER";
+      String code = primary instanceof GuidedSessionException refusal
+          ? gstFixedCode(refusal.getMessage()) : "UNPROVEN";
+      String status = primary instanceof GuidedSessionException refusal
+          ? gstFixedStatus(refusal.status()) : "NONE";
+      String frame = "NONE";
+      int line = 0;
+      StackTraceElement[] frames = primary.getStackTrace();
+      for (int i = 0; i < Math.min(frames.length, 32); i++) {
+        String known = gstFixedFrame(frames[i]);
+        if (!known.equals("NONE")) {
+          frame = known;
+          line = frames[i].getLineNumber();
+          if (line < 1 || line > 99999) { frame = "NONE"; line = 0; }
+          break;
+        }
+      }
+      gstDiagnosticLine("CUT_PRIMARY", "NONE", status, family, code, frame, line);
+    } catch (Throwable observationFailure) {
+      gstDiagnosticUnproven();
+    }
+  }
+
+  private static String gstFixedCode(String code) {
+    return switch (code) {
+      case "INVALID_CONTRACT", "UNAUTHENTICATED", "FORBIDDEN_SCOPE", "REVISION_CONFLICT",
+          "STALE_GENERATION", "TARGET_MISMATCH", "AMBIGUOUS_TARGET", "MISSING_SOURCE",
+          "BINDING_ORDER", "SENSITIVE_SOURCE", "ORIGIN_NOT_ALLOWED", "UNSUPPORTED_SURFACE",
+          "BUDGET_EXCEEDED", "STALE_FENCE", "IDEMPOTENCY_CONFLICT", "UNKNOWN_OUTCOME",
+          "PUBLICATION_CONFLICT", "RUNTIME_INCOMPATIBLE", "ASSERTION_FAILED", "CANCELLED",
+          "EXPIRED", "SECRET_UNAVAILABLE", "SECRET_USE_NOT_AUTHORIZED", "SECRET_USE_REVOKED",
+          "VAULT_UNAVAILABLE", "LOGIN_REQUIRED", "SECRET_TOO_LONG", "POLICY_NOT_APPROVED" -> code;
+      default -> "UNPROVEN";
+    };
+  }
+
+  private static String gstFixedStatus(int status) {
+    return switch (status) {
+      case 400, 401, 403, 404, 409, 422, 429, 500, 503 -> Integer.toString(status);
+      default -> "OTHER";
+    };
+  }
+
+  private static String gstFixedFrame(StackTraceElement frame) {
+    String type = frame.getClassName(), method = frame.getMethodName();
+    if (type.equals("com.citi.put.checks.studio.guided.bridge.GuidedRunnerClient")) {
+      return switch (method) {
+        case "send" -> "CLIENT_SEND";
+        case "remaining" -> "CLIENT_DEADLINE";
+        default -> "NONE";
+      };
+    }
+    if (type.equals("com.citi.put.checks.studio.guided.bridge.GuidedDispatchService")
+        && method.equals("assign")) return "ASSIGN";
+    if (type.equals("com.citi.put.checks.studio.guided.session.GuidedSessionService")) {
+      if (method.matches("lambda\\$prepareAssignment\\$[0-9]+")) return "PREPARE_ASSIGNMENT";
+      if (method.matches("lambda\\$acknowledgeAssignment\\$[0-9]+")) return "ACK_ASSIGNMENT";
+      if (method.matches("lambda\\$claim\\$[0-9]+")) return "CLAIM";
+      return switch (method) {
+        case "prepareAssignment" -> "PREPARE_ASSIGNMENT";
+        case "acknowledgeAssignment" -> "ACK_ASSIGNMENT";
+        case "claim" -> "CLAIM";
+        default -> "NONE";
+      };
+    }
+    if (type.equals("com.citi.put.checks.studio.guided.translation.GuidedProductionSessionAccess")) {
+      return switch (method) {
+        case "checkCurrent" -> "CHECK_CURRENT";
+        case "checkSourceCurrent" -> "CHECK_SOURCE";
+        default -> "NONE";
+      };
+    }
+    if (type.equals("com.citi.put.checks.studio.guided.bridge.GuidedAssignmentStore")) {
+      return switch (method) {
+        case "prepare" -> "INTENT_PREPARE";
+        case "authorizeClaim" -> "AUTHORIZE_CLAIM";
+        case "acknowledge" -> "INTENT_ACK";
+        default -> "NONE";
+      };
+    }
+    if (type.equals("com.citi.put.checks.studio.guided.session.GuidedServiceTransportFaultIT")) {
+      return switch (method) {
+        case "prepareGuidedControllerCut" -> "CUT_SETUP";
+        case "runGuidedControllerCut" -> "CUT_RUN";
+        default -> "NONE";
+      };
+    }
+    return "NONE";
+  }
+
+  private static void gstDiagnosticLine(String site, String route, String status,
+      String family, String code, String frame, int line) {
+    System.err.println("GST_DIAG|site=" + site + "|route=" + route + "|status=" + status
+        + "|family=" + family + "|code=" + code + "|frame=" + frame + "|line=" + line);
+    System.err.flush();
+  }
+
+  private static void gstDiagnosticUnproven() {
+    // Only observer failures are contained; no subject failure is caught or replaced here.
+    try {
+      gstDiagnosticLine("OBSERVER_UNPROVEN", "NONE", "NONE", "OTHER", "UNPROVEN", "NONE", 0);
+    } catch (Throwable unavailableOutput) {
+      // Missing evidence remains UNPROVEN; preserve the subject's original flow and Throwable.
+    }
+  }
