          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "dev": {
          "type": "integer",
          "minimum": 0
        },
        "ino": {
          "type": "integer",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mtimeNs": {
          "type": "integer",
          "minimum": 0
        },
        "ctimeNs": {
          "type": "integer",
          "minimum": 0
        },
        "acquisition": {
          "const": "SAME_BUFFER_NOFOLLOW_FD"
        }
