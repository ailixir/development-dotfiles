            "EXTERNAL_ROOT_INSTALL_CONTROL_AUTHOR",
            "EXTERNAL_ROOT_SETUP_CONTROL_AUTHOR",
            "FUTURE_ACTUAL_SETUP_OR_CONTROL_ACTOR"
