{
  "kind": "PROSPECTIVE_TYPED_FIELD_AND_CLIENT_SCHEMA_DESIGN_NOT_IMPLEMENTED_VALIDATOR",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemas": {
    "selfTextDigest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "SELF_REPORTED_TEXT_DIGEST"
        },
        "status": {
          "const": "COMPLETE"
        },
        "encoding": {
          "const": "STRICT_UTF8"
        },
        "normalization": {
          "const": "NONE"
        },
        "utf8Bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "textSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "status",
        "encoding",
        "normalization",
        "utf8Bytes",
        "textSha256"
      ]
    },
    "physicalFileWitness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
