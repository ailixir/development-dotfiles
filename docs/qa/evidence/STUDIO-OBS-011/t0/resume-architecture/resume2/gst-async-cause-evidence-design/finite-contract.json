  "source": "Typed LogRecord.getThrown or actual Throwable among first4 getParameters values only; do not inspect message/format/nonThrowable parameters.",
  "causeSelection": "Keep exact Execution/Completion wrapper token, first recognized substantive exception family/reason and deepest recognized cause reason within4 links; never infer message-based failure details.",
  "correlation": "No request/session/URI/identity join; asynchronous log observation only, cannot prove it is the future erased at client296.",
  "coverage": "Some HTTP1 read/cancel failures retain typed parameters; not every async future/get timeout/cancellation logs a typed Throwable. Flattened string stack records yield no reconstructed cause.",
  "absence": "UNPROVEN; no callback status record is not proof callback was unreachable. No logger record is not no transport error.",
  "preserves": [
    "real HttpClient construction",
    "real mTLS/hostname verification",
    "existing TLS context",
    "actual SQL/authentication",
    "original deadlines including3s caller expiry",
    "all80method names",
    "751original assertions",
    "99whole-class cases",
    "nineModes",
    "ownership/cleanup/native/rollback/secret oracles"
  ],
  "notSelected": [
    "FULL/raw HTTP logging",
    "headers/requests/content/ssl/trace/channel/frames categories",
    "transport replacement or spy client",
    "injected main seam",
    "JFR recording",
    "any new native/subset/retry command"
