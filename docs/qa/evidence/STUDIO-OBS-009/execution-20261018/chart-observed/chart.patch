+data:
+  catalog.json: |-
+    {{- toJson .Values.studioObserved.catalog | nindent 4 }}
+  policies.json: |-
+    {{- toJson .Values.studioObserved.policies | nindent 4 }}
+{{- end }}
 {{- $_ := include "put-checks.studioAuditSiem.guard" . }}
 {{- if .Values.studioAuditSiem.enabled }}
