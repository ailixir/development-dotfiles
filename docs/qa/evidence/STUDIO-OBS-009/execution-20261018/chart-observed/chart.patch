+# ---------------------------------------------------------------------------
+# Observed replay (STUDIO-OBS-009 residue; architect ruling OI-06, B5).
+#
+# **One source of truth for both images.** The runner (`STUDIO_RUNNER_OBSERVED_*`) and the backend
+# (`studio.observed-replay.catalog-json` / `policies-json`) must hold the SAME catalog entry and the
+# SAME policies, so this one block feeds both; none of them is settable through `studioRunner.runnerEnv`
+# or the backend's `configOverrides` / `env` while this is on (the render fails). Under the single
+# path every Studio run is an observed run, so a runner with both flags off answers 503 to every run
+# (routes.ts `OBSERVED_VALIDATION_DISABLED`, runCoordinator.ts `OBSERVED_REPLAY_DISABLED`) and a
+# backend with an empty catalog answers 409 RUNTIME_INCOMPATIBLE to every publication.
+#
+# OFF by default in every values file; `values-uat.yaml` turns both on. While EITHER flag is on:
+#   - `studioRunner.enabled` must be true, `catalog` and `policies` must be supplied (the render fails
+#     naming the key otherwise);
+#   - the runner image is pinned by digest, `<repository>@sha256:<catalog.build.executableImageDigest>`,
+#     and `studioRunner.image.tag` is ignored. The runner checks that digest against the catalog, so
+#     pinning is what binds the catalog to the image that is actually pulled;
+#   - the runner gets `catalog.json` and `policies.json` from a ConfigMap this chart renders.
+#
+# **A runner image change ALWAYS comes with a new catalog values file**: the entry is specific to
+# one image.
+#
+# Security: catalog and policies are integrity-relevant, not secret. Whoever can edit them decides
+# which origins replay may touch. Treat `policies` as reviewed configuration under the same change
+# control as `values-uat.yaml`, never as runtime input.
+# ---------------------------------------------------------------------------
+studioObserved:
+  # Runner STUDIO_RUNNER_OBSERVED_VALIDATION_ENABLED (serves /v2/validate-observed) and
+  # STUDIO_RUNNER_OBSERVED_REPLAY_ENABLED (serves /v2/runs). Real booleans: --set-string is refused.
+  validationEnabled: false
+  replayEnabled: false
+  # The runner image's OWN {profile, build} catalog entry, produced by CI from the pushed image
+  # (`build.executableImageDigest` is the 64-hex manifest digest, no "sha256:" prefix; the four
+  # hashes are 64 lower-case hex and must be QUOTED strings). No default: this repository cannot
+  # know it. Supply it per release with `-f observed-catalog.<digest>.yaml`.
+  catalog: {}
+  # Older builds the BACKEND may still accept (retained artifacts), same entry shape as `catalog`.
+  # The runner never sees these. The backend's catalog is `[catalog] + additionalBackendCatalog`, the
+  # runner's entry first, because the backend selects the first element.
+  additionalBackendCatalog: []
+  # TrustedPolicy list (replay-ipc.schema.json `#/definitions/TrustedPolicy`), per environment.
+  # Required and non-empty while on; at most 16 entries and 65,536 bytes of JSON (the backend's
+  # bounds, tighter than the runner's 32 entries and 2 MiB). Content owner: see the receipt, open item.
+  policies: []
+  # Where the runner mounts the ConfigMap (catalog.json, policies.json), read-only.
+  mountPath: /etc/studio-observed
+
