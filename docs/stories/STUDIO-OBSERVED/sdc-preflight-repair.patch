 /** @type {ReadonlySet<string>} Story statuses accepted for implementation dispatch. */
 const VALID_IMPLEMENTATION_STATUSES = new Set(['Ready', 'InProgress', 'InReview']);
+
+/** SDC validation precedes implementation; close follows QA's Done transition. */
+function statusesForTask(task) {
+  const name = String(task || '').replace(/\.md$/i, '').toLowerCase();
+  if (['validate', 'validate-story-draft', 'validate-next-story'].includes(name)) {
+    return new Set(['Draft']);
+  }
+  if (['review', 'review-story', 'qa-gate'].includes(name)) {
+    return new Set(['InProgress', 'InReview']);
+  }
+  if (['close', 'close-story', 'po-close-story'].includes(name)) {
+    return new Set(['Done']);
+  }
+  return VALID_IMPLEMENTATION_STATUSES;
+}
 
