{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/session.schema.json",
  "title": "Studio observed v3 session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "testId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "PREPARING",
        "REPLAYING_PREFIX",
        "OBSERVING",
        "PROPOSING",
        "ACTING",
        "AWAITING_CLARIFICATION",
        "FINALIZING",
        "SUCCEEDED",
        "PUBLICATION_CONFLICT",
        "FAILED",
        "UNKNOWN_OUTCOME",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelDataPolicyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valueTransferPolicyId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "observe",
              "step"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "principalId",
        "csiId",
        "environmentId",
        "sourceRevision",
        "configurationRevision",
        "modelDataPolicyId",
        "valueTransferPolicyId",
        "capabilities"
      ]
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "scopedRun"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "authorizationId",
        "kind",
        "authorizedAt",
        "principalId",
        "scopeHash"
      ]
    },
    "versions": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "leaseExpiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        }
      },
      "required": [
        "workerId",
        "fence",
        "leaseExpiresAt"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "limits": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/limits.schema.json"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelProposals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sanitizedEvidenceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "actions",
        "observations",
        "modelProposals",
        "modelInputTokens",
        "modelOutputTokens",
        "sanitizedEvidenceBytes"
      ]
    },
    "sourceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requiresAssertion": {
            "type": "boolean"
          }
        },
        "required": [
          "stepId",
          "requiresAssertion"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "baseRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "firstLearnStepId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "testId",
    "state",
    "scope",
    "scopeHash",
    "runAuthorization",
    "versions",
    "owner",
    "createdAt",
    "expiresAt",
    "limits",
    "counters",
    "sourceSteps"
  ],
  "dependencies": {
    "baseRevisionId": [
      "firstLearnStepId"
    ],
    "firstLearnStepId": [
      "baseRevisionId"
    ]
  }
}
