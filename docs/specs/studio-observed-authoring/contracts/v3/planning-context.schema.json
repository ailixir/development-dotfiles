{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/planning-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "stepId",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "configurationReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "destination",
              "nonsecretText",
              "secretRef"
            ]
          },
          "referenceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "referenceId",
          "stepId",
          "kind",
          "referenceName"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "destination",
              "nonsecretText",
              "secretRef"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "secretId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          }
        },
        "required": [
          "inputId",
          "sourceStepId",
          "kind"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "targetIntent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "scopeIntent": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "referenceIndex": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "needId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "selectedChoice": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 0,
                "maxLength": 160
              },
              "ref": {
                "type": "string",
                "pattern": "^e[0-9]{1,6}$"
              },
              "ordinal": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "index",
                  "count"
                ]
              },
              "scopeHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "role",
              "name",
              "ref"
            ]
          },
          "reconfirm": {
            "const": true
          },
          "uses": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "obligationId",
          "stepId",
          "occurrence",
          "targetIntent",
          "scopeIntent",
          "referenceIndex",
          "needId",
          "uses"
        ],
        "allOf": [
          {
            "not": {
              "type": "object",
              "properties": {
                "selectedChoice": {
                  "type": "object"
                },
                "reconfirm": {
                  "const": true
                }
              },
              "required": [
                "selectedChoice",
                "reconfirm"
              ]
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 800
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "needId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "producerStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "stepId"
              ]
            },
            "minItems": 0,
            "maxItems": 200
          },
          "bindingId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "needId",
          "producerStepId",
          "consumers",
          "bindingId"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "observation": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        {
          "type": "null"
        }
      ]
    },
    "executionEvidence": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/execution-evidence.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "authoredInputsHash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "repairCodes": {
      "type": "array",
      "items": {
        "enum": [
          "INVALID_RESPONSE",
          "INVALID_CONTRACT",
          "BINDING_ORDER",
          "STALE_GENERATION",
          "AMBIGUOUS_INTENT"
        ]
      },
      "minItems": 0,
      "maxItems": 3
    },
    "authoringContext": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "stepId",
          "text"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "clarificationSelections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/source-selection.schema.json#/definitions/sourceQuestionMeaning"
      }
    },
    "sourceReferences": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
      }
    },
    "learningWindow": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/planning-context.schema.json#/definitions/LearningWindow"
    },
    "repair": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "closedCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z_]{1,63}$"
            },
            "stage": {
              "enum": [
                "SYNTAX",
                "PRE_FENCE"
              ]
            },
            "line": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "column": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "facts": {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            "previousCode": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            }
          },
          "required": [
            "closedCode",
            "stage",
            "line",
            "column",
            "facts",
            "previousCode"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "sourceSteps",
    "configurationReferences",
    "inputs",
    "obligations",
    "needs",
    "observation",
    "executionEvidence",
    "coordinate",
    "authoredInputsHash",
    "contextRevision",
    "repairCodes",
    "authoringContext",
    "clarificationSelections"
  ],
  "definitions": {
    "LearningWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstLearnStepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "learnableStepIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextSemanticOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "completedCoordinates": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "availableBindingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "firstLearnStepId",
        "learnableStepIds",
        "nextSemanticOrdinal",
        "completedCoordinates",
        "availableBindingIds"
      ]
    }
  }
}
