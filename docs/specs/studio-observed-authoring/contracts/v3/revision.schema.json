{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/revision.schema.json",
  "title": "Observed replay revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/RevisionIdentity"
    },
    "stepSnapshotHashes": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/SnapshotMap"
    },
    "reusedFrom": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/ReuseMap"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revisionDigest",
    "identity",
    "stepSnapshotHashes",
    "reusedFrom"
  ],
  "definitions": {
    "RevisionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "configurationRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authoringHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learnedPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referencePolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operationEquivalenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "admissionProvenanceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicationEvidenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runAuthorizationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "testId",
        "csiId",
        "sourceRevision",
        "configurationRevision",
        "sourceHash",
        "configurationHash",
        "authoringHash",
        "learnedPlanHash",
        "artifactHash",
        "referencePolicyHash",
        "operationEquivalenceHash",
        "admissionProvenanceHash",
        "publicationEvidenceHash",
        "runAuthorizationHash",
        "profileHash"
      ]
    },
    "PlainDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "const": "plain"
        },
        "valueHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "referenceId",
        "kind",
        "valueHash"
      ]
    },
    "SecretDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "const": "secretRef"
        },
        "secretId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        }
      },
      "required": [
        "referenceId",
        "kind",
        "secretId"
      ]
    },
    "Declaration": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/PlainDeclaration"
        },
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/SecretDeclaration"
        }
      ]
    },
    "RevisionReferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "authoringIdentityVersion": {
          "const": 1
        },
        "authoredDeclarations": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/Declaration"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "variables",
        "secrets",
        "authoringIdentityVersion",
        "authoredDeclarations"
      ]
    },
    "StepInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "studio.step-input"
        },
        "version": {
          "const": 1
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "context": {
          "type": "object"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/Declaration"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "domain",
        "version",
        "stepId",
        "text",
        "context",
        "references"
      ]
    },
    "TestConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "studio.test-config"
        },
        "version": {
          "const": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "browser": {
          "const": "chromium"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 2160
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "waitStrategy": {
          "enum": [
            "none",
            "load",
            "domcontentloaded",
            "networkidle"
          ]
        },
        "globalContextHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "globalReferences": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/revision.schema.json#/definitions/Declaration"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "domain",
        "version",
        "environment",
        "browser",
        "viewport",
        "timeoutSeconds",
        "waitStrategy",
        "globalContextHash",
        "globalReferences"
      ]
    },
    "StepChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "studio.step-chain"
        },
        "version": {
          "const": 1
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "stepInputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "previous": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "domain",
        "version",
        "stepId",
        "stepInputHash",
        "previous"
      ]
    },
    "StepSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "studio.step-snapshot"
        },
        "version": {
          "const": 1
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "inputChain": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learnedStepHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "domain",
        "version",
        "stepId",
        "inputChain",
        "learnedStepHash"
      ]
    },
    "LearnedContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "producedBindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "consumedBindings": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "actions",
        "producedBindings",
        "consumedBindings"
      ]
    }
  }
}
