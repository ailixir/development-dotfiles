{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/replay-artifact.schema.json",
  "title": "Observed replay replay-artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 3
    },
    "kind": {
      "const": "observed"
    },
    "profile": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authoringHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "learnedPlan": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json"
    },
    "learnedPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputRecipes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json#/definitions/InputRecipe"
      }
    },
    "guards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json#/definitions/Guard"
      }
    },
    "replayPolicy": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/replay-policy.schema.json"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/replay-operation.schema.json#/definitions/Step"
      }
    }
  },
  "required": [
    "version",
    "kind",
    "profile",
    "sourceHash",
    "configurationHash",
    "authoringHash",
    "learnedPlan",
    "learnedPlanHash",
    "inputRecipes",
    "guards",
    "replayPolicy",
    "steps"
  ]
}
