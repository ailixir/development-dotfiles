{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceKind": {
          "const": "sourceSpan"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startUtf16": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "endUtf16": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "kind": {
          "enum": [
            "nonsecretText",
            "destination"
          ]
        }
      },
      "required": [
        "referenceKind",
        "sourceRevision",
        "stepId",
        "startUtf16",
        "endUtf16",
        "kind"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceKind": {
          "const": "configuration"
        },
        "configurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "nonsecretText",
            "destination"
          ]
        }
      },
      "required": [
        "referenceKind",
        "configurationRevision",
        "stepId",
        "referenceId",
        "kind"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceKind": {
          "const": "configuration"
        },
        "configurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "secretRef"
        },
        "referenceName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      },
      "required": [
        "referenceKind",
        "configurationRevision",
        "stepId",
        "referenceId",
        "kind",
        "referenceName"
      ]
    }
  ]
}
