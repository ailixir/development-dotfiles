{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/guided-policy.schema.json",
  "title": "Studio governed guided observation policy (STUDIO-OBS-014 AC-1/AC-5/AC-6)",
  "definitions": {
    "policyDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$"
          }
        },
        "applicationPolicy": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/runner-context.schema.json#/definitions/ObservationApplicationPolicy"
        },
        "sideEffectStance": {
          "type": "string",
          "enum": [
            "ALLOW",
            "CLARIFY_FIRST",
            "DENY"
          ]
        },
        "destructiveVocabulary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^\\S+(?: \\S+)*$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "allowedOrigins",
        "applicationPolicy",
        "sideEffectStance",
        "destructiveVocabulary"
      ]
    },
    "policyDocumentInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$"
          }
        },
        "applicationPolicy": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/runner-context.schema.json#/definitions/ObservationApplicationPolicy"
        },
        "sideEffectStance": {
          "type": "string",
          "enum": [
            "ALLOW",
            "CLARIFY_FIRST",
            "DENY"
          ]
        },
        "destructiveVocabulary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^\\S+(?: \\S+)*$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "allowedOrigins",
        "applicationPolicy"
      ]
    },
    "createPolicyRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "document": {
          "$ref": "#/definitions/policyDocumentInput"
        }
      },
      "required": [
        "schemaVersion",
        "csiId",
        "applicationId",
        "environmentId",
        "document"
      ]
    },
    "createVersionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "document": {
          "$ref": "#/definitions/policyDocumentInput"
        }
      },
      "required": [
        "schemaVersion",
        "expectedVersion",
        "document"
      ]
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schemaVersion",
        "approvalRef"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        }
      },
      "required": [
        "approvedBy",
        "approvalRef",
        "approvedAt"
      ]
    },
    "policyVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "document": {
          "$ref": "#/definitions/policyDocument"
        },
        "documentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observationPolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/approval"
            }
          ]
        }
      },
      "required": [
        "version",
        "document",
        "documentHash",
        "observationPolicyHash",
        "createdBy",
        "createdAt",
        "approval"
      ]
    },
    "policyView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "policyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "activeVersion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          ]
        },
        "latestVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "active": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/policyVersion"
            }
          ]
        },
        "latest": {
          "$ref": "#/definitions/policyVersion"
        }
      },
      "required": [
        "schemaVersion",
        "policyId",
        "csiId",
        "applicationId",
        "environmentId",
        "activeVersion",
        "latestVersion",
        "active",
        "latest"
      ],
      "if": {
        "type": "object",
        "properties": {
          "activeVersion": {
            "type": "null"
          }
        },
        "required": [
          "activeVersion"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "active": {
            "type": "null"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "active": {
            "type": "object"
          }
        }
      }
    }
  }
}
