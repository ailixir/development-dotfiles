{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/observation.schema.json",
  "title": "Studio observed v3 observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "origin": {
      "type": "string",
      "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "withheldRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unsupportedRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "passwordControls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "withheldRegions",
        "unsupportedRegions",
        "passwordControls"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projected": {
          "type": "boolean"
        },
        "tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "focus+parent+siblings",
            "focus+parent",
            "focus",
            "truncated",
            null
          ]
        },
        "totalNodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "shownNodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "notShown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "outlineBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        }
      },
      "required": [
        "projected",
        "tier",
        "totalNodes",
        "shownNodes",
        "notShown",
        "outlineBytes"
      ]
    },
    "readRuleId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "outline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40000
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^e[0-9]{1,6}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/ObservationFact"
      }
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "documentId",
    "generation",
    "origin",
    "scopeHash",
    "observedAt",
    "coverage",
    "projection",
    "readRuleId",
    "outline",
    "facts"
  ],
  "definitions": {
    "ObservationFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "editable": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "evidenceSegments": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/EvidenceSegment"
          }
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "nameComplete": {
          "type": "boolean"
        },
        "ownTextComplete": {
          "type": "boolean"
        },
        "ordinal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2147483647
            }
          },
          "required": [
            "index",
            "count"
          ]
        },
        "nearSource": {
          "const": "WITHHELD_ADJACENT_PUBLIC"
        },
        "readScope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relation": {
              "enum": [
                "SAME_ROW_LABEL",
                "IMMEDIATE_HEADING_SAME_PARENT",
                "R7_ADJACENT_PUBLIC"
              ]
            },
            "sourceRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^e[0-9]{1,6}$"
              }
            },
            "tableTitleRef": {
              "type": "string",
              "pattern": "^e[0-9]{1,6}$"
            }
          },
          "required": [
            "relation",
            "sourceRefs"
          ],
          "allOf": [
            {
              "if": {
                "required": [
                  "tableTitleRef"
                ]
              },
              "then": {
                "properties": {
                  "relation": {
                    "const": "SAME_ROW_LABEL"
                  },
                  "sourceRefs": {
                    "minItems": 2
                  }
                }
              }
            }
          ]
        },
        "scopeRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^e[0-9]{1,6}$"
          }
        },
        "directTextAssertion": {
          "const": true
        }
      },
      "required": [
        "role",
        "name",
        "editable",
        "evidence",
        "evidenceSegments",
        "nameComplete",
        "ownTextComplete"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "directTextAssertion"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "paragraph"
              },
              "name": {
                "const": ""
              },
              "editable": {
                "const": false
              },
              "ownTextComplete": {
                "const": true
              }
            },
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "EvidenceSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "name",
            "placeholder",
            "near",
            "ownText",
            "text",
            "group",
            "header",
            "sibling"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "purpose": {
          "const": "READ_ASSERT_ONLY"
        }
      },
      "required": [
        "field",
        "start",
        "end"
      ]
    }
  }
}
