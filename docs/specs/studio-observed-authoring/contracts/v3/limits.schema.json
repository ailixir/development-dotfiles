{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/limits.schema.json",
  "title": "Studio observed v3 limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maxSessionSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600,
      "default": 600
    },
    "maxActions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 200
    },
    "maxObservations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400,
      "default": 400
    },
    "maxModelProposals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    },
    "maxModelInputTokensTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1572864,
      "default": 1572864
    },
    "maxModelOutputTokensTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 131072,
      "default": 98304
    },
    "maxObservationBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288,
      "default": 524288
    },
    "maxSanitizedEvidenceBytesTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304,
      "default": 4194304
    },
    "maxRuntimeValues": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "default": 32
    },
    "maxRuntimeValueBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 4096
    },
    "maxRuntimeValuesBytesTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536,
      "default": 65536
    },
    "maxSourceSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    },
    "maxStatementsPerStep": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 8
    },
    "maxOutlineBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40000,
      "default": 40000
    }
  },
  "required": [
    "maxSessionSeconds",
    "maxActions",
    "maxObservations",
    "maxModelProposals",
    "maxModelInputTokensTotal",
    "maxModelOutputTokensTotal",
    "maxObservationBytes",
    "maxOutlineBytes",
    "maxSanitizedEvidenceBytesTotal",
    "maxRuntimeValues",
    "maxRuntimeValueBytes",
    "maxRuntimeValuesBytesTotal",
    "maxSourceSteps",
    "maxStatementsPerStep"
  ]
}
