{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/session-view.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "session": {
      "$ref": "#/definitions/PublicSession"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "session",
    "result"
  ],
  "definitions": {
    "PublicSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "testId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "PREPARING",
            "REPLAYING_PREFIX",
            "OBSERVING",
            "PROPOSING",
            "ACTING",
            "AWAITING_CLARIFICATION",
            "FINALIZING",
            "SUCCEEDED",
            "PUBLICATION_CONFLICT",
            "FAILED",
            "UNKNOWN_OUTCOME",
            "CANCELLED",
            "EXPIRED"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "observations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "modelProposals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "modelInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "modelOutputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "sanitizedEvidenceBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "actions",
            "observations",
            "modelProposals",
            "modelInputTokens",
            "modelOutputTokens",
            "sanitizedEvidenceBytes"
          ]
        },
        "progress": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/public-ui-projections.schema.json#/definitions/PublicProgress"
        },
        "baseRevisionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "firstLearnStepId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "testId",
        "state",
        "expiresAt",
        "counters",
        "progress"
      ],
      "dependencies": {
        "baseRevisionId": [
          "firstLearnStepId"
        ],
        "firstLearnStepId": [
          "baseRevisionId"
        ]
      }
    }
  }
}
