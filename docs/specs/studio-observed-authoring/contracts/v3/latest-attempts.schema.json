{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/latest-attempts.schema.json",
  "title": "Latest learning attempts (GET /guided-sessions/latest)",
  "description": "The caller's own most recent terminal guided session per requested test. A test the caller cannot read, an unknown, deleted or quarantined test, and a test with no terminal session of the caller are omitted, never refused. A live session never appears. explanation is the public explanation of a FAILED attempt and null otherwise.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "attempts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "testId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "SUCCEEDED",
              "PUBLICATION_CONFLICT",
              "FAILED",
              "UNKNOWN_OUTCOME",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
          },
          "errorCode": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation": {
            "oneOf": [
              {
                "$ref": "https://checks.citi.example/contracts/observed/v3/public-ui-projections.schema.json#/definitions/PublicExplanation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "testId",
          "sessionId",
          "state",
          "startedAt",
          "errorCode",
          "explanation"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "attempts"
  ]
}
