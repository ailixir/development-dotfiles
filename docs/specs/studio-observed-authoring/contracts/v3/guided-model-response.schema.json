{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/guided-model-response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "SOURCE_PLAN"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "occurrence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "targetIntent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "scopeIntent": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "referenceIndex": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "needId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uses": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "required": [
              "stepId",
              "occurrence",
              "targetIntent",
              "scopeIntent",
              "referenceIndex",
              "needId",
              "uses"
            ]
          },
          "minItems": 1,
          "maxItems": 800
        },
        "stepSections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sections": {
                "type": "array",
                "minItems": 0,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "required": [
              "stepId",
              "sections"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sourceReferences",
        "obligations",
        "stepSections"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "STEP_CODE"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "const": "CODE"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "captures": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "status",
        "code",
        "captures"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "STEP_CODE"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "const": "CLARIFICATION"
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "AMBIGUOUS_TARGET",
                "AMBIGUOUS_BINDING",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            "choices": {
              "type": "array",
              "minItems": 0,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^e[0-9]{1,6}$"
                  },
                  "safeLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "ref",
                  "safeLabel"
                ]
              }
            }
          },
          "required": [
            "reason",
            "choices"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "status",
        "question"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "SOURCE_PLAN"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "AMBIGUOUS_TARGET",
                "AMBIGUOUS_BINDING",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "choiceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "safeLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "meaning": {
                    "$ref": "https://checks.citi.example/contracts/observed/v3/source-selection.schema.json#/definitions/sourceQuestionMeaning"
                  }
                },
                "required": [
                  "choiceId",
                  "safeLabel",
                  "meaning"
                ]
              },
              "minItems": 2,
              "maxItems": 10
            }
          },
          "required": [
            "reason",
            "choices"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "question"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "SOURCE_PLAN"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "const": "UNSUPPORTED"
        },
        "reasonCode": {
          "enum": [
            "UNSUPPORTED_CAPABILITY",
            "MISSING_SOURCE",
            "INSUFFICIENT_EVIDENCE"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "status",
        "reasonCode"
      ]
    }
  ]
}
