{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/replay-profile.schema.json",
  "title": "Observed replay replay-profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 3
    }
  },
  "required": [
    "contract"
  ],
  "definitions": {
    "BuildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaBundleHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referenceBundleHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executableImageDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chromiumBuild": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "profileHash",
        "schemaBundleHash",
        "referenceBundleHash",
        "executableImageDigest",
        "chromiumBuild"
      ]
    },
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": {
          "const": "chromium"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "waitStrategy": {
          "type": "string",
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "browser",
        "viewport",
        "timeoutSeconds",
        "waitStrategy",
        "environment"
      ]
    },
    "ReplayRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "press",
              "check",
              "uncheck",
              "hover",
              "selectOption",
              "read",
              "assert"
            ]
          },
          "uniqueItems": true
        },
        "initialContext": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/properties/initialContext"
        }
      },
      "required": [
        "csiId",
        "environment",
        "capabilities",
        "initialContext"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "press",
              "check",
              "uncheck",
              "hover",
              "selectOption",
              "read",
              "assert"
            ]
          },
          "uniqueItems": true
        },
        "initialContext": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/properties/initialContext"
        }
      },
      "required": [
        "principalId",
        "csiId",
        "environment",
        "capabilities",
        "initialContext"
      ]
    },
    "LearningProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guidedModelContractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "guidedProviderSchemaHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "guidedPromptHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputContractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicationResultVersion": {
          "const": 3
        },
        "configuredModel": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "providerReturnedModelVersion": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guidedModelContractHash",
        "guidedProviderSchemaHash",
        "guidedPromptHash",
        "outputContractHash",
        "publicationResultVersion",
        "configuredModel",
        "providerReturnedModelVersion"
      ]
    }
  }
}
