{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "const": "guided"
    },
    "outcome": {
      "enum": [
        "PREPARING",
        "REPLAYING_PREFIX",
        "OBSERVING",
        "PROPOSING",
        "ACTING",
        "AWAITING_CLARIFICATION",
        "FINALIZING",
        "SUCCEEDED",
        "PUBLICATION_CONFLICT",
        "FAILED",
        "UNKNOWN_OUTCOME",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "assertionsPassed": {
      "type": "boolean"
    },
    "learnedFromThisRun": {
      "type": "boolean"
    },
    "replayVerified": {
      "const": false
    },
    "scheduleActivated": {
      "const": false
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PUBLISHED"
            },
            "receipt": {
              "$ref": "https://checks.citi.example/contracts/observed/v3/publication.schema.json#/definitions/PublicationReceipt"
            }
          },
          "required": [
            "status",
            "receipt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "PENDING",
                "CONFLICT",
                "REFUSED"
              ]
            },
            "receipt": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "receipt"
          ]
        }
      ]
    },
    "currentReadiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "code": {
          "enum": [
            "READY",
            "NOT_PUBLISHED",
            "HEAD_CHANGED",
            "SOURCE_CHANGED",
            "CONFIG_CHANGED",
            "RUNTIME_INCOMPATIBLE",
            "REPLAY_DISABLED"
          ]
        }
      },
      "required": [
        "revisionId",
        "ready",
        "code"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "guidedLedger"
        },
        "ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "video": {
          "description": "The recording of the learning attempt. Null exactly when publication.status is PUBLISHED: a published learn's recording is discarded and its proof is the observed replay named by proof.executionId. Never null otherwise.",
          "oneOf": [
            {
              "$ref": "#/definitions/videoEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "ref",
        "video"
      ]
    },
    "actionTimings": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "$ref": "#/definitions/actionTiming"
      }
    },
    "proof": {
      "description": "The observed replay of the published revision that the finalize request accepted (trigger source AFTER_LEARN). Null unless publication.status is PUBLISHED, and null while that replay was refused or has not been accepted. A refusal code is never carried.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "executionId"
          ]
        }
      ]
    },
    "errorCode": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "const": "AUTH_CONNECTION_REQUIRED"
          },
          "description": "Existing failure vocabulary plus SECRET_UNAVAILABLE, VAULT_UNAVAILABLE and LOGIN_REQUIRED. LOGIN_REQUIRED requires the closed detail."
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "loginStepsPresent": {
          "type": "boolean"
        }
      },
      "required": [
        "stepId",
        "loginStepsPresent"
      ]
    },
    "failure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_CONTRACT",
                "UNAUTHENTICATED",
                "FORBIDDEN_SCOPE",
                "REVISION_CONFLICT",
                "STALE_GENERATION",
                "TARGET_MISMATCH",
                "AMBIGUOUS_TARGET",
                "MISSING_SOURCE",
                "BINDING_ORDER",
                "SENSITIVE_SOURCE",
                "ORIGIN_NOT_ALLOWED",
                "UNSUPPORTED_SURFACE",
                "BUDGET_EXCEEDED",
                "STALE_FENCE",
                "IDEMPOTENCY_CONFLICT",
                "UNKNOWN_OUTCOME",
                "PUBLICATION_CONFLICT",
                "RUNTIME_INCOMPATIBLE",
                "ASSERTION_FAILED",
                "CANCELLED",
                "EXPIRED",
                "SECRET_UNAVAILABLE",
                "VAULT_UNAVAILABLE",
                "LOGIN_REQUIRED",
                "SECRET_TOO_LONG"
              ]
            },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "loginStepsPresent": {
                  "type": "boolean"
                }
              },
              "required": [
                "stepId",
                "loginStepsPresent"
              ]
            }
          },
          "required": [
            "code"
          ],
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "LOGIN_REQUIRED"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "detail": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "stepId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "loginStepsPresent": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "stepId",
                      "loginStepsPresent"
                    ]
                  }
                },
                "required": [
                  "detail"
                ]
              },
              "else": {
                "type": "object",
                "properties": {
                  "detail": {
                    "not": {}
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "relearnedFrom": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/RelearnedFrom"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/public-ui-projections.schema.json#/definitions/PublicProgress"
    },
    "explanation": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/public-ui-projections.schema.json#/definitions/PublicExplanation"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "executionId",
    "scopeHash",
    "mode",
    "outcome",
    "assertionsPassed",
    "learnedFromThisRun",
    "replayVerified",
    "scheduleActivated",
    "publication",
    "currentReadiness",
    "evidence",
    "actionTimings",
    "proof",
    "errorCode",
    "relearnedFrom",
    "progress",
    "explanation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "PUBLISHED"
              }
            },
            "type": "object",
            "required": [
              "status"
            ]
          }
        },
        "type": "object",
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          },
          "learnedFromThisRun": {
            "const": true
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "learnedFromThisRun"
        ]
      },
      "else": {
        "properties": {
          "learnedFromThisRun": {
            "const": false
          }
        },
        "type": "object",
        "required": [
          "learnedFromThisRun"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "currentReadiness": {
            "properties": {
              "ready": {
                "const": true
              }
            },
            "type": "object",
            "required": [
              "ready"
            ]
          }
        },
        "type": "object",
        "required": [
          "currentReadiness"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "PUBLISHED"
              }
            },
            "type": "object",
            "required": [
              "status"
            ]
          },
          "currentReadiness": {
            "properties": {
              "revisionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "code": {
                "const": "READY"
              }
            },
            "type": "object",
            "required": [
              "revisionId",
              "code"
            ]
          }
        },
        "type": "object",
        "required": [
          "publication",
          "currentReadiness"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "errorCode": {
            "const": "LOGIN_REQUIRED"
          }
        },
        "required": [
          "errorCode"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "loginStepsPresent": {
                "type": "boolean"
              }
            },
            "required": [
              "stepId",
              "loginStepsPresent"
            ]
          },
          "outcome": {
            "const": "FAILED"
          }
        },
        "required": [
          "detail"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "detail": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "failure": {
            "type": "object",
            "properties": {
              "code": {
                "const": "LOGIN_REQUIRED"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "failure"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "FAILED"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "video": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "video"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "actionTimings": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "publication": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PUBLISHED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "video": {
                "type": "null"
              }
            },
            "required": [
              "video"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "video": {
                "type": "object"
              }
            },
            "required": [
              "video"
            ]
          },
          "proof": {
            "type": "null"
          }
        },
        "required": [
          "evidence",
          "proof"
        ]
      }
    }
  ],
  "definitions": {
    "videoEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROCESSING",
            "AVAILABLE",
            "FAILED",
            "UNAVAILABLE",
            "EXPIRED"
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        },
        "expiresAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "error",
        "expiresAt",
        "partial"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "AVAILABLE",
                  "EXPIRED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "string"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "partial": {
                "const": true
              }
            },
            "required": [
              "partial"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "AVAILABLE",
                  "EXPIRED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PROCESSING"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "actionTiming": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/action-timing.schema.json"
    }
  }
}
