{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/source-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourceReferences": {
      "type": "array",
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "targetIntent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "scopeIntent": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "referenceIndex": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "needId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "uses": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "stepId",
          "occurrence",
          "targetIntent",
          "scopeIntent",
          "referenceIndex",
          "needId",
          "uses"
        ]
      },
      "minItems": 1,
      "maxItems": 800
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "needId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "producerStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "stepId"
              ]
            },
            "minItems": 0,
            "maxItems": 200
          }
        },
        "required": [
          "needId",
          "producerStepId",
          "consumers"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "sourceReferences",
    "obligations",
    "needs"
  ],
  "definitions": {
    "sourceQuestionNeed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "stepId",
        "occurrence"
      ]
    },
    "sourceQuestionMeaning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "need": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/source-selection.schema.json#/definitions/sourceQuestionNeed"
        },
        "reference": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/source-reference.schema.json"
        }
      },
      "required": [
        "need",
        "reference"
      ]
    }
  }
}
