{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json",
  "title": "Observed v3 exercised-plan candidate",
  "description": "Contract for exact exercised metadata and initial-context precondition. It does not implement lowering, publication or replay readiness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialContext": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "initialBlank"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observedDocument"
            },
            "origin": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "origin"
          ]
        }
      ]
    },
    "sourceSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "versions": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/versions.schema.json"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/blankAction"
          },
          {
            "$ref": "#/definitions/observedAction"
          }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/binding.schema.json"
      }
    },
    "stepSnapshotHashes": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/SnapshotMap"
    },
    "reusedFrom": {
      "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/ReuseMap"
    },
    "incremental": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/IncrementalMetadata"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "authoredInputsHash",
    "initialContext",
    "sourceSteps",
    "versions",
    "actions",
    "bindings",
    "stepSnapshotHashes",
    "reusedFrom",
    "incremental"
  ],
  "definitions": {
    "blankAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stepId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "ordinal": {
              "const": 0
            }
          },
          "required": [
            "stepId",
            "ordinal"
          ]
        },
        "origin": {
          "type": "null"
        },
        "operation": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/operation"
        },
        "admissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "coordinate",
        "origin",
        "operation",
        "admissionId",
        "operationHash"
      ]
    },
    "observedAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/coordinate"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
          "maxLength": 256
        },
        "operation": {
          "$ref": "https://checks.citi.example/contracts/observed/v3/action.schema.json#/properties/operation"
        },
        "admissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "coordinate",
        "origin",
        "operation",
        "admissionId",
        "operationHash"
      ]
    },
    "ReusedFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "revisionId",
        "stepId"
      ]
    },
    "SnapshotMap": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1
    },
    "ReuseMap": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "additionalProperties": {
        "$ref": "https://checks.citi.example/contracts/observed/v3/learned-plan.schema.json#/definitions/ReusedFrom"
      }
    },
    "RelearnedFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "driftSwitchStepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "stepId"
      ]
    },
    "IncrementalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseRevisionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "initialFirstLearnStepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "effectiveFirstLearnStepId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "retainedPrefixAdmissionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "driftReceiptHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "baseRevisionId",
        "initialFirstLearnStepId",
        "effectiveFirstLearnStepId",
        "retainedPrefixAdmissionIds",
        "driftReceiptHash"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "initialContext": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "initialBlank"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "actions": {
            "type": "array",
            "contains": {
              "$ref": "#/definitions/blankAction"
            }
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/observedAction"
            }
          }
        },
        "type": "object"
      }
    }
  ]
}
