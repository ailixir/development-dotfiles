{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/proposal-result.schema.json",
  "title": "Studio observed v1 proposal-result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "action"
        },
        "action": {
          "$ref": "https://checks.citi.example/contracts/observed/v1/action.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "action"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "clarification"
        },
        "clarification": {
          "$ref": "https://checks.citi.example/contracts/observed/v1/clarification.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "clarification"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "stepComplete"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "successfulAdmissionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "sessionId",
        "scopeHash",
        "stepId",
        "successfulAdmissionIds"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "unsupported"
        },
        "error": {
          "$ref": "https://checks.citi.example/contracts/observed/v1/error.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "error"
      ]
    }
  ]
}
