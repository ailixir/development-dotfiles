{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/clarification.schema.json",
  "title": "Studio observed v1 clarification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clarificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "reason": {
      "enum": [
        "AMBIGUOUS_TARGET",
        "AMBIGUOUS_BINDING",
        "MISSING_SOURCE",
        "INSUFFICIENT_EVIDENCE",
        "AUTH_REQUIRED",
        "UNSUPPORTED_SURFACE"
      ]
    },
    "promptCode": {
      "enum": [
        "CHOOSE_FIELD",
        "CHOOSE_SOURCE",
        "CONNECT_ACCOUNT",
        "REVISE_STEP"
      ]
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "choiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "safeLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "bindingId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "choiceId",
          "safeLabel",
          "nodeId",
          "bindingId"
        ]
      },
      "minItems": 0,
      "maxItems": 10
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "clarificationId",
    "sessionId",
    "scopeHash",
    "coordinate",
    "documentId",
    "generation",
    "reason",
    "promptCode",
    "choices",
    "expiresAt"
  ]
}
