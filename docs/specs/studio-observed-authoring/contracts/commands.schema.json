{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/commands.schema.json",
  "title": "Studio observed v1 commands",
  "definitions": {
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "testId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schemaVersion",
        "testId",
        "sourceRevision",
        "configurationRevision",
        "environmentId",
        "applicationId",
        "accountRef"
      ]
    },
    "advance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "admissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ownerFence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "operationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "admissionId",
        "ownerFence",
        "operationHash"
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ledger": {
          "$ref": "https://checks.citi.example/contracts/observed/v1/ledger.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "ledger"
      ]
    },
    "clarify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "clarificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "choiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "schemaVersion",
        "clarificationId",
        "choiceId",
        "generation"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "reason": {
          "enum": [
            "userRequested",
            "policyRevoked"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "reason"
      ]
    },
    "finalize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ownerFence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expectedSourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedConfigurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "learnedPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "admissionProvenanceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "ownerFence",
        "expectedSourceRevision",
        "expectedConfigurationRevision",
        "learnedPlanHash",
        "artifactHash",
        "admissionProvenanceHash"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedFence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "workerId",
        "expectedFence"
      ]
    }
  }
}
