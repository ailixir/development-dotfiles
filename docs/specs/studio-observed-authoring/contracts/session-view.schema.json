{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/session-view.schema.json",
  "title": "Public observed session v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "testId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "PREPARING",
        "OBSERVING",
        "PROPOSING",
        "ACTING",
        "AWAITING_CLARIFICATION",
        "AWAITING_AUTH",
        "FINALIZING",
        "SUCCEEDED",
        "PUBLICATION_CONFLICT",
        "FAILED",
        "UNKNOWN_OUTCOME",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelProposals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sanitizedEvidenceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "actions",
        "observations",
        "modelProposals",
        "modelInputTokens",
        "modelOutputTokens",
        "sanitizedEvidenceBytes"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "testId",
    "state",
    "expiresAt",
    "counters"
  ]
}
