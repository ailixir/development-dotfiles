{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/runner-context.schema.json",
  "title": "Studio observed v1 runner-context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ownerFence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "authoredInputs": {
      "$ref": "https://checks.citi.example/contracts/observed/v1/authored-inputs.schema.json"
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pendingBindings": {
      "$ref": "https://checks.citi.example/contracts/observed/v1/pending-bindings.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "ownerFence",
    "authoredInputs",
    "authoredInputsHash",
    "pendingBindings"
  ]
}
