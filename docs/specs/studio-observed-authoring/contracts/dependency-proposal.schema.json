{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/dependency-proposal.schema.json",
  "title": "Studio observed v1 dependency-proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "needId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "producerStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "semanticLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "valueType": {
            "const": "string"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "argumentSlot": {
                  "enum": [
                    "fill.value",
                    "selectOption.value",
                    "assert.expected"
                  ]
                }
              },
              "required": [
                "stepId",
                "argumentSlot"
              ]
            },
            "minItems": 1,
            "maxItems": 200
          }
        },
        "required": [
          "needId",
          "producerStepId",
          "semanticLabel",
          "valueType",
          "consumers"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "sourceRevision",
    "needs"
  ]
}
