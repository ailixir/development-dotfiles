{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/error.schema.json",
  "title": "Studio observed v1 error",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "code": {
      "enum": [
        "INVALID_CONTRACT",
        "UNAUTHENTICATED",
        "FORBIDDEN_SCOPE",
        "REVISION_CONFLICT",
        "STALE_GENERATION",
        "TARGET_MISMATCH",
        "AMBIGUOUS_TARGET",
        "MISSING_SOURCE",
        "BINDING_ORDER",
        "SENSITIVE_SOURCE",
        "ORIGIN_NOT_ALLOWED",
        "AUTH_CONNECTION_REQUIRED",
        "UNSUPPORTED_SURFACE",
        "BUDGET_EXCEEDED",
        "STALE_FENCE",
        "IDEMPOTENCY_CONFLICT",
        "UNKNOWN_OUTCOME",
        "PUBLICATION_CONFLICT",
        "RUNTIME_INCOMPATIBLE",
        "ASSERTION_FAILED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "retryable": {
      "type": "boolean"
    },
    "messageCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schemaVersion",
    "code",
    "requestId",
    "retryable",
    "messageCode"
  ]
}
