{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/session.schema.json",
  "title": "Studio observed v1 session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "testId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "PREPARING",
        "OBSERVING",
        "PROPOSING",
        "ACTING",
        "AWAITING_CLARIFICATION",
        "AWAITING_AUTH",
        "FINALIZING",
        "SUCCEEDED",
        "PUBLICATION_CONFLICT",
        "FAILED",
        "UNKNOWN_OUTCOME",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 10
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configurationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelDataPolicyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valueTransferPolicyId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "observe",
              "navigate",
              "click",
              "fill",
              "press",
              "check",
              "uncheck",
              "selectOption",
              "hover",
              "read",
              "assert"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "principalId",
        "csiId",
        "environmentId",
        "applicationId",
        "accountRef",
        "approvedOrigins",
        "sourceRevision",
        "configurationRevision",
        "modelDataPolicyId",
        "valueTransferPolicyId",
        "capabilities"
      ]
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "scopedRun"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "authorizationId",
        "kind",
        "authorizedAt",
        "principalId",
        "scopeHash"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": 1
        },
        "learnedPlan": {
          "const": 1
        },
        "observation": {
          "const": 1
        },
        "guidedPolicy": {
          "const": 1
        },
        "referencePolicy": {
          "const": 3
        },
        "lowering": {
          "const": 1
        },
        "artifact": {
          "const": 2
        },
        "language": {
          "const": "observed-1"
        },
        "executor": {
          "const": "observed-1"
        }
      },
      "required": [
        "contract",
        "learnedPlan",
        "observation",
        "guidedPolicy",
        "referencePolicy",
        "lowering",
        "artifact",
        "language",
        "executor"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "leaseExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workerId",
        "fence",
        "leaseExpiresAt"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "limits": {
      "$ref": "https://checks.citi.example/contracts/observed/v1/limits.schema.json"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelProposals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "modelOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sanitizedEvidenceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "actions",
        "observations",
        "modelProposals",
        "modelInputTokens",
        "modelOutputTokens",
        "sanitizedEvidenceBytes"
      ]
    },
    "sourceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requiresAssertion": {
            "type": "boolean"
          }
        },
        "required": [
          "stepId",
          "requiresAssertion"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "authConnection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "configuredAccount",
            "sameSessionHandoff",
            "unavailable"
          ]
        },
        "connectionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "connectionId"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "testId",
    "state",
    "scope",
    "scopeHash",
    "runAuthorization",
    "versions",
    "owner",
    "createdAt",
    "expiresAt",
    "limits",
    "counters",
    "sourceSteps",
    "authConnection"
  ]
}
