{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/revision.schema.json",
  "title": "Studio observed v1 revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "learnedPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissionProvenanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runAuthorizationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": 1
        },
        "learnedPlan": {
          "const": 1
        },
        "observation": {
          "const": 1
        },
        "guidedPolicy": {
          "const": 1
        },
        "referencePolicy": {
          "const": 3
        },
        "lowering": {
          "const": 1
        },
        "artifact": {
          "const": 2
        },
        "language": {
          "const": "observed-1"
        },
        "executor": {
          "const": "observed-1"
        }
      },
      "required": [
        "contract",
        "learnedPlan",
        "observation",
        "guidedPolicy",
        "referencePolicy",
        "lowering",
        "artifact",
        "language",
        "executor"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "revisionId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "learnedPlanHash",
    "artifactHash",
    "admissionProvenanceHash",
    "runAuthorizationId",
    "versions"
  ]
}
