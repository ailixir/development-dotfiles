{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/assignment-stop.schema.json",
  "title": "Observed v2 pre-context assignment stop",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "assignment"
    },
    "assignment": {
      "$ref": "https://checks.citi.example/contracts/observed/v2/assignment.schema.json"
    },
    "reason": {
      "enum": [
        "CANCELLED",
        "EXPIRED",
        "UNKNOWN_OUTCOME",
        "LEASE_LOST",
        "CONTEXT_LOST"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "assignment",
    "reason"
  ]
}
