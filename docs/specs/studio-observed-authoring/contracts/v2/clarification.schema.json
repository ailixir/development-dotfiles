{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/clarification.schema.json",
  "title": "Studio observed v2 production question",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "clarificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "documentId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "reason": {
      "enum": [
        "AMBIGUOUS_TARGET",
        "AMBIGUOUS_BINDING",
        "MISSING_SOURCE",
        "INSUFFICIENT_EVIDENCE",
        "AUTH_REQUIRED",
        "UNSUPPORTED_SURFACE"
      ]
    },
    "promptCode": {
      "enum": [
        "CHOOSE_FIELD",
        "CHOOSE_SOURCE",
        "CONNECT_ACCOUNT",
        "REVISE_STEP"
      ]
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "choiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "safeLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "bindingId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "choiceId",
          "safeLabel",
          "nodeId",
          "bindingId"
        ]
      },
      "minItems": 0,
      "maxItems": 10
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "phase": {
      "enum": [
        "source",
        "observed"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "clarificationId",
    "sessionId",
    "scopeHash",
    "coordinate",
    "documentId",
    "generation",
    "reason",
    "promptCode",
    "choices",
    "expiresAt",
    "phase"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "source"
          }
        }
      },
      "then": {
        "properties": {
          "documentId": {
            "type": "null"
          },
          "generation": {
            "const": 0
          },
          "choices": {
            "items": {
              "properties": {
                "nodeId": {
                  "type": "null"
                },
                "bindingId": {
                  "type": "null"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        }
      },
      "else": {
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  ]
}
