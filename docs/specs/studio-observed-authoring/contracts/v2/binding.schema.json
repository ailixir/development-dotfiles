{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/binding.schema.json",
  "title": "Observed v2 final exercised binding metadata",
  "description": "Final exercised metadata only. No local availability or runtime values; producer-before-consumer provenance requires cross-record verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "valueType": {
      "const": "string"
    },
    "producer": {
      "$ref": "https://checks.citi.example/contracts/observed/v2/action.schema.json#/properties/coordinate"
    },
    "recipe": {
      "$ref": "https://checks.citi.example/contracts/observed/v2/producer.schema.json#/properties/recipe"
    },
    "sourceOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
      "maxLength": 256
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/consumer-edge.schema.json"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producerAdmissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceIntentStepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sessionId",
        "producerAdmissionId",
        "sourceIntentStepId"
      ]
    },
    "transferPolicy": {
      "const": "sameOrigin"
    },
    "preserveBytes": {
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "bindingId",
    "valueType",
    "producer",
    "recipe",
    "sourceOrigin",
    "consumers",
    "provenance",
    "transferPolicy",
    "preserveBytes"
  ]
}
