{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/revision.schema.json",
  "title": "Observed replay revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "$ref": "https://checks.citi.example/contracts/observed/v2/revision.schema.json#/definitions/RevisionIdentity"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revisionDigest",
    "identity"
  ],
  "definitions": {
    "RevisionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "csiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "configurationRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authoringHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learnedPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referencePolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operationEquivalenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "admissionProvenanceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicationEvidenceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runAuthorizationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "testId",
        "csiId",
        "sourceRevision",
        "configurationRevision",
        "sourceHash",
        "configurationHash",
        "authoringHash",
        "learnedPlanHash",
        "artifactHash",
        "referencePolicyHash",
        "operationEquivalenceHash",
        "admissionProvenanceHash",
        "publicationEvidenceHash",
        "runAuthorizationHash",
        "profileHash"
      ]
    }
  }
}
