{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/planning-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "stepId",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "configurationReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "destination",
              "nonsecretText"
            ]
          },
          "intendedSlot": {
            "enum": [
              "navigate.destination",
              "fill.value",
              "selectOption.value",
              "assert.expected"
            ]
          },
          "referenceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "referenceId",
          "stepId",
          "kind",
          "intendedSlot",
          "referenceName"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "destination",
              "nonsecretText"
            ]
          },
          "intendedSlot": {
            "enum": [
              "navigate.destination",
              "fill.value",
              "selectOption.value",
              "assert.expected"
            ]
          }
        },
        "required": [
          "inputId",
          "sourceStepId",
          "kind",
          "intendedSlot"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "operationKind": {
            "enum": [
              "navigate",
              "click",
              "fill",
              "press",
              "selectOption",
              "check",
              "uncheck",
              "hover",
              "read",
              "assert"
            ]
          },
          "targetIntent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "referenceIndex": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "needId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate": {
            "oneOf": [
              {
                "enum": [
                  "visible",
                  "containsText",
                  "hasValue",
                  "url",
                  "title"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "selectedLocator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "role"
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "exact": {
                    "const": true
                  }
                },
                "required": [
                  "kind",
                  "role",
                  "name",
                  "exact"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "label",
                      "testId",
                      "text",
                      "placeholder"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "exact": {
                    "const": true
                  }
                },
                "required": [
                  "kind",
                  "value",
                  "exact"
                ]
              }
            ]
          }
        },
        "required": [
          "obligationId",
          "stepId",
          "occurrence",
          "operationKind",
          "targetIntent",
          "referenceIndex",
          "needId",
          "predicate"
        ]
      },
      "minItems": 0,
      "maxItems": 800
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "needId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "producerStepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "argumentSlot": {
                  "enum": [
                    "fill.value",
                    "selectOption.value",
                    "assert.expected"
                  ]
                }
              },
              "required": [
                "stepId",
                "argumentSlot"
              ]
            },
            "minItems": 1,
            "maxItems": 200
          },
          "bindingId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "needId",
          "producerStepId",
          "consumers",
          "bindingId"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v2/observation.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionEvidence": {
      "oneOf": [
        {
          "$ref": "https://checks.citi.example/contracts/observed/v2/execution-evidence.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "authoredInputsHash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "repairCodes": {
      "type": "array",
      "items": {
        "enum": [
          "INVALID_RESPONSE",
          "INVALID_CONTRACT",
          "BINDING_ORDER",
          "STALE_GENERATION",
          "AMBIGUOUS_INTENT"
        ]
      },
      "minItems": 0,
      "maxItems": 3
    },
    "authoringContext": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "stepId",
          "text"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "clarificationSelections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/source-selection.schema.json#/definitions/sourceQuestionMeaning"
      }
    },
    "sourceReferences": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/source-reference.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "sourceRevision",
    "configurationRevision",
    "sourceSteps",
    "configurationReferences",
    "inputs",
    "obligations",
    "needs",
    "observation",
    "executionEvidence",
    "coordinate",
    "authoredInputsHash",
    "contextRevision",
    "repairCodes",
    "authoringContext",
    "clarificationSelections"
  ]
}
