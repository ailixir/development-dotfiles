          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assertionsPassed": {
          "const": true
        },
        "scheduleActivated": {
          "const": false
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coordinate": {
                "type": "object",
