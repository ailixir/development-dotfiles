{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/result.schema.json",
  "title": "Studio observed v2 result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assertionsPassed": {
          "const": true
        },
        "scheduleActivated": {
          "const": false
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coordinate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stepId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "stepId",
                  "ordinal"
                ]
              },
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "coordinate",
              "startMs",
              "endMs"
            ]
          },
          "minItems": 0,
          "maxItems": 200
        },
        "mode": {
          "const": "guided"
        },
        "outcome": {
          "const": "SUCCEEDED"
        },
        "learnedFromThisRun": {
          "const": true
        },
        "replayVerified": {
          "const": false
        },
        "readyRevisionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "executionId",
        "scopeHash",
        "sessionId",
        "assertionsPassed",
        "scheduleActivated",
        "evidenceRef",
        "actionTimings",
        "mode",
        "outcome",
        "learnedFromThisRun",
        "replayVerified",
        "readyRevisionId"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "executionId": {
          "type": "string",
