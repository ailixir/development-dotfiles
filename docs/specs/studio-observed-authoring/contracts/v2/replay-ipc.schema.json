      },
      "required": [
        "kind",
        "protocolVersion",
        "mode",
        "runId",
        "attemptId",
        "admissionId",
        "profileHash",
        "build",
        "ok",
        "errorCode",
        "recording"
      ]
    },
    "Stop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
