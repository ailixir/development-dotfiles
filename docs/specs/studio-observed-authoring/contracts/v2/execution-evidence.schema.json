{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/execution-evidence.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "initialBlank"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "creationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bootstrapId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "const": "about:blank"
        },
        "origin": {
          "type": "null"
        },
        "generation": {
          "const": 0
        }
      },
      "required": [
        "kind",
        "sessionId",
        "contextId",
        "creationId",
        "documentId",
        "bootstrapId",
        "url",
        "origin",
        "generation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "observedDocument"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "observationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "sessionId",
        "contextId",
        "documentId",
        "generation",
        "origin",
        "observationHash"
      ]
    }
  ]
}
