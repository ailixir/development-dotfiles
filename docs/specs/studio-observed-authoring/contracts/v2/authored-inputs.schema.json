{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/authored-inputs.schema.json",
  "title": "Studio observed v2 authored-inputs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inputId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sourceStepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "const": "nonsecretText"
              },
              "value": {
                "type": "string",
                "maxLength": 4096
              },
              "intendedSlot": {
                "enum": [
                  "navigate.destination",
                  "fill.value",
                  "selectOption.value",
                  "assert.expected"
                ]
              },
              "provenance": {
                "$ref": "https://checks.citi.example/contracts/observed/v2/source-reference.schema.json"
              }
            },
            "required": [
              "inputId",
              "sourceStepId",
              "kind",
              "value",
              "intendedSlot",
              "provenance"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inputId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sourceStepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "const": "destination"
              },
              "value": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "intendedSlot": {
                "enum": [
                  "navigate.destination",
                  "fill.value",
                  "selectOption.value",
                  "assert.expected"
                ]
              },
              "provenance": {
                "$ref": "https://checks.citi.example/contracts/observed/v2/source-reference.schema.json"
              }
            },
            "required": [
              "inputId",
              "sourceStepId",
              "kind",
              "value",
              "intendedSlot",
              "provenance"
            ]
          }
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "sourceRevision",
    "inputs",
    "configurationRevision"
  ]
}
