{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/observation.schema.json",
  "title": "Studio observed v2 observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "origin": {
      "type": "string",
      "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "semantic",
            "boundedDom"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "withheldRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "reason": {
          "enum": [
            "complete",
            "budget",
            "sensitivity",
            "unsupportedSurface"
          ]
        }
      },
      "required": [
        "mode",
        "complete",
        "truncated",
        "withheldRegions",
        "reason"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "elementType": {
            "enum": [
              "button",
              "input",
              "textarea",
              "select",
              "text",
              "link",
              "other"
            ]
          },
          "controlType": {
            "enum": [
              "none",
              "text",
              "search",
              "email",
              "tel",
              "url",
              "textarea",
              "password",
              "hidden",
              "other"
            ]
          },
          "classification": {
            "enum": [
              "structuralOnly",
              "permittedBusinessData",
              "nonsecretApproved",
              "withheld"
            ]
          },
          "policyRuleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "visible": {
            "type": "boolean"
          },
          "actionable": {
            "type": "boolean"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "parentNodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "regionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "formId": {
            "type": [
              "string",
              "null"
            ]
          },
          "labelNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 20
          },
          "locatorHints": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "role"
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "exact": {
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "role",
                    "name",
                    "exact"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "label",
                        "testId",
                        "text",
                        "placeholder"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "exact": {
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "value",
                    "exact"
                  ]
                }
              ]
            },
            "minItems": 0,
            "maxItems": 5
          }
        },
        "required": [
          "nodeId",
          "documentId",
          "generation",
          "role",
          "name",
          "elementType",
          "controlType",
          "classification",
          "policyRuleId",
          "visible",
          "actionable",
          "depth",
          "parentNodeId",
          "regionId",
          "formId",
          "labelNodeIds",
          "locatorHints"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "documentId",
    "generation",
    "origin",
    "scopeHash",
    "observedAt",
    "coverage",
    "nodes"
  ]
}
