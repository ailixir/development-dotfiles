{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v2/replay-policy.schema.json",
  "title": "Observed replay replay-policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "learnedPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissionProvenanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicationEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runAuthorizationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "$ref": "https://checks.citi.example/contracts/observed/v2/replay-profile.schema.json#/definitions/ReplayRequirements"
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/replay-operation.schema.json#/definitions/InputRecipe"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/binding.schema.json"
      }
    },
    "transfers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "$ref": "https://checks.citi.example/contracts/observed/v2/replay-operation.schema.json#/definitions/Transfer"
      }
    }
  },
  "required": [
    "schemaVersion",
    "learnedPlanHash",
    "admissionProvenanceHash",
    "publicationEvidenceHash",
    "runAuthorizationHash",
    "scope",
    "inputs",
    "bindings",
    "transfers"
  ]
}
