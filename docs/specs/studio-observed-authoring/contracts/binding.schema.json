{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/binding.schema.json",
  "title": "Studio observed v1 binding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "valueType": {
      "const": "string"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "stepId",
        "ordinal"
      ]
    },
    "recipe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "visibleText"
            },
            "classification": {
              "const": "permittedBusinessData"
            },
            "policyRuleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "classification",
            "policyRuleId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "controlValue"
            },
            "classification": {
              "const": "nonsecretApproved"
            },
            "controlType": {
              "enum": [
                "text",
                "search",
                "email",
                "tel",
                "url",
                "textarea"
              ]
            },
            "policyRuleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "classification",
            "controlType",
            "policyRuleId"
          ]
        }
      ]
    },
    "sourceOrigin": {
      "type": "string",
      "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
      "maxLength": 256
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "coordinate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "stepId",
              "ordinal"
            ]
          },
          "argumentSlot": {
            "enum": [
              "fill.value",
              "selectOption.value",
              "assert.expected"
            ]
          },
          "destinationOrigin": {
            "type": "string",
            "pattern": "^https?://(?:[a-z0-9.-]+|\\[[0-9a-f:]+\\])(?::[1-9][0-9]{0,4})?$",
            "maxLength": 256
          }
        },
        "required": [
          "coordinate",
          "argumentSlot",
          "destinationOrigin"
        ]
      },
      "minItems": 1,
      "maxItems": 200
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producerAdmissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceIntentStepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sessionId",
        "producerAdmissionId",
        "sourceIntentStepId"
      ]
    },
    "transferPolicyId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "preserveBytes": {
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "bindingId",
    "valueType",
    "producer",
    "recipe",
    "sourceOrigin",
    "consumers",
    "provenance",
    "transferPolicyId",
    "preserveBytes"
  ]
}
