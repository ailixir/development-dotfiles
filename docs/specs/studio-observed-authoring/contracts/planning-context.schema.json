{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://checks.citi.example/contracts/observed/v1/planning-context.schema.json",
  "title": "Studio observed v1 planning-context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "stepId",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "authoredInputsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "scopeHash",
    "sourceRevision",
    "sourceSteps",
    "authoredInputsHash"
  ]
}
