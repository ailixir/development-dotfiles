{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checks.invalid/contracts/studio/inference-proposal-v1",
  "title": "Studio inference proposal v1",
  "description": "Local strict acceptance schema for full and incremental model responses. Dynamic exact step-ID membership/order and cardinality are enforced against the frozen compile plan. This is NOT the executable runner artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "steps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "FULL",
        "PATCH"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepId",
              "status",
              "code"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "GENERATED"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepId",
              "status",
              "reason",
              "message"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "UNSUPPORTED"
              },
              "reason": {
                "const": "UNSUPPORTED_CAPABILITY"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepId",
              "status",
              "reason",
              "message"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "CLARIFICATION"
              },
              "reason": {
                "const": "AMBIGUOUS_INTENT"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  }
}
