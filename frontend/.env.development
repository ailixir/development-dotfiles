# Development Environment Configuration
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8080
VITE_DEBUG_MODE=true

# Module Federation Configuration (for Webpack)
REACT_APP_MODULE_NAME=checks
REACT_APP_STANDALONE=false
REACT_APP_SHELL_URL=http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1


# Module Federation Configuration (for Vite)
VITE_MF_PORT=3002
VITE_HOST_PORT=3000

# Feature Flags
# Mock Service Worker for both development servers — `npm run dev:standalone` (Vite, :5173) and
# `npm run dev` (webpack, :3002) — story 10.1, AC-16. Off by default so that either one still talks
# to a real backend when one is running; set to true, or prefix the command with
# `VITE_ENABLE_MSW=true`, to demo Studio against the frozen contract with no backend at all.
# Requires `npm run msw:init` once, which writes public/mockServiceWorker.js.
# A production build never carries the mocks, whatever this is set to.
VITE_ENABLE_MSW=false
VITE_ENABLE_STUDIO=true
VITE_ENABLE_REPORTS=true
REACT_APP_ENABLE_STUDIO=true
REACT_APP_ENABLE_REPORTS=true
REACT_APP_ENABLE_CSI_INTEGRATION=true



# Logging
VITE_LOG_LEVEL=debug
