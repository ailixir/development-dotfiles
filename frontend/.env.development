# Development Environment Configuration
VITE_API_BASE_URL=/api
VITE_ENABLE_MSW=true
VITE_ALLOW_INSECURE_MSW_FALLBACK=true
VITE_API_URL=http://localhost:8080
# Comma-separated list of domains to disable MSW for (fall through to real backend).
# M1 cutover: csi,checks. M2: add schedules. M4: add reports. M5: add studio. Full: remove flag.
# VITE_DISABLE_MSW_DOMAINS=csi,checks
VITE_DEBUG_MODE=true

# Module Federation Configuration (for Webpack)
REACT_APP_MODULE_NAME=checks
REACT_APP_STANDALONE=false
REACT_APP_SHELL_URL=http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_MSW_ENABLED=true


# Module Federation Configuration (for Vite)
VITE_MF_PORT=3002
VITE_HOST_PORT=3000

# Feature Flags
VITE_ENABLE_STUDIO=true
VITE_ENABLE_REPORTS=true
REACT_APP_ENABLE_STUDIO=true
REACT_APP_ENABLE_REPORTS=true
REACT_APP_ENABLE_CSI_INTEGRATION=true



# Logging
VITE_LOG_LEVEL=debug