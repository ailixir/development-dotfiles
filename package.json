{
  "name": "put-checks",
  "version": "1.0.0",
  "private": true,
  "description": "Checks module for PUT platform - Operational health monitoring micro-frontend",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "vite",
    "dev:fed": "webpack serve --config webpack/webpack.dev.js --port 3002",
    "build": "webpack --config webpack/webpack.prod.js",
    "build:standalone": "vite build",
    "build:dev": "webpack --config webpack/webpack.dev.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "msw:init": "npx msw init public/ --save",
    "preview": "vite preview",
    "serve": "npm run dev:fed"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.0.1",
    "@mui/material": "^7.1.1",
    "@mui/icons-material": "^7.1.1",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@reduxjs/toolkit": "^2.5.0",
    "react-redux": "^9.1.2",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "oidc-react": "^3.0.0",
    "jwt-decode": "^4.0.0",
    "dayjs": "^1.11.13",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.10.0",
    "zod": "^3.24.1",
    "react-hotkeys-hook": "^4.6.1",
    "framer-motion": "^11.15.0",
    "@put/core-components": "file:../put-core-components"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "@module-federation/enhanced": "^0.18.0",
    "html-webpack-plugin": "^5.6.3",
    "ts-loader": "^9.5.1",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "webpack-merge": "^6.0.1",
    "msw": "^2.6.8",
    "vitest": "^1.4.0",
    "@vitest/ui": "^1.4.0",
    "@vitest/coverage-v8": "^1.4.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "cypress": "^13.15.2",
    "jsdom": "^24.0.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
