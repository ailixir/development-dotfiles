{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(npm install)",
      "Bash(pkill:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm install:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(mv:*)",
      "Bash(tar:*)"
    ],
    "deny": [],
    "additionalDirectories": [
      "/Users/brunobuger/workspace/citi/put/put-core-components"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .aiox-core/infrastructure/templates/grok-hooks/precompact-wrapper.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .aiox-core/infrastructure/templates/grok-hooks/synapse-wrapper.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .aiox-core/infrastructure/templates/grok-hooks/enforce-git-push-authority.cjs",
            "timeout": 10
          }
        ],
        "matcher": "Bash|run_terminal_command"
      }
    ]
  }
}